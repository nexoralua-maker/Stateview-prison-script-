-- ==========================================
-- ANIMATION & TOGGLE LOGIC
-- ==========================================
local isOpen = true
local isAnimating = false
local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function toggleGUI()
    if isAnimating then return end
    isAnimating = true
    
    if isOpen then
        local closeTween = TweenService:Create(mainContainer, tweenInfo, {Size = UDim2.new(0, 0, 0, 0)})
        closeTween:Play()
        closeTween.Completed:Wait()
        mainContainer.Visible = false
        toggleBtn.Text = "Open"
        isOpen = false
    else
        mainContainer.Visible = true
        local openTween = TweenService:Create(mainContainer, tweenInfo, {Size = UDim2.new(0, 650, 0, 360)})
        openTween:Play()
        openTween.Completed:Wait()
        toggleBtn.Text = "Close"
        isOpen = true
    end
    
    isAnimating = false
end


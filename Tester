                    if child:IsA("Tool") and string.find(string.lower(child.Name), "pizza", 1, true) then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then pcall(function() hum:EquipTool(child) end) end
                        break
                    end
                end
            end
        end
    end
end

local function getRealTargetPosition(tgtRoot)
    local now = tick()
    local currentPos = tgtRoot.Position
    table.insert(targetHistory, {pos = currentPos, time = now})
    if #targetHistory > HISTORY_SIZE then table.remove(targetHistory, 1) end
    if #targetHistory >= 2 then
        local prev = targetHistory[#targetHistory - 1]
        if (currentPos - prev.pos).Magnitude > 30 and now - prev.time < 0.2 then return prev.pos end
    end
    local v = tgtRoot.AssemblyLinearVelocity
    if v.Magnitude > 1 then return currentPos:Lerp(currentPos + v * 0.05, 0.5) end
    return currentPos
end

local function equipTool(toolName)
    local char = LP.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    local eq = char:FindFirstChild(toolName)
    if eq and eq:IsA("Tool") then return true end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        local tool = bp:FindFirstChild(toolName)
        if tool and tool:IsA("Tool") then humanoid:EquipTool(tool); return true end
    end
    return false
end

local function tryAutoShoot()
    local char = LP.Character
    if not char then return end
    local tool = char:FindFirstChildWhichIsA("Tool")
    if not tool then return end
    local n = tool.Name:lower()
    if n:find("pizza") or n:find("donut") or n:find("cola") then return end
    if n:find("katana") or n:find("knife") or n:find("sword")
        or n:find("bat") or n:find("fist") or n:find("crowbar") then return end
    if tick() - lastShot < AUTO_SHOOT_DELAY then return end
    lastShot = tick()
    pcall(function() tool:Activate() end)
end

local function runAutoKillTick()
    local t = SelectedTarget.Player
    if not t or not t.Parent or t == LP then return end
    local myChar = LP.Character
    local tgtChar = t.Character
    if not myChar or not tgtChar then return end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    local tgtRoot = tgtChar:FindFirstChild("HumanoidRootPart")
    local humanoid = myChar:FindFirstChildOfClass("Humanoid")
    if not myRoot or not tgtRoot or not humanoid then return end

    if humanoid.Health < humanoid.MaxHealth then
        local hasPizza = equippedHasKeyword("pizza")
        if not hasPizza then equipPizza() end
        if equippedHasKeyword("pizza") then startPizzaSpam() end
        return
    else
        if pizzaMode or pizzaSpamTask then
            stopPizzaSpam()
            if equippedHasKeyword("pizza") then unequipAllTools() end
        end
    end

    if humanoid.Sit then humanoid.Sit = false end
    humanoid.PlatformStand = false
    humanoid.AutoRotate = false
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    humanoid.JumpHeight = 0

    local realTargetPos = getRealTargetPosition(tgtRoot)
    local radius = 15
    local theta = math.random() * math.pi * 2
    local phi = math.acos(2 * math.random() - 1)
    local offX = radius * math.sin(phi) * math.cos(theta)
    local offY = math.max(0, radius * math.cos(phi))
    local offZ = radius * math.sin(phi) * math.sin(theta)

    local newPos = realTargetPos + Vector3.new(offX, offY, offZ)
    local diff = realTargetPos - newPos
    myRoot.CFrame = CFrame.new(newPos) * CFrame.Angles(0, math.atan2(diff.X, diff.Z), 0)
    myRoot.AssemblyLinearVelocity = Vector3.zero
    myRoot.AssemblyAngularVelocity = Vector3.zero
    tryAutoShoot()
    if not myChar:FindFirstChildWhichIsA("Tool") then pcall(equipTool, "Katana") end
end

local KILL_ANIM_ID = "rbxassetid://124982597491660"
local killAnimTrack = nil

local function playKillAnim()
    local char = LP.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
    local anim = Instance.new("Animation")
    anim.AnimationId = KILL_ANIM_ID
    local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
    if ok and track then
        killAnimTrack = track
        killAnimTrack.Priority = Enum.AnimationPriority.Action4
        killAnimTrack.Looped = true
        pcall(function() killAnimTrack:Play() end)
    end
end

local function stopKillAnim()
    if killAnimTrack then
        pcall(function() killAnimTrack:Stop() end)
        pcall(function() killAnimTrack:Destroy() end)
        killAnimTrack = nil
    end
end

local function stopAutoKill()
    autoKillEnabled = false
    if autoKillTask then task.cancel(autoKillTask); autoKillTask = nil end
    if pauseTask then task.cancel(pauseTask); pauseTask = nil end
    pauseTp = false
    targetHistory = {}
    stopPizzaSpam()
    stopKillAnim()
    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Sit = false; hum.PlatformStand = false; hum.AutoRotate = true
            hum.WalkSpeed = 16; hum.JumpPower = 50; hum.JumpHeight = 7.2
        end
    end
end

local function startAutoKill()
    autoKillEnabled, pauseTp, lastShot, targetHistory = true, false, 0, {}
    playKillAnim()
    autoKillTask = task.spawn(function()
        while autoKillEnabled do
            if not pauseTp then pcall(runAutoKillTick) end
            task.wait(0.1)
        end
    end)
    pauseTask = task.spawn(function()
        while autoKillEnabled do
            task.wait(1)
            if not autoKillEnabled then break end
            pauseTp = true
            local myChar = LP.Character
            if myChar then
                local root = myChar:FindFirstChild("HumanoidRootPart")
                if root then
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end
            task.wait(0.1)
            pauseTp = false
        end
    end)
end


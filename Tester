    local function ensure_draw()
        if Draw then return end
        local ok, lib = pcall(function()
            return loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/linemaster2/storage/main/Drawing.lua"
            ))()
        end)
        if ok and lib then Draw = lib end
    end

    local function new_player_obj(plr)
        ensure_draw()
        if not Draw then return nil end

        local o = { plr = plr, box_lines = {}, skel_lines = {}, box_strips = {} }
        for i = 1, 4 do
            local l = Draw.new("Line")
            l.Visible, l.Thickness = false, 1
            o.box_lines[i] = l
        end
        o.box_fill = Draw.new("Square")
        o.box_fill.Visible   = false
        o.box_fill.Filled    = true
        o.box_fill.Thickness = 0

        for i = 1, GRADIENT_STRIPS do
            local s = Draw.new("Square")
            s.Visible    = false
            s.Filled     = true
            s.Thickness  = 0
            o.box_strips[i] = s
        end

        for i = 1, #skeleton_bones do
            local l = Draw.new("Line")
            l.Visible, l.Thickness = false, 1
            o.skel_lines[i] = l
        end

        o.name_txt = Draw.new("Text"); o.name_txt.Visible = false; o.name_txt.Size = 13; o.name_txt.Center = true; o.name_txt.Outline = true; o.name_txt.Font = 2
        o.dist_txt = Draw.new("Text"); o.dist_txt.Visible = false; o.dist_txt.Size = 12; o.dist_txt.Center = true; o.dist_txt.Outline = true; o.dist_txt.Font = 2
        o.tool_txt = Draw.new("Text"); o.tool_txt.Visible = false; o.tool_txt.Size = 12; o.tool_txt.Center = true; o.tool_txt.Outline = true; o.tool_txt.Font = 2

        o.health_bg = Draw.new("Square"); o.health_bg.Visible = false; o.health_bg.Filled = true
        o.health_fg = Draw.new("Square"); o.health_fg.Visible = false; o.health_fg.Filled = true
        o.armor_bg  = Draw.new("Square"); o.armor_bg.Visible  = false; o.armor_bg.Filled  = true
        o.armor_fg  = Draw.new("Square"); o.armor_fg.Visible  = false; o.armor_fg.Filled  = true


local function AutoSelectPickTarget()
    local camPos  = Camera.CFrame.Position
    local camLook = Camera.CFrame.LookVector

    local best, bestScore = nil, math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        if not p.Character then continue end

        local hum = p.Character:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end

        if Aimlock.Settings.Checks.Knocked then
            local be = p.Character:FindFirstChild("BodyEffects")
            local ko = be and be:FindFirstChild("K.O")
            if ko and ko.Value then continue end
        end
        if Aimlock.Settings.Checks.Grabbed
            and p.Character:FindFirstChild("GRABBING_CONSTRAINT") then
            continue
        end
        if Aimlock.Settings.Checks.Friend
            and p:IsFriendsWith(LP.UserId) then continue end
        if Aimlock.Settings.Checks.Vehicle
            and p.Character:FindFirstChild("[CarHitBox]") then continue end

        local part = ResolveClosestPart(p.Character, Aimlock.Settings.AimPart)
            or p.Character:FindFirstChild("HumanoidRootPart")
        if not part then continue end

        local toTgt = part.Position - camPos
        local dist  = toTgt.Magnitude
        if dist < 0.1 or dist > Aimlock.Settings.MaxDistance then continue end

        if Aimlock.Settings.Checks.Wall then
            local params = RaycastParams.new()
            pcall(function() params.FilterType = Enum.RaycastFilterType.Exclude end)
            local exclude = { Camera, p.Character }
            if LP.Character then
                table.insert(exclude, LP.Character)
                for _, d in ipairs(LP.Character:GetDescendants()) do table.insert(exclude, d) end
            end
            for _, d in ipairs(p.Character:GetDescendants()) do table.insert(exclude, d) end
            params.FilterDescendantsInstances = exclude
            params.IgnoreWater = true
            local res = Workspace:Raycast(camPos, toTgt, params)
            if res and res.Instance and not res.Instance:IsDescendantOf(p.Character) then
                continue
            end
        end

        local dot = camLook:Dot(toTgt.Unit)
        local score = (1 - dot) * 1000 + dist * 0.5
        if score < bestScore then
            bestScore = score
            best = p
        end
    end

    return best
end


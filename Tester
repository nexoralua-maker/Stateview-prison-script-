            end

            local d = (center - sp).Magnitude
            if d <= radius then radius = d; closest = p end
        end
        return closest
    end

    local function get_predicted_position()
        local target = M.state.target
        if not target or not has_char(target) then return Vector3.new(0, 0, 0) end
        local aim_part = ResolveClosestPart(target.Character, AIM_PART)
        if not aim_part then return Vector3.new(0, 0, 0) end
        local pos, vel = aim_part.Position, aim_part.AssemblyLinearVelocity
        return Vector3.new(
            pos.X + vel.X * H_PREDICTION,
            pos.Y + vel.Y * V_PREDICTION,
            pos.Z + vel.Z * H_PREDICTION
        )
    end

    local function cleanup_ghost()
        if M.ghost_model then
            M.ghost_model:Destroy()
            M.ghost_model, M.ghost_owner = nil, nil
        end
    end

    local function build_ghost(p)
        cleanup_ghost()
        if not has_char(p) then return end
        local char = p.Character
        char.Archivable = true
        local clone = char:Clone()
        char.Archivable = false
        clone.Name = "SilentAimPredictionGhost"

        for _, obj in ipairs(clone:GetDescendants()) do
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("Sound")
                or obj:IsA("ParticleEmitter") or obj:IsA("Decal") or obj:IsA("Texture")
                or obj:IsA("Highlight") then
                obj:Destroy()
            elseif obj:IsA("BasePart") then
                obj.Anchored, obj.CanCollide, obj.CanTouch, obj.CanQuery, obj.Massless = true, false, false, false, true
                obj.Transparency = 0.85
                obj.Material = Enum.Material.ForceField
                obj.Color = WHITE
            end
        end

        clone.PrimaryPart = clone:FindFirstChild("HumanoidRootPart")
            or clone:FindFirstChildWhichIsA("BasePart")

        clone.Parent = workspace
        M.ghost_model, M.ghost_owner = clone, p
    end

    local function update_ghost(predicted_pos)
        if not M.ghost_model or not M.state.target then return end
        if M.ghost_owner ~= M.state.target then
            build_ghost(M.state.target)
            if not M.ghost_model then return end
        end
        local real_hrp = M.state.target.Character:FindFirstChild("HumanoidRootPart")
        if not real_hrp then return end
        M.ghost_model:PivotTo(CFrame.new(predicted_pos) * (real_hrp.CFrame - real_hrp.CFrame.Position))
    end

    local function install_hook()
        if M.hookInstalled then return end
        M.hookInstalled = true
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            local args = { ... }
            if not checkcaller() and method == "FireServer"
                and typeof(args[1]) == "string"
                and typeof(args[2]) == "Vector3" then
                if M.enabled and M.state.isTargetting and M.state.target then
                    args[2] = M.state.predicted_position
                end
                return old(self, table.unpack(args))
            end
            return old(self, ...)
        end))
    end

    RunService.RenderStepped:Connect(function()
        if not M.enabled or not drawings then
            if drawings then for _, d in pairs(drawings) do d.Visible = false end end
            M.state.target, M.state.isTargetting = nil, false
            cleanup_ghost()
            return
        end

        local new_target = get_closest_player()
        if new_target ~= M.state.target then cleanup_ghost() end
        M.state.target = new_target
        M.state.isTargetting = new_target ~= nil

        if M.state.isTargetting then
            M.state.predicted_position = get_predicted_position()
            if not M.ghost_model or M.ghost_owner ~= M.state.target then
                build_ghost(M.state.target)
            end
            update_ghost(M.state.predicted_position)
        else
            cleanup_ghost()
        end

        local center = screen_center()
        local radius = FOV_BASE * FOV_RADIUS_MULT

        local innerCol, outerCol
        if USE_CUSTOM_FOV then
            innerCol = FOV_COLOR_CUSTOM
            outerCol = FOV_COLOR_CUSTOM
        else
            innerCol = FOV_INNER_COLOR
            outerCol = FOV_OUTER_COLOR
        end

        drawings.fov_outside.Visible  = FOV_VISIBLE
        drawings.fov_outside.Radius   = radius
        drawings.fov_outside.Color    = outerCol
        drawings.fov_outside.Position = center

        drawings.fov_inside.Visible       = FOV_VISIBLE
        drawings.fov_inside.Radius        = radius
        drawings.fov_inside.Color         = innerCol
        drawings.fov_inside.Transparency  = FOV_TRANSPARENCY
        drawings.fov_inside.Position      = center

        drawings.center_dot.Visible, drawings.center_dot.Position = true, center
        drawings.center_dot.Color = innerCol

        if M.state.isTargetting then
            local ps, on = w2s(M.state.predicted_position)
            drawings.tracer.Visible = on
            drawings.tracer.From = center
            drawings.tracer.To = ps
            drawings.tracer.Color = innerCol
            drawings.tracer.Thickness = 2
            drawings.tracer.Transparency = 0.5

            drawings.pm_outline.Visible, drawings.pm_outline.Position = on, ps
            drawings.pm_outline.Color = outerCol

            drawings.pm_fill.Visible, drawings.pm_fill.Position = on, ps
            drawings.pm_fill.Color = innerCol
            drawings.pm_fill.Transparency = 0.2
        else
            drawings.tracer.Visible = false
            drawings.pm_outline.Visible = false
            drawings.pm_fill.Visible = false
        end
    end)

    local function hook_gun(character)
        if not character then return end
        character.ChildAdded:Connect(function(tool)
            if tool:IsA("Tool") then
                tool.Activated:Connect(function()
                    if M.enabled and M.state.isTargetting and M.state.target
                        and remote and mouse_argument then
                        pcall(function() remote:FireServer(mouse_argument, M.state.predicted_position) end)
                    end
                end)
            end
        end)
    end

    if player.Character then hook_gun(player.Character) end
    player.CharacterAdded:Connect(function(c) hook_gun(c); cleanup_ghost() end)

    function M.setEnabled(state)
        M.enabled = state and true or false
        if M.enabled then ensureDrawings(); install_hook()
        else
            cleanup_ghost()
            M.state.target, M.state.isTargetting = nil, false
            if drawings then for _, d in pairs(drawings) do d.Visible = false end end
        end
    end

    function M.setAimPart(name)       AIM_PART = name or "Head" end
    function M.setFOV(size)          FOV_BASE = math.clamp(tonumber(size) or 80, 1, 100) end
    function M.setFOVTransparency(p) FOV_TRANSPARENCY = math.clamp((tonumber(p) or 50) / 100, 0, 1) end
    function M.setHPrediction(v)     H_PREDICTION = tonumber(v) or H_PREDICTION end
    function M.setVPrediction(v)     V_PREDICTION = tonumber(v) or V_PREDICTION end
    function M.setWallCheck(v)       WALLCHECK = v and true or false end
    function M.setUseCustomFOV(v)    USE_CUSTOM_FOV = v and true or false end
    function M.setFOVColor(c)        FOV_COLOR_CUSTOM = c end
    function M.setFOVVisible(v)      FOV_VISIBLE = v and true or false end
    function M.setFOVInnerColor(c)   FOV_INNER_COLOR = c end
    function M.setFOVOuterColor(c)   FOV_OUTER_COLOR = c end

    return M
end)()


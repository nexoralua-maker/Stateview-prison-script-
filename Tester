local function getEquippedTool()
    local char = LP.Character
    if not char then return nil end
    return char:FindFirstChildWhichIsA("Tool")
end

local function equippedHasKeyword(keyword)
    local t = getEquippedTool()
    if not t then return false, nil end
    return string.find(string.lower(t.Name), string.lower(keyword), 1, true) ~= nil, t
end

local function equipToolByName(name)
    local char = LP.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local tool = char:FindFirstChild(name)
    if not tool then
        local bp = LP:FindFirstChild("Backpack")
        if bp then tool = bp:FindFirstChild(name) end
    end
    if tool and tool:IsA("Tool") then
        if tool.Parent ~= char then
            pcall(function() hum:EquipTool(tool) end)
        end
        return true
    end
    return false
end

local function unequipAllTools()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then pcall(function() hum:UnequipTools() end) end
end

--==================== KATANA RIGHT-CLICK SPAM ====================
local katanaSpamActive = false
local katanaSpamTask   = nil

local function stopKatanaSpam()
    katanaSpamActive = false
    if katanaSpamTask then
        task.cancel(katanaSpamTask)
        katanaSpamTask = nil
    end
end

local function startKatanaSpam()
    if katanaSpamActive then return end
    katanaSpamActive = true
    katanaSpamTask = task.spawn(function()
        while katanaSpamActive do
            local char = LP.Character
            if not char then
                katanaSpamActive = false
                break
            end
            local tool = char:FindFirstChildWhichIsA("Tool")
            if not (tool and string.find(string.lower(tool.Name), "katana", 1, true)) then
                katanaSpamActive = false
                break
            end
            fireRightClick()
            task.wait(0.05)
        end
        katanaSpamTask = nil
    end)
end

local function hookKatanaDetection(character)
    if not character then return end
    character.ChildAdded:Connect(function(child)
        if child:IsA("Tool")
            and string.find(string.lower(child.Name), "katana", 1, true) then
            startKatanaSpam()
        end
    end)
    character.ChildRemoved:Connect(function(child)
        if child:IsA("Tool")
            and string.find(string.lower(child.Name), "katana", 1, true) then
            stopKatanaSpam()
        end
    end)
end

if LP.Character then hookKatanaDetection(LP.Character) end

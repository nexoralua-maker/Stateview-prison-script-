--ESP
local ESP = (function()
    local M = { enabled = false, players = {} }
    local Draw

    local PURPLE_ESP = Color3.fromRGB(160, 60, 255)

    local S = {
        Box = false, BoxColor = PURPLE_ESP, BoxTrans = 0.6, BoxThickness = 1.5,

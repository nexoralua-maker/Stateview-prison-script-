--Velocity Desync
local VelocityDesync = (function()
    local M = { enabled = false }

    local state = {
        savedCFrame  = nil,
        savedVel     = nil,
        savedAng     = nil,
        conns        = {},
        origIndex    = nil,
        origNewIndex = nil,
    }

    local function getHRP()
        local Char = LP.Character
        if not Char then return nil, nil end
        return Char:FindFirstChild("HumanoidRootPart"), Char:FindFirstChildOfClass("Humanoid")
    end

    local function start()
        if M.enabled then return end
        M.enabled = true

        local HRP = getHRP()
        if HRP then
            state.savedCFrame = HRP.CFrame
            state.savedVel    = HRP.AssemblyLinearVelocity
            state.savedAng    = HRP.AssemblyAngularVelocity
        end

        state.conns[#state.conns + 1] = RunService.Heartbeat:Connect(function()
            if not M.enabled then return end
            local HRP, Hum = getHRP()
            if not HRP or not Hum or Hum.Health <= 0 then return end

            local realCFrame = HRP.CFrame
            local realVel    = HRP.AssemblyLinearVelocity
            local realAng    = HRP.AssemblyAngularVelocity
            state.savedCFrame = realCFrame

            HRP.CFrame = realCFrame * CFrame.new(9e9, 0, 9e9)
            RunService.RenderStepped:Wait()

            HRP.CFrame = realCFrame
            HRP.AssemblyLinearVelocity = realVel
            HRP.AssemblyAngularVelocity = realAng
        end)

        if not state.origIndex then
            local orig = hookmetamethod(game, "__index", newcclosure(function(self, key)
                if not checkcaller() and M.enabled and key == "CFrame" then
                    local HRP, Hum = getHRP()
                    if HRP and Hum and Hum.Health > 0
                        and self == HRP and state.savedCFrame then
                        return state.savedCFrame
                    end
                end
                return state.origIndex(self, key)
            end))
            state.origIndex = orig
        end

        if not state.origNewIndex then
            local orig = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
                if not checkcaller() and M.enabled then
                    local HRP = getHRP()
                    if HRP and self == HRP
                        and (key == "AssemblyLinearVelocity" or key == "Velocity") then
                        state.savedVel = value
                    end
                end
                return state.origNewIndex(self, key, value)
            end))
            state.origNewIndex = orig
        end
    end

    local function stop()
        if not M.enabled then return end
        M.enabled = false

        local HRP = getHRP()
        if HRP then
            if state.savedCFrame then HRP.CFrame = state.savedCFrame end
            if state.savedVel then HRP.AssemblyLinearVelocity = state.savedVel end
            if state.savedAng then HRP.AssemblyAngularVelocity = state.savedAng end
        end

        for _, c in ipairs(state.conns) do
            if c and c.Disconnect then c:Disconnect() end
        end
        state.conns = {}
    end

    function M.setEnabled(v)
        if v then start() else stop() end
    end

    return M
end)()


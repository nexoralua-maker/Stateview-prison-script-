--C-Sync
local CSync = (function()
    local M = {
        enabled          = false,
        type             = "Static Local",
        staticX          = 5,
        staticY          = 0,
        staticZ          = 5,
        randomization    = 5,
        visualize        = false,
        visualizeTracer  = false,
        visualizeChar    = false,
        visualizeColor   = Color3.fromRGB(207, 227, 0),
        originalPosition = CFrame.new(1, 1, 1),
        _chams           = nil,
        _tracer          = nil,
        _conn            = nil,
        _hooked          = false,
    }

    local Drawing
    do
        local ok, res = pcall(function()
            return loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/linemaster2/storage/main/Drawing.lua"
            ))()
        end)
        if ok then Drawing = res end
    end

    if Drawing then
        M._tracer = Drawing.new("Line")
        M._tracer.Visible   = false
        M._tracer.Thickness = 2
    end

    local function worldToScreen(position)
        local pos, onScreen = Camera:WorldToViewportPoint(position)
        return Vector2.new(pos.X, pos.Y), onScreen
    end

    local function randomVector3(amount)
        return Vector3.new(
            math.random(-amount * 100, amount * 100) / 100,
            math.random(-amount * 100, amount * 100) / 100,
            math.random(-amount * 100, amount * 100) / 100
        )
    end

    local function cloneCharacter(plr, transparency, color, material)
        if not plr.Character then return nil end
        plr.Character.Archivable = true
        local clone = plr.Character:Clone()
        clone.Parent = Workspace
        plr.Character.Archivable = false

        for _, part in ipairs(clone:GetChildren()) do
            if part:IsA("Accessory") then
                part:Destroy()
            elseif part:IsA("BasePart") then
                part.Anchored   = true
                part.CanCollide = false
                if part:IsA("MeshPart") then
                    part.Color        = color
                    part.Material     = Enum.Material[material]
                    part.Transparency = transparency
                end
                if part.Name == "Head" then
                    local face = part:FindFirstChild("face")
                    if face then face:Destroy() end
                end
            end
        end
        return clone
    end

    local function rebuildChams()
        if M._chams then M._chams:Destroy() end
        M._chams = cloneCharacter(player, 0.7, M.visualizeColor, "Neon")
        if M._chams then
            local hrp = M._chams:FindFirstChild("HumanoidRootPart")
            if hrp then M._chams.PrimaryPart = hrp end
            M._chams.Parent = nil
        end
    end

    if player.Character then rebuildChams() end
    player.CharacterAdded:Connect(function() task.wait(1) rebuildChams() end)

    local function updateChams(desyncedCFrame, color)
        if not M._chams or not player.Character then return end
        for _, part in ipairs(M._chams:GetChildren()) do
            local actualPart = player.Character:FindFirstChild(part.Name)
            if actualPart and part:IsA("MeshPart") then
                part.CFrame = actualPart.CFrame
                part.Color  = color
            end
        end
        M._chams:PivotTo(desyncedCFrame)
    end

    local function installHook()
        if M._hooked then return end
        M._hooked = true
        pcall(function()
            if getrawmetatable and setreadonly and checkcaller then
                local mt = getrawmetatable(game)
                if mt then
                    local oldIndex = mt.__index
                    setreadonly(mt, false)
                    local newIndex = function(self, key)
                        if not checkcaller()
                            and M.enabled
                            and key == "CFrame"
                            and player.Character
                            and self == player.Character:FindFirstChild("HumanoidRootPart")
                        then
                            return M.originalPosition
                        end
                        return oldIndex(self, key)
                    end
                    mt.__index = newcclosure and newcclosure(newIndex) or newIndex
                    setreadonly(mt, true)
                end
            end
        end)
    end

    local function start()
        if M.enabled then return end
        M.enabled = true
        installHook()

        M._conn = RunService.Heartbeat:Connect(function()
            local char = player.Character
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")

            if not hrp or not M.enabled then
                if M._tracer then M._tracer.Visible = false end
                if M._chams  then M._chams.Parent   = nil    end
                return
            end

            local desyncCFrame
            local t = M.type
            if t == "Static Local" or t == "Static Target" then
                desyncCFrame = hrp.CFrame + Vector3.new(M.staticX, M.staticY, M.staticZ)
            elseif t == "Local Random" or t == "Target Random" then
                desyncCFrame = hrp.CFrame + randomVector3(M.randomization)
            else
                desyncCFrame = hrp.CFrame
            end

            M.originalPosition = hrp.CFrame

            if M.visualize and Drawing then
                if M.visualizeTracer and M._tracer then
                    local from, fromOn = worldToScreen(hrp.Position)
                    local to,   toOn   = worldToScreen(desyncCFrame.Position)
                    M._tracer.Visible = (fromOn or toOn)
                    M._tracer.From    = from
                    M._tracer.To      = to
                    M._tracer.Color   = M.visualizeColor
                elseif M._tracer then
                    M._tracer.Visible = false
                end

                if M.visualizeChar and M._chams then
                    M._chams.Parent = Workspace
                    updateChams(desyncCFrame, M.visualizeColor)
                elseif M._chams then
                    M._chams.Parent = nil
                end
            else
                if M._tracer then M._tracer.Visible = false end
                if M._chams  then M._chams.Parent   = nil    end
            end

            hrp.CFrame = desyncCFrame
            RunService.RenderStepped:Wait()
            hrp.CFrame = M.originalPosition
        end)
    end

    local function stop()
        if not M.enabled then return end
        M.enabled = false
        if M._conn then M._conn:Disconnect(); M._conn = nil end
        if M._tracer then M._tracer.Visible = false end
        if M._chams  then M._chams.Parent   = nil    end
    end

    function M.setEnabled(v)
        if v then start() else stop() end
    end
    function M.setType(v)
        M.type = v
    end
    function M.setStatic(axis, v)
        if     axis == "X" then M.staticX = v
        elseif axis == "Y" then M.staticY = v
        elseif axis == "Z" then M.staticZ = v end
    end
    function M.setRandom(v)    M.randomization = v end
    function M.setVisualize(v) M.visualize = v and true or false end
    function M.setColor(c)
        M.visualizeColor = c
        if M._chams then
            for _, part in ipairs(M._chams:GetChildren()) do
                if part:IsA("MeshPart") then part.Color = c end
            end
        end
    end
    function M.setTracer(v) M.visualizeTracer = v and true or false end
    function M.setChar(v)   M.visualizeChar   = v and true or false end

    return M
end)()

--Auto Fire
local AutoFire = (function()
    local M = { enabled = false, initialized = false }
    local FIRE_DELAY   = 0.1
    local IGNORE_MELEE = true

    local activeTool   = nil
    local lastFireTime = 0
    local loopConn     = nil

    local function is_melee_or_consumable(tool)
        if not IGNORE_MELEE then return false end
        local n = tool.Name:lower()
        return n:find("katana") or n:find("knife") or n:find("sword")
            or n:find("bat")    or n:find("fist")  or n:find("crowbar")
            or n:find("pizza")  or n:find("donut") or n:find("cola")
    end

    local function is_gun(tool)
        if not tool or not tool:IsA("Tool") then return false end
        if not tool:FindFirstChild("Handle") then return false end
        if is_melee_or_consumable(tool) then return false end
        return true
    end

    local function activateTool(tool)
        if not tool or not tool.Parent then return end
        if tool.Parent ~= player.Character then return end
        pcall(function() tool:Activate() end)
    end

    local function onEquip(tool)
        if not M.enabled then return end
        if not is_gun(tool) then return end
        activeTool   = tool
        lastFireTime = 0
        task.wait(0.05)
        if M.enabled and activeTool == tool and tool.Parent == player.Character then
            activateTool(tool)
            lastFireTime = tick()
        end
    end

    local function hookCharacter(character)
        if not character then return end
        character.ChildAdded:Connect(function(child)
            if child:IsA("Tool") then onEquip(child) end
        end)
        character.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") and child == activeTool then activeTool = nil end
        end)
    end

    local function startLoop()
        if loopConn then return end
        loopConn = RunService.Heartbeat:Connect(function()
            if not M.enabled then return end
            if not activeTool or activeTool.Parent ~= player.Character then return end
            if tick() - lastFireTime >= FIRE_DELAY then
                activateTool(activeTool)
                lastFireTime = tick()
            end
        end)
    end

    local function init()
        if M.initialized then return end
        M.initialized = true
        if player.Character then
            hookCharacter(player.Character)
            local already = player.Character:FindFirstChildWhichIsA("Tool")
            if already then onEquip(already) end
        end
        player.CharacterAdded:Connect(function(char)
            activeTool = nil
            task.wait(0.2)
            hookCharacter(char)
        end)
        startLoop()
    end

    function M.setEnabled(state)
        M.enabled = state and true or false
        if M.enabled then
            init()
            if player.Character then
                local tool = player.Character:FindFirstChildWhichIsA("Tool")
                if tool and is_gun(tool) then onEquip(tool) end
            end
        else
            activeTool = nil
        end
    end

    function M.setFireDelay(v)
        FIRE_DELAY = math.clamp(tonumber(v) or 0.1, 0.01, 10)
    end

    return M
end)()


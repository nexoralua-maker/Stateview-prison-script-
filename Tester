        o.hl.FillTransparency, o.hl.OutlineTransparency = 0.5, 0
        o.hl.Enabled = false
        o.hl.Parent = CoreGui

        M.players[plr] = o
        return o
    end

    local function destroy_obj(o)
        for _, l in ipairs(o.box_lines) do pcall(function() l:Remove() end) end
        if o.box_fill then pcall(function() o.box_fill:Remove() end) end
        for _, s in ipairs(o.box_strips) do pcall(function() s:Remove() end) end
        for _, l in ipairs(o.skel_lines) do pcall(function() l:Remove() end) end
        for _, k in ipairs({"name_txt","dist_txt","tool_txt","health_bg","health_fg","armor_bg","armor_fg"}) do
            if o[k] then pcall(function() o[k]:Remove() end) end
        end
        if o.hl then o.hl:Destroy() end
    end

    local function w2s(pos)
        local p, on = Camera:WorldToViewportPoint(pos)
        return Vector2.new(p.X, p.Y), on and p.Z > 0
    end

    local function get_armor(plr)
        local char = plr.Character
        if not char then return 0 end
        local be = char:FindFirstChild("BodyEffects")
        local av = be and be:FindFirstChild("Armor")
        if av and av:IsA("NumberValue") then return math.clamp(av.Value, 0, 100) end
        return 0
    end

    RunService.RenderStepped:Connect(function()
        if not M.enabled then return end

        for plr, o in pairs(M.players) do
            if plr == LP or not plr.Parent then
                destroy_obj(o); M.players[plr] = nil
                continue
            end

            local char = plr.Character
            local function hideAll()
                for _, l in ipairs(o.box_lines) do l.Visible = false end
                if o.box_fill then o.box_fill.Visible = false end
                for _, s in ipairs(o.box_strips) do s.Visible = false end
                for _, l in ipairs(o.skel_lines) do l.Visible = false end
                o.name_txt.Visible = false; o.dist_txt.Visible = false; o.tool_txt.Visible = false
                o.health_bg.Visible = false; o.health_fg.Visible = false
                o.armor_bg.Visible = false;  o.armor_fg.Visible = false
                o.hl.Enabled = false
            end

            if not char then hideAll(); continue end

            local hrp = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not head or not hum then hideAll(); continue end

            local hrp_sp, hrp_on = w2s(hrp.Position)
            local head_sp, head_on = w2s(head.Position + Vector3.new(0, 0.5, 0))
            if not hrp_on or not head_on then hideAll(); continue end

            local height = math.abs(hrp_sp.Y - head_sp.Y) * 2
            local width = height * 0.5
            local topLeft = Vector2.new(hrp_sp.X - width / 2, hrp_sp.Y - height / 2)

            if S.Box then
                if S.BoxFilled then
                    if S.BoxGradient then
                        if o.box_fill then o.box_fill.Visible = false end
                        for i = 1, GRADIENT_STRIPS do
                            local strip = o.box_strips[i]
                            local t = (i - 0.5) / GRADIENT_STRIPS
                            local col = S.BoxGradientColor1:Lerp(S.BoxGradientColor2, t)
                            local stripH = height / GRADIENT_STRIPS + 1
                            strip.Position     = Vector2.new(topLeft.X, topLeft.Y + (i - 1) * (height / GRADIENT_STRIPS))
                            strip.Size         = Vector2.new(width, stripH)
                            strip.Color        = col
                            strip.Transparency = S.BoxFillTrans
                            strip.Visible      = true
                        end
                    else
                        for _, s in ipairs(o.box_strips) do s.Visible = false end
                        o.box_fill.Position     = topLeft
                        o.box_fill.Size         = Vector2.new(width, height)
                        o.box_fill.Color        = S.BoxFillColor
                        o.box_fill.Transparency = S.BoxFillTrans
                        o.box_fill.Visible      = true
                    end
                else
                    if o.box_fill then o.box_fill.Visible = false end
                    for _, s in ipairs(o.box_strips) do s.Visible = false end
                end

                local corners = {
                    {topLeft, Vector2.new(topLeft.X + width, topLeft.Y)},
                    {Vector2.new(topLeft.X + width, topLeft.Y), Vector2.new(topLeft.X + width, topLeft.Y + height)},
                    {Vector2.new(topLeft.X + width, topLeft.Y + height), Vector2.new(topLeft.X, topLeft.Y + height)},
                    {Vector2.new(topLeft.X, topLeft.Y + height), topLeft},
                }
                for i, seg in ipairs(corners) do
                    local l = o.box_lines[i]
                    l.From, l.To = seg[1], seg[2]
                    l.Color = S.BoxColor
                    l.Thickness = S.BoxThickness
                    l.Transparency = S.BoxTrans
                    l.Visible = true
                end
            else
                for _, l in ipairs(o.box_lines) do l.Visible = false end
                if o.box_fill then o.box_fill.Visible = false end
                for _, s in ipairs(o.box_strips) do s.Visible = false end
            end

            if S.Skeleton then
                for i, bone in ipairs(skeleton_bones) do
                    local a = char:FindFirstChild(bone[1])
                    local b = char:FindFirstChild(bone[2])
                    local l = o.skel_lines[i]
                    if a and b then
                        local aPos, aOn = w2s(a.Position)
                        local bPos, bOn = w2s(b.Position)
                        if aOn and bOn then
                            l.From, l.To = aPos, bPos
                            l.Color = S.SkeletonColor
                            l.Thickness = 1
                            l.Visible = true
                        else
                            l.Visible = false
                        end
                    else
                        l.Visible = false
                    end
                end
            else
                for _, l in ipairs(o.skel_lines) do l.Visible = false end
            end

            if S.Chams then
                o.hl.Adornee = char
                o.hl.FillColor = S.ChamsFill
                o.hl.OutlineColor = S.ChamsOutline
                o.hl.Enabled = true
            else
                o.hl.Enabled = false
            end

            if S.Name then
                o.name_txt.Text = plr.DisplayName or plr.Name
                o.name_txt.Position = Vector2.new(hrp_sp.X, topLeft.Y - 16)
                o.name_txt.Color = S.NameColor
                o.name_txt.Visible = true
            else
                o.name_txt.Visible = false
            end

            local myChar = LP.Character
            local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local dist = myRoot and math.floor((myRoot.Position - hrp.Position).Magnitude) or 0

            if S.Distance then
                o.dist_txt.Text = dist .. "m"
                o.dist_txt.Position = Vector2.new(hrp_sp.X, topLeft.Y + height + 2)
                o.dist_txt.Color = S.DistanceColor
                o.dist_txt.Visible = true
            else
                o.dist_txt.Visible = false
            end

            local tool = char:FindFirstChildOfClass("Tool")
            if S.Tool and tool then
                o.tool_txt.Text = tool.Name
                o.tool_txt.Position = Vector2.new(hrp_sp.X, topLeft.Y + height + 16)
                o.tool_txt.Color = S.ToolColor
                o.tool_txt.Visible = true
            else
                o.tool_txt.Visible = false
            end

            if S.Health then
                local hf = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local barX = topLeft.X - 6 * S.HealthWidth
                local barW = 2 * S.HealthWidth
                o.health_bg.Size = Vector2.new(barW + 2, height + 2)
                o.health_bg.Position = Vector2.new(barX - 1, topLeft.Y - 1)
                o.health_bg.Color = Color3.new(0, 0, 0)
                o.health_bg.Visible = true
                o.health_fg.Size = Vector2.new(barW, height * hf)
                o.health_fg.Position = Vector2.new(barX, topLeft.Y + height - (height * hf))
                o.health_fg.Color = S.HealthBottom:Lerp(S.HealthTop, hf)
                o.health_fg.Visible = true
            else
                o.health_bg.Visible = false; o.health_fg.Visible = false
            end

            if S.Armor then
                local armor = get_armor(plr) / 100
                local barX = topLeft.X + width + 4 * S.ArmorWidth
                local barW = 2 * S.ArmorWidth
                o.armor_bg.Size = Vector2.new(barW + 2, height + 2)
                o.armor_bg.Position = Vector2.new(barX - 1, topLeft.Y - 1)
                o.armor_bg.Color = Color3.new(0, 0, 0)
                o.armor_bg.Visible = true
                o.armor_fg.Size = Vector2.new(barW, height * armor)
                o.armor_fg.Position = Vector2.new(barX, topLeft.Y + height - (height * armor))
                o.armor_fg.Color = S.ArmorBottom:Lerp(S.ArmorTop, armor)
                o.armor_fg.Visible = true
            else
                o.armor_bg.Visible = false; o.armor_fg.Visible = false
            end
        end
    end)

    local function add(plr)
        if plr == LP or M.players[plr] then return end
        new_player_obj(plr)
    end

    local function remove(plr)
        local o = M.players[plr]
        if o then destroy_obj(o); M.players[plr] = nil end
    end

    Players.PlayerAdded:Connect(add)
    Players.PlayerRemoving:Connect(remove)
    for _, p in ipairs(Players:GetPlayers()) do add(p) end

    function M.setEnabled(v)
        M.enabled = v and true or false
        if M.enabled then
            for _, p in ipairs(Players:GetPlayers()) do add(p) end
        else
            for plr, o in pairs(M.players) do destroy_obj(o); M.players[plr] = nil end
        end
    end

    function M.set(key, val)
        S[key] = val
        if key == "ChamsFill" or key == "ChamsOutline" then
            for _, o in pairs(M.players) do
                o.hl.FillColor = S.ChamsFill
                o.hl.OutlineColor = S.ChamsOutline
            end
        end
    end

    return M
end)()

--==================== SELF MATERIAL / SELF TOOL MATERIAL ====================
local SelfMaterial = (function()
    local M = {
        enabled     = false,
        toolEnabled = false,
        color       = Color3.fromRGB(160, 60, 255),
        toolColor   = Color3.fromRGB(160, 60, 255),
    }

    local savedMaterials     = {}
    local savedToolMaterials = {}
    local conn               = nil

    local function applySelfMaterial()
        if not M.enabled then return end
        local char = LP.Character
        if not char then return end

        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                local isToolPart = part:FindFirstAncestorOfClass("Tool") ~= nil
                if not isToolPart then
                    if not savedMaterials[part] then
                        savedMaterials[part] = {
                            Material = part.Material,
                            Color    = part.Color,
                        }
                    end
                    part.Material = Enum.Material.ForceField
                    part.Color    = M.color
                end
            end
        end
    end

    local function applyToolMaterial(tool)
        if not tool or not tool:IsA("Tool") then return end
        for _, part in ipairs(tool:GetDescendants()) do
            if part:IsA("BasePart") then
                if not savedToolMaterials[part] then
                    savedToolMaterials[part] = {
                        Material = part.Material,
                        Color    = part.Color,
                    }
                end
                part.Material = Enum.Material.ForceField
                part.Color    = M.toolColor
            end
        end
    end

    local function applySelfToolMaterial()
        if not M.toolEnabled then return end
        local char = LP.Character
        if char then
            for _, tool in ipairs(char:GetDescendants()) do
                if tool:IsA("Tool") then applyToolMaterial(tool) end
            end
        end
        local bp = LP:FindFirstChildOfClass("Backpack")
        if bp then
            for _, tool in ipairs(bp:GetChildren()) do
                if tool:IsA("Tool") then applyToolMaterial(tool) end
            end
        end
    end

    local function restoreStore(store)
        for part, data in pairs(store) do
            if part then
                pcall(function()
                    part.Material = data.Material
                    part.Color    = data.Color
                end)
            end
        end
        table.clear(store)
    end

    local function restoreSelfMaterial()     restoreStore(savedMaterials)     end
    local function restoreSelfToolMaterial() restoreStore(savedToolMaterials) end

    local function ensureLoop()
        if conn then return end
        conn = RunService.RenderStepped:Connect(function()
            if not M.enabled and not M.toolEnabled then return end
            if M.enabled     then applySelfMaterial()     end
            if M.toolEnabled then applySelfToolMaterial() end
        end)
    end

    local function stopLoopIfIdle()
        if conn and not M.enabled and not M.toolEnabled then
            conn:Disconnect()
            conn = nil
        end
    end

    function M.setEnabled(v)
        M.enabled = v and true or false
        if M.enabled then

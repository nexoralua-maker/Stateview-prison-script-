    function M.setToolEnabled(v)
        M.toolEnabled = v and true or false
        if M.toolEnabled then
            ensureLoop()
            applySelfToolMaterial()
        else
            restoreSelfToolMaterial()
            stopLoopIfIdle()
        end
    end

    function M.setColor(c)
        M.color = c
        if M.enabled then applySelfMaterial() end
    end

    function M.setToolColor(c)
        M.toolColor = c
        if M.toolEnabled then applySelfToolMaterial() end
    end

    function M.stopAll()
        M.enabled, M.toolEnabled = false, false
        restoreSelfMaterial()
        restoreSelfToolMaterial()
        stopLoopIfIdle()
    end


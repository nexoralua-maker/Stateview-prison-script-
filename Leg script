local Modules = {}

function Modules.Grab(character, grabAnimation)
    assert(character, "Character is nil")
    Settings.Grab.GrabbedCharacter = character

    if Cache.Loops.Grab then Cache.Loops.Grab:Disconnect() end

    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BodyVelocity") or part:IsA("BodyGyro") or part:IsA("BodyPosition") then
            part:Destroy()
        end
    end

    for _, anim in ipairs(LP.Character:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks()) do
        if anim.Animation.AnimationId:match("11075367458") then anim:Stop() end
    end

    repeat task.wait() until character:FindFirstChild("GRABBING_CONSTRAINT")
    if not character:FindFirstChild("GRABBING_CONSTRAINT"):FindFirstChild("H") then return end

    local BodyPosition = Instance.new("BodyPosition", character.UpperTorso)
    local BodyGyro     = Instance.new("BodyGyro", character.UpperTorso)
    local GrabAnim     = LP.Character.Humanoid:LoadAnimation(
        Instance.new("Animation").AnimationId == nil and
        (function() local a = Instance.new("Animation"); a.AnimationId = "rbxassetid://"..grabAnimation; return a end)() or nil
    )

    BodyPosition.D, BodyGyro.D = 200, 100
    BodyPosition.MaxForce = Vector3.new(10000,10000,10000)
    BodyGyro.MaxTorque    = Vector3.new(10000,10000,10000)

    local Position    = LP.Character.RightHand.Position - Vector3.new(0,1,0)
    local Orientation = CFrame.new(character.UpperTorso.Position, LP.Character.HumanoidRootPart.Position)
    BodyGyro.CFrame   = Orientation
    BodyPosition.Position = Position

    character.GRABBING_CONSTRAINT.H.Length = 9e9

    GrabAnim.Priority = Enum.AnimationPriority.Action4
    GrabAnim:Play(); GrabAnim:AdjustSpeed(0); GrabAnim.TimePosition = .1

    Cache.Loops.Grab = RunService.Heartbeat:Connect(function()
        if Settings.Grab.GrabbedCharacter and LP.Character
           and LP.Character:FindFirstChild("BodyEffects")
           and LP.Character.BodyEffects.Grabbed.Value ~= nil
           and Settings.Grab.Grab then
            BodyGyro.CFrame = CFrame.new(character.UpperTorso.Position, LP.Character.HumanoidRootPart.Position)
            BodyPosition.Position = LP.Character.RightHand.Position - Vector3.new(0,1,0)
        end
    end)
end

function Modules.CreateTool(name, func)
    local Tool = Instance.new("Tool", LP.Backpack)
    Tool.Name = name
    Tool.RequiresHandle = false

    Cache.Tools[name] = Tool.Activated:Connect(function()
        if Settings.Grab.GrabbedCharacter == nil then return end
        func()
    end)
    return Tool
end

function Modules.DestroyTool(name)
    local Tool = LP.Backpack:FindFirstChild(name) or LP.Character:FindFirstChild(name)
    if Tool then Tool:Destroy() end
    if Cache.Tools[name] then Cache.Tools[name]:Disconnect(); Cache.Tools[name] = nil end
end

function Modules.StopAnimation(character, id)
    pcall(function()
        for _, anim in ipairs(character:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks()) do
            if anim.Animation.AnimationId:match("rbxassetid://"..tostring(id)) then anim:Stop() end
        end
    end)
end

function Modules.AnimPlay(character, id, speed, time, smoothing)
    pcall(function()
        for _, anim in ipairs(character:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks()) do
            if anim.Animation.AnimationId:match("rbxassetid://"..tostring(id)) then anim:Stop() end
        end
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://"..tostring(id)
        local loaded = character:FindFirstChildOfClass("Humanoid"):LoadAnimation(a)
        loaded.Priority = Enum.AnimationPriority.Action4
        if smoothing then loaded:Play(tonumber(smoothing)) else loaded:Play() end
        if speed then loaded:AdjustSpeed(tonumber(speed)) end
        if time  then loaded.TimePosition = tonumber(time) end
        a:Destroy()
    end)
end

function Modules.LoadAnimation(character, anim)
    return character:FindFirstChildOfClass("Humanoid"):LoadAnimation(anim)
end

function Modules.CreateAnimation(id)
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://"..id
    return a
end

function Modules.NoVelocity(player)
    for _, p in ipairs(player:GetChildren()) do
        if p:IsA("BasePart") then
            p.AssemblyLinearVelocity  = Vector3.zero
            p.AssemblyAngularVelocity = Vector3.zero
            p.Velocity = Vector3.zero
        end
    end
end

function Modules.CanCollide(player, value)
    for _, p in ipairs(player:GetChildren()) do
        if p:IsA("BasePart") then p.CanCollide = value end
    end
end

function Modules.Remove(path, bodypart)
    if bodypart == "all" then
        path.LeftUpperLeg.Position  = Vector3.new(0,-1200,0)
        path.RightUpperLeg.Position = Vector3.new(0,-1200,0)
        path.LeftUpperArm.Position  = Vector3.new(0,-1200,0)
        path.RightUpperArm.Position = Vector3.new(0,-1200,0)
    else
        path[bodypart].Position = Vector3.new(0,-1200,0)
    end
end

function Modules.Play(Id)
    Id = tostring(Id)
    local success = pcall(function()
        if LP.Backpack:FindFirstChild("[Boombox]") then
            LP.Backpack["[Boombox]"].Parent = LP.Character
            ReplicatedStorage.MainEvent:FireServer("Boombox", tonumber(Id))
            LP.Character["[Boombox]"].RequiresHandle = false
            LP.Character["[Boombox]"].Parent = LP.Backpack
            LP.PlayerGui.MainScreenGui.BoomboxFrame.Visible = false
            LP.Character.LowerTorso:WaitForChild("BOOMBOXSOUND")
        end
    end)
    if not success or not LP.Backpack:FindFirstChild("[Boombox]") then
        Sound.SoundId = "rbxassetid://"..Id
        Sound:Play()
    end
end

function Modules.StopAudio()
    Sound:Stop()
    pcall(function() ReplicatedStorage:WaitForChild("MainEvent"):FireServer("BoomboxStop") end)
end

function Modules.Chat(msg)
    pcall(function()
        ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(msg, "All")
    end)
end

function Modules.GetForwardPosition(distance)
    return LP.Character.HumanoidRootPart.Position + (LP.Character.HumanoidRootPart.CFrame.LookVector * distance)
end

function Modules.TweenPosition(Part, Speed, Position)
    TweenService:Create(Part, TweenInfo.new(Speed, Enum.EasingStyle.Linear), {Position = Position}):Play()
end

function Modules.Void(character, part, drop)
    local BodyVelocity = Instance.new("BodyVelocity")
    BodyVelocity.MaxForce = Vector3.new(9e9,9e9,9e9)
    BodyVelocity.Velocity = Vector3.new(9e9,-9e9,9e9)
    BodyVelocity.Parent = part and character[part] or character.UpperTorso
    task.wait(0.1)
    if not drop then
        ReplicatedStorage:FindFirstChild("MainEvent"):FireServer("Grabbing", false)
    end
end

function Modules.CloneCharacter(character)
    character.Archivable = true
    local Clone = character:Clone()
    Clone.HumanoidRootPart.Anchored = false
    Clone.Humanoid.Health = 9e9
    Clone.Humanoid.MaxHealth = 9e9
    for _, c in ipairs({"RagdollConstraints","BodyEffects","GRABBING_CONSTRAINT"}) do
        if Clone:FindFirstChild(c) then Clone[c]:Destroy() end
    end
    for _, part in ipairs(Clone:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CustomPhysicalProperties = PhysicalProperties.new(100,2,.5,100,1)
            part.Transparency = 1
        end
        if part:IsA("Decal") then part.Transparency = 1 end
        if part:IsA("Motor6D") then part:Destroy() end
    end
    Clone.Parent = LP.Character
    Clone.Humanoid:ChangeState("GettingUp")
    character.LeftHand:FindFirstChildOfClass("Motor6D").Enabled  = false
    character.RightHand:FindFirstChildOfClass("Motor6D").Enabled = false
    character.LeftFoot:FindFirstChildOfClass("Motor6D").Enabled  = false
    character.RightFoot:FindFirstChildOfClass("Motor6D").Enabled = false
    return Clone
end

function Modules.DestroyClone(clone, origin)
    if clone then clone:Destroy() end
    if origin then
        origin.LeftHand:FindFirstChildOfClass("Motor6D").Enabled  = true
        origin.RightHand:FindFirstChildOfClass("Motor6D").Enabled = true
        origin.LeftFoot:FindFirstChildOfClass("Motor6D").Enabled  = true
        origin.RightFoot:FindFirstChildOfClass("Motor6D").Enabled = true
    end
end

function Modules.AlignControl(P1, P2, Offset)
    P1.AssemblyLinearVelocity  = Vector3.zero
    P1.AssemblyAngularVelocity = Vector3.zero
    P1.Velocity = Vector3.zero
    P1.CFrame = P2.CFrame * (Offset or CFrame.new())
    P1.CanCollide = false
    P2.CanCollide = false
end

function Modules.ImpactFrame()
    if not Settings.Grab.Effects then return end
    local black = Instance.new("ColorCorrectionEffect", Lighting)
    black.TintColor = Color3.fromRGB(0,0,0)
    local white = Instance.new("Highlight", LP.Character)
    white.FillColor = Color3.fromRGB(255,255,255)
    white.FillTransparency = 0
    task.wait(.1)
    white.FillColor = Color3.fromRGB(0,0,0)
    black.TintColor = Color3.fromRGB(255,255,255)
    black.Brightness = 1
    task.wait(.1)
    black:Destroy(); white:Destroy()
end


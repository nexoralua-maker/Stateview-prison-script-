Tools["Portal"] = function()
    if Settings.Grab["Portal"] then
        Modules.CreateTool("Portal", function()
            if Cache.Loops.Portal then return end
            local StoredPos = LP.Character.HumanoidRootPart.CFrame
            Settings.Grab.Grab = false
            local Storage = ReplicatedStorage
            local Assets, Cloud, StoredAssets = {}, {}, {}
            local function LoadAsset(delete, where)
                if delete then
                    for _, e in ipairs(StoredAssets) do e:Destroy() end
                    for _, c in ipairs(Workspace:GetChildren()) do
                        if c.Name == "Clouds" then c:Destroy() end
                    end
                    return
                end
                for _, a in ipairs(Assets:GetChildren()) do
                    local Clone = a:Clone(); Clone.Parent = Lighting
                    table.insert(StoredAssets, Clone)
                end
                local c = Cloud:Clone(); c.Parent = Workspace; c.CFrame = where; c.Anchored = true
                return c
            end
            Assets = Storage:FindFirstChild("Assets") or game:GetObjects("rbxassetid://81123099704912")[1]
            Assets.Parent = Storage
            Cloud = Storage:FindFirstChild("Clouds") or game:GetObjects("rbxassetid://96210417036558")[1]
            Cloud.Parent = Storage
            local GrabbedChar = Settings.Grab.GrabbedCharacter
            for _, v in ipairs(GrabbedChar:GetDescendants()) do
                if v:IsA("BodyGyro") or v:IsA("BodyPosition") then v:Destroy() end
            end
            local Clone = Modules.CloneCharacter(GrabbedChar)
            Clone.Parent = Workspace
            local yes = false
            Clone.HumanoidRootPart.CFrame = LP.Character.HumanoidRootPart.CFrame
            Cache.Loops.Portal = RunService.Heartbeat:Connect(function()
                for _, part in ipairs(GrabbedChar:GetChildren()) do
                    if part:IsA("BasePart") and not yes then
                        Modules.AlignControl(part, Clone[part.Name], CFrame.new())
                    end
                end
                Modules.NoVelocity(GrabbedChar); Modules.CanCollide(GrabbedChar, false)
                if Clone then
                    LP.Character.HumanoidRootPart.CFrame = Clone.HumanoidRootPart.CFrame - Vector3.new(0,15,0)
                end
                if LP.Character.BodyEffects.Grabbed.Value == nil then
                    LoadAsset(true); Settings.Grab.Grab = true
                    Cache.Loops.Portal:Disconnect(); Cache.Loops.Portal = nil
                end
            end)
            Workspace.Camera.CameraSubject = Clone.Humanoid
            Modules.AnimPlay(Clone, "10714360343")
            task.wait(2)
            Modules.StopAnimation(Clone, "10714360343")
            if Settings.Grab.Effects then
                LoadAsset(false, Clone.HumanoidRootPart.CFrame + Vector3.new(0,20,0))
            end
            Modules.AnimPlay(Clone, "4940561610")
            Modules.Play("7224830040")
            task.wait(6)
            local BodyPos = Instance.new("BodyPosition", GrabbedChar.UpperTorso)
            BodyPos.D = 200
            BodyPos.Position = Clone.UpperTorso.Position
            yes = true
            Modules.NoVelocity(GrabbedChar)
            Modules.TweenPosition(BodyPos, 6, Clone.UpperTorso.Position + Vector3.new(0,20,0))
            task.wait(3.5)
            Modules.Void(GrabbedChar)
            Modules.DestroyClone(GrabbedChar, Clone)
            Clone = nil
            if Cache.Loops.Portal then Cache.Loops.Portal:Disconnect(); Cache.Loops.Portal = nil end
            LoadAsset(true)
            Workspace.Camera.CameraSubject = LP.Character.Humanoid
            for _ = 1,40 do LP.Character.HumanoidRootPart.CFrame = StoredPos end
            Settings.Grab.Grab = true
        end)
    else
        Settings.Grab.Grab = true
        Modules.DestroyTool("Portal")
    end
end


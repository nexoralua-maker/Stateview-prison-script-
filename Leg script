local function hookGrab()
    if Cache.Connections.Grab then
        Cache.Connections.Grab:Disconnect(); Cache.Connections.Grab = nil
    end
    Cache.Connections.Grab = RunService.Heartbeat:Connect(function()
        if not LP.Character then return end
        local be = LP.Character:FindFirstChild("BodyEffects")
        if not be or not be:FindFirstChild("Grabbed") then return end

        local gv = be.Grabbed.Value
        if not gv then
            if Cache.Loops.Grab then
                if Settings.Grab.GrabbedCharacter then
                    for _, p in ipairs(Settings.Grab.GrabbedCharacter:GetDescendants()) do
                        if p:IsA("BodyVelocity") or p:IsA("BodyGyro") or p:IsA("BodyPosition") then
                            p:Destroy()
                        end
                    end
                end
                Settings.Grab.GrabbedCharacter = nil
                Cache.Loops.Grab:Disconnect(); Cache.Loops.Grab = nil
            end
            M.StopAnim(LP.Character, "3135389157")
            return
        end

        if Settings.Grab.GrabbedCharacter and Settings.Grab.GrabbedCharacter.Parent then return end

        M.Grab(gv, 3135389157)
        M.CanCollide(gv, false)
        M.NoVelocity(gv)
    end)
end


Tools["Time Stop"] = function()
    if Settings.Grab["Time Stop"] then
        Modules.CreateTool("Time Stop", function()
            if not Settings.Grab.GrabbedCharacter then return end
            Settings.Grab.Grab = false
            Modules.StopAnimation(LP.Character, "3135389157")
            Modules.StopAnimation(LP.Character, "11075367458")
            Modules.Play(Sounds.TimeStop)
            Modules.AnimPlay(LP.Character, Animations["Time Stop Charging"])
            task.wait(2.5)
            Modules.StopAudio(); task.wait(.3)
            Modules.Play(Sounds.WhenTimeStopped)
            Modules.Chat("When Time is Stopped, There is Only Dio!")
            if Settings.Grab.Effects and Lighting:FindFirstChild("ColorCorrection") then
                TweenService:Create(Lighting.ColorCorrection, TweenInfo.new(1), {Contrast = -1.8}):Play()
            end
            task.wait(4)
            Modules.StopAudio()
            Modules.Play(Sounds.Countdown)
            for _, v in ipairs({4,3,2,1}) do
                Modules.Chat(tostring(v).." Seconds left...")
                task.wait(1.5)
            end
            task.wait(1)
            Modules.Play(Sounds.Muda)
            for i = 1,10 do
                Modules.AnimPlay(LP.Character, Animations.Ora1, 9); task.wait(.2)
                Modules.AnimPlay(LP.Character, Animations.Ora2, 9); task.wait(.2)
            end
            Modules.Play(Sounds.Muda)
            Modules.AnimPlay(LP.Character, Animations.Punch, 1.5); task.wait(1)
            Modules.Play(Sounds.Zero); Modules.Chat("Zero."); task.wait(3)
            Modules.Play(Sounds.TimeResume); Modules.Chat("The time shall move again!"); task.wait(2)
            Modules.Play(Sounds.LoudPunch)
            if Settings.Grab.GrabbedCharacter.UpperTorso:FindFirstChild("BodyPosition") then
                Modules.TweenPosition(Settings.Grab.GrabbedCharacter.UpperTorso.BodyPosition, .8, Modules.GetForwardPosition(19))
            end
            task.wait(1)
            Modules.Remove(Settings.Grab.GrabbedCharacter, "all")
            Modules.Play(Sounds.Rip)
            if Lighting:FindFirstChild("ColorCorrection") then
                TweenService:Create(Lighting.ColorCorrection, TweenInfo.new(1), {Contrast = 0}):Play()
            end
            task.wait(.3)
            ReplicatedStorage.MainEvent:FireServer("Grabbing", false)
            task.wait(.7)
            Modules.StopAudio()
            Settings.Grab.Grab = true
        end)
    else
        Modules.DestroyTool("Time Stop")
    end
end


--==========================================================
-- CORE GRAB — anti-fling version
--==========================================================
function M.Grab(character, grabAnimId)
    if not character or not character.Parent then return end
    Settings.Grab.GrabbedCharacter = character

    if Cache.Loops.Grab then Cache.Loops.Grab:Disconnect(); Cache.Loops.Grab = nil end

    -- Remove any stale physics from a previous grab
    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BodyVelocity") or p:IsA("BodyGyro") or p:IsA("BodyPosition") then
            p:Destroy()
        end
    end

    -- Stop the wrong grab anim on our own character
    for _, a in ipairs(LP.Character.Humanoid:GetPlayingAnimationTracks()) do
        if a.Animation.AnimationId:match("11075367458") then a:Stop() end
    end

    -- Wait for constraint + body parts (max 3s)
    local waited = 0
    while not (character:FindFirstChild("GRABBING_CONSTRAINT")
        and character:FindFirstChild("UpperTorso")
        and character:FindFirstChild("LowerTorso")
        and LP.Character
        and LP.Character:FindFirstChild("RightHand")
        and LP.Character:FindFirstChild("HumanoidRootPart")) do
        task.wait(0.05); waited = waited + 0.05
        if waited > 3 or not character.Parent then return end
    end

    --==========================================================
    -- ANTI-FLING STEP 1:
    -- Freeze the victim BEFORE touching the constraint length.
    -- This stops the physics solver from snapping them into us.
    --==========================================================
    local function freezeTarget()
        for _, p in ipairs(character:GetDescendants()) do
            if p:IsA("BasePart") then
                p.CanCollide = false
                p.AssemblyLinearVelocity  = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
                p.Velocity = Vector3.zero
            end
        end
    end
    freezeTarget()

    --==========================================================
    -- ANTI-FLING STEP 2:
    -- Teleport the victim's UpperTorso to the hand FIRST,
    -- THEN set the constraint length. Otherwise the constraint
    -- tries to pull them across the map in one frame → fling.
    --==========================================================
    pcall(function()
        local hand = LP.Character.RightHand
        character.UpperTorso.CFrame = CFrame.new(hand.Position - Vector3.new(0,1,0),
                                                 LP.Character.HumanoidRootPart.Position)
    end)

    -- Now it's safe to make the constraint effectively infinite
    local gc = character.GRABBING_CONSTRAINT
    local function forceConstraint()
        if not gc or not gc.Parent then return end
        if gc:FindFirstChild("H") then
            pcall(function() gc.H.Length = 9e9 end)
        else
            for _, c in ipairs(gc:GetChildren()) do
                if c:IsA("HingeConstraint") then pcall(function() c.Length = 9e9 end) end
            end
        end
    end
    forceConstraint()

    --==========================================================
    -- ANTI-FLING STEP 3:
    -- Physics is created AFTER the target is already positioned.
    -- BP is set to their CURRENT position first, then the loop
    -- moves it toward the hand smoothly instead of snapping.
    --==========================================================
    local BP = Instance.new("BodyPosition", character.UpperTorso)
    local BG = Instance.new("BodyGyro",     character.UpperTorso)
    BP.D, BG.D = 200, 100
    BP.P = 30000
    BG.P = 30000
    BP.MaxForce  = Vector3.new(9e9, 9e9, 9e9)
    BG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    BP.Position = character.UpperTorso.Position

    -- Grab animation
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://"..grabAnimId
    local GrabAnim = LP.Character.Humanoid:LoadAnimation(anim)
    GrabAnim.Priority = Enum.AnimationPriority.Action4
    pcall(function()
        GrabAnim:Play(); GrabAnim:AdjustSpeed(0); GrabAnim.TimePosition = .1
    end)

    --==========================================================
    -- FOLLOW LOOP
    --==========================================================
    Cache.Loops.Grab = RunService.Heartbeat:Connect(function()
        if not character or not character.Parent
        or not LP.Character
        or not LP.Character:FindFirstChild("BodyEffects")
        or not LP.Character:FindFirstChild("RightHand")
        or not LP.Character:FindFirstChild("HumanoidRootPart")
        or not character:FindFirstChild("UpperTorso") then
            if Cache.Loops.Grab then Cache.Loops.Grab:Disconnect(); Cache.Loops.Grab = nil end
            Settings.Grab.GrabbedCharacter = nil
            return
        end

        if LP.Character.BodyEffects.Grabbed.Value == nil then
            if Cache.Loops.Grab then Cache.Loops.Grab:Disconnect(); Cache.Loops.Grab = nil end
            Settings.Grab.GrabbedCharacter = nil
            return
        end

        if not BP.Parent then
            BP = Instance.new("BodyPosition", character.UpperTorso)
            BP.D = 200; BP.P = 30000; BP.MaxForce = Vector3.new(9e9,9e9,9e9)
        end
        if not BG.Parent then
            BG = Instance.new("BodyGyro", character.UpperTorso)
            BG.D = 100; BG.P = 30000; BG.MaxTorque = Vector3.new(9e9,9e9,9e9)
        end

        -- Target: right in front of your right hand
        local hand = LP.Character.RightHand
        local root = LP.Character.HumanoidRootPart
        local holdOffset = Vector3.new(0, -1, -2.2)
        local targetPos  = hand.Position + hand.CFrame.LookVector * holdOffset.Z
                          + Vector3.new(0, holdOffset.Y, 0)

        --==========================================================
        -- ANTI-FLING STEP 4:
        -- Only move BP toward the target in small increments so
        -- the physics engine doesn't overshoot and launch anyone.
        --==========================================================
        local current = BP.Position
        local diff    = (targetPos - current)
        if diff.Magnitude > 50 then
            -- If we somehow ended up very far, jump once (rare)
            BP.Position = targetPos
        else
            -- Smooth interpolate instead of snapping
            BP.Position = current + diff * 0.35
        end

        BG.CFrame = CFrame.new(character.UpperTorso.Position, root.Position)

        -- Keep velocity zeroed every frame
        for _, p in ipairs(character:GetChildren()) do
            if p:IsA("BasePart") then
                p.AssemblyLinearVelocity  = Vector3.zero
                p.AssemblyAngularVelocity = Vector3.zero
                p.CanCollide = false
            end
        end

        --==========================================================
        -- ANTI-FLING STEP 5:
        -- Also zero YOUR velocity in case the victim pushes back.
        -- (Prevents self-launch.)
        --==========================================================
        local myRoot = LP.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            if myRoot.AssemblyLinearVelocity.Magnitude > 300 then
                myRoot.AssemblyLinearVelocity  = Vector3.zero
                myRoot.AssemblyAngularVelocity = Vector3.zero
            end
        end

        forceConstraint()
    end)
end

--==========================================================
-- Other helpers
--==========================================================
function M.CreateTool(name, func)
    local Tool = Instance.new("Tool", LP.Backpack)
    Tool.Name = name
    Tool.RequiresHandle = false
    Cache.Tools[name] = Tool.Activated:Connect(function()
        if Settings.Grab.GrabbedCharacter == nil then return end
        func()
    end)
    return Tool
end

function M.DestroyTool(name)
    local t = LP.Backpack:FindFirstChild(name) or LP.Character:FindFirstChild(name)
    if t then t:Destroy() end
    if Cache.Tools[name] then Cache.Tools[name]:Disconnect(); Cache.Tools[name] = nil end
end

function M.StopAnim(chr, id)
    pcall(function()
        for _, a in ipairs(chr:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks()) do
            if a.Animation.AnimationId:match("rbxassetid://"..tostring(id)) then a:Stop() end
        end
    end)
end

function M.AnimPlay(chr, id, speed, time, smoothing)
    pcall(function()
        for _, a in ipairs(chr:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks()) do
            if a.Animation.AnimationId:match("rbxassetid://"..tostring(id)) then a:Stop() end
        end
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://"..tostring(id)
        local loaded = chr:FindFirstChildOfClass("Humanoid"):LoadAnimation(anim)
        loaded.Priority = Enum.AnimationPriority.Action4
        if smoothing then loaded:Play(tonumber(smoothing)) else loaded:Play() end
        if speed then loaded:AdjustSpeed(tonumber(speed)) end
        if time  then loaded.TimePosition = tonumber(time) end
        anim:Destroy()
    end)
end

function M.NewAnim(id)
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://"..id
    return a
end

function M.NoVelocity(chr)
    for _, p in ipairs(chr:GetChildren()) do
        if p:IsA("BasePart") then
            p.AssemblyLinearVelocity  = Vector3.zero
            p.AssemblyAngularVelocity = Vector3.zero
            p.Velocity = Vector3.zero
        end
    end
end

function M.CanCollide(chr, v)
    for _, p in ipairs(chr:GetChildren()) do
        if p:IsA("BasePart") then p.CanCollide = v end
    end
end

function M.Remove(chr, part)
    if part == "all" then
        chr.LeftUpperLeg.Position  = Vector3.new(0,-1200,0)
        chr.RightUpperLeg.Position = Vector3.new(0,-1200,0)
        chr.LeftUpperArm.Position  = Vector3.new(0,-1200,0)
        chr.RightUpperArm.Position = Vector3.new(0,-1200,0)
    else
        chr[part].Position = Vector3.new(0,-1200,0)
    end
end

function M.Play(id)
    id = tostring(id)
    local used = false
    if LP.Backpack:FindFirstChild("[Boombox]") then
        pcall(function()
            LP.Backpack["[Boombox]"].Parent = LP.Character
            RS.MainEvent:FireServer("Boombox", tonumber(id))
            LP.Character["[Boombox]"].RequiresHandle = false
            LP.Character["[Boombox]"].Parent = LP.Backpack
            if LP.PlayerGui:FindFirstChild("MainScreenGui")
            and LP.PlayerGui.MainScreenGui:FindFirstChild("BoomboxFrame") then
                LP.PlayerGui.MainScreenGui.BoomboxFrame.Visible = false
            end
        end)
        used = true
    end
    if not used then
        Sound.SoundId = "rbxassetid://"..id
        Sound:Play()
    end
end

function M.StopAudio()
    Sound:Stop()
    pcall(function() RS:WaitForChild("MainEvent"):FireServer("BoomboxStop") end)
end

function M.Chat(msg)
    if msg == nil or msg == "" or msg:gsub("%s", "") == "" then return false end
    local success = false
    pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        if channels then
            local general = channels:FindFirstChild("RBXGeneral")
            if general then
                general:SendAsync(msg)
                success = true
            end
        end
    end)
    if not success then
        pcall(function()
            local legacy = RS:FindFirstChild("DefaultChatSystemChatEvents")
            if legacy and legacy:FindFirstChild("SayMessageRequest") then
                legacy.SayMessageRequest:FireServer(msg, "All")
                success = true
            end
        end)
    end
    return success
end

function M.FwdPos(dist)
    return LP.Character.HumanoidRootPart.Position
         + LP.Character.HumanoidRootPart.CFrame.LookVector * dist
end

function M.TweenPos(part, speed, pos)
    TweenSvc:Create(part, TweenInfo.new(speed, Enum.EasingStyle.Linear), {Position = pos}):Play()
end

function M.Void(chr, part, drop)
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9,9e9,9e9)
    bv.Velocity = Vector3.new(9e9,-9e9,9e9)
    bv.Parent = part and chr[part] or chr.UpperTorso
    task.wait(.1)
    if not drop then
        RS:FindFirstChild("MainEvent"):FireServer("Grabbing", false)
    end
end

function M.CloneChar(chr)
    chr.Archivable = true
    local c = chr:Clone()
    c.HumanoidRootPart.Anchored = false
    c.Humanoid.Health, c.Humanoid.MaxHealth = 9e9, 9e9
    for _, n in ipairs({"RagdollConstraints","BodyEffects","GRABBING_CONSTRAINT"}) do
        if c:FindFirstChild(n) then c[n]:Destroy() end
    end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CustomPhysicalProperties = PhysicalProperties.new(100,2,.5,100,1)
            p.Transparency = 1
        end
        if p:IsA("Decal") then p.Transparency = 1 end
        if p:IsA("Motor6D") then p:Destroy() end
    end
    c.Parent = LP.Character
    c.Humanoid:ChangeState("GettingUp")
    chr.LeftHand:FindFirstChildOfClass("Motor6D").Enabled  = false
    chr.RightHand:FindFirstChildOfClass("Motor6D").Enabled = false
    chr.LeftFoot:FindFirstChildOfClass("Motor6D").Enabled  = false
    chr.RightFoot:FindFirstChildOfClass("Motor6D").Enabled = false
    return c
end

function M.DestroyClone(c, orig)
    if c then c:Destroy() end
    if orig then
        pcall(function()
            orig.LeftHand:FindFirstChildOfClass("Motor6D").Enabled  = true
            orig.RightHand:FindFirstChildOfClass("Motor6D").Enabled = true
            orig.LeftFoot:FindFirstChildOfClass("Motor6D").Enabled  = true
            orig.RightFoot:FindFirstChildOfClass("Motor6D").Enabled = true
        end)
    end
end

function M.Align(p1, p2, off)
    p1.AssemblyLinearVelocity  = Vector3.zero
    p1.AssemblyAngularVelocity = Vector3.zero
    p1.Velocity = Vector3.zero
    p1.CFrame = p2.CFrame * (off or CFrame.new())
    p1.CanCollide, p2.CanCollide = false, false
end

function M.ImpactFrame()
    if not Settings.Grab.Effects then return end
    local black = Instance.new("ColorCorrectionEffect", Lighting)
    black.TintColor = Color3.fromRGB(0,0,0)
    local white = Instance.new("Highlight", LP.Character)
    white.FillColor = Color3.fromRGB(255,255,255); white.FillTransparency = 0
    task.wait(.1)
    white.FillColor = Color3.fromRGB(0,0,0)
    black.TintColor = Color3.fromRGB(255,255,255); black.Brightness = 1
    task.wait(.1)
    black:Destroy(); white:Destroy()
end


T["Portal"] = function()
    if Settings.Grab["Portal"] then
        M.CreateTool("Portal", function()
            if Cache.Loops.Portal then return end
            local storedPos = LP.Character.HumanoidRootPart.CFrame
            Settings.Grab.Grab = false
            local storage = RS
            local assets, cloud, stored = {}, {}, {}
            local function loadAsset(del, where)
                if del then
                    for _, e in ipairs(stored) do e:Destroy() end
                    for _, c in ipairs(WS:GetChildren()) do if c.Name == "Clouds" then c:Destroy() end end
                    return
                end
                for _, a in ipairs(assets:GetChildren()) do
                    local cl = a:Clone(); cl.Parent = Lighting
                    table.insert(stored, cl)
                end
                local c = cloud:Clone(); c.Parent = WS; c.CFrame = where; c.Anchored = true
                return c
            end
            assets = storage:FindFirstChild("Assets") or game:GetObjects("rbxassetid://81123099704912")[1]
            assets.Parent = storage
            cloud = storage:FindFirstChild("Clouds") or game:GetObjects("rbxassetid://96210417036558")[1]
            cloud.Parent = storage
            local GC = Settings.Grab.GrabbedCharacter
            for _, v in ipairs(GC:GetDescendants()) do
                if v:IsA("BodyGyro") or v:IsA("BodyPosition") then v:Destroy() end
            end
            local clone = M.CloneChar(GC); clone.Parent = WS
            local yes = false
            clone.HumanoidRootPart.CFrame = LP.Character.HumanoidRootPart.CFrame
            Cache.Loops.Portal = RunService.Heartbeat:Connect(function()
                for _, p in ipairs(GC:GetChildren()) do
                    if p:IsA("BasePart") and not yes then M.Align(p, clone[p.Name], CFrame.new()) end
                end
                M.NoVelocity(GC); M.CanCollide(GC, false)
                if clone then LP.Character.HumanoidRootPart.CFrame = clone.HumanoidRootPart.CFrame - Vector3.new(0,15,0) end
                if not LP.Character.BodyEffects.Grabbed.Value then
                    loadAsset(true); Settings.Grab.Grab = true
                    if Cache.Loops.Portal then Cache.Loops.Portal:Disconnect(); Cache.Loops.Portal = nil end
                end
            end)
            WS.CurrentCamera.CameraSubject = clone.Humanoid
            M.AnimPlay(clone, 10714360343); task.wait(2)
            M.StopAnim(clone, 10714360343)
            if Settings.Grab.Effects then loadAsset(false, clone.HumanoidRootPart.CFrame + Vector3.new(0,20,0)) end
            M.AnimPlay(clone, 4940561610)
            M.Play("7224830040"); task.wait(6)
            local bp = Instance.new("BodyPosition", GC.UpperTorso)
            bp.D = 200; bp.Position = clone.UpperTorso.Position
            yes = true
            M.NoVelocity(GC)
            M.TweenPos(bp, 6, clone.UpperTorso.Position + Vector3.new(0,20,0))

local function getThumb(p)
    local ok, t = pcall(function()
        return Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
    end)
    return ok and t or ""
end
local function getPlayersList()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(list, p) end
    end
    table.sort(list, function(a, b)
        return (a.DisplayName or a.Name):lower() < (b.DisplayName or b.Name):lower()
    end)
    return list
end
local function getRealTargetPosition(tgtRoot)
    local now = tick()
    local currentPos = tgtRoot.Position
    table.insert(targetHistory, {pos = currentPos, time = now})
    if #targetHistory > HISTORY_SIZE then table.remove(targetHistory, 1) end
    if #targetHistory >= 2 then
        local prev = targetHistory[#targetHistory - 1]
        local jump = (currentPos - prev.pos).Magnitude
        local dt = now - prev.time
        if jump > 30 and dt < 0.2 then return prev.pos end
    end
    local velocity = tgtRoot.AssemblyLinearVelocity
    if velocity.Magnitude > 1 then
        local predicted = currentPos + velocity * 0.05
        return currentPos:Lerp(predicted, 0.5)
    end
    return currentPos
end

-- PIZZA/DONUT AUTO-CLICKER
local PD_TOOL_NAMES = { "[Pizza]", "[Donut]" }
local PD_CLICK_DELAY = 0.1
local PD_MAX_HEALTH  = 100
local pd_running = false

local function pd_getHumanoid()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end
local function pd_findTool()
    local char = player.Character
    local backpack = player:FindFirstChild("Backpack")
    for _, name in ipairs(PD_TOOL_NAMES) do
        if char and char:FindFirstChild(name) then return char:FindFirstChild(name) end
        if backpack and backpack:FindFirstChild(name) then return backpack:FindFirstChild(name) end
    end
    return nil
end
local function pd_getEquippedTool()
    local char = player.Character
    if not char then return nil end
    for _, name in ipairs(PD_TOOL_NAMES) do
        local t = char:FindFirstChild(name)
        if t then return t end
    end
    return nil
end
local function pd_startClicking()
    if pd_running then return end
    pd_running = true
    task.spawn(function()
        while pd_running and autoKillEnabled do
            local hum = pd_getHumanoid()
            if hum and hum.Health >= PD_MAX_HEALTH then pd_running = false break end
            local tool = pd_getEquippedTool()
            if not tool then
                local found = pd_findTool()
                if found and hum then hum:EquipTool(found) else pd_running = false break end
            else
                pcall(function() tool:Activate() end)
            end
            task.wait(PD_CLICK_DELAY)
        end
        pd_running = false
    end)
end
local function pd_stopClicking() pd_running = false end
local function pd_unequipTools()
    local hum = pd_getHumanoid()
    if not hum then return end
    local char = player.Character
    if not char then return end
    for _, name in ipairs(PD_TOOL_NAMES) do
        if char:FindFirstChild(name) then
            pcall(function() hum:UnequipTools() end)
            break
        end
    end
end
local function pd_equipAndClick()
    local tool = pd_findTool()
    if not tool then pd_stopClicking() return end
    local hum = pd_getHumanoid()
    if hum and tool.Parent ~= player.Character then hum:EquipTool(tool) end
    pd_startClicking()
end
local pd_healthConn = nil
local function pd_watchHealth()
    if pd_healthConn then pd_healthConn:Disconnect() pd_healthConn = nil end
    local hum = pd_getHumanoid()
    if not hum then return end
    pd_healthConn = hum.HealthChanged:Connect(function(newHealth)
        if not autoKillEnabled then return end
        if newHealth >= PD_MAX_HEALTH then
            pd_stopClicking() pd_unequipTools()
        elseif newHealth < PD_MAX_HEALTH then
            pd_equipAndClick()
        end
    end)
end
local pd_safetyTask = nil
local function pd_start()
    pd_watchHealth()
    local hum = pd_getHumanoid()
    if hum and hum.Health < PD_MAX_HEALTH then pd_equipAndClick() end
    if pd_safetyTask then task.cancel(pd_safetyTask) pd_safetyTask = nil end
    pd_safetyTask = task.spawn(function()
        while autoKillEnabled do
            local hum = pd_getHumanoid()
            if hum then
                if hum.Health >= PD_MAX_HEALTH then
                    pd_stopClicking()
                    if pd_getEquippedTool() then pd_unequipTools() end
                else
                    if pd_findTool() then pd_equipAndClick() else pd_stopClicking() end
                end
            end
            task.wait(0.25)
        end
    end)
end
local function pd_stop()
    pd_stopClicking() pd_unequipTools()
    if pd_healthConn then pd_healthConn:Disconnect() pd_healthConn = nil end
    if pd_safetyTask then task.cancel(pd_safetyTask) pd_safetyTask = nil end
end


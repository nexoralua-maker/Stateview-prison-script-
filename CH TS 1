-- ============================================================
-- ARMOR MODULE
-- ============================================================
local ArmorModule = {}
local ARMOR_ATTRIBUTES      = {"Armor","ArmorPercent","ArmorPercentage","ArmorValue","Shield"}
local ARMOR_MAX_ATTRIBUTES  = {"MaxArmor","ArmorMax","MaxShield"}
local ARMOR_VALUES          = {"Armor","ArmorValue","Shield"}
local DEFAULT_MAX_ARMOR     = 100

local function findAttribute(container, names)
    if not container then return nil end
    for _, n in ipairs(names) do
        local v = container:GetAttribute(n)
        if v ~= nil then return v, n end
    end
    return nil
end
local function findValueObject(container, names)
    if not container then return nil end
    for _, n in ipairs(names) do
        local v = container:FindFirstChild(n)
        if v and (v:IsA("NumberValue") or v:IsA("IntValue")) then
            return v.Value, n, v
        end
    end
    return nil
end

function ArmorModule.get(targetPlayer)
    if not targetPlayer or not targetPlayer.Parent then return nil end
    local character = targetPlayer.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    local armor = findAttribute(humanoid, ARMOR_ATTRIBUTES)
    if armor ~= nil then
        local maxArmor = findAttribute(humanoid, ARMOR_MAX_ATTRIBUTES) or DEFAULT_MAX_ARMOR
        return {percent = math.clamp((armor/maxArmor)*100,0,100), current = armor, max = maxArmor}
    end
    armor = findAttribute(character, ARMOR_ATTRIBUTES)
    if armor ~= nil then
        local maxArmor = findAttribute(character, ARMOR_MAX_ATTRIBUTES) or DEFAULT_MAX_ARMOR
        return {percent = math.clamp((armor/maxArmor)*100,0,100), current = armor, max = maxArmor}
    end
    for _, container in ipairs({humanoid, character}) do
        local value = findValueObject(container, ARMOR_VALUES)
        if value ~= nil then
            local maxValue = findValueObject(container, ARMOR_MAX_ATTRIBUTES)
            local max = maxValue or DEFAULT_MAX_ARMOR
            return {percent = math.clamp((value/max)*100,0,100), current = value, max = max}
        end
    end
    return {percent = 0, current = 0, max = DEFAULT_MAX_ARMOR}
end

function ArmorModule.getColor(percent)
    if percent >= 75 then return Color3.fromRGB(90,170,255)
    elseif percent >= 50 then return Color3.fromRGB(60,130,230)
    elseif percent >= 25 then return Color3.fromRGB(45,95,200)
    else return Color3.fromRGB(30,60,160) end
end

-- ============================================================
-- HEALTH MODULE
-- ============================================================
local HealthModule = {}
function HealthModule.get(targetPlayer)
    if not targetPlayer or not targetPlayer.Parent then return nil end
    local character = targetPlayer.Character
    if not character then return nil end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil end
    local max = humanoid.MaxHealth
    if max <= 0 then return {percent = 0, current = 0, max = 100} end
    return {percent = math.clamp((humanoid.Health/max)*100,0,100), current = humanoid.Health, max = max}
end
function HealthModule.getColor(percent)
    if percent >= 75 then return Color3.fromRGB(60,220,100)
    elseif percent >= 50 then return Color3.fromRGB(255,210,70)
    elseif percent >= 25 then return Color3.fromRGB(255,140,50)
    else return Color3.fromRGB(230,70,70) end
end

-- ============================================================
-- C-SYNC MODULE (self material / self tool material)
-- ============================================================
local CSync = (function()
    local M = {
        config = {
            enabled          = false,
            keybind          = Enum.KeyCode.N,
            type             = "Static Local",
            staticX          = 5,
            staticY          = 0,
            staticZ          = 5,
            randomization    = 5,
            visualize        = false,
            visualizeTracer  = true,
            visualizeChar    = false,
            visualizeColor   = Color3.fromRGB(207, 227, 0),
            originalPosition = CFrame.new(1, 1, 1),

            -- NEW: self material
            selfMaterial = {
                enabled = false,
                type    = "Neon",
                color   = Color3.fromRGB(207, 227, 0),
            },
            -- NEW: self tool material
            selfToolMaterial = {
                enabled = false,
                type    = "Neon",
                color   = Color3.fromRGB(207, 227, 0),
            },
        }
    }

    -- ---- Drawing library (for tracer + ghost) ----
    local Drawing
    do
        local ok, res = pcall(function()
            return loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/linemaster2/storage/main/Drawing.lua"
            ))()
        end)
        if ok then Drawing = res else warn("[C-Sync] Failed to load Drawing library") end
    end

    local tracer
    if Drawing then
        tracer = Drawing.new("Line")
        tracer.Visible = false
        tracer.Thickness = 2
    end

    -- ---- Helpers ----
    local function worldToScreen(position)
        local pos, onScreen = camera:WorldToViewportPoint(position)
        return Vector2.new(pos.X, pos.Y), onScreen
    end
    local function randomVector3(amount)
        return Vector3.new(
            math.random(-amount * 100, amount * 100) / 100,
            math.random(-amount * 100, amount * 100) / 100,
            math.random(-amount * 100, amount * 100) / 100
        )
    end
    local function cloneCharacter(plr, transparency, color, material)
        if not plr.Character then return nil end
        plr.Character.Archivable = true
        local clone = plr.Character:Clone()
        clone.Parent = Workspace
        plr.Character.Archivable = false
        for _, part in ipairs(clone:GetChildren()) do
            if part:IsA("Accessory") then
                part:Destroy()
            elseif part:IsA("BasePart") then
                part.Anchored   = true
                part.CanCollide = false
                if part:IsA("MeshPart") then
                    part.Color        = color
                    part.Material     = Enum.Material[material]
                    part.Transparency = transparency
                end
                if part.Name == "Head" then
                    local face = part:FindFirstChild("face")
                    if face then face:Destroy() end
                end
            end
        end
        return clone
    end

    -- ---- Ghost chams ----
    local chams
    local function rebuildChams()
        if chams then chams:Destroy() end
        chams = cloneCharacter(player, 0.7, M.config.visualizeColor, "Neon")
        if chams then
            local hrp = chams:FindFirstChild("HumanoidRootPart")
            if hrp then chams.PrimaryPart = hrp end
            chams.Parent = nil
        end
    end
    if player.Character then rebuildChams() end
    player.CharacterAdded:Connect(function() task.wait(1) rebuildChams() end)

    local function updateChams(desyncedCFrame, color)
        if not chams or not player.Character then return end
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        for _, part in ipairs(chams:GetChildren()) do
            local actualPart = player.Character:FindFirstChild(part.Name)
            if actualPart and part:IsA("MeshPart") then
                part.CFrame = actualPart.CFrame
                part.Color  = color
            end
        end
        chams:PivotTo(desyncedCFrame)
    end

    -- ---- Self material update (character parts) ----
    local function updateSelfMaterial()
        local char = player.Character
        if not char then return end

        if M.config.selfMaterial.enabled then
            local materialType = Enum.Material[M.config.selfMaterial.type] or Enum.Material.Neon
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.Material = materialType
                    part.Color    = M.config.selfMaterial.color
                end
            end
        end
    end

    -- ---- Self tool material update ----
    local function updateSelfToolMaterial()
        local char = player.Character
        if not char then return end

        if M.config.selfToolMaterial.enabled then
            local materialType = Enum.Material[M.config.selfToolMaterial.type] or Enum.Material.Neon
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                for _, part in ipairs(tool:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Material = materialType
                        part.Color    = M.config.selfToolMaterial.color
                    end
                end
            end
        end
    end

    -- ---- Main loop ----
    RunService.Heartbeat:Connect(function()
        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")

        if not hrp or not M.config.enabled then
            if tracer then tracer.Visible = false end
            if chams  then chams.Parent   = nil    end
            return
        end

        local desyncCFrame
        local t = M.config.type
        if t == "Static Local" or t == "Static Target" then
            desyncCFrame = hrp.CFrame + Vector3.new(M.config.staticX, M.config.staticY, M.config.staticZ)
        elseif t == "Local Random" or t == "Target Random" then
            desyncCFrame = hrp.CFrame + randomVector3(M.config.randomization)
        else
            desyncCFrame = hrp.CFrame
        end

        M.config.originalPosition = hrp.CFrame

        -- Visualization
        if M.config.visualize and Drawing then
            if M.config.visualizeTracer then
                local from, fromOn = worldToScreen(hrp.Position)
                local to, toOn     = worldToScreen(desyncCFrame.Position)
                tracer.Visible = (fromOn or toOn)
                tracer.From    = from
                tracer.To      = to
                tracer.Color   = M.config.visualizeColor
            else
                tracer.Visible = false
            end

            if M.config.visualizeChar and chams then
                chams.Parent = Workspace
                updateChams(desyncCFrame, M.config.visualizeColor)
            else
                if chams then chams.Parent = nil end
            end
        else
            if tracer then tracer.Visible = false end
            if chams  then chams.Parent   = nil    end
        end

        -- Self material / tool material (runs each frame while enabled)
        updateSelfMaterial()
        updateSelfToolMaterial()

        -- Apply desync
        hrp.CFrame = desyncCFrame
        RunService.RenderStepped:Wait()
        hrp.CFrame = M.config.originalPosition
    end)

    -- ---- Metamethod hook ----
    pcall(function()
        if getrawmetatable and setreadonly and checkcaller then
            local mt = getrawmetatable(game)
            if mt then
                local oldIndex = mt.__index
                setreadonly(mt, false)
                local newIndex = function(self, key)
                    if not checkcaller()
                        and M.config.enabled
                        and key == "CFrame"
                        and player.Character
                        and self == player.Character:FindFirstChild("HumanoidRootPart")
                    then
                        return M.config.originalPosition
                    end
                    return oldIndex(self, key)
                end
                mt.__index = newcclosure and newcclosure(newIndex) or newIndex
                setreadonly(mt, true)
            end
        end
    end)

    -- ---- Public setters ----
    function M.setEnabled(v)  M.config.enabled = v and true or false end
    function M.setType(v)     M.config.type = v end
    function M.setStatic(axis, v)
        if axis == "X" then M.config.staticX = v
        elseif axis == "Y" then M.config.staticY = v
        elseif axis == "Z" then M.config.staticZ = v end
    end
    function M.setRandom(v)   M.config.randomization = v end
    function M.setVisualize(v) M.config.visualize = v and true or false end
    function M.setColor(c)
        M.config.visualizeColor = c
        if chams then
            for _, part in ipairs(chams:GetChildren()) do
                if part:IsA("MeshPart") then part.Color = c end
            end
        end
    end
    function M.setTracer(v)   M.config.visualizeTracer = v and true or false end
    function M.setChar(v)     M.config.visualizeChar   = v and true or false end
    function M.setKeybind(k)  M.config.keybind = k end

    -- Self material setters
    function M.setSelfMaterialEnabled(v) M.config.selfMaterial.enabled = v and true or false end
    function M.setSelfMaterialType(v)    M.config.selfMaterial.type    = v end
    function M.setSelfMaterialColor(c)   M.config.selfMaterial.color   = c end

    -- Self tool material setters
    function M.setSelfToolMaterialEnabled(v) M.config.selfToolMaterial.enabled = v and true or false end
    function M.setSelfToolMaterialType(v)    M.config.selfToolMaterial.type    = v end
    function M.setSelfToolMaterialColor(c)   M.config.selfToolMaterial.color   = c end

    return M
end)()


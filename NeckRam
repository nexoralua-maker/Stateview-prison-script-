function CreateFullKickTool()
    if LocalPlayer.Backpack:FindFirstChild("Full Kick") then
        LocalPlayer.Backpack:FindFirstChild("Full Kick"):Destroy()
    end
    task.wait(0.1)

    local Tool = Instance.new("Tool")
    Tool.RequiresHandle = false
    Tool.Name = "Full Kick"
    Tool.Parent = LocalPlayer.Backpack

    local follow = StartFollowLoop()

    Tool.Activated:Connect(function()
        local grabbed = LocalPlayer.Character.BodyEffects.Grabbed.Value
        if not grabbed then return end

        local success, err = pcall(function()
            timeStopActive = true
            task.wait(0.1)

            AnimStopv2(3135389157)
            AnimStopv2(11075367458)

            -- STEP 1 — forward position → 3
            follow:start()
            follow:setTarget(-3)
            task.wait(0.4)

            -- STEP 2 — play 3354696735
            local kickTrack1 = PlayTrack(3354696735)

            -- STEP 3 — while playing, forward position → 20
            task.wait(0.3)
            follow:setTarget(-20)
            task.wait(0.6)

            if kickTrack1.IsPlaying then kickTrack1.Stopped:Wait() end

            -- STEP 4 — TP my character in front of victim
            follow:stop()
            task.wait(0.05)

            local victimPlayer = Players:FindFirstChild(tostring(grabbed))
            local victimChar = victimPlayer and victimPlayer.Character
            if not victimChar or not victimChar:FindFirstChild("HumanoidRootPart") then return end

            local victimRoot = victimChar.HumanoidRootPart
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.lookAt(
                victimRoot.Position + victimRoot.CFrame.LookVector * 3,
                victimRoot.Position
            )

            -- STEP 5 — restart follow so victim sticks during kick
            follow:start()
            follow:setTarget(-3)

            -- STEP 6 — play 2788290270
            local kickTrack2 = PlayTrack(2788290270)

            -- STEP 7 — after 2s freeze 1s, then unfreeze
            task.wait(2)
            kickTrack2:AdjustSpeed(0)
            task.wait(1)
            kickTrack2:AdjustSpeed(1)

            -- STEP 8 — stop follow before launch
            follow:stop()
            task.wait(0.05)

            -- STEP 9 — launch victim 10 studs away
            local myPos     = LocalPlayer.Character.HumanoidRootPart.Position
            local victimPos = victimRoot.Position
            local pushDir   = (victimPos - myPos).Unit
            victimRoot.CFrame = CFrame.new(victimPos + pushDir * 10)

            -- STEP 10 — rip arms + legs only
            RipAllLimbs(grabbed)

            follow:stop()
            timeStopActive = false
        end)

        if not success then
            follow:stop()
            timeStopActive = false
            print("A error occured when trying to use Full Kick: " .. tostring(err))
        end
    end)

    return Tool
end


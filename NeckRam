        Dot.Size = UDim2.new(0, 14, 0, 14)
        Dot.AnchorPoint = Vector2.new(0.5, 0.5)
        Dot.Position = UDim2.new((default - minValue) / (maxValue - minValue), 0, 0.5, 0)
        Dot.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
        Dot.BorderSizePixel = 0
        Dot.Text = ""
        Dot.AutoButtonColor = false
        Dot.Parent = Track
        local DotCorner = Instance.new("UICorner")
        DotCorner.CornerRadius = UDim.new(1, 0)
        DotCorner.Parent = Dot

        local dragging = false

        local function updateFromX(x)
            local trackAbs = Track.AbsolutePosition.X
            local trackSize = Track.AbsoluteSize.X
            local alpha = math.clamp((x - trackAbs) / trackSize, 0, 1)
            local val = math.floor(minValue + alpha * (maxValue - minValue) + 0.5)
            Dot.Position = UDim2.new(alpha, 0, 0.5, 0)
            Fill.Size = UDim2.new(alpha, 0, 1, 0)
            ValueLabel.Text = tostring(val)
            if callback then callback(val) end
        end

        local function isInTrack(x, y)
            local absPos  = Track.AbsolutePosition
            local absSize = Track.AbsoluteSize
            return x >= absPos.X - 8 and x <= absPos.X + absSize.X + 8
               and y >= absPos.Y - 10 and y <= absPos.Y + absSize.Y + 10
        end

        UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                if isInTrack(input.Position.X, input.Position.Y) then
                    dragging = true
                    updateFromX(input.Position.X)
                end
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch then
                updateFromX(input.Position.X)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        Dot.MouseButton1Down:Connect(function() dragging = true end)

        if callback then callback(default) end
    end


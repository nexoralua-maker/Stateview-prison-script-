local M = {}

function M.Grab(character, grabAnimId)
    assert(character, "Character is nil")
    Settings.Grab.GrabbedCharacter = character
    if Cache.Loops.Grab then Cache.Loops.Grab:Disconnect() end

    for _, p in ipairs(character:GetDescendants()) do
        if p:IsA("BodyVelocity") or p:IsA("BodyGyro") or p:IsA("BodyPosition") then
            p:Destroy()
        end
    end

    for _, a in ipairs(LP.Character.Humanoid:GetPlayingAnimationTracks()) do
        if a.Animation.AnimationId:match("11075367458") then a:Stop() end
    end

    repeat task.wait() until character:FindFirstChild("GRABBING_CONSTRAINT")
    if not character.GRABBING_CONSTRAINT:FindFirstChild("H") then return end

    local BP = Instance.new("BodyPosition", character.UpperTorso)
    local BG = Instance.new("BodyGyro",     character.UpperTorso)
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://"..grabAnimId
    local GrabAnim = LP.Character.Humanoid:LoadAnimation(anim)

    BP.D, BG.D = 200, 100
    BP.MaxForce  = Vector3.new(10000,10000,10000)
    BG.MaxTorque = Vector3.new(10000,10000,10000)

    BG.CFrame   = CFrame.new(character.UpperTorso.Position, LP.Character.HumanoidRootPart.Position)
    BP.Position = LP.Character.RightHand.Position - Vector3.new(0,1,0)
    character.GRABBING_CONSTRAINT.H.Length = 9e9

    GrabAnim.Priority = Enum.AnimationPriority.Action4
    GrabAnim:Play(); GrabAnim:AdjustSpeed(0); GrabAnim.TimePosition = .1

    Cache.Loops.Grab = RunService.Heartbeat:Connect(function()
        if Settings.Grab.GrabbedCharacter
        and LP.Character
        and LP.Character:FindFirstChild("BodyEffects")
        and LP.Character.BodyEffects.Grabbed.Value ~= nil
        and Settings.Grab.Grab then
            BG.CFrame   = CFrame.new(character.UpperTorso.Position, LP.Character.HumanoidRootPart.Position)
            BP.Position = LP.Character.RightHand.Position - Vector3.new(0,1,0)
        end
    end)
end

function M.CreateTool(name, func)
    local Tool = Instance.new("Tool", LP.Backpack)
    Tool.Name = name
    Tool.RequiresHandle = false
    Cache.Tools[name] = Tool.Activated:Connect(function()
        if Settings.Grab.GrabbedCharacter == nil then return end
        func()
    end)
    return Tool
end

function M.DestroyTool(name)
    local t = LP.Backpack:FindFirstChild(name) or LP.Character:FindFirstChild(name)
    if t then t:Destroy() end
    if Cache.Tools[name] then Cache.Tools[name]:Disconnect(); Cache.Tools[name] = nil end
end

function M.StopAnim(chr, id)
    pcall(function()
        for _, a in ipairs(chr:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks()) do
            if a.Animation.AnimationId:match("rbxassetid://"..tostring(id)) then a:Stop() end
        end
    end)
end

function M.AnimPlay(chr, id, speed, time, smoothing)
    pcall(function()
        for _, a in ipairs(chr:FindFirstChildOfClass("Humanoid"):GetPlayingAnimationTracks()) do
            if a.Animation.AnimationId:match("rbxassetid://"..tostring(id)) then a:Stop() end
        end
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://"..tostring(id)
        local loaded = chr:FindFirstChildOfClass("Humanoid"):LoadAnimation(anim)
        loaded.Priority = Enum.AnimationPriority.Action4
        if smoothing then loaded:Play(tonumber(smoothing)) else loaded:Play() end
        if speed then loaded:AdjustSpeed(tonumber(speed)) end
        if time  then loaded.TimePosition = tonumber(time) end
        anim:Destroy()
    end)
end

function M.NewAnim(id)
    local a = Instance.new("Animation")
    a.AnimationId = "rbxassetid://"..id
    return a
end

function M.NoVelocity(chr)
    for _, p in ipairs(chr:GetChildren()) do
        if p:IsA("BasePart") then
            p.AssemblyLinearVelocity  = Vector3.zero
            p.AssemblyAngularVelocity = Vector3.zero
            p.Velocity = Vector3.zero
        end
    end
end

function M.CanCollide(chr, v)
    for _, p in ipairs(chr:GetChildren()) do
        if p:IsA("BasePart") then p.CanCollide = v end
    end
end

function M.Remove(chr, part)
    if part == "all" then
        chr.LeftUpperLeg.Position  = Vector3.new(0,-1200,0)
        chr.RightUpperLeg.Position = Vector3.new(0,-1200,0)
        chr.LeftUpperArm.Position  = Vector3.new(0,-1200,0)
        chr.RightUpperArm.Position = Vector3.new(0,-1200,0)
    else
        chr[part].Position = Vector3.new(0,-1200,0)
    end
end

function M.Play(id)
    id = tostring(id)
    local used = false
    if LP.Backpack:FindFirstChild("[Boombox]") then
        pcall(function()
            LP.Backpack["[Boombox]"].Parent = LP.Character
            RS.MainEvent:FireServer("Boombox", tonumber(id))
            LP.Character["[Boombox]"].RequiresHandle = false
            LP.Character["[Boombox]"].Parent = LP.Backpack
            if LP.PlayerGui:FindFirstChild("MainScreenGui")
            and LP.PlayerGui.MainScreenGui:FindFirstChild("BoomboxFrame") then
                LP.PlayerGui.MainScreenGui.BoomboxFrame.Visible = false
            end
        end)
        used = true
    end
    if not used then
        Sound.SoundId = "rbxassetid://"..id
        Sound:Play()
    end
end

function M.StopAudio()
    Sound:Stop()
    pcall(function() RS:WaitForChild("MainEvent"):FireServer("BoomboxStop") end)
end

--==========================================================
-- CHAT FUNCTION (uses TextChatService, legacy fallback)
--==========================================================
function M.Chat(msg)
    if msg == nil or msg == "" or msg:gsub("%s", "") == "" then
        return false
    end

    local success = false

    pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        if channels then
            local general = channels:FindFirstChild("RBXGeneral")
            if general then
                general:SendAsync(msg)
                success = true
            end
        end
    end)

    if not success then
        pcall(function()
            local legacy = RS:FindFirstChild("DefaultChatSystemChatEvents")
            if legacy and legacy:FindFirstChild("SayMessageRequest") then
                legacy.SayMessageRequest:FireServer(msg, "All")
                success = true
            end
        end)
    end

    return success
end

function M.FwdPos(dist)
    return LP.Character.HumanoidRootPart.Position
         + LP.Character.HumanoidRootPart.CFrame.LookVector * dist
end

function M.TweenPos(part, speed, pos)
    TweenSvc:Create(part, TweenInfo.new(speed, Enum.EasingStyle.Linear), {Position = pos}):Play()
end

function M.Void(chr, part, drop)
    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(9e9,9e9,9e9)
    bv.Velocity = Vector3.new(9e9,-9e9,9e9)
    bv.Parent = part and chr[part] or chr.UpperTorso
    task.wait(.1)
    if not drop then
        RS:FindFirstChild("MainEvent"):FireServer("Grabbing", false)
    end
end

function M.CloneChar(chr)
    chr.Archivable = true
    local c = chr:Clone()
    c.HumanoidRootPart.Anchored = false
    c.Humanoid.Health, c.Humanoid.MaxHealth = 9e9, 9e9
    for _, n in ipairs({"RagdollConstraints","BodyEffects","GRABBING_CONSTRAINT"}) do
        if c:FindFirstChild(n) then c[n]:Destroy() end
    end
    for _, p in ipairs(c:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CustomPhysicalProperties = PhysicalProperties.new(100,2,.5,100,1)
            p.Transparency = 1
        end
        if p:IsA("Decal") then p.Transparency = 1 end
        if p:IsA("Motor6D") then p:Destroy() end
    end
    c.Parent = LP.Character
    c.Humanoid:ChangeState("GettingUp")
    chr.LeftHand:FindFirstChildOfClass("Motor6D").Enabled  = false
    chr.RightHand:FindFirstChildOfClass("Motor6D").Enabled = false
    chr.LeftFoot:FindFirstChildOfClass("Motor6D").Enabled  = false
    chr.RightFoot:FindFirstChildOfClass("Motor6D").Enabled = false
    return c
end

function M.DestroyClone(c, orig)
    if c then c:Destroy() end
    if orig then
        pcall(function()
            orig.LeftHand:FindFirstChildOfClass("Motor6D").Enabled  = true
            orig.RightHand:FindFirstChildOfClass("Motor6D").Enabled = true
            orig.LeftFoot:FindFirstChildOfClass("Motor6D").Enabled  = true
            orig.RightFoot:FindFirstChildOfClass("Motor6D").Enabled = true
        end)
    end
end

function M.Align(p1, p2, off)
    p1.AssemblyLinearVelocity  = Vector3.zero
    p1.AssemblyAngularVelocity = Vector3.zero
    p1.Velocity = Vector3.zero
    p1.CFrame = p2.CFrame * (off or CFrame.new())
    p1.CanCollide, p2.CanCollide = false, false
end

function M.ImpactFrame()
    if not Settings.Grab.Effects then return end   -- ← gated by Effects
    local black = Instance.new("ColorCorrectionEffect", Lighting)
    black.TintColor = Color3.fromRGB(0,0,0)
    local white = Instance.new("Highlight", LP.Character)
    white.FillColor = Color3.fromRGB(255,255,255); white.FillTransparency = 0
    task.wait(.1)
    white.FillColor = Color3.fromRGB(0,0,0)
    black.TintColor = Color3.fromRGB(255,255,255); black.Brightness = 1
    task.wait(.1)
    black:Destroy(); white:Destroy()
end

--==========================================================
-- GOKU HELPERS
--  - playKamehamehaVisuals = EXACT same visuals as the user's
--    LocalScript (charge ball, light, particles, beams, aura,
--    sound, 3-second cleanup).  Gated by Settings.Grab.Effects.
--  - HellKill = voids 5 body parts + releases grab.
--==========================================================
local function playKamehamehaVisuals(character, duration)
    duration = duration or 3

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root     = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end
    local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
    if not rightHand then return end

    local created = {}

    -- Charge ball
    local charge = Instance.new("Part")
    charge.Name = "KameCharge"
    charge.Shape = Enum.PartType.Ball
    charge.Size = Vector3.new(0.5, 0.5, 0.5)
    charge.Material = Enum.Material.Neon
    charge.Color = Color3.fromRGB(0, 170, 255)
    charge.Anchored = false
    charge.CanCollide = false
    charge.CanTouch = false
    charge.CanQuery = false
    charge.Transparency = 0.2
    charge.Parent = character
    charge.CFrame = rightHand.CFrame

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = charge
    weld.Part1 = rightHand
    weld.Parent = charge

    local light = Instance.new("PointLight")
    light.Color = Color3.fromRGB(0, 170, 255)
    light.Range = 12
    light.Brightness = 3
    light.Parent = charge

    local chargeParticles = Instance.new("ParticleEmitter")
    chargeParticles.Texture = "rbxassetid://243660364"
    chargeParticles.Color = ColorSequence.new(Color3.fromRGB(0, 200, 255))
    chargeParticles.Size = NumberSequence.new(0.2, 0.8)
    chargeParticles.Rate = 100
    chargeParticles.Speed = NumberRange.new(2)
    chargeParticles.Lifetime = NumberRange.new(0.5)
    chargeParticles.Transparency = NumberSequence.new(0.2)
    chargeParticles.LightEmission = 1
    chargeParticles.SpreadAngle = Vector2.new(180, 180)
    chargeParticles.Parent = charge
    table.insert(created, charge)

    -- Beam attachments
    local handAttach = Instance.new("Attachment")
    handAttach.Name = "KameHandAttach"
    handAttach.Parent = rightHand
    table.insert(created, handAttach)

    local endPart = Instance.new("Part")
    endPart.Name = "KameEnd"
    endPart.Size = Vector3.new(0.1, 0.1, 0.1)
    endPart.Transparency = 1
    endPart.Anchored = false
    endPart.CanCollide = false
    endPart.CanTouch = false
    endPart.CanQuery = false
    endPart.Parent = character
    endPart.CFrame = root.CFrame * CFrame.new(0, 0, -50)

    local endWeld = Instance.new("WeldConstraint")
    endWeld.Part0 = endPart
    endWeld.Part1 = root
    endWeld.Parent = endPart

    local endAttach = Instance.new("Attachment")
    endAttach.Name = "KameEndAttach"
    endAttach.Parent = endPart
    table.insert(created, endPart)

    -- Core beam
    local coreBeam = Instance.new("Beam")
    coreBeam.Attachment0 = handAttach
    coreBeam.Attachment1 = endAttach
    coreBeam.Width0 = 1.5
    coreBeam.Width1 = 3
    coreBeam.Color = ColorSequence.new(Color3.fromRGB(200, 240, 255))
    coreBeam.LightEmission = 1
    coreBeam.Transparency = NumberSequence.new(0.1)
    coreBeam.FaceCamera = true
    coreBeam.Parent = endPart

    -- Glow beam
    local glowBeam = Instance.new("Beam")
    glowBeam.Attachment0 = handAttach
    glowBeam.Attachment1 = endAttach
    glowBeam.Width0 = 3
    glowBeam.Width1 = 6
    glowBeam.Color = ColorSequence.new(Color3.fromRGB(0, 170, 255))
    glowBeam.LightEmission = 1
    glowBeam.Transparency = NumberSequence.new(0.6)
    glowBeam.FaceCamera = true
    glowBeam.Parent = endPart

    -- Aura
    local aura = Instance.new("ParticleEmitter")
    aura.Texture = "rbxassetid://243660364"
    aura.Color = ColorSequence.new(Color3.fromRGB(0, 170, 255))
    aura.Size = NumberSequence.new(1, 3)
    aura.Rate = 50
    aura.Speed = NumberRange.new(5)
    aura.Lifetime = NumberRange.new(0.5, 1)
    aura.Transparency = NumberSequence.new(0.5)
    aura.LightEmission = 1
    aura.SpreadAngle = Vector2.new(180, 180)
    aura.Parent = root
    table.insert(created, aura)

    -- Sound
    local sound = Instance.new("Sound")
    sound.SoundId = "rbxassetid://131961136"
    sound.Volume = 2
    sound.Parent = root
    sound:Play()
    table.insert(created, sound)

    -- Cleanup
    task.delay(duration, function()
        for _, obj in ipairs(created) do
            if obj and obj.Parent then obj:Destroy() end
        end
    end)
end

local function HellKill(character)
    if not character then return end

    local voidParts = {
        "UpperTorso",
        "RightUpperArm",
        "LeftUpperArm",
        "RightUpperLeg",
        "LeftUpperLeg",
    }

    for _, partName in ipairs(voidParts) do
        local part = character:FindFirstChild(partName)
        if part then
            part.CFrame = CFrame.new(0, -1200000, 0)
        end
    end

    task.wait(0.5)

    game:GetService("ReplicatedStorage")
        :WaitForChild("MainEvent")
        :FireServer("Grabbing")
end


        AnimStopv2(11075367458)

        local Character = LocalPlayer.Character
        local Humanoid  = Character:FindFirstChildOfClass("Humanoid")
        if not Humanoid then offeringsRunning = false; return end

        follow:start()
        follow:setTarget(-11)
        follow:setLift(11)

        local mihTrack = PlayTrack(11394033602, 1)

        Chat("Six offerings…")
        PlaySound("5747238236")
        task.wait(2.4)

        Chat("Say Goodbye…")
        task.wait(1.8)

        PlaySound("429400881")
        task.wait(1.7)

        if victim and victim.Parent then
            local leftArm = victim:FindFirstChild("LeftUpperArm") or victim:FindFirstChild("Left Arm")
            if leftArm then
                leftArm.Position = Vector3.new(0, -999, 0)
                task.wait(0.07)
                leftArm.Velocity = Character.HumanoidRootPart.CFrame.RightVector * -400 + Vector3.new(0, 170, 0)
            end

            local rightArm = victim:FindFirstChild("RightUpperArm") or victim:FindFirstChild("Right Arm")
            if rightArm then
                rightArm.Position = Vector3.new(0, -999, 0)
                task.wait(0.07)
                rightArm.Velocity = Character.HumanoidRootPart.CFrame.RightVector * 400 + Vector3.new(0, 170, 0)
            end

            if victim:FindFirstChild("LowerTorso") then
                victim.LowerTorso.Position = Vector3.new(0, -999, 0)
            end

            task.wait(0.15)
            local upperTorso = victim:FindFirstChild("UpperTorso")
            if upperTorso then
                upperTorso.Velocity = Character.HumanoidRootPart.CFrame.LookVector * -180 + Vector3.new(0, 220, 0)
            end

            if victim:FindFirstChildOfClass("Humanoid") then
                victim:FindFirstChildOfClass("Humanoid").Health = 0
            end
        end

        task.wait(1.5)
        follow:stop()
        if mihTrack then mihTrack:Stop(0.4) end
        ReplicatedStorage.MainEvent:FireServer("Grabbing", false)

        timeStopActive = false
        offeringsRunning = false
    end)

    return Tool
end


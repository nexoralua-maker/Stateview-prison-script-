        end
        iTitle.Text = grabName..": "..(state and "ON — tool added to Backpack" or "OFF — tool removed")
    end)

    btn.MouseEnter:Connect(function()
        if not state then TweenSvc:Create(btn, TweenInfo.new(.2), {BackgroundColor3=Color3.fromRGB(38,38,38)}):Play() end
    end)
    btn.MouseLeave:Connect(function()
        if not state then TweenSvc:Create(btn, TweenInfo.new(.2), {BackgroundColor3=Color3.fromRGB(28,28,28)}):Play() end
    end)
end


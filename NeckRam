	Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		Scroll.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 20)
	end)

	--// HELPER: Section Label
	local function createSectionLabel(text)
		local lbl = Instance.new("TextLabel", Scroll)
		lbl.BackgroundTransparency = 1
		lbl.Size = UDim2.new(1, 0, 0, 20)
		lbl.Font = Enum.Font.GothamBold
		lbl.Text = text
		lbl.TextColor3 = Color3.fromRGB(120, 120, 120)
		lbl.TextSize = 11
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		return lbl
	end

	--// HELPER: Toggle
	local function createToggle(text, default, callback)
		local Btn = Instance.new("TextButton", Scroll)
		Btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
		Btn.BorderSizePixel = 0
		Btn.Size = UDim2.new(1, 0, 0, 38)
		Btn.Text = ""
		Btn.AutoButtonColor = false

		local BtnCorner = Instance.new("UICorner", Btn)
		BtnCorner.CornerRadius = UDim.new(0, 6)

		local BtnStroke = Instance.new("UIStroke", Btn)
		BtnStroke.Color = Color3.fromRGB(30, 30, 30)
		BtnStroke.Thickness = 1.25

		local Label = Instance.new("TextLabel", Btn)
		Label.BackgroundTransparency = 1
		Label.Position = UDim2.new(0, 15, 0, 0)
		Label.Size = UDim2.new(1, -50, 1, 0)
		Label.Font = Enum.Font.Gotham
		Label.Text = text
		Label.TextColor3 = Color3.fromRGB(200, 200, 200)
		Label.TextSize = 12
		Label.TextXAlignment = Enum.TextXAlignment.Left

		local Dot = Instance.new("TextButton", Btn)
		Dot.AnchorPoint = Vector2.new(0.5, 0.5)
		Dot.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		Dot.BorderSizePixel = 0
		Dot.Position = UDim2.new(0.9, 0, 0.5, 0)
		Dot.Size = UDim2.new(0, 14, 0, 14)
		Dot.Text = ""
		Dot.AutoButtonColor = false

		local DotCorner = Instance.new("UICorner", Dot)
		DotCorner.CornerRadius = UDim.new(1, 0)

		local State = default or false

		local function setState(v)
			State = v
			Services.TweenService:Create(Dot, TweenInfo.new(0.3), {
				BackgroundColor3 = State and Color3.fromRGB(81, 194, 58) or Color3.fromRGB(0, 0, 0)
			}):Play()
		end

		if State then setState(true) end

		Btn.MouseEnter:Connect(function()
			Services.TweenService:Create(Btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(25, 25, 25)}):Play()
		end)
		Btn.MouseLeave:Connect(function()
			Services.TweenService:Create(Btn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(18, 18, 18)}):Play()
		end)

		Btn.MouseButton1Click:Connect(function()
			setState(not State)
			if callback then callback(State) end
		end)

		return Btn
	end

	--// =====================================================================
	--// BUILD UI
	--// =====================================================================
	createSectionLabel("MAIN")

	createToggle("Grab", false, function(state)
		Settings["Grab"]["Grab"] = state
		if not state then
			if Settings["Grab"]["GrabbedCharacter"] ~= nil then
				Services.ReplicatedStorage.MainEvent:FireServer("Grabbing", false)
				Modules["StopAnimation"](Services.LocalPlayer.Character, "3135389157")
			end
			if Cache["Loops"]["Grab"] ~= nil then
				Settings["Grab"]["GrabbedCharacter"] = nil
				Cache["Loops"]["Grab"]:Disconnect()
				Cache["Loops"]["Grab"] = nil
			end
			if Cache["Connections"]["Grab"] ~= nil then
				Cache["Connections"]["Grab"]:Disconnect()
				Cache["Connections"]["Grab"] = nil
			end
			return
		end

		Cache["Connections"]["Grab"] = Services.LocalPlayer.Character.BodyEffects.Grabbed:GetPropertyChangedSignal("Value"):Connect(function()
			if Cache["Loops"]["Grab"] ~= nil then
				for _, part in pairs(Settings["Grab"]["GrabbedCharacter"]:GetDescendants()) do
					if part:IsA("BodyVelocity") or part:IsA("BodyGyro") or part:IsA("BodyPosition") then
						part:Destroy()
					end
				end
				Settings["Grab"]["GrabbedCharacter"] = nil
				Cache["Loops"]["Grab"]:Disconnect()
				Cache["Loops"]["Grab"] = nil
			end
			if Services.LocalPlayer.Character.BodyEffects.Grabbed.Value ~= nil then
				Modules["Grab"](Services.LocalPlayer.Character.BodyEffects.Grabbed.Value, Animations["Grab"])
				Modules["CanCollide"](Services.LocalPlayer.Character.BodyEffects.Grabbed.Value, false)
				Modules["NoVelocity"](Services.LocalPlayer.Character.BodyEffects.Grabbed.Value)
				return
			end
			Modules["StopAnimation"](Services.LocalPlayer.Character, "3135389157")
		end)
	end)

	createToggle("Effects", true, function(state)
		Settings["Grab"]["Effects"] = state
	end)

	createSectionLabel("GRAB TOOLS")

	--// Loop through all Tools and create toggles
	for name, func in pairs(Tools) do
		createToggle(name, false, function(state)
			Settings["Grab"][name] = state
			func()
		end)
	end

	--// Reattach Grab connections on respawn
	Services.LocalPlayer.CharacterAdded:Connect(function(char)
		repeat task.wait() until char:FindFirstChild("BodyEffects")
		if Cache["Connections"]["Grab"] ~= nil then
			Cache["Connections"]["Grab"]:Disconnect()
			Cache["Connections"]["Grab"] = nil
		end
		if Settings["Grab"]["Grab"] then
			Cache["Connections"]["Grab"] = char.BodyEffects.Grabbed:GetPropertyChangedSignal("Value"):Connect(function()
				if Cache["Loops"]["Grab"] ~= nil then
					for _, part in pairs(Settings["Grab"]["GrabbedCharacter"]:GetDescendants()) do
						if part:IsA("BodyVelocity") or part:IsA("BodyGyro") or part:IsA("BodyPosition") then
							part:Destroy()
						end
					end
					Settings["Grab"]["GrabbedCharacter"] = nil
					Cache["Loops"]["Grab"]:Disconnect()
					Cache["Loops"]["Grab"] = nil
				end
				if char.BodyEffects.Grabbed.Value ~= nil then
					Modules["Grab"](char.BodyEffects.Grabbed.Value, Animations["Grab"])
					Modules["CanCollide"](char.BodyEffects.Grabbed.Value, false)
					Modules["NoVelocity"](char.BodyEffects.Grabbed.Value)
					return
				end
				Modules["StopAnimation"](Services.LocalPlayer.Character, "3135389157")
			end)
		end
		for _, func in pairs(Tools) do
			func()
		end
	end)
end


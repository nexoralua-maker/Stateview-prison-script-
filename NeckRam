local fallbackSound = Instance.new("Sound", game.ReplicatedStorage)

function PlaySound(id, volume)
    id = tonumber(id)
    local ok = pcall(function()
        if LocalPlayer.Backpack:FindFirstChild("[Boombox]") then
            LocalPlayer.Backpack["[Boombox]"].Parent = LocalPlayer.Character
            ReplicatedStorage.MainEvent:FireServer("Boombox", id)
            LocalPlayer.Character["[Boombox]"].RequiresHandle = false
            LocalPlayer.Character["[Boombox]"].Parent = LocalPlayer.Backpack
            if LocalPlayer.PlayerGui.MainScreenGui
                and LocalPlayer.PlayerGui.MainScreenGui:FindFirstChild("BoomboxFrame") then
                LocalPlayer.PlayerGui.MainScreenGui.BoomboxFrame.Visible = false
            end
            LocalPlayer.Character.LowerTorso:WaitForChild("BOOMBOXSOUND")
            coroutine.wrap(function()
                repeat task.wait()
                until LocalPlayer.Character.LowerTorso.BOOMBOXSOUND.SoundId == "rbxassetid://" .. id
                    and LocalPlayer.Character.LowerTorso.BOOMBOXSOUND.TimeLength > 0.01
                task.wait(LocalPlayer.Character.LowerTorso.BOOMBOXSOUND.TimeLength - 0.1)
                if LocalPlayer.Character.LowerTorso.BOOMBOXSOUND.SoundId == "rbxassetid://" .. id then
                    ReplicatedStorage.MainEvent:FireServer("BoomboxStop")
                end
            end)()
        else
            error("no boombox")
        end
    end)
    if not ok then
        fallbackSound.SoundId = "rbxassetid://" .. id
        fallbackSound.Volume  = volume or 3
        fallbackSound:Play()
    end
end

function StopAudio()
    pcall(function()
        fallbackSound:Stop()
        ReplicatedStorage:WaitForChild("MainEvent"):FireServer("BoomboxStop")
    end)
end

function Chat(message)
    pcall(function()
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            TextChatService.TextChannels.RBXGeneral:SendAsync(message)
        else
            ReplicatedStorage.DefaultChatSystemChatEvents.SayMessageRequest:FireServer(message, "All")
        end
    end)
end

function RemoveAll(character)
    if not character then return end
    for _, name in ipairs({
        "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart",
        "LeftUpperArm", "LeftLowerArm", "LeftHand",
        "RightUpperArm", "RightLowerArm", "RightHand",
        "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
        "RightUpperLeg", "RightLowerLeg", "RightFoot"
    }) do
        local part = character:FindFirstChild(name)
        if part then part.CFrame = CFrame.new(0, -1200, 0) end
    end
end

function RemoveLimb(character, bodypart)
    if bodypart == "all" then
        for _, p in ipairs({"LeftUpperLeg","RightUpperLeg","LeftUpperArm","RightUpperArm"}) do
            local part = character:FindFirstChild(p)
            if part then part.Position = Vector3.new(0, -1200, 0) end
        end
    else
        local part = character:FindFirstChild(bodypart)
        if part then part.Position = Vector3.new(0, -1200, 0) end
    end
end

function GetForwardPosition(distance)
    return LocalPlayer.Character.HumanoidRootPart.Position
        + (LocalPlayer.Character.HumanoidRootPart.CFrame.LookVector * distance)
end

function TweenPosition(instance, speed, position)
    TweenService:Create(instance, TweenInfo.new(speed, Enum.EasingStyle.Linear),
        {Position = position}):Play()
end

function EnsureColorCorrection()
    local cc = Lighting:FindFirstChild("ColorCorrection")
    if not cc then
        cc = Instance.new("ColorCorrectionEffect")
        cc.Name = "ColorCorrection"
        cc.Parent = Lighting
    end
    return cc
end

-- ============================================================
--  GOKU-STYLE FOLLOW LOOP
-- ============================================================

local function StartFollowLoop()
    local state = { activeLoop = nil, targetForward = nil }

    function state:start()
        if self.activeLoop then self.activeLoop:Disconnect() end
        self.activeLoop = RunService.Heartbeat:Connect(function()
            if not self.targetForward then return end
            Align(8000, 800, "UpperTorso", "HumanoidRootPart",
                CFrame.new(0, 0, self.targetForward),
                CFrame.Angles(0, math.pi, 0))
        end)
    end

    function state:setTarget(z) self.targetForward = z end

    function state:stop()
        if self.activeLoop then self.activeLoop:Disconnect(); self.activeLoop = nil end
    end

    return state
end


            M.Void(GC); M.DestroyClone(GC, clone); clone = nil
            if Cache.Loops.Portal then Cache.Loops.Portal:Disconnect(); Cache.Loops.Portal = nil end
            loadAsset(true)
            WS.CurrentCamera.CameraSubject = LP.Character.Humanoid
            for _ = 1,40 do LP.Character.HumanoidRootPart.CFrame = storedPos end
            Settings.Grab.Grab = true
        end)
    else

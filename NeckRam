    local state = false
    local function update()
        TweenSvc:Create(dot, TweenInfo.new(.25),
            {BackgroundColor3 = state and Color3.fromRGB(81,194,58) or Color3.fromRGB(60,60,60)}):Play()
        TweenSvc:Create(btn, TweenInfo.new(.25),
            {BackgroundColor3 = state and Color3.fromRGB(22,45,22) or Color3.fromRGB(28,28,28)}):Play()
    end

    btn.MouseButton1Click:Connect(function()
        state = not state
        Settings.Grab[grabName] = state

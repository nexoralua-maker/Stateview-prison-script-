-- CORE "Grab Function Tool"
--==========================================================
local function hookGrab()
    if Cache.Connections.Grab then
        Cache.Connections.Grab:Disconnect(); Cache.Connections.Grab = nil
    end
    if not LP.Character
    or not LP.Character:FindFirstChild("BodyEffects")
    or not LP.Character.BodyEffects:FindFirstChild("Grabbed") then return end

    Cache.Connections.Grab = LP.Character.BodyEffects.Grabbed:GetPropertyChangedSignal("Value"):Connect(function()
        if Cache.Loops.Grab then
            if Settings.Grab.GrabbedCharacter then
                for _, p in ipairs(Settings.Grab.GrabbedCharacter:GetDescendants()) do
                    if p:IsA("BodyVelocity") or p:IsA("BodyGyro") or p:IsA("BodyPosition") then p:Destroy() end
                end
            end
            Settings.Grab.GrabbedCharacter = nil
            Cache.Loops.Grab:Disconnect(); Cache.Loops.Grab = nil
        end
        if LP.Character.BodyEffects.Grabbed.Value ~= nil then
            M.Grab(LP.Character.BodyEffects.Grabbed.Value, 3135389157)
            M.CanCollide(LP.Character.BodyEffects.Grabbed.Value, false)
            M.NoVelocity(LP.Character.BodyEffects.Grabbed.Value)
            return
        end
        M.StopAnim(LP.Character, "3135389157")
    end)
end

grabBtn.MouseButton1Click:Connect(function()
    Settings.Grab.Grab = not Settings.Grab.Grab
    grabBtn.Text = "Grab Function Tool: "..(Settings.Grab.Grab and "ON" or "OFF")
    grabStroke.Color = Settings.Grab.Grab and Color3.fromRGB(81,194,58) or Color3.fromRGB(45,45,45)

    if Settings.Grab.Grab then
        hookGrab()
    else
        if Settings.Grab.GrabbedCharacter then
            RS.MainEvent:FireServer("Grabbing", false)
            M.StopAnim(LP.Character, "3135389157")
        end
        if Cache.Loops.Grab then
            Settings.Grab.GrabbedCharacter = nil
            Cache.Loops.Grab:Disconnect(); Cache.Loops.Grab = nil
        end
        if Cache.Connections.Grab then
            Cache.Connections.Grab:Disconnect(); Cache.Connections.Grab = nil
        end
    end
end)


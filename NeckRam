        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -50, 1, 0)
        lbl.Position = UDim2.new(0, 12, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.Gotham
        lbl.Text = name
        lbl.TextColor3 = Color3.fromRGB(200, 200, 200)
        lbl.TextSize = 13
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = btn

        local dot = Instance.new("Frame")
        dot.Size = UDim2.new(0, 14, 0, 14)
        dot.Position = UDim2.new(1, -26, 0.5, -7)
        dot.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
        dot.BorderSizePixel = 0
        dot.Parent = btn
        Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)

        local function refresh()
            local on = Settings.Grab[name] == true
            dot.BackgroundColor3 = on and Color3.fromRGB(81, 194, 58) or Color3.fromRGB(0, 0, 0)
        end
        refresh()

        btn.MouseButton1Click:Connect(function()
            local new = not (Settings.Grab[name] == true)
            Settings.Grab[name] = new
            refresh() -- paint first, THEN fire callback
            if onChanged then
                local ok, err = pcall(onChanged, new)
                if not ok then warn("[Grab] " .. name .. " callback error: " .. tostring(err)) end
            end
        end)

        btn.MouseEnter:Connect(function()
            Services.TweenService:Create(btn, TweenInfo.new(.2), { BackgroundColor3 = Color3.fromRGB(30, 30, 30) }):Play()
        end)
        btn.MouseLeave:Connect(function()
            Services.TweenService:Create(btn, TweenInfo.new(.2), { BackgroundColor3 = Color3.fromRGB(22, 22, 22) }):Play()
        end)

        return refresh
    end

    -- === Base toggles (persistent) ===
    MakeToggle("Grab", function(v)
        if v then
            StartGrabBinding()
        else
            StopGrabBinding()
        end
    end)

    MakeToggle("Effects", function(v)
        -- nothing extra needed, Settings.Grab.Effects is already set
    end)

    -- === Tool toggles (one-shot with visible green flash) ===
    local refreshMap = {}
    for name, fn in pairs(Tools) do
        refreshMap[name] = MakeToggle(name, function(v)
            if v then
                task.spawn(function()
                    local ok, err = pcall(fn)
                    if not ok then warn("[Grab] " .. name .. " error: " .. tostring(err)) end
                    -- Minimum 0.4s so user sees the toggle flash green
                    task.wait(0.4)
                    Settings.Grab[name] = false
                    if refreshMap[name] then refreshMap[name]() end
                end)
            end
        end)
    end

    -- Minimize behavior
    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        scroll.Visible = not minimized
        main.Size = minimized and UDim2.new(0, 320, 0, 45) or UDim2.new(0, 320, 0, 480)
    end)

    -- Close
    closeBtn.MouseButton1Click:Connect(function()
        screenGui:Destroy()
    end)

    return screenGui
end


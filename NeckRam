Tools["Goku"] = function()
    if Settings.Grab.GrabbedCharacter == nil then return end

    Settings.Grab.Grab = false

    Modules.StopAnimation(Services.LocalPlayer.Character, "3135389157")
    Modules.StopAnimation(Services.LocalPlayer.Character, "11075367458")

    local Grabbed = Settings.Grab.GrabbedCharacter
    local bodyPos = Grabbed.UpperTorso:FindFirstChild("BodyPosition")
    if not bodyPos then
        warn("[Goku] No BodyPosition found on grabbed character")
        Settings.Grab.Grab = true
        return
    end

    -- Step 1: bring target to forward 3
    Modules.TweenPosition(bodyPos, 0.3, Modules.GetForwardPosition(3))
    task.wait(0.35)

    -- Step 2: play punch animation on local player
    Modules.AnimPlay(Services.LocalPlayer.Character, 3354696735)

    -- Step 3: push target to forward 15 while punch plays
    Modules.TweenPosition(bodyPos, 0.6, Modules.GetForwardPosition(15))
    task.wait(0.7)

    -- Step 4: play the charge animation 110517638794017
    local kameAnimObj = Modules.CreateAnimation("110517638794017")
    local kameTrack = Modules.LoadAnimation(Services.LocalPlayer.Character, kameAnimObj)
    kameTrack.Priority = Enum.AnimationPriority.Action4
    kameTrack:Play()
    kameAnimObj:Destroy()

    -- Wait for that animation to finish (with fallback timeout)
    local finished = false
    local conn
    conn = kameTrack.Stopped:Connect(function()
        finished = true
    end)

    local t0 = tick()
    while not finished and tick() - t0 < 6 do
        task.wait(0.1)
    end
    if conn then conn:Disconnect() end

    -- Step 5: fire the Kamehameha (only spawns VFX if Effects is ON)
    if Settings.Grab.Effects then
        Modules.playKamehameha(Services.LocalPlayer.Character, 3)
    else
        local anim = Modules.CreateAnimation("73436636651186")
        local humanoid = Services.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
        if animator then
            local t = animator:LoadAnimation(anim)
            t:Play(0.1, 1, 0.5)
            task.delay(3, function() t:Stop() end)
        end
        anim:Destroy()
    end

    -- Wait for kamehameha, then void the target and release grab
    task.wait(3)
    if Grabbed and Grabbed.Parent then
        Modules.Void(Grabbed)
    end

    Settings.Grab.Grab = true
end


--==========================================================
-- GOKU  — full sequence
--   1) target → FwdPos 3      ; play 3354696735
--   2) target → FwdPos 15
--   3) play 110517638794017   ; wait for it to end
--   4) play 73436636651186 @ 0.5 speed + Kamehameha visuals
--   5) HellKill(g)  → void 5 body parts + release grab
--==========================================================
T["Goku"] = function()
    if Settings.Grab["Goku"] then
        M.CreateTool("Goku", function()
            if not Settings.Grab.GrabbedCharacter then return end
            Settings.Grab.Grab = false

            local g = Settings.Grab.GrabbedCharacter

            M.StopAnim(LP.Character, "3135389157")
            M.StopAnim(LP.Character, "11075367458")

            ----------------------------------------------------------
            -- STEP 1 — target to FwdPos 3, then play 3354696735
            ----------------------------------------------------------
            if g and g.UpperTorso:FindFirstChild("BodyPosition") then
                M.TweenPos(g.UpperTorso.BodyPosition, .5, M.FwdPos(3))
            end

            local chargeAnim = Instance.new("Animation")
            chargeAnim.AnimationId = "rbxassetid://3354696735"
            local chargeTrack = LP.Character.Humanoid:LoadAnimation(chargeAnim)
            chargeTrack.Priority = Enum.AnimationPriority.Action4
            chargeTrack:Play()

            task.wait(1)

            ----------------------------------------------------------
            -- STEP 2 — while 3354696735 plays, target to FwdPos 15
            ----------------------------------------------------------
            if g and g.UpperTorso:FindFirstChild("BodyPosition") then
                M.TweenPos(g.UpperTorso.BodyPosition, 1, M.FwdPos(15))
            end

            task.wait(1)

            ----------------------------------------------------------
            -- STEP 3 — play 110517638794017, wait until it finishes
            ----------------------------------------------------------
            local beamAnim = Instance.new("Animation")
            beamAnim.AnimationId = "rbxassetid://110517638794017"
            local beamTrack = LP.Character.Humanoid:LoadAnimation(beamAnim)
            beamTrack.Priority = Enum.AnimationPriority.Action4
            beamTrack:Play()

            beamTrack.Stopped:Wait()

            ----------------------------------------------------------
            -- STEP 4 — when 110517638794017 done:
            --          play 73436636651186 @ speed 0.5
            --          + Kamehameha visuals (GATED by Effects toggle)
            ----------------------------------------------------------
            local kameAnim = Instance.new("Animation")
            kameAnim.AnimationId = "rbxassetid://73436636651186"
            local kameTrack = LP.Character.Humanoid:LoadAnimation(kameAnim)
            kameTrack.Priority = Enum.AnimationPriority.Action4
            kameTrack:Play(0.1, 1, 0.5)   -- speed 0.5, matches LocalScript

            if Settings.Grab.Effects then
                playKamehamehaVisuals(LP.Character, 3)
            end

            task.wait(3)

            ----------------------------------------------------------
            -- STEP 5 — HellKill the target
            ----------------------------------------------------------
            HellKill(g)

            Settings.Grab.Grab = true
        end)
    else
        M.DestroyTool("Goku")
    end
end


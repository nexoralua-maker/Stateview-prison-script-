-- ============================================================
-- AURA LOGIC
-- ============================================================
local function getTargetPart(auraType, char)
    if auraType == "Angel Wings" then
        return char:FindFirstChild("UpperTorso")
    elseif auraType == "Halo" then
        return char:FindFirstChild("Head")
    elseif auraType == "Electrical" or auraType == "Lightning" or auraType == "Swirl"
        or auraType == "Wave" or auraType == "Air" or auraType == "Bubble" then
        return char:FindFirstChild("HumanoidRootPart")
    else
        return char:FindFirstChild("LowerTorso") or char:FindFirstChild("HumanoidRootPart")
    end
end

local function updaurcol()
    local col = State.auraColor
    local seq = ColorSequence.new(col)
    for i = 1, #aurp do
        local p = aurp[i]
        if p and p.Parent then
            if p:IsA("ParticleEmitter") or p:IsA("Trail") or p:IsA("Beam") then
                p.Color = seq
            elseif p:IsA("PointLight") then
                p.Color = col
            end
            for _, d in ipairs(p:GetDescendants()) do
                if d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") then
                    d.Color = seq
                elseif d:IsA("PointLight") then
                    d.Color = col
                end
            end
        end
    end
end

local function clraur()
    for i = 1, #aurp do
        if aurp[i] then aurp[i]:Destroy() end
    end
    table.clear(aurp)
end

local function applaur()
    clraur()
    if not State.auraEnabled then return end

    local char = LocalPlayer.Character
    if not char then return end

    -- ═══════════════════════════════════════════════════
    -- Asset-based aura (clone from asset)
    -- ═══════════════════════════════════════════════════
    if IsAssetAura(State.auraType) then
        local asset = aurasst[State.auraType]
        if not asset then return end
        local clo = asset:Clone()
        for _, m_p in ipairs(clo:GetChildren()) do
            local targ = char:FindFirstChild(m_p.Name)
            if targ then
                for _, eff in ipairs(m_p:GetChildren()) do
                    eff.Name   = "\0"
                    eff.Parent = targ
                    table.insert(aurp, eff)
                end
            end
        end
        clo:Destroy()
        updaurcol()
        return
    end

    -- ═══════════════════════════════════════════════════
    -- Procedural aura (built in code)
    -- ═══════════════════════════════════════════════════
    local target = getTargetPart(State.auraType, char)
    if not target then return end

    local Attachment = Instance.new("Attachment")
    if State.auraType == "Angel Wings" then
        Attachment.Position = Vector3.new(0, 0.5, 0)
    end
    Attachment.Parent = target

    local Emitters, ExtraAttachments = CreateAura(State.auraType, Attachment, target)

    -- Track everything so we can clean it later
    table.insert(aurp, Attachment)
    for _, e in ipairs(Emitters) do table.insert(aurp, e) end
    for _, a in ipairs(ExtraAttachments) do table.insert(aurp, a) end

    updaurcol()
end

local function setAuraEnabled(v)
    State.auraEnabled = v
    if v then
        applaur()
        if not State.aurCon then
            State.aurCon = LocalPlayer.CharacterAdded:Connect(function()
                task.wait(1)
                if State.auraEnabled then applaur() end
            end)
        end
    else
        clraur()
    end
end

-- ============================================================
-- FORCEFIELD LOGIC
-- ============================================================
local function appFF(char, col, en)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and not p:FindFirstAncestorOfClass("Tool") then
            if en then
                if p.Material ~= Enum.Material.ForceField then
                    p.Material = Enum.Material.ForceField
                    p.Color    = col
                end
            else
                p.Material = Enum.Material.Plastic
            end
        end
    end
end

local function appTFF(char, col, en)
    if not char then return end
    for _, t in ipairs(char:GetChildren()) do
        if t:IsA("Tool") then
            for _, p in ipairs(t:GetDescendants()) do
                if p:IsA("BasePart") then
                    if en then
                        if p.Material ~= Enum.Material.ForceField then
                            p.Material = Enum.Material.ForceField
                            p.Color    = col
                        end
                    else
                        p.Material = Enum.Material.Plastic
                    end
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function()
    if not (State.ffCharEnabled or State.ffToolEnabled) then return end
    local char = LocalPlayer.Character
    if not char then return end
    if State.ffCharEnabled then appFF(char, State.ffCharColor, true) end
    if State.ffToolEnabled then appTFF(char, State.ffToolColor, true) end
end)


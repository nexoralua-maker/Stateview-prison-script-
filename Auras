local function makeSection(titleText)
    local sec = new("Frame", {
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
    }, scroll)
    new("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = titleText,
        TextColor3 = ACCENT,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Active = false,
    }, sec)
end

local function makeToggleRow(labelText, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundColor3 = BG_ROW,
        BorderSizePixel = 0,
    }, scroll)
    corner(row, 6)

    new("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = TEXT,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Active = false,
    }, row)

    local track = new("Frame", {
        Size = UDim2.new(0, 36, 0, 18),
        Position = UDim2.new(1, -46, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(50, 50, 58),
        BorderSizePixel = 0,
        Active = false,
    }, row)
    corner(track, 9)

    local knob = new("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(220, 220, 230),
        BorderSizePixel = 0,
        Active = false,
    }, track)
    corner(knob, 7)

    local btn = new("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
    }, track)

    local state = false
    local function render()
        local tPos   = state and UDim2.new(0, 20, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        local tColor = state and ACCENT or Color3.fromRGB(50, 50, 58)
        TweenService:Create(knob,  TweenInfo.new(0.13), { Position = tPos }):Play()
        TweenService:Create(track, TweenInfo.new(0.13), { BackgroundColor3 = tColor }):Play()
    end
    render()

    btn.MouseButton1Click:Connect(function()
        state = not state
        render()
        if callback then callback(state) end
    end)
end

local function makeColorPicker(labelText, initialColor, callback)
    local container = new("Frame", {
        Size = UDim2.new(1, 0, 0, 90),
        BackgroundColor3 = BG_ROW,
        BorderSizePixel = 0,
    }, scroll)
    corner(container, 6)

    local header = new("Frame", {
        Size = UDim2.new(1, -20, 0, 22),
        Position = UDim2.new(0, 10, 0, 2),
        BackgroundTransparency = 1,
    }, container)

    new("TextLabel", {
        Size = UDim2.new(1, -30, 1, 0),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = TEXT,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Active = false,
    }, header)

    local preview = new("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(1, -18, 0.5, -9),
        BackgroundColor3 = initialColor,
        BorderSizePixel = 0,
        Active = false,
    }, header)
    corner(preview, 4)

    local currentColor = initialColor
    local function applyColor()
        preview.BackgroundColor3 = currentColor
        if callback then callback(currentColor) end
    end

    local labels, keys = {"R","G","B"}, {"R","G","B"}

    for idx = 1, 3 do
        local yOff = (idx - 1) * 20

        local row = new("Frame", {
            Size = UDim2.new(1, -20, 0, 18),
            Position = UDim2.new(0, 10, 0, 26 + yOff),
            BackgroundTransparency = 1,
        }, container)

        new("TextLabel", {
            Size = UDim2.new(0, 14, 1, 0),
            BackgroundTransparency = 1,
            Text = labels[idx],
            TextColor3 = TEXT_DIM,
            TextSize = 11,
            Font = Enum.Font.GothamBold,
            TextXAlignment = Enum.TextXAlignment.Left,
            Active = false,
        }, row)

        local track = new("Frame", {
            Size = UDim2.new(1, -50, 0, 5),
            Position = UDim2.new(0, 16, 0.5, -2.5),
            BackgroundColor3 = Color3.fromRGB(50, 50, 58),
            BorderSizePixel = 0,
        }, row)
        corner(track, 2)

        local fill = new("Frame", {
            Size = UDim2.new(currentColor[keys[idx]], 0, 1, 0),
            BackgroundColor3 = ACCENT,
            BorderSizePixel = 0,
            Active = false,
        }, track)
        corner(fill, 2)

        local handle = new("Frame", {
            Size = UDim2.new(0, 10, 0, 10),
            Position = UDim2.new(currentColor[keys[idx]], -5, 0.5, -5),
            BackgroundColor3 = Color3.fromRGB(240, 240, 240),
            BorderSizePixel = 0,
            Active = false,
        }, track)
        corner(handle, 5)

        local valLbl = new("TextLabel", {
            Size = UDim2.new(0, 30, 1, 0),
            Position = UDim2.new(1, -30, 0, 0),
            BackgroundTransparency = 1,
            Text = string.format("%d", math.floor(currentColor[keys[idx]] * 255)),
            TextColor3 = TEXT,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Right,
            Active = false,
        }, row)

        local btn = new("TextButton", {
            Size = UDim2.new(1, 0, 2, 0),
            Position = UDim2.new(0, 0, 0.5, -8),
            BackgroundTransparency = 1,
            Text = "",
        }, track)

        local dragging = false
        local function update(input)
            local tp = track.AbsolutePosition
            local ts = track.AbsoluteSize
            local pct = math.clamp((input.Position.X - tp.X) / ts.X, 0, 1)
            local r, g, b = currentColor.R, currentColor.G, currentColor.B
            if idx == 1 then r = pct elseif idx == 2 then g = pct else b = pct end
            currentColor = Color3.new(r, g, b)
            fill.Size       = UDim2.new(pct, 0, 1, 0)
            handle.Position = UDim2.new(pct, -5, 0.5, -5)
            valLbl.Text     = string.format("%d", math.floor(pct * 255))
            applyColor()
        end

        btn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input)
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
                update(input)
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end
end

local function makeCycleRow(labelText, items, initialValue, callback)
    local row = new("Frame", {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = BG_ROW,
        BorderSizePixel = 0,
    }, scroll)
    corner(row, 6)

    new("TextLabel", {
        Size = UDim2.new(0.35, -10, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = labelText,
        TextColor3 = TEXT,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        Active = false,
    }, row)

    local prevBtn = new("TextButton", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(1, -160, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(50, 50, 58),
        Text = "◄", TextColor3 = TEXT, TextSize = 10,
        Font = Enum.Font.GothamBold, BorderSizePixel = 0,
    }, row)
    corner(prevBtn, 4)

    local valLbl = new("TextLabel", {
        Size = UDim2.new(0, 120, 1, 0),
        Position = UDim2.new(1, -140, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(initialValue),
        TextColor3 = ACCENT,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        Active = false,
    }, row)

    local nextBtn = new("TextButton", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(1, -20, 0.5, -9),
        BackgroundColor3 = Color3.fromRGB(50, 50, 58),
        Text = "►", TextColor3 = TEXT, TextSize = 10,
        Font = Enum.Font.GothamBold, BorderSizePixel = 0,
    }, row)
    corner(nextBtn, 4)

    local index = table.find(items, initialValue) or 1
    local function render()
        valLbl.Text = items[index]
        if callback then callback(items[index]) end
    end
    render()

    prevBtn.MouseButton1Click:Connect(function()
        index = index - 1
        if index < 1 then index = #items end
        render()
    end)
    nextBtn.MouseButton1Click:Connect(function()
        index = index + 1
        if index > #items then index = 1 end
        render()
    end)
end


    if not ConfigName or ConfigName == "" then cfgNotify("error", "name is empty") return end
    local ok = pcall(function() makefolder(Library.Directory); makefolder(Library.Directory .. Library.Folders.Configs); writefile(ConfigsFolder .. ConfigName .. ".json", Library:GetConfig()) end)
    if ok then ConfigsList:Refresh(listConfigs()); cfgNotify("config", "saved " .. ConfigName) else cfgNotify("config", "save failed") end
end })
ConfigSection:Button({ Name = "Load Selected", Callback = function()
    if not SelectedConfig or SelectedConfig == "" then cfgNotify("error", "no config selected") return end
    local ok, data = pcall(function() return readfile(ConfigsFolder .. SelectedConfig .. ".json") end)
    if ok and data then local ok2 = pcall(function() Library:LoadConfig(data) end); cfgNotify("config", ok2 and ("loaded " .. SelectedConfig) or "load failed") else cfgNotify("config", "could not read") end
end })
ConfigSection:Button({ Name = "Delete Selected", Callback = function()
    if not SelectedConfig or SelectedConfig == "" then cfgNotify("error", "no config selected") return end
    local ok = pcall(function() delfile(ConfigsFolder .. SelectedConfig .. ".json") end)
    if ok then SelectedConfig = nil; ConfigsList:Refresh(listConfigs()); cfgNotify("config", "deleted") end
end })
ConfigSection:Button({ Name = "Refresh List", Callback = function() ConfigsList:Refresh(listConfigs()); cfgNotify("config", "refreshed") end })
local AutoSection = SettingsPage:Section({ Name = "Autoload", Side = 2 })
AutoSection:Button({ Name = "Set Selected as Autoload", Callback = function()
    if not SelectedConfig or SelectedConfig == "" then cfgNotify("error", "no config selected") return end
    local ok, data = pcall(function() return readfile(ConfigsFolder .. SelectedConfig .. ".json") end)
    if ok and data then pcall(function() writefile(Library.Directory .. "/autoload.json", data) end); cfgNotify("autoload", "set " .. SelectedConfig) end
end })
AutoSection:Button({ Name = "Clear Autoload", Callback = function() pcall(function() writefile(Library.Directory .. "/autoload.json", "") end); cfgNotify("autoload", "cleared") end })
AutoSection:Button({ Name = "Load Autoload Now", Callback = function()
    local ok, data = pcall(function() return readfile(Library.Directory .. "/autoload.json") end)
    if ok and data and data ~= "" then local ok2 = pcall(function() Library:LoadConfig(data) end); cfgNotify("autoload", ok2 and "loaded" or "failed") else cfgNotify("autoload", "no autoload set") end
end })
local ExtraSection = SettingsPage:Section({ Name = "Extra", Side = 1 })
local cachedFrames = nil
ExtraSection:Slider({ Name = "UI Transparency", Flag = "settings_uitrans", Min = 0, Max = 1, Default = 0, Decimals = 0.01, Callback = function(v)
    pcall(function()
        if not cachedFrames then
            cachedFrames = {}
            for _, d in ipairs(Library.Holder.Instance:GetDescendants()) do if d:IsA("Frame") or d:IsA("TextButton") then cachedFrames[#cachedFrames+1] = { obj = d, orig = d.BackgroundTransparency } end end
        end
        for _, e in ipairs(cachedFrames) do if e.obj.Parent then e.obj.BackgroundTransparency = math.clamp(e.orig + v, 0, 1) end end
    end)
end })
ExtraSection:Button({ Name = "Test Notification", Callback = function() notify("test", "if you see this, notifications work") end })
ExtraSection:Button({ Name = "Unload Script", Callback = function() pcall(function() if Library.Exit then Library:Exit() elseif Library.Unload then Library:Unload() end end); getgenv().CRISPY_LOADED = nil end })
local DangerSection = SettingsPage:Section({ Name = "Danger", Side = 2 })
DangerSection:Button({ Name = "Reset All Toggles", Callback = function()
    for flag, val in pairs(Library.Flags) do local setter = Library.SetFlags[flag]; if setter and type(val) == "boolean" then pcall(function() setter(false) end) end end
    cfgNotify("reset", "all boolean flags off")
end })
DangerSection:Button({ Name = "Re-execute Script", Callback = function()
    local ok = pcall(function() getgenv().CRISPY_LOADED = nil; local src = game:HttpGet("https://raw.githubusercontent.com/Essluau/EssnceLibrary/refs/heads/main/MobileBuild.lua"); if src then loadstring(src)() end end)
    notify("re-execute", ok and "attempted" or "failed — rejoin required")
end })


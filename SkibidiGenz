local FPSBooster = (function()
    local M = { flags = { texture = false, effects = false, lighting = false, mesh = false, shadows = false }, saved = { texture = {}, effects = {}, lighting = {}, mesh = {}, shadows = {} }, conn = nil }
    local function isTex(v) return v:IsA("Texture") or v:IsA("Decal") end
    local function isFx(v) return v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Beam") or v:IsA("Trail") end
    local function isLightFx(v) return v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("BloomEffect") or v:IsA("BlurEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("SunRaysEffect") or v:IsA("DepthOfFieldEffect") end
    local function handleOne(v)
        if isTex(v) then
            if M.saved.texture[v] == nil then M.saved.texture[v] = v.Texture end
            if M.flags.texture then pcall(function() v.Texture = "" end) end
        elseif v:IsA("MeshPart") then
            if M.saved.mesh[v] == nil then M.saved.mesh[v] = v.RenderFidelity end
            if M.flags.mesh then pcall(function() v.RenderFidelity = Enum.RenderFidelity.Automatic end) end
        elseif isFx(v) then
            if M.saved.effects[v] == nil then M.saved.effects[v] = v.Enabled end
            if M.flags.effects then pcall(function() v.Enabled = false end) end
        elseif v:IsA("BasePart") then
            if M.saved.shadows[v] == nil then M.saved.shadows[v] = v.CastShadow end
            if M.flags.shadows then pcall(function() v.CastShadow = false end) end
        elseif isLightFx(v) then
            if M.saved.lighting[v] == nil then M.saved.lighting[v] = v.Enabled end
            if M.flags.lighting then pcall(function() v.Enabled = false end) end
        end
    end
    local function scanAll()
        for _, v in ipairs(Workspace:GetDescendants()) do handleOne(v) end
        for _, v in ipairs(Lighting:GetChildren()) do handleOne(v) end
        if M.flags.shadows then pcall(function() Lighting.GlobalShadows = false end) end
    end
    local function applyCategory(name)
        local map = M.saved[name]; if not map then return end
        for v, _ in pairs(map) do
            if v.Parent then
                if name == "texture" then pcall(function() v.Texture = "" end)
                elseif name == "effects" then pcall(function() v.Enabled = false end)
                elseif name == "lighting" then pcall(function() v.Enabled = false end)
                elseif name == "mesh" then pcall(function() v.RenderFidelity = Enum.RenderFidelity.Automatic end)
                elseif name == "shadows" then pcall(function() v.CastShadow = false end) end
            end
        end
        if name == "shadows" then pcall(function() Lighting.GlobalShadows = false end) end
    end
    local function restoreCategory(name)
        local map = M.saved[name]; if not map then return end
        for v, val in pairs(map) do
            if v.Parent then
                if name == "texture" then pcall(function() v.Texture = val end)
                elseif name == "effects" then pcall(function() v.Enabled = val end)
                elseif name == "lighting" then pcall(function() v.Enabled = val end)
                elseif name == "mesh" then pcall(function() v.RenderFidelity = val end)
                elseif name == "shadows" then pcall(function() v.CastShadow = val end) end
            end
        end
        if name == "shadows" then pcall(function() Lighting.GlobalShadows = true end) end
    end
    local function startListener() if M.conn then return end; M.conn = Workspace.DescendantAdded:Connect(function(v) handleOne(v) end) end
    local function stopListener() if M.conn then M.conn:Disconnect() M.conn = nil end end
    local function anyOn() for _, v in pairs(M.flags) do if v then return true end end; return false end
    function M.set(cat, on) M.flags[cat] = on; if on then scanAll(); applyCategory(cat); startListener() else restoreCategory(cat); if not anyOn() then stopListener() end end end
    function M.refresh() scanAll(); for name, on in pairs(M.flags) do if on then applyCategory(name) end end end
    function M.restoreAll() for name, _ in pairs(M.flags) do M.flags[name] = false; restoreCategory(name) end; pcall(function() Lighting.GlobalShadows = true end); stopListener() end
    return M
end)()

local LegitAutoBuy = (function()
    local CONFIG = {
        Targets = {
            ["medium armor"] = { enabled = false, equip = false },
            ["pizza"]        = { enabled = false, equip = true },
            ["donut"]        = { enabled = false, equip = true },
        },
        Range = 10,
        Cooldown = 1.5,
        ScanTick = 0.15,
        UsePrompts = true,
        UseClicks = true,
        EquipDelay = 0.15,
    }
    local cache     = {}
    local lastFired = {}
    local nextScan  = 0
    local running   = false
    local conn

    local function nameMatches(name)
        local n = name:lower()
        for target, cfg in pairs(CONFIG.Targets) do
            if cfg.enabled and (n == target or n:find(target, 1, true)) then
                return target
            end
        end
        return nil
    end

    local function buildCache()
        local out = {}
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("BasePart") or obj:IsA("Model") then
                local target = nameMatches(obj.Name)
                if target then
                    local pos
                    if obj:IsA("BasePart") then pos = obj.Position
                    else local p = obj:FindFirstChildWhichIsA("BasePart", true); pos = p and p.Position end
                    if pos then
                        local prompts, clicks = {}, {}
                        for _, d in ipairs(obj:GetDescendants()) do
                            if d:IsA("ProximityPrompt") then table.insert(prompts, d) end
                            if d:IsA("ClickDetector")  then table.insert(clicks,  d) end
                        end
                        if obj:IsA("ProximityPrompt") then table.insert(prompts, obj) end
                        if obj:IsA("ClickDetector")  then table.insert(clicks,  obj) end
                        table.insert(out, {
                            obj = obj, pos = pos, name = obj.Name,
                            prompts = prompts, clicks = clicks,
                            equip = CONFIG.Targets[target].equip,
                            target = target,
                        })
                    end
                end
            end
        end
        return out
    end

    local function firePrompt(prompt)
        local t = lastFired[prompt]
        if t and tick() - t < CONFIG.Cooldown then return false end
        lastFired[prompt] = tick()
        pcall(function() prompt:InputHoldBegin() end)
        task.delay(prompt.HoldDuration or 0, function()
            pcall(function() prompt:InputHoldEnd() end)
        end)
        return true
    end

    local function fireClick(cd)
        local t = lastFired[cd]
        if t and tick() - t < CONFIG.Cooldown then return false end
        lastFired[cd] = tick()
        pcall(function() fireclickdetector(cd) end)
        return true
    end

    local function tryEquip(targetName)
        local char = LP.Character; if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local bag = LP:FindFirstChildOfClass("Backpack")
        if not hum or not bag then return end
        for _, tool in ipairs(bag:GetChildren()) do
            if tool:IsA("Tool") then
                local tn = tool.Name:lower()
                if tn == targetName or tn:find(targetName, 1, true) then
                    pcall(function() hum:EquipTool(tool) end)
                    return
                end
            end
        end
    end

    local function scan()
        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        for _, entry in ipairs(cache) do
            local dist = (hrp.Position - entry.pos).Magnitude
            if dist <= CONFIG.Range then
                local bought = false
                if CONFIG.UsePrompts then
                    for _, p in ipairs(entry.prompts) do
                        if p.Enabled ~= false and firePrompt(p) then bought = true end
                    end
                end
                if CONFIG.UseClicks then
                    for _, c in ipairs(entry.clicks) do
                        if c.Parent and fireClick(c) then bought = true end
                    end
                end
                if bought and entry.equip then
                    local targetName = entry.target
                    task.delay(CONFIG.EquipDelay, function() tryEquip(targetName) end)
                end
            end
        end
    end

    local function anyEnabled()
        for _, cfg in pairs(CONFIG.Targets) do if cfg.enabled then return true end end
        return false
    end

    local function startLoop()
        if running then return end
        running = true
        cache = buildCache()
        conn = RunService.Heartbeat:Connect(function()
            local now = tick()
            if now < nextScan then return end
            nextScan = now + CONFIG.ScanTick
            pcall(scan)
        end)
        task.spawn(function()
            while running do
                task.wait(5)
                if not running then break end
                cache = buildCache()
            end
        end)
    end

    local function stopLoop()
        if not running then return end
        running = false
        if conn then conn:Disconnect(); conn = nil end
        cache = {}
        lastFired = {}
    end

    local function refresh()
        if anyEnabled() then startLoop() else stopLoop() end
    end

    local M = {}
    function M.setTarget(name, enabled)
        if not CONFIG.Targets[name] then return end
        CONFIG.Targets[name].enabled = enabled and true or false
        refresh()
    end
    function M.setRange(v) CONFIG.Range = math.clamp(tonumber(v) or CONFIG.Range, 3, 100); cache = buildCache() end
    function M.setCooldown(v) CONFIG.Cooldown = math.clamp(tonumber(v) or CONFIG.Cooldown, 0.2, 10) end
    function M.setPrompts(v) CONFIG.UsePrompts = v and true or false end
    function M.setClicks(v) CONFIG.UseClicks = v and true or false end
    function M.stop() for _, cfg in pairs(CONFIG.Targets) do cfg.enabled = false end; stopLoop() end
    return M
end)()

local ESPFrame = (function()
    local Players_    = cloneref(game:GetService("Players"))
    local RunService_ = cloneref(game:GetService("RunService"))
    local Workspace_  = cloneref(game:GetService("Workspace"))
    local LocalPlayer_ = Players_.LocalPlayer

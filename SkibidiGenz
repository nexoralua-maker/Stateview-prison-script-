        local sg = Instance.new("ScreenGui")
        sg.Name = "CrispyESP"; sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true
        sg.ClipToDeviceSafeArea = false; sg.ZIndexBehavior = Enum.ZIndexBehavior.Global
        local ok = pcall(function() sg.Parent = gethui() end)
        if not ok or not sg.Parent then pcall(function() sg.Parent = LocalPlayer_:WaitForChild("PlayerGui") end) end
        return sg
    end
    local esp = {
        Classes = {}, Objects = {}, Connections = {}, Gui = makeGui(),
        FontSize = 12, Font = Font.fromEnum(Enum.Font.Gotham), UpdateRate = 1/30,
        Configuration = {
            Enabled = false,
            TargetOnly = false,
            TeamCheck = { Enabled = false, UseTeamColors = false },
            Box = {
                Style = "Dynamic", Type = "Full",
                Fill = { Enabled = false, Color = TEAL, Transparency = {0.3, 0.8} },
                Outline = { Enabled = false, Color = TEAL, Thickness = 1, CornerLength = 12 },
                GetStyle = function(Type, cachedParts, cam)
                    Type = Type or "Dynamic"
                    if not cam or not cachedParts or #cachedParts == 0 then return nil, nil end
                    local min_x, min_y, min_z = math.huge, math.huge, math.huge
                    local max_x, max_y, max_z = -math.huge, -math.huge, -math.huge
                    if Type == "Static" then
                        for _, part in cachedParts do
                            if part.Name == "HumanoidRootPart" and part.Parent then
                                local p,s = part.Position, part.Size
                                min_x = p.X - s.X*0.5; max_x = p.X + s.X*0.5
                                min_y = p.Y - s.Y*0.5; max_y = p.Y + s.Y*0.5
                                min_z = p.Z - s.Z*0.5; max_z = p.Z + s.Z*0.5
                                break
                            end
                        end
                    else
                        for _, part in cachedParts do
                            if part.Parent then
                                local p,s = part.Position, part.Size
                                local hx,hy,hz = s.X*0.5, s.Y*0.5, s.Z*0.5
                                if p.X-hx < min_x then min_x = p.X-hx end
                                if p.Y-hy < min_y then min_y = p.Y-hy end
                                if p.Z-hz < min_z then min_z = p.Z-hz end
                                if p.X+hx > max_x then max_x = p.X+hx end
                                if p.Y+hy > max_y then max_y = p.Y+hy end
                                if p.Z+hz > max_z then max_z = p.Z+hz end
                            end
                        end
                    end
                    if max_x == -math.huge then return nil,nil end
                    local sc_min_x, sc_min_y = math.huge, math.huge
                    local sc_max_x, sc_max_y = -math.huge, -math.huge
                    local anyOn = false
                    local function proj(x,y,z)
                        local sp, on = cam:WorldToViewportPoint(Vector3.new(x,y,z))
                        if on then anyOn = true; if sp.X<sc_min_x then sc_min_x=sp.X end; if sp.Y<sc_min_y then sc_min_y=sp.Y end; if sp.X>sc_max_x then sc_max_x=sp.X end; if sp.Y>sc_max_y then sc_max_y=sp.Y end end
                    end
                    proj(min_x,min_y,min_z); proj(min_x,min_y,max_z); proj(min_x,max_y,min_z); proj(min_x,max_y,max_z)
                    proj(max_x,min_y,min_z); proj(max_x,min_y,max_z); proj(max_x,max_y,min_z); proj(max_x,max_y,max_z)
                    if not anyOn then return nil,nil end
                    return Vector2.new(sc_min_x,sc_min_y), Vector2.new(sc_max_x-sc_min_x, sc_max_y-sc_min_y)
                end,
            },
            HealthBar = { Enabled = false, Position = "Left",
                Color = { High = Color3.fromRGB(131,245,78), Medium = Color3.fromRGB(255,255,0), Low = Color3.fromRGB(252,71,77) },
                GetHealth = function(h) if not h or h.MaxHealth == 0 then return 1 end; return math.clamp(h.Health/h.MaxHealth, 0, 1) end,
                Text = { Enabled = false, Color = WHITE, Transparency = 0, GetText = function(h) if not h then return "0", false end; return tostring(math.floor(h.Health)), h.Health ~= h.MaxHealth end } },
            Name = { Enabled = false, Color = TEAL, Transparency = 0 },
            Distance = { Enabled = false, Color = WHITE, Transparency = 0, Format = function(d) return string.format("%dst", d) end },
            Tool = { Enabled = false, Color = TEAL, Transparency = 0, NoToolText = "none" },
        },
    }
    local function makeLabel(parent)
        local lbl = Instance.new("TextLabel")
        lbl.BackgroundTransparency = 1; lbl.TextColor3 = WHITE; lbl.TextStrokeTransparency = 0
        lbl.TextStrokeColor3 = Color3.new(0,0,0); lbl.FontFace = esp.Font; lbl.TextSize = esp.FontSize
        lbl.Size = UDim2.new(0,100,0,esp.FontSize+2); lbl.Parent = parent

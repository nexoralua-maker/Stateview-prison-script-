    Callback = function(v) local map = { ["[chicken]"]="[Chicken]",["[burger]"]="[Burger]",["[pizza]"]="[Pizza]",["[taco]"]="[Taco]",["[donut]"]="[Donut]" }; AutoBuyState.SelectedFood = map[v] or "[Chicken]" end })
buySec:Toggle({ Text = "auto buy armor", Flag = "ab_armor", Default = false, Callback = function(v) AutoBuyState.AutoArmor = v end })
buySec:Dropdown({ Text = "armor type", Flag = "ab_armort", Options = { "[medium armor]","[high-medium armor]" }, Default = "[medium armor]",
    Callback = function(v) local map = { ["[medium armor]"]="[Medium Armor]",["[high-medium armor]"]="[High-Medium Armor]" }; AutoBuyState.SelectedArmor = map[v] or "[Medium Armor]" end })
buySec:Toggle({ Text = "auto buy guns", Flag = "ab_gun", Default = false, Callback = function(v) AutoBuyState.AutoGun = v end })
buySec:Dropdown({ Text = "gun types", Flag = "ab_gunt", Options = { "[silencer]","[usp]","[tactical shotgun]" }, Default = "[silencer]",
    Callback = function(v) local map = { ["[silencer]"]="[Silencer]",["[usp]"]="[USP]",["[tactical shotgun]"]="[Tactical Shotgun]" }; AutoBuyState.SelectedGun = map[v] or "[Silencer]" end })

--settings
local configs = SettingsTab:Section("configs", 1)
local configName = "default"
configs:Search({ Placeholder = "config name", Label = "name", Live = true, Callback = function(text) configName = text end })
local configDropdown = configs:Dropdown({ Text = "saved configs", Flag = "selected_config", Options = { "" }, Default = "",
    Callback = function(value) if value and value ~= "" then configName = value end end })
local function refreshConfigDropdown()
    local list = SaveManager:List(); if #list == 0 then list = { "" } end
    pcall(function() configDropdown:SetOptions(list) end)
end
refreshConfigDropdown()
configs:ButtonRow({
    { Text = "create", Callback = function()
        if configName == nil or configName == "" then notify("config", "enter a name first", "warn"); return end
        if SaveManager:Save(configName) then refreshConfigDropdown(); notify("config", "created " .. configName, "success")
        else notify("config", "failed to save " .. configName, "error") end
    end },
    { Text = "overwrite", Callback = function()
        if configName == nil or configName == "" then notify("config", "enter a name first", "warn"); return end
        if SaveManager:Save(configName) then refreshConfigDropdown(); notify("config", "overwritten " .. configName, "success")
        else notify("config", "failed to save " .. configName, "error") end
    end },
})
configs:ButtonRow({
    { Text = "load", Callback = function()
        if configName == nil or configName == "" then notify("config", "enter a name first", "warn"); return end
        if SaveManager:Load(configName) then notify("config", "loaded " .. configName, "success")
        else notify("config", "could not load " .. configName, "error") end
    end },
    { Text = "delete", Callback = function()
        if configName == nil or configName == "" then notify("config", "enter a name first", "warn"); return end
        SaveManager:Delete(configName); refreshConfigDropdown(); notify("config", "deleted " .. configName, "success")
    end },
})
configs:ButtonRow({
    { Text = "set autoload", Callback = function()
        if configName == nil or configName == "" then notify("config", "enter a name first", "warn"); return end
        SaveManager:SetAutoloadConfig(configName); refreshConfigDropdown(); notify("config", "autoload set to " .. configName, "success")
    end },
    { Text = "remove autoload", Callback = function()
        SaveManager:ClearAutoload(); refreshConfigDropdown(); notify("config", "autoload removed", "success")
    end },
})

local notifications = SettingsTab:Section("notifications", 2)
notifications:ButtonRow({
    { Text = "normal", Callback = function() notify("crispy", "test notification", "info") end },
    { Text = "warning", Callback = function() notify("attention", "this option is experimental", "warn") end },
})
notifications:ButtonRow({
    { Text = "danger", Callback = function() notify("risky", "this action cannot be undone", "error") end },
    { Text = "success", Callback = function() notify("done", "config applied", "success") end },
})

local notes = SettingsTab:Section("notes", 2)
notes:Paragraph({ Title = "how it works", Content = "each option writes into Library.Flags, configs only store flagged elements.", Icon = "info" })
notes:Paragraph({ Title = "careful", Content = "changing the format only changes the file extension, not the encoding.", Style = "warning", Icon = "alert-triangle" })
notes:Paragraph({ Title = "no filesystem", Content = "without executor file functions, configs stay in memory for the session only.", Style = "danger", Icon = "x-circle" })
notes:Label("all systems nominal.", { Style = "success", Icon = "check" })

Window:Action("connect", function() notify("connected", "session started", "success") end)

SaveManager:SetLibrary(Library)
Library:BuildFolders("crispy.gg")
Library:BuildFolders("crispy.gg/game")
SaveManager:SetFolder("crispy.gg/game")

if InterfaceManager then
    pcall(function() InterfaceManager:SetLibrary(Library) end)
    pcall(function() InterfaceManager:SetWindow(Window) end)
    pcall(function() InterfaceManager:SetFolder("crispy.gg") end)
    if InterfaceManager.BuildInterfaceSection then pcall(function() InterfaceManager:BuildInterfaceSection(SettingsTab, 1) end) end
end
if ThemeManager then
    pcall(function() ThemeManager:SetLibrary(Library) end)
    pcall(function() ThemeManager:SetFolder("crispy.gg") end)
    if ThemeManager.BuildThemeSection then pcall(function() ThemeManager:BuildThemeSection(SettingsTab, 1) end) end
end

--ui polish
task.spawn(function()
    task.wait(1)
    local function roundAll(root)
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("Frame") or d:IsA("TextButton") or d:IsA("TextLabel") or d:IsA("ImageLabel") then
                local c = d:FindFirstChildOfClass("UICorner")
                if not c then c = Instance.new("UICorner"); c.Parent = d end
                local m = math.min(d.AbsoluteSize.X, d.AbsoluteSize.Y)
                local px = math.clamp(m * 0.12, 4, 12)
                c.CornerRadius = UDim.new(0, px)
            end
        end
    end
    local pg = LP:FindFirstChild("PlayerGui")
    if pg then
        for _, g in ipairs(pg:GetChildren()) do
            if g:IsA("ScreenGui") and #g:GetDescendants() > 100 then pcall(roundAll, g) end
        end
    end
    for _, g in ipairs(CoreGui:GetChildren()) do
        if g:IsA("ScreenGui") and #g:GetDescendants() > 100 then pcall(roundAll, g) end
    end
end)

notify("crispy.gg", "loaded", "success")
SaveManager:LoadAutoloadConfig()

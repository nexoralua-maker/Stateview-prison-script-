local Window = Library:Window({ Title = "crispy.gg", Width = 640, Height = 620 })

--strip .app suffix
task.spawn(function()
    task.wait(0.4)
    for _, root in ipairs({ CoreGui, LP:FindFirstChild("PlayerGui") }) do
        if not root then continue end
        for _, d in ipairs(root:GetDescendants()) do
            if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text and d.Text:find("crispy.gg") then
                d.Text = d.Text:gsub("crispy%.gg", "crispy.gg")
            end
        end
    end
end)

--lock button
task.spawn(function()
    local sg = Instance.new("ScreenGui")
    sg.Name = "crispy_lock"; sg.ResetOnSpawn = false; sg.IgnoreGuiInset = true
    sg.DisplayOrder = 999; sg.Parent = LP:WaitForChild("PlayerGui")
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 100, 0, 100)
    btn.Position = UDim2.new(0, 16, 0.5, -50)
    btn.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
    btn.BackgroundTransparency = 0.35
    btn.Text = ""
    btn.AutoButtonColor = false
    btn.Active = true
    btn.Draggable = true
    btn.Parent = sg
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 14)

    local icon = Instance.new("ImageLabel")
    icon.Size = UDim2.new(0, 72, 0, 72)
    icon.Position = UDim2.new(0.5, -36, 0.5, -36)
    icon.BackgroundTransparency = 1
    icon.Image = "rbxassetid://122060075814313"
    icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
    icon.ScaleType = Enum.ScaleType.Fit
    icon.Parent = btn

    local fallback = Instance.new("TextLabel")
    fallback.Size = UDim2.new(1, 0, 1, 0)
    fallback.BackgroundTransparency = 1
    fallback.Text = "◉"
    fallback.TextColor3 = Color3.fromRGB(255, 255, 255)
    fallback.TextSize = 52
    fallback.Font = Enum.Font.GothamBold
    fallback.Visible = false
    fallback.Parent = btn

    task.spawn(function()
        task.wait(2.5)
        if not icon.IsLoaded then icon.Visible = false; fallback.Visible = true end
    end)

    local function refresh()
        local locked = Aimlock.enabled
        icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
        fallback.TextColor3 = Color3.fromRGB(255, 255, 255)
        icon.ImageTransparency = locked and 0 or 0.45
        fallback.TextTransparency = locked and 0 or 0.45
        btn.BackgroundTransparency = locked and 0.15 or 0.5
    end
    RunService.RenderStepped:Connect(refresh)
    btn.MouseButton1Click:Connect(function()
        Aimlock.setEnabled(not Aimlock.enabled)
        if Toggles and Toggles.ta_enabled then Toggles.ta_enabled:SetValue(Aimlock.enabled) end
        notify("target aim", Aimlock.enabled and "enabled" or "disabled", Aimlock.enabled and "success" or "warn")
        refresh()
    end)
end)

--lock change notify
Aimlock.onLockChange = function(locked, target)
    if locked and target then
        notify("locked", target.DisplayName or target.Name, "success")
    else
        notify("unlocked", "target released", "warn")
    end
end


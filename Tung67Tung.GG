        rthro         = { Idle1="rbxassetid://2510196951", Idle2="rbxassetid://2510197257", Walk="rbxassetid://2510202577", Run="rbxassetid://2510198475", Fall="rbxassetid://656115606",  Jump="rbxassetid://656117878",  Climb="rbxassetid://2510192778", Swim="rbxassetid://2510199791", SwimIdle="rbxassetid://2510201162" },
        stylish       = { Idle1="rbxassetid://616136790",  Idle2="rbxassetid://616138447",  Walk="rbxassetid://616146177",  Run="rbxassetid://616140816",  Fall="rbxassetid://616134815",  Jump="rbxassetid://616139451",  Climb="rbxassetid://616133594",  Swim="rbxassetid://616143378",  SwimIdle="rbxassetid://616144772" },
        superhero     = { Idle1="rbxassetid://616111295",  Idle2="rbxassetid://616113536",  Walk="rbxassetid://616122287",  Run="rbxassetid://616117076",  Fall="rbxassetid://616108001",  Jump="rbxassetid://616115533",  Climb="rbxassetid://616104706",  Swim="rbxassetid://616119360",  SwimIdle="rbxassetid://616120861" },
        toy           = { Idle1="rbxassetid://782841498",  Idle2="rbxassetid://782845736",  Walk="rbxassetid://782843345",  Run="rbxassetid://782842708",  Fall="rbxassetid://782846423",  Jump="rbxassetid://782847020",  Climb="rbxassetid://782843869",  Swim="rbxassetid://782844582",  SwimIdle="rbxassetid://782845186" },
        vampire       = { Idle1="rbxassetid://1083445855", Idle2="rbxassetid://1083450166", Walk="rbxassetid://1083473930", Run="rbxassetid://1083462077", Fall="rbxassetid://1083443587", Jump="rbxassetid://1083455352", Climb="rbxassetid://1083439238", Swim="rbxassetid://1083464683", SwimIdle="rbxassetid://1083467779" },
        werewolf      = { Idle1="rbxassetid://1083195517", Idle2="rbxassetid://1083214717", Walk="rbxassetid://1083178339", Run="rbxassetid://1083216690", Fall="rbxassetid://1083189019", Jump="rbxassetid://1083218792", Climb="rbxassetid://1083182000", Swim="rbxassetid://1083222527", SwimIdle="rbxassetid://1083222527" },
        zombie        = { Idle1="rbxassetid://616158929",  Idle2="rbxassetid://616160636",  Walk="rbxassetid://616168032",  Run="rbxassetid://616163682",  Fall="rbxassetid://616157476",  Jump="rbxassetid://616161997",  Climb="rbxassetid://18537363391", Swim="rbxassetid://616165109",  SwimIdle="rbxassetid://616166655" },
        adidas        = { Idle1="rbxassetid://18537376492",Idle2="rbxassetid://18537371272",Walk="rbxassetid://18537392113",Run="rbxassetid://18537384040",Fall="rbxassetid://18537367238",Jump="rbxassetid://18537380791",Climb="rbxassetid://18537363391",Swim="rbxassetid://18537389531",SwimIdle="rbxassetid://18537387180" },
        fake_r6       = { Idle1="rbxassetid://12521158637",Idle2="rbxassetid://12521162526",Walk="rbxassetid://126997486407971",Run="rbxassetid://126997486407971",Fall="rbxassetid://12520972571",Jump="rbxassetid://12520880485",Climb="rbxassetid://12520982150",Swim="rbxassetid://12520993168",SwimIdle="rbxassetid://2510201162" },
    }
    local SLOTS = {
        Idle1={"idle","Animation1"}, Idle2={"idle","Animation2"},
        Walk={"walk","WalkAnim"}, Run={"run","RunAnim"},
        Swim={"swim","Swim"}, SwimIdle={"swimidle","SwimIdle"},
        Jump={"jump","JumpAnim"}, Fall={"fall","FallAnim"}, Climb={"climb","ClimbAnim"},
    }
    local function getAnimate() local char = LP.Character; return char and char:FindFirstChild("Animate") end
    local function resolve(animate, path) local obj = animate; for _, name in ipairs(path) do obj = obj and obj:FindFirstChild(name) end; return obj end
    local function saveOriginals()
        local animate = getAnimate(); if not animate then return end
        M.orig = {}
        for slot, path in pairs(SLOTS) do
            local obj = resolve(animate, path)
            if obj and obj:IsA("Animation") then M.orig[slot] = obj.AnimationId end
        end
        M.saved = true
    end
    local function apply()
        local animate = getAnimate(); if not animate then return end
        animate.Enabled = false
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then for _, t in ipairs(animator:GetPlayingAnimationTracks()) do pcall(function() t:Stop() end) end end
        for slot, path in pairs(SLOTS) do
            local id = M.current[slot]
            if id then
                local obj = resolve(animate, path)
                if obj and obj:IsA("Animation") then obj.AnimationId = id end
            end
        end
        animate.Enabled = true
    end
    function M.applyPackage(name)
        if not name or not Packages[name] then return end
        M.current = {}
        for k, v in pairs(Packages[name]) do M.current[k] = v end
        if M.enabled then apply() end
    end
    function M.setSlot(slot, id)
        if not slot then return end
        if not id or id == "" then M.current[slot] = nil
        else
            if not id:find("rbxassetid://") then id = "rbxassetid://" .. id end
            M.current[slot] = id
        end
        if M.enabled then apply() end
    end
    function M.reset()
        M.current = {}
        if not M.saved then saveOriginals() end
        if M.enabled then
            local animate = getAnimate()
            if animate then
                animate.Enabled = false
                for slot, path in pairs(SLOTS) do
                    if M.orig[slot] then local obj = resolve(animate, path); if obj and obj:IsA("Animation") then obj.AnimationId = M.orig[slot] end end
                end
                animate.Enabled = true
            end
        end
    end
    function M.setEnabled(v)
        M.enabled = v and true or false
        if M.enabled then if not M.saved then saveOriginals() end; apply()
        else M.reset() end
    end
    LP.CharacterAdded:Connect(function() if M.enabled then task.wait(0.5); M.saved = false; saveOriginals(); apply() end end)
    M.Packages = Packages
    return M
end)()

--auto buy
local AutoBuyState = { AutoFood=false, SelectedFood="[Chicken]", AutoArmor=false, SelectedArmor="[Medium Armor]", AutoGun=false, SelectedGun="[Silencer]" }
local function SafeFireClickDetector(padName)
    if not padName then return false end
    local function tryClick(obj) if not obj then return false end; local det = obj:FindFirstChildOfClass("ClickDetector") or obj:FindFirstChildWhichIsA("ClickDetector"); if det then pcall(function() fireclickdetector(det) end); return true end; return false end
    local map = Workspace:FindFirstChild("MAP")
    if map then
        for _, group in ipairs({ "Pads","Shops","Shop","Items" }) do
            local g = map:FindFirstChild(group)
            if g then local pad = g:FindFirstChild(padName); if tryClick(pad) then return true end end
        end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do if obj.Name == padName and tryClick(obj) then return true end end
    return false
end
task.spawn(function()
    while task.wait(0.5) do
        pcall(SafeFireClickDetector, AutoBuyState.AutoFood and AutoBuyState.SelectedFood or nil)
        pcall(SafeFireClickDetector, AutoBuyState.AutoArmor and AutoBuyState.SelectedArmor or nil)
        pcall(SafeFireClickDetector, AutoBuyState.AutoGun and AutoBuyState.SelectedGun or nil)
    end
end)

--auto stomp
local StompState = { Enabled=false, Mode="normal" }
local stompLastFire, stompFirstFired = 0, false
RunService.RenderStepped:Connect(function()
    if StompState.Enabled then
        local remote = ReplicatedStorage:FindFirstChild("MAINEVENT") or ReplicatedStorage:FindFirstChild("MainEvent")
        if remote then
            if StompState.Mode == "normal" then
                if not stompFirstFired then pcall(function() remote:FireServer("STOMP") end); stompLastFire, stompFirstFired = tick(), true
                elseif tick() - stompLastFire >= 0.8 then pcall(function() remote:FireServer("STOMP") end); stompLastFire = tick() end
            else if tick() - stompLastFire >= 0.05 then pcall(function() remote:FireServer("STOMP") end); stompLastFire = tick() end end
        end
    else stompFirstFired = false end
end)

--auto reload
local AutoReloadState = { Enabled=false }
RunService.RenderStepped:Connect(function()
    if not AutoReloadState.Enabled then return end
    local char = LP.Character; if not char then return end
    local tool = char:FindFirstChildOfClass("Tool"); if not tool then return end
    local ammo = tool:FindFirstChild("AMMO")
    if ammo and ammo.Value <= 0 then local rl = tool:FindFirstChild("rl"); if rl then pcall(function() rl:FireServer() end) end end
end)

--anti stomp
local AntiStompState = { Enabled=false }
local antiStompResetting = false
local function antiStomp_OnCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 5); if not humanoid then return end
    antiStompResetting = false
    humanoid.HealthChanged:Connect(function(health)
        if not AntiStompState.Enabled or antiStompResetting then return end
        if health >= 1 and health <= 20 then
            antiStompResetting = true; task.wait(0.1)
            if humanoid.Parent and humanoid.Health > 0 then pcall(function() humanoid.Health = 0 end) end
            antiStompResetting = false
        end
    end)
end
LP.CharacterAdded:Connect(antiStomp_OnCharacter)
if LP.Character then antiStomp_OnCharacter(LP.Character) end


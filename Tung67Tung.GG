local selTarget = { Player = nil }
local targetAvatarSection = TargetTab:Section("profile", 1)

local targetAvatarFrame = Instance.new("Frame")
targetAvatarFrame.Size = UDim2.new(1, 0, 0, 130)
targetAvatarFrame.BackgroundTransparency = 1

local targetAvatar = Instance.new("ImageLabel")
targetAvatar.Size = UDim2.new(0, 120, 0, 120)
targetAvatar.Position = UDim2.new(0.5, -60, 0, 0)
targetAvatar.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
targetAvatar.BackgroundTransparency = 0
targetAvatar.BorderSizePixel = 0
targetAvatar.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
targetAvatar.ScaleType = Enum.ScaleType.Crop
targetAvatar.Parent = targetAvatarFrame
Instance.new("UICorner", targetAvatar).CornerRadius = UDim.new(0, 12)

pcall(function()
    targetAvatarSection:AddUIPassthrough("TargetAvatarView", { Instance = targetAvatarFrame, Height = 130 })
end)

local targetHeaderLabel = targetAvatarSection:Label("no target selected")
local targetHealthLabel = targetAvatarSection:Label("health: — | dist: —")
local targetArmorLabel  = targetAvatarSection:Label("armor: —")
local targetStateLabel  = targetAvatarSection:Label("status: —")

local searchState = { query = "" }
TargetTab:Section("search", 2):Search({ Placeholder = "username", Label = "search", Live = true, Callback = function(text) searchState.query = text end })

local function FindPlayer(query)
    if not query or query == "" then return nil end
    local q = string.lower(query)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then
            local name, display = string.lower(plr.Name), string.lower(plr.DisplayName or plr.Name)
            if name == q or display == q or string.find(name, q, 1, true) or string.find(display, q, 1, true) then return plr end
        end
    end
    return nil
end

TargetTab:Section("actions", 2):ButtonRow({
    { Text = "find", Callback = function()
        local plr = FindPlayer(searchState.query)
        if plr then selTarget.Player = plr; notify("target", "found " .. plr.Name, "success")
        else selTarget.Player = nil; notify("target", "not found", "error") end
    end },
    { Text = "clear", Callback = function() selTarget.Player = nil; notify("target", "cleared", "warn") end },
})

-- live updater for the profile group
task.spawn(function()
    local lastUserId = nil
    while task.wait(0.25) do
        pcall(function()
            local p = selTarget.Player

            if p and p.Parent and p.UserId then
                if p.UserId ~= lastUserId then
                    lastUserId = p.UserId
                    loadAvatar(targetAvatar, p.UserId)
                end

                targetHeaderLabel:SetName("Target selected !")

                local char = p.Character
                if char then
                    local hum    = char:FindFirstChildOfClass("Humanoid")
                    local myHRP  = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
                    local hrp    = char:FindFirstChild("HumanoidRootPart")

                    local hp     = hum and math.floor(hum.Health)    or 0
                    local maxHp  = hum and math.floor(hum.MaxHealth) or 100
                    local dist   = (myHRP and hrp) and math.floor((myHRP.Position - hrp.Position).Magnitude) or 0

                    -- Armor (text only, no bar)
                    local armorData = ArmorModule.get(p)
                    local armorCur  = armorData and math.floor(armorData.current) or 0
                    local armorMax  = armorData and math.floor(armorData.max)     or 200

                    -- Status logic
                    local status
                    if hp <= 0 then
                        status = "Bozo Died"
                    elseif hp <= 20 then
                        status = "Knocked"
                    else
                        status = "Alive"
                    end

                    targetHealthLabel:SetName("health: " .. hp .. "/" .. maxHp .. " | dist: " .. dist)
                    targetArmorLabel:SetName("armor: "  .. armorCur .. "/" .. armorMax)
                    targetStateLabel:SetName("status: " .. status)
                else
                    targetHealthLabel:SetName("health: — | dist: —")
                    targetArmorLabel:SetName("armor: —")
                    targetStateLabel:SetName("status: —")
                end
            else
                if lastUserId ~= nil then
                    lastUserId = nil
                    targetAvatar.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
                end
                targetHeaderLabel:SetName("no target selected")
                targetHealthLabel:SetName("health: — | dist: —")
                targetArmorLabel:SetName("armor: —")
                targetStateLabel:SetName("status: —")
            end
        end)
    end
end)

local spectateActive = false
local spectateConn = nil
local function stopSpectate()
    spectateActive = false
    if spectateConn then spectateConn:Disconnect(); spectateConn = nil end
    local cam = Workspace.CurrentCamera
    local myHum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if cam and myHum then cam.CameraSubject = myHum; cam.CameraType = Enum.CameraType.Custom end
end
local function startSpectate()
    if spectateConn then return end
    spectateActive = true
    spectateConn = RunService.RenderStepped:Connect(function()
        if not spectateActive then return end
        local p = selTarget.Player
        if not p or not p.Parent then stopSpectate(); return end
        local char = p.Character; if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local subj = (hum and hum.Health > 0) and hum or char:FindFirstChild("Head")
        if subj and Workspace.CurrentCamera.CameraSubject ~= subj then Workspace.CurrentCamera.CameraSubject = subj end
    end)
end
local utilSec = TargetTab:Section("utility", 2)
utilSec:Toggle({
    Text = "spectate", Flag = "target_spectate", Default = false,
    Callback = function(v)
        if v then
            if not selTarget.Player then notify("spectate", "select a target first", "warn"); return end
            startSpectate()
            notify("spectate", "watching " .. selTarget.Player.Name, "success")
        else
            stopSpectate()
            notify("spectate", "stopped", "warn")
        end
    end,
})
utilSec:Button({
    Text = "teleport",
    Callback = function()
        local p = selTarget.Player; if not p or not p.Character then return end
        local myChar = LP.Character; if not myChar then return end
        local myHRP = myChar:FindFirstChild("HumanoidRootPart")
        local tgtHRP = p.Character:FindFirstChild("HumanoidRootPart")
        if not myHRP or not tgtHRP then return end
        myHRP.CFrame = CFrame.new(tgtHRP.Position + tgtHRP.CFrame.LookVector * -3)
        notify("teleport", "to " .. p.Name, "success")
    end,
})
utilSec:Toggle({
    Text = "Auto kill", Flag = "target_autokill", Default = false,
    Callback = function(v)
        if v then
            if selTarget.Player then
                AutoKill.setTargetName(selTarget.Player.Name)
            else
                AutoKill.setTargetName(nil)
                notify("auto kill", "no target selected — using nearest", "warn")
            end
            AutoKill.setEnabled(true)
            notify("auto kill", "enabled", "success")
        else
            AutoKill.setEnabled(false)
            notify("auto kill", "disabled", "warn")
        end
    end,
})
utilSec:Toggle({
    Text = "Fling", Flag = "target_fling", Default = false,
    Callback = function(v)
        if v then
            if selTarget.Player then
                Fling.setTargetName(selTarget.Player.Name)
            else
                Fling.setTargetName(nil)
                notify("fling", "select a target first", "warn")
                if Toggles and Toggles.target_fling then Toggles.target_fling:SetValue(false) end
                return
            end
            Fling.setEnabled(true)
            notify("fling", "enabled on " .. selTarget.Player.Name, "success")
        else
            Fling.setEnabled(false)
            notify("fling", "disabled", "warn")
        end
    end,
})


--crispy.gg — full
if _G.CRISPY_LOADED then return end
_G.CRISPY_LOADED = true
pcall(function() if setfpscap then setfpscap(240) end end)
repeat task.wait() until game:IsLoaded()

local Players           = game:GetService("Players")
local RunService        = game:GetService("RunService")
local Workspace         = game:GetService("Workspace")
local UIS               = game:GetService("UserInputService")
local GuiService        = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService      = game:GetService("TweenService")
local Lighting          = game:GetService("Lighting")
local LP                = Players.LocalPlayer
local Camera            = Workspace.CurrentCamera
local player, camera, workspace = LP, Camera, Workspace
local UserInputService = UIS

local CoreGui
pcall(function() if gethui then CoreGui = gethui() end end)
CoreGui = CoreGui or game:GetService("CoreGui")

hookmetamethod    = hookmetamethod    or function() return function() end end
newcclosure       = newcclosure       or function(f) return f end
checkcaller       = checkcaller       or function() return false end
getnamecallmethod = getnamecallmethod or function() return "" end

--library
local BASE = "https://raw.githubusercontent.com/FacilityHUB/UI-Facility/refs/heads/main/"
local source = game:HttpGet(BASE .. "main.luau")
local Library = loadstring(source)()
assert(type(Library) == "table", "ui library failed to load")
Library.BaseUrl = BASE

--save manager
local SaveManager = {}
local SM = { Library = Library, Folder = "crispy.gg/game", Ignore = {}, AutoloadFile = "autoload.txt" }
local FS = Library.FileSystem
function SaveManager:SetLibrary(lib) SM.Library = lib end
function SaveManager:SetFolder(folder) SM.Folder = folder; Library:BuildFolders(folder) end
function SaveManager:SetIgnoreIndexes(list) SM.Ignore = list or {} end
function SaveManager:IgnoreThemeSettings() end
function SaveManager:GetConfigPath(name) return SM.Folder .. "/configs/" .. tostring(name) .. ".json" end
function SaveManager:GetAutoloadPath() return SM.Folder .. "/settings/" .. SM.AutoloadFile end
function SaveManager:Save(name)
    if not name or name == "" then return false end
    local data = SM.Library:GetConfig(SM.Ignore)
    local ok, encoded = pcall(function() return game:GetService("HttpService"):JSONEncode(data) end)
    if not ok then return false end
    Library:BuildFolders(SM.Folder); Library:BuildFolders(SM.Folder .. "/configs")
    FS:Write(self:GetConfigPath(name), encoded); return true
end
function SaveManager:Load(name)
    if not name or name == "" then return false end
    local raw = FS:Read(self:GetConfigPath(name)); if not raw then return false end
    local ok, data = pcall(function() return game:GetService("HttpService"):JSONDecode(raw) end)
    if not ok or type(data) ~= "table" then return false end
    SM.Library:LoadConfig(data, SM.Ignore); return true
end
function SaveManager:Delete(name) if not name or name == "" then return false end; FS:Delete(self:GetConfigPath(name)); return true end
function SaveManager:List()
    local files = FS:List(SM.Folder .. "/configs"); local out = {}
    for _, f in ipairs(files) do local nm = string.match(f, "^(.+)%.json$"); if nm then table.insert(out, nm) end end
    table.sort(out); return out
end
function SaveManager:RefreshConfigList() end
function SaveManager:GetConfigList() return self:List() end
function SaveManager:SetAutoloadConfig(name)
    Library:BuildFolders(SM.Folder); Library:BuildFolders(SM.Folder .. "/settings")
    FS:Write(self:GetAutoloadPath(), tostring(name or "")); return true
end
function SaveManager:GetAutoload()
    local raw = FS:Read(self:GetAutoloadPath()); if not raw or raw == "" then return nil end
    return raw
end
function SaveManager:ClearAutoload() return self:SetAutoloadConfig("") end
function SaveManager:LoadAutoloadConfig()
    local name = self:GetAutoload(); if not name or name == "" then return false end
    return self:Load(name)
end
Library.SaveManager = SaveManager

local InterfaceManager = Library.InterfaceManager
local ThemeManager = Library.ThemeManager

local WHITE       = Color3.fromRGB(255, 255, 255)
local DARK_PURPLE = Color3.fromRGB(80, 15, 120)

--notify helper
local function notify(title, text, kind)
    pcall(function()
        if kind == "success" and Library.Success then
            Library:Success(title, text, 3)
        elseif kind == "warn" and Library.Warn then
            Library:Warn(title, text, 3)
        elseif kind == "error" and Library.Error then
            Library:Error(title, text, 3)
        else
            Library:Notify({ Title = title, Text = text, Duration = 3 })
        end
    end)
end

--avatar helper
local function loadAvatar(imageLabel, userId)
    task.spawn(function()
        local ok, url = pcall(function()
            return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
        end)
        if ok and url then
            imageLabel.Image = url
        else
            imageLabel.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(userId) .. "&w=420&h=420"
        end
    end)
end

local HitParts = {
    "head","neck","uppertorso","lowertorso","leftupperarm","leftlowerarm","lefthand",
    "rightupperarm","rightlowerarm","righthand","leftupperleg","leftlowerleg","leftfoot",
    "rightupperleg","rightlowerleg","rightfoot","humanoidrootpart","closest part",
}
local HITPART_MAP = {
    ["head"]="Head",["neck"]="Neck",["uppertorso"]="UpperTorso",["lowertorso"]="LowerTorso",
    ["leftupperarm"]="LeftUpperArm",["leftlowerarm"]="LeftLowerArm",["lefthand"]="LeftHand",
    ["rightupperarm"]="RightUpperArm",["rightlowerarm"]="RightLowerArm",["righthand"]="RightHand",
    ["leftupperleg"]="LeftUpperLeg",["leftlowerleg"]="LeftLowerLeg",["leftfoot"]="LeftFoot",
    ["rightupperleg"]="RightUpperLeg",["rightlowerleg"]="RightLowerLeg",["rightfoot"]="RightFoot",
    ["humanoidrootpart"]="HumanoidRootPart",["closest part"]="Closest Part",
}
local CLOSEST_PART_NAMES = {"Head","Neck","UpperTorso","LowerTorso","HumanoidRootPart","LeftUpperArm","RightUpperArm","LeftLowerArm","RightLowerArm","LeftHand","RightHand","LeftUpperLeg","RightUpperLeg","LeftLowerLeg","RightLowerLeg","LeftFoot","RightFoot"}
local function ResolveClosestPart(character, requestedPart)
    if not character then return nil end
    if requestedPart ~= "Closest Part" then
        return character:FindFirstChild(requestedPart) or character:FindFirstChild("HumanoidRootPart")
    end
    local camPos = Camera.CFrame.Position
    local best, bestDist = nil, math.huge
    for _, name in ipairs(CLOSEST_PART_NAMES) do
        local part = character:FindFirstChild(name)
        if part then
            local d = (part.Position - camPos).Magnitude
            if d < bestDist then bestDist = d; best = part end
        end
    end
    return best or character:FindFirstChild("HumanoidRootPart")
end
local dot_gradient_ref = nil

--aimlock
local Aimlock = (function()
    local M = {
        enabled = false, initialized = false, onStateChange = nil, onLockChange = nil,
        lockKey = Enum.KeyCode.Insert,
        state = { locked_target = nil, isTargetting = false, predicted_position = Vector3.new(1,1,1) },
        camlock = true, camSmooth = true, camSmoothValue = 1,
        autoAir = true, autoAirDelay = 0.2,
    }
    local lastAutoAir = 0
    local Settings = {
        HPrediction = 0.134, VPrediction = 0.134,
        AimPart = "Head", MaxDistance = 500, LookConeDot = 0.90,
        UseChecks = true,
        Checks = { Knocked = true, Grabbed = true, Friend = false, Wall = false, Vehicle = false },
        AntiGroundShots = true, AntiGroundMult = 0.2,
        ShowTargetDot = true,
        TargetDotColor = WHITE, TargetDotColor2 = WHITE,
        TargetDotSize = 12, TargetDotOffset = 1.2,
    }
    local game_support = {
        [2788229376]={Remote="MainEvent",Argument="UpdateMousePosI"},[12238627497]={Remote="MainEvent",Argument="UpdateMousePos"},
        [5602055394]={Remote="MAINEVENT",Argument="MousePos"},[17403265390]={Remote="MAINEVENT",Argument="MOUSE"},
        [17403166075]={Remote="MAINEVENT",Argument="MOUSE"},[18111448661]={Remote="MAINEVENT",Argument="MOUSE"},
        [15186202290]={Remote="MAINEVENT",Argument="MOUSE"},[11143225577]={Remote="MAINEVENT",Argument="UpdateMousePos"},
        [15763494605]={Remote="MAINEVENT",Argument="MOUSE"},[15166543806]={Remote="MAINEVENT",Argument="MoonUpdateMousePos"},
        [17897702920]={Remote="MainEvent",Argument="UpdateMousePos"},[16033173781]={Remote="MainEvent",Argument="UpdateMousePos1"},
        [7213786345]={Remote="MainEvent",Argument="UpdateMousePosI"},[9825515356]={Remote="MainEvent",Argument="MousePosUpdate"},
        [16859411452]={Remote="MainEvent",Argument="UpdateMousePos"},[14277620939]={Remote="MainEvent",Argument="UpdateMousePos"},
    }
    local remote, mouse_argument
    do
        local cfg = game_support[game.PlaceId]
        if cfg then remote = ReplicatedStorage:FindFirstChild(cfg.Remote); mouse_argument = cfg.Argument
        else
            for _, name in ipairs({"MainEvent","MAINEVENT","Main","Remote"}) do
                local r = ReplicatedStorage:FindFirstChild(name)
                if r and r:IsA("RemoteEvent") then remote = r; mouse_argument = "MOUSE"; break end
            end
        end
    end
    local function has_char(p) return p and p.Character and p.Character:FindFirstChild("Humanoid") ~= nil end
    local function is_knocked(p) if not has_char(p) then return false end; local be = p.Character:FindFirstChild("BodyEffects"); if not be then return false end; local ko = be:FindFirstChild("K.O"); return ko and ko.Value or false end
    local function is_grabbed(p) if not has_char(p) then return false end; return p.Character:FindFirstChild("GRABBING_CONSTRAINT") ~= nil end
    local function is_visible(targetChar, targetPart)
        if not targetChar or not targetPart then return false end
        local origin = Camera.CFrame.Position; local dir = targetPart.Position - origin
        if dir.Magnitude < 0.1 then return true end
        local params = RaycastParams.new()
        local ok = pcall(function() params.FilterType = Enum.RaycastFilterType.Exclude end)
        if not ok then pcall(function() params.FilterType = Enum.RaycastFilterType.Blacklist end) end
        local exclude = { Camera, targetChar }
        if LP.Character then table.insert(exclude, LP.Character); for _, d in ipairs(LP.Character:GetDescendants()) do table.insert(exclude, d) end end
        for _, d in ipairs(targetChar:GetDescendants()) do table.insert(exclude, d) end
        params.FilterDescendantsInstances = exclude; params.IgnoreWater = true
        local result = Workspace:Raycast(origin, dir, params)
        if not result then return true end
        return result.Instance and result.Instance:IsDescendantOf(targetChar) or false
    end
    local function is_in_air(p)
        if not has_char(p) then return false end
        local root = p.Character:FindFirstChild("HumanoidRootPart")
        return root and math.abs(root.AssemblyLinearVelocity.Y) > 1 or false
    end
    local function get_target_in_look_direction()
        if not has_char(LP) then return nil end
        local myRoot = LP.Character:FindFirstChild("HumanoidRootPart"); if not myRoot then return nil end
        local camCF, lookDir = Camera.CFrame, Camera.CFrame.LookVector
        local best, bestDot = nil, Settings.LookConeDot
        for _, p in ipairs(Players:GetPlayers()) do
            if p == LP then continue end
            if not has_char(p) then continue end
            local head = ResolveClosestPart(p.Character, Settings.AimPart); if not head then continue end
            if (head.Position - myRoot.Position).Magnitude > Settings.MaxDistance then continue end
            if Settings.UseChecks then
                if Settings.Checks.Knocked and is_knocked(p) then continue end
                if Settings.Checks.Grabbed and is_grabbed(p) then continue end
                if Settings.Checks.Friend  and p:IsFriendsWith(LP.UserId) then continue end
                if Settings.Checks.Vehicle and p.Character:FindFirstChild("[CarHitBox]") then continue end
            end
            if Settings.Checks.Wall and not is_visible(p.Character, head) then continue end
            local dir = head.Position - camCF.Position
            if dir.Magnitude < 0.01 then continue end
            local dot = lookDir:Dot(dir.Unit)
            if dot > bestDot then bestDot = dot; best = p end
        end
        return best
    end
    local function get_predicted_position()
        local target = M.state.locked_target
        if not has_char(target) then return Vector3.new(0, 0, 0) end
        local aimPart = ResolveClosestPart(target.Character, Settings.AimPart)
        if not aimPart then return Vector3.new(0, 0, 0) end
        local pos, vel = aimPart.Position, aimPart.AssemblyLinearVelocity
        if Settings.AntiGroundShots and is_in_air(target) then
            vel = Vector3.new(vel.X, math.abs(vel.Y * Settings.AntiGroundMult), vel.Z)
        end
        return Vector3.new(pos.X + vel.X * Settings.HPrediction, pos.Y + vel.Y * Settings.VPrediction, pos.Z)
    end
    local dot_frame
    local function ensure_dot()
        if dot_frame and dot_frame.Parent then return end
        local gui = LP:FindFirstChild("PlayerGui"); if not gui then return end
        local sg = gui:FindFirstChild("DaLockGui")
        if not sg then
            sg = Instance.new("ScreenGui"); sg.Name = "DaLockGui"; sg.ResetOnSpawn = false
            sg.IgnoreGuiInset = true; sg.DisplayOrder = 999; sg.Parent = gui
        end
        dot_frame = Instance.new("Frame")
        dot_frame.AnchorPoint = Vector2.new(0.5, 0.5)
        dot_frame.Size = UDim2.new(0, Settings.TargetDotSize, 0, Settings.TargetDotSize)
        dot_frame.BackgroundColor3 = WHITE; dot_frame.BorderSizePixel = 0
        dot_frame.Visible = false; dot_frame.ZIndex = 50; dot_frame.Parent = sg
        Instance.new("UICorner", dot_frame).CornerRadius = UDim.new(1, 0)
        local gradient = Instance.new("UIGradient")
        gradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, Settings.TargetDotColor2),
            ColorSequenceKeypoint.new(0.50, Settings.TargetDotColor),
            ColorSequenceKeypoint.new(1.00, Settings.TargetDotColor),
        })
        gradient.Rotation = 45; gradient.Parent = dot_frame; dot_gradient_ref = gradient
    end
    local function do_lock()
        if not M.enabled then return end
        local target = get_target_in_look_direction()
        if target then
            M.state.locked_target = target
            M.state.isTargetting = true
            if M.onLockChange then pcall(M.onLockChange, true, target) end
        else
            M.state.locked_target = nil
            M.state.isTargetting = false
            if M.onLockChange then pcall(M.onLockChange, false, nil) end
        end
    end
    local function do_unlock()
        local had = M.state.locked_target ~= nil
        M.state.locked_target = nil
        M.state.isTargetting = false
        if dot_frame then dot_frame.Visible = false end
        if had and M.onLockChange then pcall(M.onLockChange, false, nil) end
    end
    function M.toggleLock() if not M.enabled then return end; if M.state.locked_target then do_unlock() else do_lock() end end
    local function install_hook()
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod(); local args = { ... }
            if not checkcaller() and method == "FireServer" and typeof(args[1]) == "string" and typeof(args[2]) == "Vector3" then
                if M.enabled and M.state.isTargetting and M.state.locked_target then args[2] = M.state.predicted_position end
                return old(self, table.unpack(args))
            end
            return old(self, ...)
        end))
    end
    local function hook_gun(character)
        if not character then return end
        character.ChildAdded:Connect(function(tool)
            if not tool:IsA("Tool") then return end
            tool.Activated:Connect(function()
                if M.enabled and M.state.isTargetting and M.state.locked_target and remote and mouse_argument then
                    pcall(function() remote:FireServer(mouse_argument, M.state.predicted_position) end)
                end
            end)
        end)
    end
    local function init()
        if M.initialized then return end
        M.initialized = true; ensure_dot(); install_hook()
        if LP.Character then hook_gun(LP.Character) end
        LP.CharacterAdded:Connect(hook_gun)
        UIS.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputState ~= Enum.UserInputState.Begin then return end
            if input.KeyCode == M.lockKey then M.toggleLock() end
        end)
        RunService.RenderStepped:Connect(function()
            if not M.enabled then if dot_frame then dot_frame.Visible = false end; return end
            if M.state.locked_target and not M.state.locked_target.Parent then do_unlock() end
            if M.state.locked_target and not has_char(M.state.locked_target) then do_unlock() end
            if not M.state.locked_target then if dot_frame then dot_frame.Visible = false end; return end
            M.state.isTargetting = true; M.state.predicted_position = get_predicted_position()
            if M.camlock then
                local goal = CFrame.new(Camera.CFrame.Position, M.state.predicted_position)
                if M.camSmooth then Camera.CFrame = Camera.CFrame:Lerp(goal, M.camSmoothValue)
                else Camera.CFrame = goal end
            end
        end)
        pcall(function()
            RunService:BindToRenderStep("CrispyAimlockDot", Enum.RenderPriority.Camera.Value + 1, function()
                if not M.enabled or not dot_frame then if dot_frame then dot_frame.Visible = false end; return end
                if not M.state.locked_target or not has_char(M.state.locked_target) then dot_frame.Visible = false; return end
                if Settings.ShowTargetDot then
                    local head = ResolveClosestPart(M.state.locked_target.Character, Settings.AimPart)
                    if head then
                        local above = head.Position + Vector3.new(0, Settings.TargetDotOffset, 0)
                        local sp, on = Camera:WorldToViewportPoint(above)
                        if on and sp.Z > 0 then dot_frame.Visible = true; dot_frame.Position = UDim2.new(0, sp.X, 0, sp.Y)
                        else dot_frame.Visible = false end
                    else dot_frame.Visible = false end
                end
            end)
        end)
        RunService.Heartbeat:Connect(function()
            if not M.enabled or not M.autoAir then return end
            local t = M.state.locked_target
            if not has_char(t) then return end
            local hum = t.Character:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            local ok, st = pcall(function() return hum:GetState() end)
            local airborne = ok and (st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall or hum.FloorMaterial == Enum.Material.Air)
            if not airborne then return end
            if tick() - lastAutoAir < M.autoAirDelay then return end
            lastAutoAir = tick()
            local char = LP.Character; if not char then return end
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then pcall(function() tool:Activate() end) end
        end)
    end
    function M.setEnabled(state)
        M.enabled = state and true or false
        if M.enabled then init(); do_lock() else do_unlock() end
        if M.onStateChange then pcall(M.onStateChange, M.enabled) end
    end
    function M.setHPrediction(v) Settings.HPrediction = tonumber(v) or Settings.HPrediction end
    function M.setVPrediction(v) Settings.VPrediction = tonumber(v) or Settings.VPrediction end
    function M.setAimPart(part) Settings.AimPart = part end
    function M.setWallCheck(v) Settings.Checks.Wall = v and true or false end
    function M.setCamlock(v) M.camlock = v and true or false end
    function M.setCamSmooth(v) M.camSmooth = v and true or false end
    function M.setCamSmoothValue(v) M.camSmoothValue = math.clamp(tonumber(v) or M.camSmoothValue, 0.01, 1) end
    function M.setAutoAir(v) M.autoAir = v and true or false end
    function M.setAutoAirDelay(v) M.autoAirDelay = tonumber(v) or M.autoAirDelay end
    M.Settings = Settings
    return M
end)()

--silent aim
local SilentAimPrediction = (function()
    local M = { enabled=false, hookInstalled=false,
        state = { target=nil, isTargetting=false, predicted_position=Vector3.new(1,1,1) },
        ghost_model=nil, ghost_owner=nil }
    local FOV_RADIUS_MULT, H_PREDICTION, V_PREDICTION = 1.5, 0.134, 0.134
    local FOV_BASE, FOV_TRANSPARENCY = 80, 0.5
    local AIM_PART, WALLCHECK = "Head", false
    local FOV_VISIBLE, FOV_INNER_COLOR, FOV_OUTER_COLOR = true, WHITE, WHITE
    local game_support = {
        [2788229376]={Remote="MainEvent",Argument="UpdateMousePosI"},[12238627497]={Remote="MainEvent",Argument="UpdateMousePos"},
        [5602055394]={Remote="MAINEVENT",Argument="MousePos"},[17403265390]={Remote="MAINEVENT",Argument="MOUSE"},
        [17403166075]={Remote="MAINEVENT",Argument="MOUSE"},[18111448661]={Remote="MAINEVENT",Argument="MOUSE"},
        [15186202290]={Remote="MAINEVENT",Argument="MOUSE"},[11143225577]={Remote="MAINEVENT",Argument="UpdateMousePos"},
        [15763494605]={Remote="MAINEVENT",Argument="MOUSE"},[15166543806]={Remote="MAINEVENT",Argument="MoonUpdateMousePos"},
        [17897702920]={Remote="MainEvent",Argument="UpdateMousePos"},[16033173781]={Remote="MainEvent",Argument="UpdateMousePos1"},
        [7213786345]={Remote="MainEvent",Argument="UpdateMousePosI"},[9825515356]={Remote="MainEvent",Argument="MousePosUpdate"},
        [16859411452]={Remote="MainEvent",Argument="UpdateMousePos"},[14277620939]={Remote="MainEvent",Argument="UpdateMousePos"},
    }
    local game_config = game_support[game.PlaceId]
    local remote, mouse_argument
    if game_config then remote = ReplicatedStorage:FindFirstChild(game_config.Remote); mouse_argument = game_config.Argument
    else
        for _, name in ipairs({"MainEvent","MAINEVENT","Main","Remote"}) do
            local r = ReplicatedStorage:FindFirstChild(name)
            if r and r:IsA("RemoteEvent") then remote = r; mouse_argument = "MOUSE"; break end
        end
    end
    local drawings
    local function ensureDrawings()
        if drawings then return end
        local ok, Drawing = pcall(function() return loadstring(game:HttpGet("https://raw.githubusercontent.com/linemaster2/storage/main/Drawing.lua"))() end)
        if not ok or not Drawing then return end
        local function mkC(filled, color, radius)
            local c = Drawing.new("Circle"); c.Visible, c.Filled, c.Color, c.NumSides = false, filled, color, 64
            c.Radius = radius or 1; return c
        end
        drawings = { fov_outside=mkC(false,DARK_PURPLE), fov_inside=mkC(true,DARK_PURPLE),
            tracer=Drawing.new("Line"), center_dot=mkC(true,DARK_PURPLE,4),
            pm_outline=mkC(false,WHITE,5), pm_fill=mkC(true,DARK_PURPLE,5) }
        drawings.tracer.Visible = false
    end
    local function screen_center() local vp = camera.ViewportSize; return Vector2.new(vp.X/2, vp.Y/2) end
    local function has_char(p) return p and p.Character and p.Character:FindFirstChild("Humanoid") ~= nil end
    local function w2s(pos) local p, on = camera:WorldToViewportPoint(pos); return Vector2.new(p.X, p.Y), on end
    local function is_knocked(p) if not has_char(p) then return false end; local be = p.Character:FindFirstChild("BodyEffects"); if not be then return false end; local ko = be:FindFirstChild("K.O"); return ko and ko.Value or false end
    local function is_grabbed(p) if not has_char(p) then return false end; return p.Character:FindFirstChild("GRABBING_CONSTRAINT") ~= nil end
    local function get_closest_player()
        local center = screen_center(); local radius = FOV_BASE * FOV_RADIUS_MULT; local closest
        for _, p in ipairs(Players:GetPlayers()) do
            if p == player then continue end
            if not has_char(p) then continue end
            local part = ResolveClosestPart(p.Character, AIM_PART); if not part then continue end
            local sp, on = w2s(part.Position); if not on then continue end
            if is_knocked(p) or is_grabbed(p) then continue end
            local d = (center - sp).Magnitude
            if d <= radius then radius = d; closest = p end
        end
        return closest
    end
    local function get_predicted_position()
        local target = M.state.target
        if not target or not has_char(target) then return Vector3.new(0, 0, 0) end
        local aim_part = ResolveClosestPart(target.Character, AIM_PART)
        if not aim_part then return Vector3.new(0, 0, 0) end
        local pos, vel = aim_part.Position, aim_part.AssemblyLinearVelocity
        return Vector3.new(pos.X + vel.X*H_PREDICTION, pos.Y + vel.Y*V_PREDICTION, pos.Z + vel.Z*H_PREDICTION)
    end
    local function cleanup_ghost() if M.ghost_model then M.ghost_model:Destroy(); M.ghost_model, M.ghost_owner = nil, nil end end
    local function build_ghost(p)
        cleanup_ghost(); if not has_char(p) then return end
        local char = p.Character; char.Archivable = true
        local clone = char:Clone(); char.Archivable = false; clone.Name = "SilentAimPredictionGhost"
        for _, obj in ipairs(clone:GetDescendants()) do
            if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("Sound") or obj:IsA("ParticleEmitter") or obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("Highlight") then obj:Destroy()
            elseif obj:IsA("BasePart") then
                obj.Anchored, obj.CanCollide, obj.CanTouch, obj.CanQuery, obj.Massless = true, false, false, false, true
                obj.Transparency = 0.85; obj.Material = Enum.Material.ForceField; obj.Color = DARK_PURPLE
            end
        end
        clone.PrimaryPart = clone:FindFirstChild("HumanoidRootPart") or clone:FindFirstChildWhichIsA("BasePart")
        clone.Parent = workspace; M.ghost_model, M.ghost_owner = clone, p
    end
    local function update_ghost(pp)
        if not M.ghost_model or not M.state.target then return end
        if M.ghost_owner ~= M.state.target then build_ghost(M.state.target); if not M.ghost_model then return end end
        local real_hrp = M.state.target.Character:FindFirstChild("HumanoidRootPart"); if not real_hrp then return end
        M.ghost_model:PivotTo(CFrame.new(pp) * (real_hrp.CFrame - real_hrp.CFrame.Position))
    end
    local function install_hook()
        if M.hookInstalled then return end; M.hookInstalled = true
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod(); local args = { ... }
            if not checkcaller() and method == "FireServer" and typeof(args[1]) == "string" and typeof(args[2]) == "Vector3" then
                if M.enabled and M.state.isTargetting and M.state.target then args[2] = M.state.predicted_position end
                return old(self, table.unpack(args))
            end
            return old(self, ...)
        end))
    end
    RunService.RenderStepped:Connect(function()
        if not M.enabled or not drawings then
            if drawings then for _, d in pairs(drawings) do d.Visible = false end end
            M.state.target, M.state.isTargetting = nil, false; cleanup_ghost(); return
        end
        local nt = get_closest_player()
        if nt ~= M.state.target then cleanup_ghost() end
        M.state.target = nt; M.state.isTargetting = nt ~= nil
        if M.state.isTargetting then
            M.state.predicted_position = get_predicted_position()
            if not M.ghost_model or M.ghost_owner ~= M.state.target then build_ghost(M.state.target) end
            update_ghost(M.state.predicted_position)
        else cleanup_ghost() end
        local center = screen_center(); local radius = FOV_BASE * FOV_RADIUS_MULT
        drawings.fov_outside.Visible = FOV_VISIBLE; drawings.fov_outside.Radius = radius
        drawings.fov_outside.Color = FOV_OUTER_COLOR; drawings.fov_outside.Position = center
        drawings.fov_inside.Visible = FOV_VISIBLE; drawings.fov_inside.Radius = radius
        drawings.fov_inside.Color = FOV_INNER_COLOR; drawings.fov_inside.Transparency = FOV_TRANSPARENCY
        drawings.fov_inside.Position = center
        drawings.center_dot.Visible, drawings.center_dot.Position = true, center
        drawings.center_dot.Color = FOV_INNER_COLOR
        if M.state.isTargetting then
            local ps, on = w2s(M.state.predicted_position)
            drawings.tracer.Visible = on; drawings.tracer.From = center; drawings.tracer.To = ps
            drawings.tracer.Color = FOV_INNER_COLOR; drawings.tracer.Thickness = 2; drawings.tracer.Transparency = 0.5
            drawings.pm_outline.Visible, drawings.pm_outline.Position = on, ps; drawings.pm_outline.Color = FOV_OUTER_COLOR
            drawings.pm_fill.Visible, drawings.pm_fill.Position = on, ps; drawings.pm_fill.Color = FOV_INNER_COLOR
            drawings.pm_fill.Transparency = 0.2
        else
            drawings.tracer.Visible = false; drawings.pm_outline.Visible = false; drawings.pm_fill.Visible = false
        end
    end)
    local function hook_gun(character)
        if not character then return end
        character.ChildAdded:Connect(function(tool)
            if tool:IsA("Tool") then
                tool.Activated:Connect(function()
                    if M.enabled and M.state.isTargetting and M.state.target and remote and mouse_argument then
                        pcall(function() remote:FireServer(mouse_argument, M.state.predicted_position) end)
                    end
                end)
            end
        end)
    end
    if player.Character then hook_gun(player.Character) end
    player.CharacterAdded:Connect(function(c) hook_gun(c); cleanup_ghost() end)
    function M.setEnabled(state)
        M.enabled = state and true or false
        if M.enabled then ensureDrawings(); install_hook()
        else cleanup_ghost(); M.state.target, M.state.isTargetting = nil, false
            if drawings then for _, d in pairs(drawings) do d.Visible = false end end
        end
    end
    function M.setAimPart(name) AIM_PART = name or "Head" end
    function M.setFOV(size) FOV_BASE = math.clamp(tonumber(size) or 80, 1, 100) end
    function M.setFOVTransparency(p) FOV_TRANSPARENCY = math.clamp((tonumber(p) or 50)/100, 0, 1) end
    function M.setHPrediction(v) H_PREDICTION = tonumber(v) or H_PREDICTION end
    function M.setVPrediction(v) V_PREDICTION = tonumber(v) or V_PREDICTION end
    function M.setWallCheck(v) WALLCHECK = v and true or false end
    function M.setFOVVisible(v) FOV_VISIBLE = v and true or false end
    function M.setFOVInnerColor(c) FOV_INNER_COLOR = c end
    function M.setFOVOuterColor(c) FOV_OUTER_COLOR = c end
    return M
end)()

--auto fire
local AutoFire = (function()
    local M = { enabled=false, initialized=false }
    local FIRE_DELAY, IGNORE_MELEE = 0.1, true
    local activeTool, lastFireTime, loopConn = nil, 0, nil
    local function is_melee_or_consumable(tool)
        if not IGNORE_MELEE then return false end
        local n = tool.Name:lower()
        return n:find("katana") or n:find("knife") or n:find("sword") or n:find("bat") or n:find("fist") or n:find("crowbar") or n:find("pizza") or n:find("donut") or n:find("cola")
    end
    local function is_gun(tool) if not tool or not tool:IsA("Tool") then return false end; if not tool:FindFirstChild("Handle") then return false end; if is_melee_or_consumable(tool) then return false end; return true end
    local function activateTool(tool) if not tool or not tool.Parent then return end; if tool.Parent ~= player.Character then return end; pcall(function() tool:Activate() end) end
    local function onEquip(tool)
        if not M.enabled then return end; if not is_gun(tool) then return end
        activeTool, lastFireTime = tool, 0; task.wait(0.05)
        if M.enabled and activeTool == tool and tool.Parent == player.Character then activateTool(tool); lastFireTime = tick() end
    end
    local function hookCharacter(character)
        if not character then return end
        character.ChildAdded:Connect(function(child) if child:IsA("Tool") then onEquip(child) end end)
        character.ChildRemoved:Connect(function(child) if child:IsA("Tool") and child == activeTool then activeTool = nil end end)
    end
    local function startLoop()
        if loopConn then return end
        loopConn = RunService.Heartbeat:Connect(function()
            if not M.enabled then return end
            if not activeTool or activeTool.Parent ~= player.Character then return end
            if tick() - lastFireTime >= FIRE_DELAY then activateTool(activeTool); lastFireTime = tick() end
        end)
    end
    local function init()
        if M.initialized then return end; M.initialized = true
        if player.Character then hookCharacter(player.Character); local already = player.Character:FindFirstChildWhichIsA("Tool"); if already then onEquip(already) end end
        player.CharacterAdded:Connect(function(char) activeTool = nil; task.wait(0.2); hookCharacter(char) end)
        startLoop()
    end
    function M.setEnabled(state)
        M.enabled = state and true or false
        if M.enabled then init()
            if player.Character then local tool = player.Character:FindFirstChildWhichIsA("Tool"); if tool and is_gun(tool) then onEquip(tool) end end
        else activeTool = nil end
    end
    function M.setFireDelay(v) FIRE_DELAY = math.clamp(tonumber(v) or 0.1, 0.01, 10) end
    return M
end)()

--rapid fire
local RapidFire = (function()
    local M = { enabled=false, initialized=false }
    local FIRE_RATE, mouseDown = 0.015, false
    local function getTool() local char = LP.Character; if not char then return nil end; return char:FindFirstChildOfClass("Tool") end
    local function activateTool() local tool = getTool(); if tool then pcall(function() tool:Activate() end) end end
    local function init()
        if M.initialized then return end; M.initialized = true
        UIS.InputBegan:Connect(function(input, gp) if gp then return end; if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseDown = true end end)
        UIS.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseDown = false end end)
        task.spawn(function()
            while true do
                if M.enabled and mouseDown then activateTool(); task.wait(FIRE_RATE)
                else task.wait(0.1) end
            end
        end)
    end
    function M.setEnabled(state) M.enabled = state and true or false; if M.enabled then init() end end
    function M.setFireRate(v) FIRE_RATE = math.clamp(tonumber(v) or 0.015, 0.005, 1) end
    return M
end)()

--triggerbot
local TriggerBot = (function()
    local M = { enabled=false, initialized=false }
    local SETTINGS = { AimRadius=20, FireDelay=0.08, HPrediction=0.155, VPrediction=0.155,
        SilentAim=true, IgnoreKnocked=true, HitPart="Head", KnifeCheck=false, ForcefieldCheck=false, KnockedCheck=false }
    local last_shot = 0
    local main_remote = ReplicatedStorage:FindFirstChild("MAINEVENT") or ReplicatedStorage:FindFirstChild("MainEvent")
    local function has_char(p) return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") end
    local function is_knocked(p) if not has_char(p) then return false end; local be = p.Character:FindFirstChild("BodyEffects"); if not be then return false end; local ko = be:FindFirstChild("K.O"); return ko and ko.Value or false end
    local function local_has_katana() if not player.Character then return false end; local tool = player.Character:FindFirstChildWhichIsA("Tool"); if not tool then return false end; return string.lower(tool.Name):find("katana", 1, true) ~= nil end
    local function has_forcefield(p) if not has_char(p) then return false end; return p.Character:FindFirstChildOfClass("ForceField") ~= nil end
    local function is_knocked_hp(p) if not has_char(p) then return false end; local hum = p.Character:FindFirstChildOfClass("Humanoid"); if not hum then return false end; return hum.Health >= 1 and hum.Health <= 20 end
    local function get_equipped_gun()
        if not player.Character then return nil end
        local tool = player.Character:FindFirstChildWhichIsA("Tool")
        if not tool or not tool:FindFirstChild("Handle") then return nil end
        return tool
    end
    local function get_aim_ray()
        if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then return camera.CFrame.Position, camera.CFrame.LookVector end
        local mousePos = UserInputService:GetMouseLocation(); local inset = GuiService:GetGuiInset()
        local ray = camera:ViewportPointToRay(mousePos.X - inset.X, mousePos.Y - inset.Y)
        return ray.Origin, ray.Direction
    end
    local function get_aim_screen_point()
        if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then return Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2) end
        local mousePos = UserInputService:GetMouseLocation(); local inset = GuiService:GetGuiInset()
        return Vector2.new(mousePos.X - inset.X, mousePos.Y - inset.Y)
    end
    local function crosshair_hits_player(p)
        if not has_char(p) then return false end
        local origin, dir = get_aim_ray()
        local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {}; if player.Character then table.insert(filter, player.Character) end
        params.FilterDescendantsInstances = filter; params.IgnoreWater = true
        local hit = workspace:Raycast(origin, dir.Unit * 1000, params)
        if not hit or not hit.Instance then return false end
        return hit.Instance:IsDescendantOf(p.Character)
    end
    local function get_aimed_player()
        local origin, dir = get_aim_ray()
        local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
        local filter = {}; if player.Character then table.insert(filter, player.Character) end
        params.FilterDescendantsInstances = filter; params.IgnoreWater = true
        local hit = workspace:Raycast(origin, dir.Unit * 1000, params)
        if hit and hit.Instance then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and has_char(p) and hit.Instance:IsDescendantOf(p.Character) then
                    if SETTINGS.IgnoreKnocked and is_knocked(p) then return nil end
                    return p
                end
            end
        end
        local aimScreen = get_aim_screen_point(); local best, bestDist = nil, math.min(SETTINGS.AimRadius, 22)
        for _, p in ipairs(Players:GetPlayers()) do
            if p == player then continue end; if not has_char(p) then continue end
            if SETTINGS.IgnoreKnocked and is_knocked(p) then continue end
            local part = ResolveClosestPart(p.Character, SETTINGS.HitPart)
            if part then
                local sp, on = camera:WorldToViewportPoint(part.Position)
                if on and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - aimScreen).Magnitude
                    if d < bestDist then bestDist, best = d, p end
                end
            end
        end
        if best and crosshair_hits_player(best) then return best end
        return nil
    end
    local function init()
        if M.initialized then return end; M.initialized = true
        RunService.Heartbeat:Connect(function()
            if not M.enabled then return end
            if tick() - last_shot < SETTINGS.FireDelay then return end
            if SETTINGS.KnifeCheck and local_has_katana() then return end
            local gun = get_equipped_gun(); if not gun then return end
            local target = get_aimed_player(); if not target then return end
            if SETTINGS.ForcefieldCheck and has_forcefield(target) then return end
            if SETTINGS.KnockedCheck and is_knocked_hp(target) then return end
            local char = target.Character; local hrp = char and char:FindFirstChild("HumanoidRootPart"); if not hrp then return end
            local aimPart = ResolveClosestPart(char, SETTINGS.HitPart) or hrp
            local pos, vel = aimPart.Position, hrp.AssemblyLinearVelocity
            local predicted = Vector3.new(pos.X + vel.X*SETTINGS.HPrediction, pos.Y + vel.Y*SETTINGS.VPrediction, pos.Z)
            last_shot = tick()
            if SETTINGS.SilentAim and main_remote then
                pcall(function() main_remote:FireServer("MOUSE", predicted) end)
                pcall(function() main_remote:FireServer("MousePos", predicted) end)
                pcall(function() main_remote:FireServer("UpdateMousePosI", predicted) end)
                pcall(function() main_remote:FireServer("UpdateMousePos", predicted) end)
            end
            pcall(function() gun:Activate() end)
        end)
    end
    function M.setEnabled(state) M.enabled = state and true or false; if M.enabled then init(); last_shot = 0 end end
    function M.setFireDelay(v) SETTINGS.FireDelay = tonumber(v) or SETTINGS.FireDelay end
    function M.setHPrediction(v) SETTINGS.HPrediction = tonumber(v) or SETTINGS.HPrediction end
    function M.setVPrediction(v) SETTINGS.VPrediction = tonumber(v) or SETTINGS.VPrediction end
    function M.setHitPart(name) SETTINGS.HitPart = name or "Head" end
    function M.setKnifeCheck(v) SETTINGS.KnifeCheck = v and true or false end
    function M.setForcefieldCheck(v) SETTINGS.ForcefieldCheck = v and true or false end
    function M.setKnockedCheck(v) SETTINGS.KnockedCheck = v and true or false end
    return M
end)()

--velocity desync
local velocityDesync = (function()
    local state = { _init = true, enabled = false, savedCFrame = nil, savedVel = nil, savedAng = nil, conns = {} }

    local function getHRP()
        local Char = LP.Character
        if not Char then return nil, nil end
        return Char:FindFirstChild("HumanoidRootPart"), Char:FindFirstChildOfClass("Humanoid")
    end

    local function restore()
        local HRP = getHRP()
        if not HRP then return end
        if state.savedCFrame then HRP.CFrame = state.savedCFrame end
        if state.savedVel then HRP.AssemblyLinearVelocity = state.savedVel end
        if state.savedAng then HRP.AssemblyAngularVelocity = state.savedAng end
    end

    local function start()
        if state.enabled then return end
        state.enabled = true

        local HRP = getHRP()
        if HRP then
            state.savedCFrame = HRP.CFrame
            state.savedVel = HRP.AssemblyLinearVelocity
            state.savedAng = HRP.AssemblyAngularVelocity
        end

        state.conns[#state.conns + 1] = RunService.Heartbeat:Connect(function()
            if not state.enabled then return end
            local HRP, Hum = getHRP()
            if not HRP or not Hum or Hum.Health <= 0 then return end

            local realCFrame = HRP.CFrame
            local realVel = HRP.AssemblyLinearVelocity
            local realAng = HRP.AssemblyAngularVelocity
            state.savedCFrame = realCFrame

            HRP.CFrame = realCFrame * CFrame.new(9e9, 0, 9e9)
            RunService.RenderStepped:Wait()

            HRP.CFrame = realCFrame
            HRP.AssemblyLinearVelocity = realVel
            HRP.AssemblyAngularVelocity = realAng
        end)

        if not state._indexHook then
            local old
            old = hookmetamethod(game, "__index", newcclosure(function(self, key)
                if not checkcaller() and state.enabled and key == "CFrame" then
                    local HRP, Hum = getHRP()
                    if HRP and Hum and Hum.Health > 0 and self == HRP and state.savedCFrame then
                        return state.savedCFrame
                    end
                end
                return old(self, key)
            end))
            state._indexHook = old
        end

        if not state._newindexHook then
            local old
            old = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
                if not checkcaller() and state.enabled then
                    local HRP = getHRP()
                    if HRP and self == HRP and (key == "AssemblyLinearVelocity" or key == "Velocity") then
                        state.savedVel = value
                    end
                end
                return old(self, key, value)
            end))
            state._newindexHook = old
        end
    end

    local function stop()
        if not state.enabled then return end
        state.enabled = false
        restore()
        for _, c in ipairs(state.conns) do
            if c and c.Disconnect then c:Disconnect() end
        end
        state.conns = {}
    end

    return function(enable)
        if enable == nil then
            if state.enabled then stop() else start() end
        elseif enable then
            start()
        else
            stop()
        end
        return state.enabled
    end
end)()

--invisible desync
local invisibleDesync = (function()
    local state = { enabled = false, lastCFrame = nil, conn = nil, hookInstalled = false }

    local function getHRP()
        local Char = LP.Character
        if not Char then return nil, nil end
        return Char:FindFirstChild("HumanoidRootPart"), Char:FindFirstChildOfClass("Humanoid")
    end

    local function start()
        if state.enabled then return end
        state.enabled = true

        if not state.conn then
            state.conn = RunService.Heartbeat:Connect(function()
                if not state.enabled then return end
                local HRP = getHRP()
                if not HRP then return end

                state.lastCFrame = HRP.CFrame
                HRP.CFrame = state.lastCFrame * CFrame.new(9e9, 0, 9e9)
                RunService.RenderStepped:Wait()
                if state.lastCFrame then HRP.CFrame = state.lastCFrame end
            end)
        end

        if not state.hookInstalled then
            state.hookInstalled = true
            local old
            old = hookmetamethod(game, "__index", newcclosure(function(self, key)
                if not checkcaller() and key == "CFrame" and state.enabled then
                    local HRP, Hum = getHRP()
                    if HRP and Hum and Hum.Health > 0 and self == HRP and state.lastCFrame then
                        return state.lastCFrame
                    end
                end
                return old(self, key)
            end))
        end
    end

    local function stop()
        if not state.enabled then return end
        state.enabled = false
        if state.conn then state.conn:Disconnect(); state.conn = nil end
    end

    return function(enable)
        if enable == nil then
            if state.enabled then stop() else start() end
        elseif enable then
            start()
        else
            stop()
        end
        return state.enabled
    end
end)()

--c-sync
local CSync = (function()
    local M = {
        config = {
            enabled          = false,
            type             = "Static Local",
            staticX          = 5,
            staticY          = 0,
            staticZ          = 5,
            randomization    = 5,
            visualize        = false,
            visualizeTracer  = true,
            visualizeChar    = false,
            visualizeColor   = DARK_PURPLE,
            originalPosition = CFrame.new(1, 1, 1),
        }
    }

    local Drawing
    do
        local ok, res = pcall(function()
            return loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/linemaster2/storage/main/Drawing.lua"
            ))()
        end)
        if ok then Drawing = res end
    end

    local tracer
    if Drawing then
        tracer = Drawing.new("Line")
        tracer.Visible   = false
        tracer.Thickness = 2
    end

    local function worldToScreen(position)
        local pos, onScreen = camera:WorldToViewportPoint(position)
        return Vector2.new(pos.X, pos.Y), onScreen
    end

    local function randomVector3(amount)
        return Vector3.new(
            math.random(-amount * 100, amount * 100) / 100,
            math.random(-amount * 100, amount * 100) / 100,
            math.random(-amount * 100, amount * 100) / 100
        )
    end

    local function cloneCharacter(plr, transparency, color, material)
        if not plr.Character then return nil end
        plr.Character.Archivable = true
        local clone = plr.Character:Clone()
        clone.Parent = Workspace
        plr.Character.Archivable = false
        for _, part in ipairs(clone:GetChildren()) do
            if part:IsA("Accessory") then
                part:Destroy()
            elseif part:IsA("BasePart") then
                part.Anchored   = true
                part.CanCollide = false
                if part:IsA("MeshPart") then
                    part.Color        = color
                    part.Material     = Enum.Material[material]
                    part.Transparency = transparency
                end
                if part.Name == "Head" then
                    local face = part:FindFirstChild("face")
                    if face then face:Destroy() end
                end
            end
        end
        return clone
    end

    local chams
    local function rebuildChams()
        if chams then chams:Destroy() end
        chams = cloneCharacter(LP, 0.7, M.config.visualizeColor, "Neon")
        if chams then
            local hrp = chams:FindFirstChild("HumanoidRootPart")
            if hrp then chams.PrimaryPart = hrp end
            chams.Parent = nil
        end
    end

    if LP.Character then rebuildChams() end
    LP.CharacterAdded:Connect(function() task.wait(1) rebuildChams() end)

    local function updateChams(desyncedCFrame, color)
        if not chams or not LP.Character then return end
        local hrp = LP.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        for _, part in ipairs(chams:GetChildren()) do
            local actualPart = LP.Character:FindFirstChild(part.Name)
            if actualPart and part:IsA("MeshPart") then
                part.CFrame = actualPart.CFrame
                part.Color  = color
            end
        end
        chams:PivotTo(desyncedCFrame)
    end

    RunService.Heartbeat:Connect(function()
        local char = LP.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")

        if not hrp or not M.config.enabled then
            if tracer then tracer.Visible = false end
            if chams  then chams.Parent   = nil    end
            return
        end

        local desyncCFrame
        local t = M.config.type
        if t == "Static Local" or t == "Static Target" then
            desyncCFrame = hrp.CFrame + Vector3.new(
                M.config.staticX, M.config.staticY, M.config.staticZ
            )
        elseif t == "Local Random" or t == "Target Random" then
            desyncCFrame = hrp.CFrame + randomVector3(M.config.randomization)
        else
            desyncCFrame = hrp.CFrame
        end

        M.config.originalPosition = hrp.CFrame

        if M.config.visualize and Drawing then
            if M.config.visualizeTracer then
                local from, fromOn = worldToScreen(hrp.Position)
                local to,   toOn   = worldToScreen(desyncCFrame.Position)
                tracer.Visible = (fromOn or toOn)
                tracer.From    = from
                tracer.To      = to
                tracer.Color   = M.config.visualizeColor
            else
                tracer.Visible = false
            end
            if M.config.visualizeChar and chams then
                chams.Parent = Workspace
                updateChams(desyncCFrame, M.config.visualizeColor)
            else
                if chams then chams.Parent = nil end
            end
        else
            if tracer then tracer.Visible = false end
            if chams  then chams.Parent   = nil    end
        end

        hrp.CFrame = desyncCFrame
        RunService.RenderStepped:Wait()
        hrp.CFrame = M.config.originalPosition
    end)

    pcall(function()
        if getrawmetatable and setreadonly and checkcaller then
            local mt = getrawmetatable(game)
            if mt then
                local oldIndex = mt.__index
                setreadonly(mt, false)
                local newIndex = function(self, key)
                    if not checkcaller()
                        and M.config.enabled
                        and key == "CFrame"
                        and LP.Character
                        and self == LP.Character:FindFirstChild("HumanoidRootPart")
                    then
                        return M.config.originalPosition
                    end
                    return oldIndex(self, key)
                end
                mt.__index = newcclosure and newcclosure(newIndex) or newIndex
                setreadonly(mt, true)
            end
        end
    end)

    function M.setEnabled(v)
        M.config.enabled = v and true or false
        if not M.config.enabled then
            if tracer then tracer.Visible = false end
            if chams  then chams.Parent   = nil    end
        end
    end
    function M.setType(v) M.config.type = v end
    function M.setStatic(axis, v)
        if     axis == "X" then M.config.staticX = v
        elseif axis == "Y" then M.config.staticY = v
        elseif axis == "Z" then M.config.staticZ = v end
    end
    function M.setRandom(v)    M.config.randomization = v end
    function M.setVisualize(v) M.config.visualize = v and true or false end
    function M.setColor(c)
        M.config.visualizeColor = c
        if chams then
            for _, part in ipairs(chams:GetChildren()) do
                if part:IsA("MeshPart") then part.Color = c end
            end
        end
    end
    function M.setTracer(v) M.config.visualizeTracer = v and true or false end
    function M.setChar(v)   M.config.visualizeChar   = v and true or false end
    function M.resetAll()
        M.config.enabled = false
        M.config.visualize = false
        if tracer then tracer.Visible = false end
        if chams  then chams.Parent   = nil    end
    end
    return M
end)()

--fly
local Fly = (function()
    local M = {
        enabled       = false,
        initialized   = false,
        speed         = 50,
        onStateChange = nil,
    }

    local CONFIG = {
        Speed           = 50,
        BoostMultiplier = 2.5,
        ToggleKey       = Enum.KeyCode.F,
        JumpHoldTime    = 0.15,
        MaxPitchFactor  = 1.0,
    }

    local IS_MOBILE = UserInputService.TouchEnabled

    local flying       = false
    local boost        = false
    local upHeld       = false
    local downHeld     = false
    local jumpUpExpire = 0

    local bodyVelocity
    local humanoid
    local rootPart
    local savedWalkSpeed, savedJumpPower, savedJumpHeight

    local function setJumpButtonVisible(visible)
        if not IS_MOBILE then return end
        local pg = player:FindFirstChild("PlayerGui")
        if not pg then return end
        local touchGui = pg:FindFirstChild("TouchGui")
        if not touchGui then return end
        local cf = touchGui:FindFirstChild("TouchControlFrame")
        if not cf then return end
        local jb = cf:FindFirstChild("JumpButton")
        if jb then jb.Visible = visible end
    end

    local function fireStateChange()
        if M.onStateChange then
            pcall(M.onStateChange, flying)
        end
    end

    local function startFly()
        if flying then return end
        local char = player.Character
        if not char then return end

        rootPart = char:FindFirstChild("HumanoidRootPart")
        humanoid = char:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid then return end

        savedWalkSpeed  = humanoid.WalkSpeed
        savedJumpPower  = humanoid.JumpPower
        savedJumpHeight = humanoid.JumpHeight
        humanoid.WalkSpeed  = 0
        humanoid.JumpPower  = 0
        humanoid.JumpHeight = 0

        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.Parent   = rootPart

        flying   = true
        boost    = false
        upHeld   = false
        downHeld = false

        setJumpButtonVisible(false)
        fireStateChange()
    end

    local function stopFly()
        if not flying then return end
        flying   = false
        boost    = false
        upHeld   = false
        downHeld = false

        if bodyVelocity then
            bodyVelocity:Destroy()
            bodyVelocity = nil
        end

        if humanoid then
            humanoid.WalkSpeed  = savedWalkSpeed  or 16
            humanoid.JumpPower  = savedJumpPower  or 50
            humanoid.JumpHeight = savedJumpHeight or 7.2
        end

        setJumpButtonVisible(true)
        fireStateChange()
    end

    function M.toggle()
        if flying then stopFly() else startFly() end
    end

    function M.isOn()
        return flying
    end

    function M.setEnabled(state)
        if state then
            M.init()
            startFly()
        else
            stopFly()
        end
    end

    function M.setSpeed(v)
        M.speed = math.clamp(tonumber(v) or 50, 1, 100)
    end

    function M.init()
        if M.initialized then return end
        M.initialized = true

        RunService.RenderStepped:Connect(function()
            if not flying then return end

            if not rootPart or not rootPart.Parent or not bodyVelocity or not humanoid then
                stopFly()
                return
            end

            local move = Vector3.zero

            local md = humanoid.MoveDirection
            if md.Magnitude > 0.01 then
                local localDir   = camera.CFrame:VectorToObjectSpace(md)
                local forwardAmt = -localDir.Z
                local rightAmt   =  localDir.X

                local look = camera.CFrame.LookVector
                if CONFIG.MaxPitchFactor < 1 then
                    local flat = Vector3.new(look.X, 0, look.Z)
                    if flat.Magnitude > 0 then
                        flat = flat.Unit
                        local pitch = math.asin(math.clamp(look.Y, -1, 1))
                        local maxP  = math.asin(CONFIG.MaxPitchFactor)
                        pitch = math.clamp(pitch, -maxP, maxP)
                        local horiz = math.cos(pitch)
                        look = Vector3.new(
                            flat.X * horiz,
                            math.sin(pitch),
                            flat.Z * horiz
                        ).Unit
                    end
                end

                move += look                      * forwardAmt
                move += camera.CFrame.RightVector * rightAmt
            end

            local now = tick()
            if upHeld or (now < jumpUpExpire) then move += Vector3.yAxis end
            if downHeld then move -= Vector3.yAxis end

            local speed = M.speed * (boost and CONFIG.BoostMultiplier or 1)

            if move.Magnitude > 0 then
                bodyVelocity.Velocity = move.Unit * speed
            else
                bodyVelocity.Velocity = Vector3.zero
            end
        end)

        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

            local key = input.KeyCode
            if key == CONFIG.ToggleKey then
                M.toggle()
                if Toggles and Toggles.mv_fly then Toggles.mv_fly:SetValue(flying) end
                return
            end

            if not flying then return end

            if key == Enum.KeyCode.Space or key == Enum.KeyCode.E then
                upHeld = true
            elseif key == Enum.KeyCode.LeftControl or key == Enum.KeyCode.Q then
                downHeld = true
            elseif key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.RightShift then
                boost = true
            end
        end)

        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            local key = input.KeyCode
            if key == Enum.KeyCode.Space or key == Enum.KeyCode.E then
                upHeld = false
            elseif key == Enum.KeyCode.LeftControl or key == Enum.KeyCode.Q then
                downHeld = false
            elseif key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.RightShift then
                boost = false
            end
        end)

        UserInputService.JumpRequest:Connect(function()
            if flying and IS_MOBILE then
                jumpUpExpire = tick() + CONFIG.JumpHoldTime
            end
        end)

        player.CharacterAdded:Connect(function()
            if flying then stopFly() end
            rootPart = nil
            humanoid = nil
        end)
    end

    return M
end)()

--walkspeed (velocity bypass)
local WalkSpeed = (function()
    local M = { enabled = false, initialized = false, speed = 16 }

    local conn
    local bv
    local char, hum, root

    local function cleanup()
        if conn then conn:Disconnect(); conn = nil end
        if bv and bv.Parent then bv:Destroy() end
        bv = nil
    end

    local function setup()
        cleanup()
        char = player.Character
        if not char then return end
        hum  = char:FindFirstChildOfClass("Humanoid")
        root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end

        if root:FindFirstChild("SpeedBypass") then
            root.SpeedBypass:Destroy()
        end

        bv = Instance.new("BodyVelocity")
        bv.Name     = "SpeedBypass"
        bv.MaxForce = Vector3.new(math.huge, 0, math.huge)
        bv.Velocity = Vector3.zero
        bv.Parent   = root

        conn = RunService.RenderStepped:Connect(function()
            if not M.enabled then return end
            if not bv or not bv.Parent or not hum or not hum.Parent then return end
            if hum.MoveDirection.Magnitude > 0 then
                bv.Velocity = Vector3.new(
                    hum.MoveDirection.X * M.speed,
                    0,
                    hum.MoveDirection.Z * M.speed
                )
            else
                bv.Velocity = Vector3.zero
            end
        end)
    end

    function M.setEnabled(v)
        M.enabled = v and true or false
        if M.enabled then
            M.init()
            setup()
        else
            cleanup()
        end
    end

    function M.setSpeed(v)
        M.speed = math.clamp(tonumber(v) or 16, 1, 100)
    end

    function M.init()
        if M.initialized then return end
        M.initialized = true
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
            if M.enabled then setup() end
        end)
    end

    return M
end)()

--jumppower (server bypass)
local JumpPower = (function()
    local M = { enabled = false, initialized = false, power = 50 }

    local hookedHum = nil
    local oldNewIndex = nil

    local function applyToHumanoid(hum)
        if not hum then return end
        pcall(function()
            hum.UseJumpPower = true
            hum.JumpPower    = M.power
        end)
        hookedHum = hum
    end

    local function installHook()
        if oldNewIndex then return end
        oldNewIndex = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
            if not checkcaller() and M.enabled and self == hookedHum and key == "JumpPower" then
                if value ~= M.power then
                    return
                end
            end
            return oldNewIndex(self, key, value)
        end))
    end

    local function setup()
        local char = player.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        applyToHumanoid(hum)
        installHook()
    end

    function M.setEnabled(v)
        M.enabled = v and true or false
        if M.enabled then
            M.init()
            setup()
        else
            hookedHum = nil
        end
    end

    function M.setPower(v)
        M.power = math.clamp(tonumber(v) or 50, 1, 100)
        if M.enabled and hookedHum then
            pcall(function()
                hookedHum.UseJumpPower = true
                hookedHum.JumpPower    = M.power
            end)
        end
    end

    function M.init()
        if M.initialized then return end
        M.initialized = true
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
            if M.enabled then setup() end
        end)
    end

    return M
end)()

--auto kill
local AutoKill = (function()
    local M = { enabled = false }

    local TARGET_TOOL        = "katana"
    local KATANA_CLICK_DELAY = 0.01

    local autoKillTask    = nil
    local pauseTask       = nil
    local pauseTp         = false
    local targetHistory   = {}
    local HISTORY_SIZE    = 5
    local katanaToken     = 0
    local katanaConns     = {}
    local currentTargetName = nil

    local function getEquippedKatana()
        local char = player.Character
        if not char then return nil end
        for _, c in ipairs(char:GetChildren()) do
            if c:IsA("Tool") and c.Name:lower() == TARGET_TOOL then
                return c
            end
        end
        return nil
    end

    local function startKatanaClick()
        katanaToken += 1
        local tok = katanaToken
        task.spawn(function()
            while M.enabled and tok == katanaToken do
                local tool = getEquippedKatana()
                if not tool then break end
                pcall(function() tool:Activate() end)
                task.wait(KATANA_CLICK_DELAY)
            end
        end)
    end

    local function stopKatanaClick()
        katanaToken += 1
    end

    local function unhookKatana()
        for _, c in ipairs(katanaConns) do
            pcall(function() c:Disconnect() end)
        end
        katanaConns = {}
    end

    local function hookKatana(char)
        unhookKatana()
        table.insert(katanaConns, char.ChildAdded:Connect(function(child)
            if child:IsA("Tool") and child.Name:lower() == TARGET_TOOL then
                if M.enabled then startKatanaClick() end
            end
        end))
        table.insert(katanaConns, char.ChildRemoved:Connect(function(child)
            if child:IsA("Tool") and child.Name:lower() == TARGET_TOOL then
                stopKatanaClick()
            end
        end))
        if getEquippedKatana() and M.enabled then startKatanaClick() end
    end

    local function resolveTarget(targetName)
        if targetName and targetName ~= "" and targetName ~= player.Name then
            local p = Players:FindFirstChild(targetName)
            if p and p ~= player and p.Character then return p end
        end
        local myChar = player.Character
        if not myChar then return nil end
        local myRoot = myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then return nil end
        local nearest, bestDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local r = p.Character:FindFirstChild("HumanoidRootPart")
                if r then
                    local d = (r.Position - myRoot.Position).Magnitude
                    if d < bestDist then bestDist = d; nearest = p end
                end
            end
        end
        return nearest
    end

    local function getRealTargetPosition(tgtRoot)
        local now = tick()
        local currentPos = tgtRoot.Position
        table.insert(targetHistory, { pos = currentPos, time = now })
        if #targetHistory > HISTORY_SIZE then table.remove(targetHistory, 1) end
        if #targetHistory >= 2 then
            local prev = targetHistory[#targetHistory - 1]
            local jump = (currentPos - prev.pos).Magnitude
            local dt   = now - prev.time
            if jump > 30 and dt < 0.2 then return prev.pos end
        end
        local velocity = tgtRoot.AssemblyLinearVelocity
        if velocity.Magnitude > 1 then
            local predicted = currentPos + velocity * 0.05
            return currentPos:Lerp(predicted, 0.5)
        end
        return currentPos
    end

    local function runAutoKillTick(targetName)
        local t = resolveTarget(targetName)
        if not t or not t.Parent or t == player then return end
        local myChar  = player.Character
        local tgtChar = t.Character
        if not myChar or not tgtChar then return end
        local myRoot   = myChar:FindFirstChild("HumanoidRootPart")
        local tgtRoot  = tgtChar:FindFirstChild("HumanoidRootPart")
        local humanoid = myChar:FindFirstChildOfClass("Humanoid")
        if not myRoot or not tgtRoot or not humanoid then return end

        if humanoid.Sit then humanoid.Sit = false end
        humanoid.PlatformStand = false
        humanoid.AutoRotate    = false
        humanoid.WalkSpeed     = 0
        humanoid.JumpPower     = 0
        humanoid.JumpHeight    = 0

        local realTargetPos = getRealTargetPosition(tgtRoot)
        local radius = 15
        local theta  = math.random() * math.pi * 2
        local phi    = math.acos(2 * math.random() - 1)
        local offX   = radius * math.sin(phi) * math.cos(theta)
        local offY   = math.max(0, radius * math.cos(phi))
        local offZ   = radius * math.sin(phi) * math.sin(theta)
        local newPos = Vector3.new(
            realTargetPos.X + offX,
            realTargetPos.Y + offY,
            realTargetPos.Z + offZ
        )
        local diff = realTargetPos - newPos
        local yRot = math.atan2(diff.X, diff.Z)
        myRoot.CFrame = CFrame.new(newPos) * CFrame.Angles(0, yRot, 0)
        myRoot.AssemblyLinearVelocity  = Vector3.zero
        myRoot.AssemblyAngularVelocity = Vector3.zero
    end

    function M.setTargetName(name)
        currentTargetName = name
    end

    function M.setEnabled(v)
        M.enabled = v and true or false
        if M.enabled then
            pauseTp       = false
            targetHistory = {}

            autoKillTask = task.spawn(function()
                while M.enabled do
                    if not pauseTp then
                        pcall(runAutoKillTick, currentTargetName)
                    end
                    task.wait(0.1)
                end
            end)

            pauseTask = task.spawn(function()
                while M.enabled do
                    task.wait(1)
                    if not M.enabled then break end
                    pauseTp = true
                    local myChar = player.Character
                    if myChar then
                        local root = myChar:FindFirstChild("HumanoidRootPart")
                        if root then
                            root.AssemblyLinearVelocity  = Vector3.zero
                            root.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                    task.wait(0.1)
                    pauseTp = false
                end
            end)

            if getEquippedKatana() then startKatanaClick() end
        else
            if autoKillTask then task.cancel(autoKillTask) autoKillTask = nil end
            if pauseTask    then task.cancel(pauseTask)    pauseTask    = nil end
            pauseTp       = false
            targetHistory = {}
            stopKatanaClick()
            local char = player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.Sit           = false
                    hum.PlatformStand = false
                    hum.AutoRotate    = true
                    hum.WalkSpeed     = 16
                    hum.JumpPower     = 50
                    hum.JumpHeight    = 7.2
                end
            end
        end
    end

    local function onCharacter(char)
        task.wait(0.25)
        hookKatana(char)
    end
    if player.Character then task.spawn(onCharacter, player.Character) end
    player.CharacterAdded:Connect(onCharacter)

    return M
end)()

--fling
local Fling = (function()
    local M = { enabled = false }

    local flingRunning = false
    local savedFallenHeight = Workspace.FallenPartsDestroyHeight
    local currentTarget = nil

    local function doSkidFling(TargetPlayer)
        local character = player.Character
        local humanoid  = character and character:FindFirstChildOfClass("Humanoid")
        local rootPart  = humanoid and humanoid.RootPart
        local tChar     = TargetPlayer.Character
        if not tChar then return end

        local tHumanoid = tChar:FindFirstChildOfClass("Humanoid")
        local tRootPart = tHumanoid and tHumanoid.RootPart
        local tHead     = tChar:FindFirstChild("Head")
        local accessory = tChar:FindFirstChildOfClass("Accessory")
        local handle    = accessory and accessory:FindFirstChild("Handle")

        if not (character and humanoid and rootPart) then return end

        local oldPos
        if rootPart.Velocity.Magnitude < 50 then
            oldPos = rootPart.CFrame
        end

        if tHumanoid and tHumanoid.Sit then return end

        if tHead then
            camera.CameraSubject = tHead
        elseif handle then
            camera.CameraSubject = handle
        elseif tHumanoid and tRootPart then
            camera.CameraSubject = tHumanoid
        end

        if not tChar:FindFirstChildWhichIsA("BasePart") then return end

        local function FPos(basePart, pos, ang)
            rootPart.CFrame = CFrame.new(basePart.Position) * pos * ang
            character:SetPrimaryPartCFrame(CFrame.new(basePart.Position) * pos * ang)
            rootPart.Velocity    = Vector3.new(9e7, 9e7 * 10, 9e7)
            rootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
        end

        local function SFBasePart(basePart)
            local timeToWait = 2
            local startTime = tick()
            local angle = 0

            repeat
                if rootPart and tHumanoid and M.enabled then
                    if basePart.Velocity.Magnitude < 50 then
                        angle = angle + 100
                        FPos(basePart, CFrame.new(0, 1.5, 0) + tHumanoid.MoveDirection * basePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                        task.wait()
                        FPos(basePart, CFrame.new(0, -1.5, 0) + tHumanoid.MoveDirection * basePart.Velocity.Magnitude / 1.25, CFrame.Angles(math.rad(angle), 0, 0))
                        task.wait()
                        FPos(basePart, CFrame.new(0, 1.5, 0) + tHumanoid.MoveDirection, CFrame.Angles(math.rad(angle), 0, 0))
                        task.wait()
                        FPos(basePart, CFrame.new(0, -1.5, 0) + tHumanoid.MoveDirection, CFrame.Angles(math.rad(angle), 0, 0))
                        task.wait()
                    else
                        FPos(basePart, CFrame.new(0, 1.5, tHumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(basePart, CFrame.new(0, -1.5, -tHumanoid.WalkSpeed), CFrame.Angles(0, 0, 0))
                        task.wait()
                        FPos(basePart, CFrame.new(0, 1.5, tHumanoid.WalkSpeed), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(basePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                    end
                end
            until startTime + timeToWait < tick() or not M.enabled

            pcall(function() Workspace.FallenPartsDestroyHeight = 0/0 end)
            local bv = Instance.new("BodyVelocity")
            bv.Parent   = rootPart
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

            if M.enabled then
                if tRootPart then
                    SFBasePart(tRootPart)
                elseif tHead then
                    SFBasePart(tHead)
                elseif handle then
                    SFBasePart(handle)
                end
            end

            bv:Destroy()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            camera.CameraSubject = humanoid

            if oldPos then
                local startT = tick()
                repeat
                    rootPart.CFrame = oldPos * CFrame.new(0, .5, 0)
                    character:SetPrimaryPartCFrame(oldPos * CFrame.new(0, .5, 0))
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                    for _, part in pairs(character:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.Velocity, part.RotVelocity = Vector3.new(), Vector3.new()
                        end
                    end
                    task.wait()
                until (rootPart.Position - oldPos.p).Magnitude < 25 or tick() - startT > 1
                pcall(function() Workspace.FallenPartsDestroyHeight = savedFallenHeight end)
            end
        end

        SFBasePart(tRootPart or tHead or handle)
    end

    function M.setTargetName(name)
        currentTarget = name
    end

    local function resolveTarget()
        if currentTarget and currentTarget ~= "" then
            local p = Players:FindFirstChild(currentTarget)
            if p and p ~= player and p.Character then return p end
        end
        return nil
    end

    function M.setEnabled(v)
        M.enabled = v and true or false
        if M.enabled then
            if flingRunning then return end
            flingRunning = true
            task.spawn(function()
                while M.enabled do
                    local t = resolveTarget()
                    if t and t ~= player and t.Character
                        and t.Character:FindFirstChildOfClass("Humanoid") then
                        pcall(doSkidFling, t)
                    end
                    task.wait(0.1)
                end
                flingRunning = false
            end)
        else
            pcall(function() Workspace.FallenPartsDestroyHeight = savedFallenHeight end)
        end
    end

    return M
end)()

--self auras
local SelfAuras = (function()
    local M = {
        enabled = false,
        color   = nil,
        auras = {
            ["Angel Wings"]   = false,
            ["Particle Aura"] = false,
            ["Earthquake"]    = false,
            ["Halo"]          = false,
            ["Saturn Ring"]   = false,
        }
    }

    local PURPLE = {
        Deep     = Color3.fromRGB(60, 0, 110),
        Dark     = Color3.fromRGB(100, 20, 180),
        Rich     = Color3.fromRGB(138, 43, 226),
        Vivid    = Color3.fromRGB(160, 60, 255),
        Bright   = Color3.fromRGB(190, 100, 255),
        Light    = Color3.fromRGB(215, 150, 255),
        Lavender = Color3.fromRGB(230, 190, 255),
        Pink     = Color3.fromRGB(255, 130, 255),
        White    = Color3.fromRGB(245, 230, 255),
    }

    local function shade(c, factor)
        local h, s, v = Color3.toHSV(c)
        if factor < 0 then
            v = math.clamp(v * (1 + factor), 0, 1)
            s = math.clamp(s * (1 + factor * 0.5), 0, 1)
        else
            v = math.clamp(v + (1 - v) * factor, 0, 1)
            s = math.clamp(s * (1 - factor * 0.5), 0, 1)
        end
        return Color3.fromHSV(h, s, v)
    end

    local function palette()
        if not M.color then return PURPLE end
        local base = M.color
        return {
            Deep     = shade(base, -0.75),
            Dark     = shade(base, -0.50),
            Rich     = shade(base, -0.25),
            Vivid    = base,
            Bright   = shade(base,  0.20),
            Light    = shade(base,  0.45),
            Lavender = shade(base,  0.70),
            Pink     = shade(base,  0.35),
            White    = Color3.new(1, 1, 1),
        }
    end

    local function purple_gradient(reverse)
        local p = palette()
        local seq = {
            ColorSequenceKeypoint.new(0.00, p.Deep),
            ColorSequenceKeypoint.new(0.35, p.Rich),
            ColorSequenceKeypoint.new(0.65, p.Bright),
            ColorSequenceKeypoint.new(1.00, p.Lavender),
        }
        if reverse then
            local rev = {}
            for i = #seq, 1, -1 do
                table.insert(rev, ColorSequenceKeypoint.new(1 - seq[i].Time, seq[i].Value))
            end
            return ColorSequence.new(rev)
        end
        return ColorSequence.new(seq)
    end

    local function purple_pink_gradient()
        local p = palette()
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0.00, p.Deep),
            ColorSequenceKeypoint.new(0.30, p.Rich),
            ColorSequenceKeypoint.new(0.55, p.Pink),
            ColorSequenceKeypoint.new(0.80, p.Bright),
            ColorSequenceKeypoint.new(1.00, p.Lavender),
        })
    end

    local function create_aura_effect(aura_type, attachment, parent_part)
        local emitters = {}
        local extra_attachments = {}

        if aura_type == "Angel Wings" then
            attachment.Name = "ParticleAttachment"
            attachment.CFrame = CFrame.new(0, 0, 0, 0.965, 0.259, 0, -0.259, 0.965, 0, 0, 0, 1)
            attachment.Axis = Vector3.new(0.966, -0.259, 0)
            attachment.SecondaryAxis = Vector3.new(0.259, 0.966, 0)

            local pe = Instance.new("ParticleEmitter")
            pe.Name = "ParticleEmitter"
            pe.Texture = "rbxassetid://14054635072"
            pe.LockedToPart = true
            pe.Brightness = 1.5
            pe.LightEmission = 1
            pe.LightInfluence = 0
            pe.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
            pe.Size = NumberSequence.new(4)
            pe.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 1),
                NumberSequenceKeypoint.new(0.5, 0),
                NumberSequenceKeypoint.new(1, 1)
            })
            pe.Color = purple_gradient()
            pe.Lifetime = NumberRange.new(1)
            pe.Rate = 10
            pe.Rotation = NumberRange.new(0, 360)
            pe.RotSpeed = NumberRange.new(30, 60)
            pe.Speed = NumberRange.new(0.01)
            pe.SpreadAngle = Vector2.new(0.1)
            pe.Parent = attachment
            table.insert(emitters, pe)

        elseif aura_type == "Particle Aura" then
            local ringAttachment = Instance.new("Attachment")
            ringAttachment.Name = "ParticleAttachment"
            ringAttachment.Parent = parent_part
            ringAttachment.CFrame = CFrame.new(0, -3, 0)
            ringAttachment.Axis = Vector3.new(1, 0, 0)
            ringAttachment.SecondaryAxis = Vector3.new(0, 1, 0)
            table.insert(extra_attachments, ringAttachment)

            local purpleColor = purple_gradient()
            local purplePink  = purple_pink_gradient()

            local emitterProps = {
                Brightness = 2.5, LightEmission = 1, LightInfluence = 0,
                Orientation = Enum.ParticleOrientation.VelocityPerpendicular, LockedToPart = true,
                EmissionDirection = Enum.NormalId.Top, Lifetime = NumberRange.new(2, 2), Rate = 20,
                Rotation = NumberRange.new(0, 360), Speed = NumberRange.new(0.001, 0.001),
                SpreadAngle = Vector2.new(0.001, 0.001)
            }

            local sizeLarge = NumberSequence.new({NumberSequenceKeypoint.new(0, 0),NumberSequenceKeypoint.new(0.3, 2),NumberSequenceKeypoint.new(0.6, 5),NumberSequenceKeypoint.new(0.8, 8),NumberSequenceKeypoint.new(1, 12)})
            local sizeSmall = NumberSequence.new({NumberSequenceKeypoint.new(0, 0),NumberSequenceKeypoint.new(0.3, 1),NumberSequenceKeypoint.new(0.6, 2.5),NumberSequenceKeypoint.new(0.8, 4),NumberSequenceKeypoint.new(1, 6)})
            local squashLight = NumberSequence.new({NumberSequenceKeypoint.new(0, 0),NumberSequenceKeypoint.new(1, 0.2)})
            local squashHeavy = NumberSequence.new({NumberSequenceKeypoint.new(0, 0),NumberSequenceKeypoint.new(1, 2)})
            local transFade = NumberSequence.new({NumberSequenceKeypoint.new(0, 0),NumberSequenceKeypoint.new(0.2, 0.3),NumberSequenceKeypoint.new(1, 1)})
            local transQuick = NumberSequence.new({NumberSequenceKeypoint.new(0, 0),NumberSequenceKeypoint.new(1, 1)})
            local transMidFade = NumberSequence.new({NumberSequenceKeypoint.new(0, 0),NumberSequenceKeypoint.new(0.2, 0.6),NumberSequenceKeypoint.new(1, 1)})

            local e1 = Instance.new("ParticleEmitter")
            e1.Name = "ParticleEmitter1"
            for k, v in pairs(emitterProps) do e1[k] = v end
            e1.Size = sizeLarge; e1.Squash = squashLight
            e1.Texture = "rbxassetid://7216855136"; e1.Transparency = transFade
            e1.Color = purpleColor; e1.RotSpeed = NumberRange.new(-40, 40)
            e1.Parent = ringAttachment
            table.insert(emitters, e1)

            local e2 = Instance.new("ParticleEmitter")
            e2.Name = "ParticleEmitter2"
            for k, v in pairs(emitterProps) do e2[k] = v end
            e2.Size = sizeSmall; e2.Squash = squashLight
            e2.Texture = "https://assetgame.roblox.com/asset/?id=12713358087&assetName=crescent"
            e2.Transparency = transQuick; e2.Color = purplePink
            e2.RotSpeed = NumberRange.new(-600, 600)
            e2.Parent = ringAttachment
            table.insert(emitters, e2)

            local e3 = Instance.new("ParticleEmitter")
            e3.Name = "ParticleEmitter3"
            for k, v in pairs(emitterProps) do e3[k] = v end
            e3.Size = sizeSmall; e3.Squash = squashHeavy
            e3.Texture = "rbxassetid://7216849325"; e3.Transparency = transMidFade
            e3.Color = purple_gradient(true); e3.RotSpeed = NumberRange.new(-30, 30)
            e3.Parent = ringAttachment
            table.insert(emitters, e3)

        elseif aura_type == "Earthquake" then
            local transparency1 = NumberSequence.new({NumberSequenceKeypoint.new(0, 1),NumberSequenceKeypoint.new(0.5, 0.863),NumberSequenceKeypoint.new(1, 1)})
            local transparency2 = NumberSequence.new({NumberSequenceKeypoint.new(0, 1),NumberSequenceKeypoint.new(0.5, 0.225),NumberSequenceKeypoint.new(1, 1)})

            local attachmentOffsets = {
                CFrame.new(2.9, 0.42, 0.65, 1, 0, 0, 0, 0, -1, 0, 1, 0),
                CFrame.new(0.91, 0.42, -2.98, 1, 0, 0, 0, 0, -1, 0, 1, 0),
                CFrame.new(0.84, 0.06, 2.57, 0, 0, 1, 1, 0, 0, 0, 1, 0),
                CFrame.new(2.67, -0.84, -1.51, 0, 0, 1, 1, 0, 0, 0, 1, 0),
                CFrame.new(-1.63, 1.88, 2.09, 0, 0, 1, 1, 0, 0, 0, 1, 0),
                CFrame.new(-1.68, -0.18, -2.84, 0, 0, 1, 1, 0, 0, 0, 1, 0),
                CFrame.new(-3.29, 0.2, 0.32, 0, 0, 1, 1, 0, 0, 0, 1, 0),
                CFrame.new(-0.87, -0.53, 1.34, 0, 0, 1, 1, 0, 0, 0, 1, 0),
                CFrame.new(-3.21, 0.91, -2.04, 0, 0, 1, 1, 0, 0, 0, 1, 0)
            }

            local wingAttachments = {}
            for i, offset in ipairs(attachmentOffsets) do
                local wa = Instance.new("Attachment")
                wa.Name = "ParticleAttachment" .. i
                wa.Parent = parent_part
                wa.CFrame = offset
                wa.Axis = Vector3.new(1, 0, 0)
                wa.SecondaryAxis = Vector3.new(0, 0, 1)

                local e1 = Instance.new("ParticleEmitter")
                e1.Name = "ParticleEmitter1"
                e1.Parent = wa
                e1.Brightness = 10; e1.Size = NumberSequence.new(1); e1.Squash = NumberSequence.new(0)
                e1.LockedToPart = true; e1.Color = purple_gradient()
                e1.LightEmission = 1; e1.LightInfluence = 0.65
                e1.Orientation = Enum.ParticleOrientation.FacingCamera
                e1.EmissionDirection = Enum.NormalId.Top
                e1.Lifetime = NumberRange.new(1); e1.Rate = 5
                e1.Speed = NumberRange.new(0.001); e1.SpreadAngle = Vector2.new(0.1, 0.1)
                e1.Texture = "rbxassetid://9922864240"; e1.Transparency = transparency1
                table.insert(emitters, e1)

                local e2 = Instance.new("ParticleEmitter")
                e2.Name = "ParticleEmitter2"
                e2.Parent = wa
                e2.Brightness = 3; e2.Size = NumberSequence.new(0.75); e2.Squash = NumberSequence.new(0)
                e2.LockedToPart = true; e2.Color = purple_pink_gradient()
                e2.LightEmission = 1; e2.LightInfluence = 0
                e2.Orientation = Enum.ParticleOrientation.FacingCamera
                e2.EmissionDirection = Enum.NormalId.Top
                e2.Lifetime = NumberRange.new(1); e2.Rate = 5
                e2.Speed = NumberRange.new(0.001); e2.SpreadAngle = Vector2.new(0.1, 0.1)
                e2.Texture = "rbxassetid://16444981264"; e2.Transparency = transparency2
                table.insert(emitters, e2)

                table.insert(extra_attachments, wa)
                wingAttachments[i] = wa
            end

            local textures = {
                { "rbxassetid://15687629443", 0.5, -2, NumberSequence.new({NumberSequenceKeypoint.new(0,0.3),NumberSequenceKeypoint.new(0.018,0.3),NumberSequenceKeypoint.new(0.019,0),NumberSequenceKeypoint.new(0.991,0),NumberSequenceKeypoint.new(0.992,0.3),NumberSequenceKeypoint.new(1,0.3)}), 0.15, 0.15 },
                { "rbxassetid://15687532616", 0.5, -0.8, NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.018,1),NumberSequenceKeypoint.new(0.019,0),NumberSequenceKeypoint.new(0.798,0),NumberSequenceKeypoint.new(0.847,0.546),NumberSequenceKeypoint.new(1,1)}), 0.3, 0.15 },
                { "rbxassetid://16726908900", 1, -0.8, NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.018,1),NumberSequenceKeypoint.new(0.019,0.2),NumberSequenceKeypoint.new(0.798,0.2),NumberSequenceKeypoint.new(0.847,0.546),NumberSequenceKeypoint.new(1,1)}), 0.25, 0.25 },
                { "rbxassetid://623219622", 0.5, -0.8, NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(0.018,1),NumberSequenceKeypoint.new(0.019,0.2),NumberSequenceKeypoint.new(0.798,0.2),NumberSequenceKeypoint.new(0.847,0.546),NumberSequenceKeypoint.new(1,1)}), 0.25, 0.25 }
            }

            for _, pair in ipairs({
                {wingAttachments[2], wingAttachments[4]}, {wingAttachments[4], wingAttachments[1]}, {wingAttachments[1], wingAttachments[3]}, {wingAttachments[3], wingAttachments[8]},
                {wingAttachments[3], wingAttachments[5]}, {wingAttachments[5], wingAttachments[7]}, {wingAttachments[7], wingAttachments[9]}, {wingAttachments[7], wingAttachments[6]}
            }) do
                for i = 1, 4 do
                    local selected = textures[i]
                    local beam = Instance.new("Beam")
                    beam.Parent = parent_part
                    beam.Attachment0 = pair[1]
                    beam.Attachment1 = pair[2]
                    beam.FaceCamera = true
                    beam.Segments = 10
                    beam.Brightness = 6
                    beam.Color = purple_gradient()
                    beam.LightEmission = 1
                    beam.LightInfluence = 0
                    beam.Texture = selected[1]
                    beam.TextureLength = selected[2]
                    beam.TextureSpeed = selected[3]
                    beam.Transparency = selected[4]
                    beam.Width0 = selected[5]
                    beam.Width1 = selected[6]
                    table.insert(emitters, beam)
                end
            end

        elseif aura_type == "Halo" then
            local head = parent_part:FindFirstChild("Head")
            if not head then return emitters, extra_attachments end

            local haloAttachment = Instance.new("Attachment")
            haloAttachment.Name = "CustomAttachment"
            haloAttachment.CFrame = CFrame.new(-0.05, 0.933012962, 0.25881958,
                0.965931654, -0.249973103, 0.0670034066,
                0.258797228, 0.933025956, -0.249973089,
                -2.9373914e-05, 0.258797228, 0.965931654)
            haloAttachment.Axis = Vector3.new(0.9659316539764404, 0.25879722833633423, -0.000029373914003372192)
            haloAttachment.SecondaryAxis = Vector3.new(-0.2499731034040451, 0.9330259561538696, 0.25879722833633423)
            haloAttachment.Parent = head
            table.insert(extra_attachments, haloAttachment)

            local e1 = Instance.new("ParticleEmitter")
            e1.Name = "ParticleEmitter1"
            e1.Brightness = 3; e1.Color = purple_gradient()
            e1.LightEmission = 1; e1.LightInfluence = 0
            e1.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
            e1.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 3)})
            e1.Squash = NumberSequence.new(0)
            e1.Texture = "rbxassetid://8819682608"
            e1.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1),NumberSequenceKeypoint.new(0.2, 0),NumberSequenceKeypoint.new(0.8, 0),NumberSequenceKeypoint.new(1, 1)})
            e1.EmissionDirection = Enum.NormalId.Top
            e1.Lifetime = NumberRange.new(1, 1); e1.Rate = 7
            e1.Rotation = NumberRange.new(0, 360); e1.RotSpeed = NumberRange.new(-400, 400)
            e1.Speed = NumberRange.new(0.001); e1.SpreadAngle = Vector2.new(5, 5)
            e1.Shape = Enum.ParticleEmitterShape.Box
            e1.LockedToPart = true
            e1.Parent = haloAttachment
            table.insert(emitters, e1)

            local e2 = Instance.new("ParticleEmitter")
            e2.Name = "ParticleEmitter2"
            e2.Brightness = 3; e2.Color = purple_pink_gradient()
            e2.LightEmission = 1
            e2.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
            e2.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 3)})
            e2.Squash = NumberSequence.new(0)
            e2.Texture = "rbxassetid://8819682608"
            e2.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 1),NumberSequenceKeypoint.new(0.2, 0),NumberSequenceKeypoint.new(0.8, 0),NumberSequenceKeypoint.new(1, 1)})
            e2.EmissionDirection = Enum.NormalId.Top
            e2.Lifetime = NumberRange.new(1, 1); e2.Rate = 7
            e2.Rotation = NumberRange.new(0, 360); e2.RotSpeed = NumberRange.new(-400, 400)
            e2.Speed = NumberRange.new(0.001); e2.SpreadAngle = Vector2.new(5, 5)
            e2.Shape = Enum.ParticleEmitterShape.Box
            e2.LockedToPart = true
            e2.Parent = haloAttachment
            table.insert(emitters, e2)

        elseif aura_type == "Saturn Ring" then
            local a1 = Instance.new("Attachment")
            a1.Name = "ParticleAttachment1"
            a1.CFrame = CFrame.new(2, 0.5, 1) * CFrame.fromMatrix(Vector3.new(), Vector3.new(0.965929627, 0, 0.258804798), Vector3.new(0, 1, 0), Vector3.new(-0.258804798, 0, 0.965929627))
            a1.Axis = Vector3.new(0.9659296274185181, 0, 0.2588047981262207)
            a1.SecondaryAxis = Vector3.new(0, 1, 0)
            a1.Parent = parent_part
            table.insert(extra_attachments, a1)

            local e1 = Instance.new("ParticleEmitter")
            e1.Name = "ParticleEmitter1"
            e1.Brightness = 3; e1.Color = purple_gradient()
            e1.LightEmission = 1; e1.LightInfluence = 0
            e1.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
            e1.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2.75), NumberSequenceKeypoint.new(1, 3.5)})
            e1.Squash = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0)})
            e1.Texture = "http://www.roblox.com/asset/?id=13267054240"
            e1.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.944444),NumberSequenceKeypoint.new(0.5, 0.2),NumberSequenceKeypoint.new(0.8, 0.8),NumberSequenceKeypoint.new(1, 1)})
            e1.LockedToPart = true
            e1.EmissionDirection = Enum.NormalId.Front
            e1.Lifetime = NumberRange.new(1, 1); e1.Rate = 4
            e1.Rotation = NumberRange.new(-15, -15)
            e1.Speed = NumberRange.new(0.05000000074505806, 0.05000000074505806)
            e1.Parent = a1
            table.insert(emitters, e1)

            local a2 = Instance.new("Attachment")
            a2.Name = "ParticleAttachment2"
            a2.CFrame = CFrame.new(-2, 0.5, 1) * CFrame.fromMatrix(Vector3.new(), Vector3.new(0.965929627, 0, -0.258804798), Vector3.new(0, 1, 0), Vector3.new(0.258804798, 0, 0.965929627))
            a2.Axis = Vector3.new(0.9659296274185181, 0, -0.2588047981262207)
            a2.SecondaryAxis = Vector3.new(0, 1, 0)
            a2.Parent = parent_part
            table.insert(extra_attachments, a2)

            local e2 = Instance.new("ParticleEmitter")
            e2.Name = "ParticleEmitter2"
            e2.Brightness = 3; e2.Color = purple_gradient(true)
            e2.LightEmission = 1; e2.LightInfluence = 0
            e2.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
            e2.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 2.75), NumberSequenceKeypoint.new(1, 3.5)})
            e2.Squash = NumberSequence.new({NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0)})
            e2.Texture = "http://www.roblox.com/asset/?id=13267054240"
            e2.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.944444),NumberSequenceKeypoint.new(0.5, 0.2),NumberSequenceKeypoint.new(0.8, 0.8),NumberSequenceKeypoint.new(1, 1)})
            e2.LockedToPart = true
            e2.EmissionDirection = Enum.NormalId.Back
            e2.Lifetime = NumberRange.new(1, 1); e2.Rate = 4
            e2.Rotation = NumberRange.new(-15, -15)
            e2.Speed = NumberRange.new(0.05000000074505806, 0.05000000074505806)
            e2.Parent = a2
            table.insert(emitters, e2)
        end

        return emitters, extra_attachments
    end

    local aura_cache = {}

    local function destroy_cache(cache)
        if not cache then return end
        if cache.attachment then cache.attachment:Destroy() end
        if cache.attachments then
            for _, att in ipairs(cache.attachments) do
                if att and att.Parent then att:Destroy() end
            end
        end
        if cache.emitters then
            for _, emitter in ipairs(cache.emitters) do
                if emitter and emitter.Parent then emitter:Destroy() end
            end
        end
    end

    local function cleanup_all()
        for _, cache in pairs(aura_cache) do
            destroy_cache(cache)
        end
        aura_cache = {}
    end

    local function update_aura()
        local char = LP.Character
        if not char then
            cleanup_all()
            return
        end

        local current_types = {}
        for name, enabled in pairs(M.auras) do
            if enabled then table.insert(current_types, name) end
        end

        local to_remove = {}
        for cached_type in pairs(aura_cache) do
            local found = false
            for _, t in ipairs(current_types) do
                if cached_type == t then found = true break end
            end
            if not found then table.insert(to_remove, cached_type) end
        end

        for _, type_to_remove in ipairs(to_remove) do
            destroy_cache(aura_cache[type_to_remove])
            aura_cache[type_to_remove] = nil
        end

        for _, current_type in ipairs(current_types) do
            local use_upper_torso = (current_type == "Angel Wings")
            local target_part

            if use_upper_torso then
                target_part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            else
                target_part = char:FindFirstChild("LowerTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
            end

            if current_type == "Halo" then
                target_part = char:FindFirstChild("Head")
            end

            if target_part then
                if not aura_cache[current_type] then
                    local attachment = Instance.new("Attachment")
                    if use_upper_torso then
                        attachment.Position = Vector3.new(0, 0.5, 0)
                    end
                    attachment.Parent = target_part

                    local emitters, extra_attachments = create_aura_effect(current_type, attachment, target_part)

                    aura_cache[current_type] = {
                        attachment = attachment,
                        emitters = emitters,
                        attachments = extra_attachments or {}
                    }
                else
                    local cache = aura_cache[current_type]
                    if cache.attachment and cache.attachment.Parent ~= target_part then
                        cache.attachment.Parent = target_part
                        if cache.attachments then
                            for _, att in ipairs(cache.attachments) do
                                if att then att.Parent = target_part end
                            end
                        end
                    end
                    if cache.emitters then
                        for _, emitter in ipairs(cache.emitters) do
                            if emitter then
                                pcall(function() emitter.Enabled = true end)
                            end
                        end
                    end
                end
            end
        end
    end

    RunService.RenderStepped:Connect(function()
        if not M.enabled then return end
        update_aura()
    end)

    LP.CharacterAdded:Connect(function()
        task.wait(0.5)
        cleanup_all()
    end)

    function M.setEnabled(v)
        M.enabled = v and true or false
        if not M.enabled then cleanup_all() end
    end

    function M.setAura(name, v)
        if M.auras[name] == nil then return end
        M.auras[name] = v and true or false
        if not M.enabled then return end
        if not v then
            local cache = aura_cache[name]
            if cache then
                destroy_cache(cache)
                aura_cache[name] = nil
            end
        end
    end

    function M.setColor(c)
        M.color = c
        if M.enabled then
            cleanup_all()
        end
    end

    function M.cleanupAll()
        cleanup_all()
    end

    return M
end)()

--self material
local SelfMaterial = (function()
    local M = { enabled = false, color = DARK_PURPLE }
    local savedMaterials = {}

    local function restoreAll()
        for part, data in pairs(savedMaterials) do
            if part and part.Parent then
                pcall(function()
                    part.Material = data.Material
                    part.Color    = data.Color
                end)
            end
        end
        table.clear(savedMaterials)
    end

    local function apply()
        local char = LP.Character
        if not char then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                local isToolPart = part:FindFirstAncestorOfClass("Tool") ~= nil
                if not isToolPart then
                    if not savedMaterials[part] then
                        savedMaterials[part] = {
                            Material = part.Material,
                            Color    = part.Color,
                        }
                    end
                    part.Material = Enum.Material.ForceField
                    part.Color    = M.color
                end
            end
        end
    end

    RunService.Heartbeat:Connect(function()
        if not M.enabled then return end
        local char = LP.Character
        if not char then
            if next(savedMaterials) then restoreAll() end
            return
        end
        apply()
    end)

    LP.CharacterAdded:Connect(function()
        restoreAll()
    end)

    function M.setEnabled(v)
        M.enabled = v and true or false
        if not M.enabled then restoreAll() end
    end

    function M.setColor(c)
        M.color = c
    end

    function M.restoreAll()
        restoreAll()
    end

    return M
end)()

--self tool material
local SelfToolMaterial = (function()
    local M = { enabled = false, color = DARK_PURPLE }
    local savedToolMaterials = {}

    local function restoreAll()
        for part, data in pairs(savedToolMaterials) do
            if part and part.Parent then
                pcall(function()
                    part.Material = data.Material
                    part.Color    = data.Color
                end)
            end
        end
        table.clear(savedToolMaterials)
    end

    local function applyTool(tool)
        if not tool or not tool:IsA("Tool") then return end
        for _, part in ipairs(tool:GetDescendants()) do
            if part:IsA("BasePart") then
                if not savedToolMaterials[part] then
                    savedToolMaterials[part] = {
                        Material = part.Material,
                        Color    = part.Color,
                    }
                end
                part.Material = Enum.Material.ForceField
                part.Color    = M.color
            end
        end
    end

    local function apply()
        local char = LP.Character
        if char then
            for _, tool in ipairs(char:GetDescendants()) do
                if tool:IsA("Tool") then applyTool(tool) end
            end
        end
        local backpack = LP:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") then applyTool(tool) end
            end
        end
    end

    RunService.Heartbeat:Connect(function()
        if not M.enabled then return end
        apply()
    end)

    LP.CharacterAdded:Connect(function()
        restoreAll()
    end)

    function M.setEnabled(v)
        M.enabled = v and true or false
        if not M.enabled then restoreAll() end
    end

    function M.setColor(c)
        M.color = c
    end

    function M.restoreAll()
        restoreAll()
    end

    return M
end)()

--bullet tracer
local BulletTracer = (function()
    local M = { enabled=false, active={} }
    local S = { Width=1, Duration=3, Fade=false, FadeDuration=1.5,
        Color=DARK_PURPLE, Color2=DARK_PURPLE, Texture="electro", LightEmission=10,
        LocalOnly=true, MaxDistFromMe=15, BeamName="gb", Rainbow=false, RainbowSpeed=1 }
    local Textures = { electro="rbxassetid://139193109954329", cool="rbxassetid://116848240236550",
        cum="rbxassetid://88263664141635", none="" }
    local function mkPart(pos)
        local p = Instance.new("Part"); p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
        p.Transparency = 1; p.Size = Vector3.zero; p.CFrame = CFrame.new(pos); p.Parent = Workspace; return p
    end
    local function isMine(pos) if not S.LocalOnly then return true end; local h = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"); if not h then return false end; return (h.Position - pos).Magnitude <= S.MaxDistFromMe end
    local function spawnTracer(a, b)
        local p0, p1 = mkPart(a), mkPart(b)
        local a0, a1 = Instance.new("Attachment", p0), Instance.new("Attachment", p1)
        local beam = Instance.new("Beam")
        beam.Attachment0, beam.Attachment1 = a0, a1
        beam.Width0, beam.Width1 = S.Width, S.Width
        beam.FaceCamera = true; beam.LightEmission = S.LightEmission
        beam.Transparency = NumberSequence.new(0)
        beam.Texture = Textures[S.Texture] or Textures.electro
        beam.TextureMode = Enum.TextureMode.Wrap; beam.TextureLength = 10; beam.ZOffset = -1
        if S.Rainbow then
            local t = tick() * S.RainbowSpeed
            beam.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromHSV(t%1,1,1)), ColorSequenceKeypoint.new(1, Color3.fromHSV((t+0.3)%1,1,1)) })
        else beam.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, S.Color), ColorSequenceKeypoint.new(1, S.Color2) }) end
        beam.Parent = p0; M.active[#M.active + 1] = { p0, p1, beam, tick(), false }
    end
    local function handle(beam)
        if not M.enabled or not beam or not beam.Parent then return end
        if beam.Name ~= S.BeamName then return end
        local ray = beam.Parent
        local a = ray:IsA("BasePart") and ray.Position or (ray.PrimaryPart and ray.PrimaryPart.Position)
        if not a or not isMine(a) then return end
        local b
        if beam.Attachment1 then b = beam.Attachment1.WorldCFrame.Position
        elseif beam.Attachment0 then b = beam.Attachment0.WorldCFrame.Position
        elseif ray:IsA("BasePart") then b = a + ray.CFrame.LookVector * 200
        else return end
        spawnTracer(a, b); pcall(function() beam:Destroy() end)
    end
    local hooked
    local function install() if hooked then return end; hooked = Workspace.DescendantAdded:Connect(function(d) if d:IsA("Beam") and d.Name == S.BeamName then task.defer(handle, d) end end) end
    RunService.RenderStepped:Connect(function()
        local now = tick()
        for i = #M.active, 1, -1 do
            local e = M.active[i]
            if now - e[4] <= S.Duration then continue end
            if S.Fade and not e[5] then
                e[5] = true; local t0 = now; local c
                c = RunService.Heartbeat:Connect(function()
                    local t = (tick() - t0) / S.FadeDuration
                    if t >= 1 then e[1]:Destroy(); e[2]:Destroy(); table.remove(M.active, i); c:Disconnect(); return end
                    e[3].Transparency = NumberSequence.new(TweenService:GetValue(t, Enum.EasingStyle.Quad, Enum.EasingDirection.In))
                end)
            elseif not S.Fade then e[1]:Destroy(); e[2]:Destroy(); table.remove(M.active, i) end
        end
    end)
    function M.setEnabled(v) M.enabled = v and true or false; if M.enabled then install() end end
    function M.setColor(c) S.Color = c end
    function M.setColor2(c) S.Color2 = c end
    function M.setWidth(v) S.Width = tonumber(v) or S.Width end
    function M.setDuration(v) S.Duration = tonumber(v) or S.Duration end
    function M.setTexture(v) S.Texture = tostring(v):lower() end
    function M.setRainbow(v) S.Rainbow = v and true or false end
    return M
end)()

--esp
local ESP = (function()
    local M = { players={}, draw_ready=false }
    local Draw
    local GRADIENT_STRIPS = 10
    local S = { Box=false, BoxColor=DARK_PURPLE, BoxTrans=0.6, BoxThickness=1.5,
        BoxFilled=false, BoxFillColor=DARK_PURPLE, BoxFillTrans=0.5,
        BoxGradient=false, BoxGradientColor1=DARK_PURPLE, BoxGradientColor2=Color3.fromRGB(140,60,200),
        Skeleton=false, SkeletonColor=DARK_PURPLE,
        Chams=false, ChamsFill=DARK_PURPLE, ChamsOutline=WHITE,
        Name=false, NameColor=Color3.fromRGB(235,235,240),
        Distance=false, DistanceColor=Color3.fromRGB(140,140,150),
        Tool=false, ToolColor=DARK_PURPLE,
        Health=false, HealthTop=Color3.fromRGB(158,206,106), HealthBottom=Color3.fromRGB(247,118,142), HealthWidth=1,
        Armor=false, ArmorTop=Color3.fromRGB(122,162,247), ArmorBottom=Color3.fromRGB(125,207,255), ArmorWidth=1 }
    local skeleton_bones = {
        {"UpperTorso","Head"},{"UpperTorso","LowerTorso"},
        {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
        {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
        {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
        {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    }
    local function ensure_draw()
        if Draw and Draw.new then return true end
        local ok0, builtin = pcall(function() return Drawing end)
        if ok0 and builtin and builtin.new then Draw = builtin; return true end
        local sources = { "https://raw.githubusercontent.com/linemaster2/storage/main/Drawing.lua",
            "https://raw.githubusercontent.com/Erfan-Ahmadi/Universal-ESP/main/Drawing.lua" }
        for _, url in ipairs(sources) do
            local ok, lib = pcall(function() return loadstring(game:HttpGet(url, true))() end)
            if ok and lib and lib.new then Draw = lib; M.draw_ready = true; return true end
        end
        return false
    end
    local function anyOn() return S.Box or S.Skeleton or S.Chams or S.Name or S.Distance or S.Tool or S.Health or S.Armor end
    local function dremove(obj) if not obj then return end; pcall(function() obj:Remove() end); pcall(function() obj:Destroy() end) end
    local function new_player_obj(plr)
        if not ensure_draw() then return nil end
        local o = { plr=plr, box_lines={}, skel_lines={}, box_strips={} }
        for i = 1, 4 do local l = Draw.new("Line"); l.Visible, l.Thickness = false, 1; o.box_lines[i] = l end
        o.box_fill = Draw.new("Square"); o.box_fill.Visible = false; o.box_fill.Filled = true; o.box_fill.Thickness = 0
        for i = 1, GRADIENT_STRIPS do
            local s = Draw.new("Square"); s.Visible=false; s.Filled=true; s.Thickness=0; o.box_strips[i] = s
        end
        for i = 1, #skeleton_bones do local l = Draw.new("Line"); l.Visible, l.Thickness = false, 1; o.skel_lines[i] = l end
        o.name_txt = Draw.new("Text"); o.name_txt.Visible=false; o.name_txt.Size=13; o.name_txt.Center=true; o.name_txt.Outline=true; o.name_txt.Font=2
        o.dist_txt = Draw.new("Text"); o.dist_txt.Visible=false; o.dist_txt.Size=12; o.dist_txt.Center=true; o.dist_txt.Outline=true; o.dist_txt.Font=2
        o.tool_txt = Draw.new("Text"); o.tool_txt.Visible=false; o.tool_txt.Size=12; o.tool_txt.Center=true; o.tool_txt.Outline=true; o.tool_txt.Font=2
        o.health_bg = Draw.new("Square"); o.health_bg.Visible=false; o.health_bg.Filled=true
        o.health_fg = Draw.new("Square"); o.health_fg.Visible=false; o.health_fg.Filled=true
        o.armor_bg = Draw.new("Square"); o.armor_bg.Visible=false; o.armor_bg.Filled=true
        o.armor_fg = Draw.new("Square"); o.armor_fg.Visible=false; o.armor_fg.Filled=true
        o.hl = Instance.new("Highlight"); o.hl.FillColor, o.hl.OutlineColor = S.ChamsFill, S.ChamsOutline
        o.hl.FillTransparency, o.hl.OutlineTransparency = 0.5, 0; o.hl.Enabled = false; o.hl.Parent = CoreGui
        M.players[plr] = o; return o
    end
    local function destroy_obj(o)
        for _, l in ipairs(o.box_lines) do dremove(l) end
        if o.box_fill then dremove(o.box_fill) end
        for _, s in ipairs(o.box_strips) do dremove(s) end
        for _, l in ipairs(o.skel_lines) do dremove(l) end
        for _, k in ipairs({"name_txt","dist_txt","tool_txt","health_bg","health_fg","armor_bg","armor_fg"}) do if o[k] then dremove(o[k]) end end
        if o.hl then pcall(function() o.hl:Destroy() end) end
    end
    local function w2s(pos) local p, on = Camera:WorldToViewportPoint(pos); return Vector2.new(p.X, p.Y), on and p.Z > 0 end
    local function get_armor(plr)
        local char = plr.Character; if not char then return 0 end
        local be = char:FindFirstChild("BodyEffects"); local av = be and be:FindFirstChild("Armor")
        if av and av:IsA("NumberValue") then return math.clamp(av.Value, 0, 100) end; return 0
    end
    local function ensurePlayer(plr) if plr == LP then return end; if not M.players[plr] then new_player_obj(plr) end end
    RunService.RenderStepped:Connect(function()
        if not anyOn() then
            for _, o in pairs(M.players) do
                for _, l in ipairs(o.box_lines) do l.Visible = false end
                if o.box_fill then o.box_fill.Visible = false end
                for _, s in ipairs(o.box_strips) do s.Visible = false end
                for _, l in ipairs(o.skel_lines) do l.Visible = false end
                o.name_txt.Visible=false; o.dist_txt.Visible=false; o.tool_txt.Visible=false
                o.health_bg.Visible=false; o.health_fg.Visible=false; o.armor_bg.Visible=false; o.armor_fg.Visible=false
                o.hl.Enabled = false
            end
            return
        end
        if not Draw then ensure_draw() end
        if not Draw then return end
        for _, p in ipairs(Players:GetPlayers()) do ensurePlayer(p) end
        for plr, o in pairs(M.players) do
            if plr == LP or not plr.Parent then destroy_obj(o); M.players[plr] = nil; continue end
            local char = plr.Character
            local function hideAll()
                for _, l in ipairs(o.box_lines) do l.Visible = false end
                if o.box_fill then o.box_fill.Visible = false end
                for _, s in ipairs(o.box_strips) do s.Visible = false end
                for _, l in ipairs(o.skel_lines) do l.Visible = false end
                o.name_txt.Visible=false; o.dist_txt.Visible=false; o.tool_txt.Visible=false
                o.health_bg.Visible=false; o.health_fg.Visible=false; o.armor_bg.Visible=false; o.armor_fg.Visible=false
                o.hl.Enabled = false
            end
            if not char then hideAll(); continue end
            local hrp = char:FindFirstChild("HumanoidRootPart"); local head = char:FindFirstChild("Head"); local hum = char:FindFirstChildOfClass("Humanoid")
            if not hrp or not head or not hum then hideAll(); continue end
            local hrp_sp, hrp_on = w2s(hrp.Position); local head_sp = w2s(head.Position + Vector3.new(0, 0.5, 0))
            if not hrp_on then hideAll(); continue end
            local height = math.abs(hrp_sp.Y - head_sp.Y) * 2; local width = height * 0.5
            local topLeft = Vector2.new(hrp_sp.X - width/2, hrp_sp.Y - height/2)
            if S.Box then
                if S.BoxFilled then
                    if S.BoxGradient then
                        if o.box_fill then o.box_fill.Visible = false end
                        for i = 1, GRADIENT_STRIPS do
                            local strip = o.box_strips[i]
                            local t = (i - 0.5) / GRADIENT_STRIPS
                            local col = S.BoxGradientColor1:Lerp(S.BoxGradientColor2, t)
                            local stripH = height / GRADIENT_STRIPS + 1
                            strip.Position = Vector2.new(topLeft.X, topLeft.Y + (i - 1) * (height / GRADIENT_STRIPS))
                            strip.Size = Vector2.new(width, stripH)
                            strip.Color = col
                            strip.Transparency = S.BoxFillTrans
                            strip.Visible = true
                        end
                    else
                        for _, s in ipairs(o.box_strips) do s.Visible = false end
                        o.box_fill.Position = topLeft
                        o.box_fill.Size = Vector2.new(width, height)
                        o.box_fill.Color = S.BoxFillColor
                        o.box_fill.Transparency = S.BoxFillTrans
                        o.box_fill.Visible = true
                    end
                else
                    if o.box_fill then o.box_fill.Visible = false end
                    for _, s in ipairs(o.box_strips) do s.Visible = false end
                end
                local corners = {
                    {topLeft, Vector2.new(topLeft.X+width, topLeft.Y)},
                    {Vector2.new(topLeft.X+width, topLeft.Y), Vector2.new(topLeft.X+width, topLeft.Y+height)},
                    {Vector2.new(topLeft.X+width, topLeft.Y+height), Vector2.new(topLeft.X, topLeft.Y+height)},
                    {Vector2.new(topLeft.X, topLeft.Y+height), topLeft},
                }
                for i, seg in ipairs(corners) do
                    local l = o.box_lines[i]; l.From, l.To = seg[1], seg[2]
                    l.Color = S.BoxColor; l.Thickness = S.BoxThickness; l.Transparency = S.BoxTrans; l.Visible = true
                end
            else
                for _, l in ipairs(o.box_lines) do l.Visible = false end
                if o.box_fill then o.box_fill.Visible = false end
                for _, s in ipairs(o.box_strips) do s.Visible = false end
            end
            if S.Skeleton then
                for i, bone in ipairs(skeleton_bones) do
                    local a = char:FindFirstChild(bone[1]); local b = char:FindFirstChild(bone[2]); local l = o.skel_lines[i]
                    if a and b then
                        local aPos, aOn = w2s(a.Position); local bPos, bOn = w2s(b.Position)
                        if aOn and bOn then l.From, l.To = aPos, bPos; l.Color = S.SkeletonColor; l.Thickness = 1; l.Visible = true
                        else l.Visible = false end
                    else l.Visible = false end
                end
            else for _, l in ipairs(o.skel_lines) do l.Visible = false end end
            if S.Chams then o.hl.Adornee = char; o.hl.FillColor = S.ChamsFill; o.hl.OutlineColor = S.ChamsOutline; o.hl.Enabled = true
            else o.hl.Enabled = false end
            if S.Name then
                o.name_txt.Text = plr.DisplayName or plr.Name
                o.name_txt.Position = Vector2.new(hrp_sp.X, topLeft.Y - 16)
                o.name_txt.Color = S.NameColor; o.name_txt.Visible = true
            else o.name_txt.Visible = false end
            local myChar = LP.Character; local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local dist = myRoot and math.floor((myRoot.Position - hrp.Position).Magnitude) or 0
            if S.Distance then
                o.dist_txt.Text = dist .. "m"
                o.dist_txt.Position = Vector2.new(hrp_sp.X, topLeft.Y + height + 2)
                o.dist_txt.Color = S.DistanceColor; o.dist_txt.Visible = true
            else o.dist_txt.Visible = false end
            local tool = char:FindFirstChildOfClass("Tool")
            if S.Tool and tool then
                o.tool_txt.Text = tool.Name
                o.tool_txt.Position = Vector2.new(hrp_sp.X, topLeft.Y + height + 16)
                o.tool_txt.Color = S.ToolColor; o.tool_txt.Visible = true
            else o.tool_txt.Visible = false end
            if S.Health then
                local hf = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                local barX = topLeft.X - 6*S.HealthWidth; local barW = 2*S.HealthWidth
                o.health_bg.Size = Vector2.new(barW+2, height+2); o.health_bg.Position = Vector2.new(barX-1, topLeft.Y-1)
                o.health_bg.Color = Color3.new(0,0,0); o.health_bg.Visible = true
                o.health_fg.Size = Vector2.new(barW, height*hf); o.health_fg.Position = Vector2.new(barX, topLeft.Y + height - height*hf)
                o.health_fg.Color = S.HealthBottom:Lerp(S.HealthTop, hf); o.health_fg.Visible = true
            else o.health_bg.Visible = false; o.health_fg.Visible = false end
            if S.Armor then
                local armor = get_armor(plr)/100
                local barX = topLeft.X + width + 4*S.ArmorWidth; local barW = 2*S.ArmorWidth
                o.armor_bg.Size = Vector2.new(barW+2, height+2); o.armor_bg.Position = Vector2.new(barX-1, topLeft.Y-1)
                o.armor_bg.Color = Color3.new(0,0,0); o.armor_bg.Visible = true
                o.armor_fg.Size = Vector2.new(barW, height*armor); o.armor_fg.Position = Vector2.new(barX, topLeft.Y + height - height*armor)
                o.armor_fg.Color = S.ArmorBottom:Lerp(S.ArmorTop, armor); o.armor_fg.Visible = true
            else o.armor_bg.Visible = false; o.armor_fg.Visible = false end
        end
    end)
    Players.PlayerAdded:Connect(function(plr) task.wait(0.5); ensurePlayer(plr) end)
    Players.PlayerRemoving:Connect(function(plr) local o = M.players[plr]; if o then destroy_obj(o); M.players[plr] = nil end end)
    function M.set(key, val)
        S[key] = val
        if key == "ChamsFill" or key == "ChamsOutline" then
            for _, o in pairs(M.players) do o.hl.FillColor = S.ChamsFill; o.hl.OutlineColor = S.ChamsOutline end
        end
        if anyOn() then ensure_draw(); for _, p in ipairs(Players:GetPlayers()) do ensurePlayer(p) end end
    end
    task.spawn(function() task.wait(0.5); ensure_draw(); for _, p in ipairs(Players:GetPlayers()) do ensurePlayer(p) end end)
    return M
end)()


-- no slow (button)
miscSec:Button({ Text = "No slow", Callback = function()
    if _G.__NO_SLOW_ACTIVE then
        notify("no slow", "already active", "warn")
        return
    end
    local ok, err = pcall(function()
        local mt = getrawmetatable(game)
        if not mt then error("no metatable") end
        local backup
        backup = hookfunction(mt.__newindex, newcclosure(function(self, key, value)
            if key == "WalkSpeed" and type(value) == "number" and value < 16 then
                value = 16
            end
            return backup(self, key, value)
        end))
    end)
    if ok then
        _G.__NO_SLOW_ACTIVE = true
        notify("no slow", "enabled", "success")
    else
        notify("no slow", "failed: " .. tostring(err), "error")
    end
end })

-- no jump cooldown (button)
miscSec:Button({ Text = "No jump Cooldown", Callback = function()
    if _G.__NO_JUMP_CD_ACTIVE then
        notify("no jump cooldown", "already active", "warn")
        return
    end
    if type(hookfunction) ~= "function" then
        notify("no jump cooldown", "hookfunction not supported", "error")
        return
    end
    local ok, err = pcall(function()
        local originalWait
        originalWait = hookfunction(wait, newcclosure(function(seconds)
            return originalWait(0)
        end))
    end)
    if ok then
        _G.__NO_JUMP_CD_ACTIVE = true
        notify("no jump cooldown", "enabled", "success")
    else
        notify("no jump cooldown", "failed: " .. tostring(err), "error")
    end
end })


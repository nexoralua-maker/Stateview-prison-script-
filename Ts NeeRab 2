            ToolShooter.Parent = LocalPlayer2.Backpack
            revolver.Parent = LocalPlayer2.Character
            task.wait(0.2)
        end

        AnimPlay(72650574575349, 1)

        -- Wait until shoot animation FULLY finishes
        repeat task.wait() until playing and not playing.IsPlaying

        -- Unequip Revolver
        if revolver then
            revolver.Parent = LocalPlayer2.Backpack
        end

        -- If grab was released mid-animation, abort kill
        if not LocalPlayer2.Character.BodyEffects.Grabbed.Value then
            stopAlign = true
            Humanoid.WalkSpeed = 16
            return
        end

        -- ============ HELL TOOL KILL METHOD ============
        local strKill = tostring(LocalPlayer2.Character.BodyEffects.Grabbed.Value)
        if Players:FindFirstChild(strKill) then
            local CharacterK = Players[strKill].Character
            if CharacterK and CharacterK:FindFirstChild("UpperTorso") then
                CharacterK.UpperTorso.CFrame = CFrame.new(0, -1200000, 0)
            end
        end
        local str7 = Players:FindFirstChild(strKill)
        if str7 and str7.Character then
            local CharacterK = str7.Character
            for _, v in ipairs({"RightUpperArm", "LeftUpperArm", "RightUpperLeg", "LeftUpperLeg"}) do
                local limb = CharacterK:FindFirstChild(v)
                if limb then limb.CFrame = CFrame.new(0, -1200000, 0) end
            end
        end
        task.wait(0.5)
        ReplicatedStorage:WaitForChild("MainEvent"):FireServer("Grabbing")

        stopAlign = true
        Destroy("UpperTorso")
        Humanoid.WalkSpeed = 16
    end
end)


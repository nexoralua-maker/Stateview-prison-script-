        if not victim or not victim:FindFirstChild("LowerTorso") then return end

        timeStopActive = true
        task.wait(0.1)

        AnimStopv2(3135389157)
        AnimStopv2(11075367458)

        ppConn = RunService.Heartbeat:Connect(function(dt)
            local Character = LocalPlayer.Character

            if not (Character and Character.BodyEffects
                and Character.BodyEffects.Grabbed
                and Character.BodyEffects.Grabbed.Value) then
                if ppConn then ppConn:Disconnect(); ppConn = nil end
                timeStopActive = false
                return
            end
            if not (victim and victim.Parent and Character.HumanoidRootPart) then
                if ppConn then ppConn:Disconnect(); ppConn = nil end
                timeStopActive = false
                return
            end

            local root = Character.HumanoidRootPart
            local basePos = root.Position + root.CFrame.LookVector * 4 + Vector3.new(0, 0.5, 0)

            local slashStack = {
                victim.LowerTorso,
                victim.UpperTorso,
                victim.LeftUpperLeg, victim.RightUpperLeg,
                victim.LeftLowerLeg, victim.RightLowerLeg,
                victim.LeftFoot,     victim.RightFoot,
                victim.LeftUpperArm, victim.RightUpperArm,
                victim.LeftLowerArm, victim.RightLowerArm,
                victim.LeftHand,     victim.RightHand,
                victim.Head
            }

            local step  = 0
            local slant = 1.5

            for i, part in ipairs(slashStack) do
                if part and part.Parent then
                    local height        = (i - 1) * step
                    local forwardOffset = (i - 1) * slant

                    local pos = basePos
                        + Vector3.new(0, height, 0)
                        + root.CFrame.LookVector * forwardOffset

                    part.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(15), 0, 0)

                    part.AssemblyLinearVelocity  = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                    part.CanCollide = false
                end
            end
        end)
    end)

    return Tool
end


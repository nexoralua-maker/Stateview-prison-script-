-- ============================================================
--  CFrameHover  ·  toggleable  ·  accepts optional config
-- ============================================================
local CFrameHover = (function()
    local DEFAULT_SPEED  = 50
    local DEFAULT_HEIGHT = 7
    local DEFAULT_NOCLIP = true

    local enabled = false
    local conn    = nil
    local speed       = DEFAULT_SPEED
    local hoverHeight = DEFAULT_HEIGHT
    local noclip      = DEFAULT_NOCLIP

    local rayParams = RaycastParams.new()
    rayParams.FilterType  = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true

    local function getChar() return LocalPlayer.Character end
    local function getHRP()
        local c = getChar()
        return c and c:FindFirstChild("HumanoidRootPart")
    end

    local function setCollide(state)
        local c = getChar(); if not c then return end
        for _, p in ipairs(c:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = state end
        end
    end

    local function getGroundY(hrp)
        if not hrp then return nil end
        local filterList = { getChar() }
        if _G.SkateboardVictim and _G.SkateboardVictim.Parent then
            table.insert(filterList, _G.SkateboardVictim)
        end
        rayParams.FilterDescendantsInstances = filterList
        local hit = workspace:Raycast(hrp.Position, Vector3.new(0, -200, 0), rayParams)
        return hit and hit.Position.Y or nil
    end

    local function start()
        if conn then return end
        conn = RunService.Heartbeat:Connect(function(dt)
            if not enabled then return end
            local char = getChar()
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if not hrp or not hum then return end

            dt = math.min(dt, 0.1)
            if noclip then setCollide(false) end

            local move  = hum.MoveDirection
            local dir   = move.Magnitude > 0 and move.Unit or Vector3.zero
            local delta = dir * speed * dt
            local newPos = hrp.Position + delta

            local gy = getGroundY(hrp)
            if gy then
                local targetY = gy + hoverHeight
                local y = newPos.Y
                y = y + (targetY - y) * math.min(dt * 15, 1)
                newPos = Vector3.new(newPos.X, y, newPos.Z)
            end

            hrp.CFrame = CFrame.new(newPos) * (hrp.CFrame - hrp.CFrame.Position)
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    local function stop()
        if conn then conn:Disconnect(); conn = nil end
        setCollide(true)
        local hrp = getHRP()
        if hrp then
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end

    return function(state, cfg)
        if state == nil then state = not enabled end
        if cfg then
            speed       = cfg.speed or DEFAULT_SPEED
            hoverHeight = cfg.height or DEFAULT_HEIGHT
            noclip      = cfg.noclip ~= false
        else
            speed       = DEFAULT_SPEED
            hoverHeight = DEFAULT_HEIGHT
            noclip      = DEFAULT_NOCLIP
        end
        if state == enabled then return enabled end
        enabled = state
        if enabled then start() else stop() end
        return enabled
    end
end)()


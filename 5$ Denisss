-- ---------- Skateboard factory ----------
local function makeSkateboardTool(toolName, hoverCfg, idleAnimId, runAnimId)
    return function()
        if LocalPlayer.Backpack:FindFirstChild(toolName) then
            LocalPlayer.Backpack:FindFirstChild(toolName):Destroy()
        end
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(toolName) then
            LocalPlayer.Character:FindFirstChild(toolName):Destroy()
        end
        task.wait(0.1)

        local Tool = Instance.new("Tool")
        Tool.RequiresHandle = false
        Tool.Name = toolName
        Tool.Parent = LocalPlayer.Backpack

        local active    = false
        local victim    = nil
        local bp, bg    = nil, nil
        local idleTrack = nil
        local runTrack  = nil
        local heartConn = nil

        local function forcePlayerAnim(id)
            local char = LocalPlayer.Character
            if not char then return end
            local hum = char:FindFirstChildOfClass("Humanoid")
            if not hum then return end
            for _, v in pairs(hum:GetPlayingAnimationTracks()) do
                v:Stop(0)
            end
            local a = Instance.new("Animation", workspace)
            a.AnimationId = "rbxassetid://" .. id
            local t = hum:LoadAnimation(a)
            t.Priority = Enum.AnimationPriority.Action4
            t.Looped = true
            t:Play()
            a:Destroy()
            return t
        end

        local function stopTrack(t)
            if t then pcall(function() t:Stop(0) end) end
        end

        local function stopSkate()
            if not active then return end
            active = false
            _G.SkateboardVictim = nil
            CFrameHover(false)
            if heartConn then heartConn:Disconnect(); heartConn = nil end
            if bp then bp:Destroy(); bp = nil end
            if bg then bg:Destroy(); bg = nil end
            stopTrack(idleTrack); idleTrack = nil
            stopTrack(runTrack);  runTrack  = nil
            if victim and victim.Parent then
                for _, d in pairs(victim:GetDescendants()) do
                    if d:IsA("BasePart") then d.CanCollide = true end
                end
            end
            victim = nil
            timeStopActive = false
        end

        local function startSkate()
            if active then return end
            local char = LocalPlayer.Character
            if not char then return end
            local bEff = char:FindFirstChild("BodyEffects")
            local grabbed = bEff and bEff:FindFirstChild("Grabbed")
            if not grabbed or not grabbed.Value then return end

            victim = grabbed.Value
            if not victim:FindFirstChild("UpperTorso") then return end

            active = true
            timeStopActive = true
            _G.SkateboardVictim = victim
            CFrameHover(true, hoverCfg)

            AnimStopv2(3135389157)
            AnimStopv2(11075367458)

            for _, d in pairs(victim:GetDescendants()) do
                if d:IsA("BasePart") then
                    d.Velocity = Vector3.zero
                    d.AssemblyAngularVelocity = Vector3.zero
                    d.AssemblyLinearVelocity = Vector3.zero
                    d.CanCollide = false
                end
            end

            local ut = victim.UpperTorso
            for _, c in pairs(ut:GetChildren()) do
                if c:IsA("BodyPosition") or c:IsA("BodyGyro") then c:Destroy() end
            end

            bp = Instance.new("BodyPosition")
            bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            bp.P = 20000
            bp.D = 800
            bp.Parent = ut

            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
            bg.P = 20000
            bg.D = 800
            bg.Parent = ut

            idleTrack = forcePlayerAnim(idleAnimId)

            heartConn = RunService.Heartbeat:Connect(function()
                if not active then return end
                local c = LocalPlayer.Character
                if not c or not c:FindFirstChild("HumanoidRootPart") then stopSkate(); return end
                local hum = c:FindFirstChildOfClass("Humanoid")
                if not hum then stopSkate(); return end
                local be = c:FindFirstChild("BodyEffects")
                local gv = be and be:FindFirstChild("Grabbed")
                if not gv or not gv.Value then stopSkate(); return end
                if not victim or not victim.Parent then stopSkate(); return end

                local root = c.HumanoidRootPart
                local moving = hum.MoveDirection.Magnitude > 0.1

                if moving then
                    if not runTrack or not runTrack.IsPlaying then
                        stopTrack(idleTrack); idleTrack = nil
                        runTrack = forcePlayerAnim(runAnimId)
                    end
                else
                    if not idleTrack or not idleTrack.IsPlaying then
                        stopTrack(runTrack); runTrack = nil
                        idleTrack = forcePlayerAnim(idleAnimId)
                    end
                end

                local pos = root.Position + Vector3.new(0, -3, 0)
                bp.Position = pos

                local look = root.CFrame.LookVector
                local headDir = Vector3.new(look.X, 0, look.Z)
                if headDir.Magnitude < 0.01 then headDir = Vector3.new(0, 0, -1) end
                headDir = headDir.Unit

                local up = Vector3.new(0, 1, 0)
                local vX = headDir:Cross(up)
                if vX.Magnitude < 0.01 then vX = Vector3.new(1, 0, 0) end
                vX = vX.Unit

                bg.CFrame = CFrame.fromMatrix(pos, vX, headDir, up)
            end)
        end

        Tool.Activated:Connect(function()
            if active then stopSkate() else startSkate() end
        end)

        LocalPlayer.CharacterAdded:Connect(function() stopSkate() end)

        return Tool
    end
end


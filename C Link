local function createToggle(text, default, callback)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = BG
    btn.BorderSizePixel  = 0
    btn.Text             = ""
    btn.AutoButtonColor  = false
    btn.Parent           = content
    addCorner(btn)

    local label = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, -50, 1, 0)
    label.Position               = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text                   = text
    label.TextColor3             = TXT
    label.Font                   = Enum.Font.Gotham
    label.TextSize               = 13
    label.TextXAlignment         = Enum.TextXAlignment.Left
    label.Parent                 = btn

    local indicator = Instance.new("Frame")
    indicator.Size             = UDim2.new(0, 36, 0, 18)
    indicator.Position         = UDim2.new(1, -46, 0.5, -9)
    indicator.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    indicator.BorderSizePixel  = 0
    indicator.Parent           = btn
    addCorner(indicator, 99)

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 14, 0, 14)
    knob.Position         = UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    knob.BorderSizePixel  = 0
    knob.Parent           = indicator
    addCorner(knob, 99)

    local state = default

    local function render()
        if state then
            indicator.BackgroundColor3 = ACCENT
            TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, 20, 0.5, -7)}):Play()
        else
            indicator.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -7)}):Play()
        end
    end
    render()

    btn.MouseButton1Click:Connect(function()
        state = not state
        render()
        callback(state)
    end)

    local handle = {
        Set = function(v)
            state = v and true or false
            render()
        end,
        Get = function() return state end,
    }

    table.insert(allToggles, handle)
    return handle
end

local function createSlider(text, min, max, default, decimals, callback)
    local holder = Instance.new("Frame")
    holder.Size             = UDim2.new(1, 0, 0, 42)
    holder.BackgroundColor3 = BG
    holder.BorderSizePixel  = 0
    holder.Active           = true
    holder.Parent           = content
    addCorner(holder)

    local label = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, -20, 0, 18)
    label.Position               = UDim2.new(0, 10, 0, 4)
    label.BackgroundTransparency = 1
    label.Text                   = text
    label.TextColor3             = TXT
    label.Font                   = Enum.Font.Gotham
    label.TextSize               = 13
    label.TextXAlignment         = Enum.TextXAlignment.Left
    label.Parent                 = holder

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size                   = UDim2.new(1, -20, 0, 18)
    valueLabel.Position               = UDim2.new(0, 10, 0, 4)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text                   = tostring(default)
    valueLabel.TextColor3             = ACCENT
    valueLabel.Font                   = Enum.Font.Gotham
    valueLabel.TextSize               = 13
    valueLabel.TextXAlignment         = Enum.TextXAlignment.Right
    valueLabel.Parent                 = holder

    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(1, -20, 0, 6)
    bar.Position         = UDim2.new(0, 10, 1, -14)
    bar.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    bar.BorderSizePixel  = 0
    bar.Active           = false
    bar.Parent           = holder
    addCorner(bar, 99)

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = ACCENT
    fill.BorderSizePixel  = 0
    fill.Parent           = bar
    addCorner(fill, 99)

    local value    = default
    local sliding  = false

    local function render()
        local alpha = (value - min) / (max - min)
        fill.Size       = UDim2.new(math.clamp(alpha, 0, 1), 0, 1, 0)
        valueLabel.Text = string.format("%." .. decimals .. "f", value)
    end

    local function setFromAbsoluteX(absX)
        local relStart = bar.AbsolutePosition.X
        local width    = bar.AbsoluteSize.X
        if width <= 0 then return end
        local alpha    = math.clamp((absX - relStart) / width, 0, 1)
        value = min + (max - min) * alpha
        if decimals == 0 then
            value = math.floor(value + 0.5)
        else
            local m = 10 ^ decimals
            value = math.floor(value * m + 0.5) / m
        end
        render()
        callback(value)
    end

    -- Use InputBegan on holder to start sliding anywhere on the row
    local function isPress(t)
        return t == Enum.UserInputType.MouseButton1
            or t == Enum.UserInputType.Touch
    end

    local function isMove(t)
        return t == Enum.UserInputType.MouseMovement
            or t == Enum.UserInputType.Touch
    end

    holder.InputBegan:Connect(function(input)
        if isPress(input.UserInputType) then
            sliding = true
            setFromAbsoluteX(input.Position.X)
        end
    end)

    holder.InputChanged:Connect(function(input)
        if sliding and isMove(input.UserInputType) then
            setFromAbsoluteX(input.Position.X)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if sliding and isMove(input.UserInputType) then
            setFromAbsoluteX(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if isPress(input.UserInputType) then
            sliding = false
        end
    end)

    render()
    return {
        Set = function(v) value = v render(); callback(v) end,
        Get = function() return value end,
    }
end

local function createDropdown(text, options, default, callback)
    local holder = Instance.new("Frame")
    holder.Size              = UDim2.new(1, 0, 0, 28)
    holder.BackgroundColor3  = BG
    holder.BorderSizePixel   = 0
    holder.ClipsDescendants  = true

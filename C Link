local function worldToScreen(position)
    local pos, onScreen = Camera:WorldToViewportPoint(position)
    return Vector2.new(pos.X, pos.Y), onScreen
end

local function randomVector3(amount)
    return Vector3.new(
        math.random(-amount * 100, amount * 100) / 100,
        math.random(-amount * 100, amount * 100) / 100,
        math.random(-amount * 100, amount * 100) / 100
    )
end

local function cloneCharacter(player, transparency, color, material)
    if not player.Character then return nil end
    player.Character.Archivable = true
    local clone = player.Character:Clone()
    clone.Parent = workspace
    player.Character.Archivable = false

    for _, part in ipairs(clone:GetChildren()) do
        if part:IsA("Accessory") then
            part:Destroy()
        elseif part:IsA("BasePart") then
            part.Anchored   = true
            part.CanCollide = false
            if part:IsA("MeshPart") then
                part.Color        = color
                part.Material     = Enum.Material[material]
                part.Transparency = transparency
            end
            if part.Name == "Head" then
                local face = part:FindFirstChild("face")
                if face then face:Destroy() end
            end
        end
    end
    return clone
end

-- ============================================================
-- C-SYNC CHAMS
-- ============================================================
local cSyncChams = nil

local function rebuildChams()
    if cSyncChams then
        cSyncChams:Destroy()
    end
    cSyncChams = cloneCharacter(LocalPlayer, 0.7, config.visualizeColor, "Neon")
    if cSyncChams then
        local hrp = cSyncChams:FindFirstChild("HumanoidRootPart")
        if hrp then
            cSyncChams.PrimaryPart = hrp
        end
        cSyncChams.Parent = nil
    end
end

if LocalPlayer.Character then
    rebuildChams()
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    rebuildChams()
end)

local function updateChams(desyncedCFrame, color)
    if not cSyncChams or not LocalPlayer.Character then return end
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, part in ipairs(cSyncChams:GetChildren()) do
        local actualPart = LocalPlayer.Character:FindFirstChild(part.Name)
        if actualPart and part:IsA("MeshPart") then
            part.CFrame = actualPart.CFrame
            part.Color  = color
        end
    end
    cSyncChams:PivotTo(desyncedCFrame)
end


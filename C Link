UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == CSync.config.keybind then
        CSync.config.enabled = not CSync.config.enabled
        if toggleEnabled then toggleEnabled.Set(CSync.config.enabled) end
        CSync.setEnabled(CSync.config.enabled)
    end
end)

-- ============================================================
-- X CLOSE BUTTON: reset all toggles + materials, then hide
-- ============================================================
closeBtn.MouseButton1Click:Connect(function()
    -- Turn off every toggle
    for _, handle in ipairs(allToggles) do
        if handle.Get() == true then
            handle.Set(false)
        end
    end

    -- Call every setter to off via the module
    CSync.setEnabled(false)
    CSync.setVisualize(false)
    CSync.setTracer(false)
    CSync.setChar(false)
    CSync.setSelfMaterialEnabled(false)
    CSync.setSelfToolMaterialEnabled(false)

    -- Restore materials immediately
    if CSync.resetAll then CSync.resetAll() end

    -- Hide the window
    main.Visible = false
end)


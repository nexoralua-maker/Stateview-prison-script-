-- C-SYNC Standalone (ForceField Self Material Edition)
-- Fixed sliders, material restore on disable, X close button
-- ============================================================

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local Workspace        = game:GetService("Workspace")

local player    = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera    = Workspace.CurrentCamera

-- ============================================================
-- C-SYNC MODULE
-- ============================================================
local CSync = (function()
    local M = {
        config = {
            enabled          = false,
            keybind          = Enum.KeyCode.N,
            type             = "Static Local",
            staticX          = 5,
            staticY          = 0,
            staticZ          = 5,
            randomization    = 5,
            visualize        = false,
            visualizeTracer  = true,
            visualizeChar    = false,
            visualizeColor   = Color3.fromRGB(207, 227, 0),
            originalPosition = CFrame.new(1, 1, 1),

            selfMaterial = {
                enabled = false,
                type    = "ForceField",
                color   = Color3.fromRGB(207, 227, 0),
            },
            selfToolMaterial = {
                enabled = false,
                type    = "ForceField",
                color   = Color3.fromRGB(207, 227, 0),
            },
        }
    }

    -- ---- Drawing library ----
    local Drawing
    do
        local ok, res = pcall(function()
            return loadstring(game:HttpGet(
                "https://raw.githubusercontent.com/linemaster2/storage/main/Drawing.lua"
            ))()
        end)
        if ok then Drawing = res else warn("[C-Sync] Failed to load Drawing library") end
    end

    local tracer
    if Drawing then
        tracer = Drawing.new("Line")
        tracer.Visible   = false
        tracer.Thickness = 2
    end

    -- ---- Helpers ----
    local function worldToScreen(position)
        local pos, onScreen = camera:WorldToViewportPoint(position)
        return Vector2.new(pos.X, pos.Y), onScreen
    end

    local function randomVector3(amount)
        return Vector3.new(
            math.random(-amount * 100, amount * 100) / 100,
            math.random(-amount * 100, amount * 100) / 100,
            math.random(-amount * 100, amount * 100) / 100
        )
    end

    local function cloneCharacter(plr, transparency, color, material)
        if not plr.Character then return nil end
        plr.Character.Archivable = true
        local clone = plr.Character:Clone()
        clone.Parent = Workspace
        plr.Character.Archivable = false

        for _, part in ipairs(clone:GetChildren()) do
            if part:IsA("Accessory") then
                part:Destroy()
            elseif part:IsA("BasePart") then
                part.Anchored   = true
                part.CanCollide = false
                if part:IsA("MeshPart") then
                    part.Color        = color
                    part.Material     = Enum.Material[material]
                    part.Transparency = transparency
                end
                if part.Name == "Head" then
                    local face = part:FindFirstChild("face")
                    if face then face:Destroy() end
                end
            end
        end
        return clone
    end

    -- ---- Ghost chams ----
    local chams
    local function rebuildChams()
        if chams then chams:Destroy() end
        chams = cloneCharacter(player, 0.7, M.config.visualizeColor, "Neon")
        if chams then
            local hrp = chams:FindFirstChild("HumanoidRootPart")
            if hrp then chams.PrimaryPart = hrp end
            chams.Parent = nil
        end
    end

    if player.Character then rebuildChams() end
    player.CharacterAdded:Connect(function() task.wait(1) rebuildChams() end)

    local function updateChams(desyncedCFrame, color)
        if not chams or not player.Character then return end
        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        for _, part in ipairs(chams:GetChildren()) do
            local actualPart = player.Character:FindFirstChild(part.Name)
            if actualPart and part:IsA("MeshPart") then
                part.CFrame = actualPart.CFrame
                part.Color  = color
            end
        end
        chams:PivotTo(desyncedCFrame)
    end

    -- ============================================================
    -- ORIGINAL MATERIAL STORAGE (for restore)
    -- ============================================================
    local savedMaterials = {}      -- [BasePart] = { Material = ..., Color = ... }
    local savedToolMaterials = {}  -- [BasePart] = { Material = ..., Color = ... }

    local function restoreMaterials(store)
        for part, data in pairs(store) do
            if part and part.Parent then
                pcall(function()
                    part.Material = data.Material
                    part.Color    = data.Color
                end)
            end
        end
        table.clear(store)
    end

    -- ---- Self material (ForceField, hardcoded) ----
    local function updateSelfMaterial()
        local char = player.Character
        if not char then return end
        if M.config.selfMaterial.enabled then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    if not savedMaterials[part] then
                        savedMaterials[part] = {
                            Material = part.Material,
                            Color    = part.Color,
                        }
                    end
                    part.Material = Enum.Material.ForceField
                    part.Color    = M.config.selfMaterial.color
                end
            end
        end
    end

    -- ---- Self tool material (ForceField, hardcoded) ----
    local function updateSelfToolMaterial()
        local char = player.Character
        if not char then return end
        if M.config.selfToolMaterial.enabled then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool then
                for _, part in ipairs(tool:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if not savedToolMaterials[part] then
                            savedToolMaterials[part] = {
                                Material = part.Material,
                                Color    = part.Color,
                            }
                        end
                        part.Material = Enum.Material.ForceField
                        part.Color    = M.config.selfToolMaterial.color
                    end
                end
            end
        end
    end

    -- ---- Restore when toggles turn off ----
    local function restoreSelfMaterial()
        restoreMaterials(savedMaterials)
    end

    local function restoreSelfToolMaterial()
        restoreMaterials(savedToolMaterials)
    end

    -- ---- Main loop ----
    RunService.Heartbeat:Connect(function()
        local char = player.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")

        -- Restore materials when features disabled
        if not M.config.selfMaterial.enabled and next(savedMaterials) then
            restoreSelfMaterial()
        end
        if not M.config.selfToolMaterial.enabled and next(savedToolMaterials) then
            restoreSelfToolMaterial()
        end

        if not hrp or not M.config.enabled then
            if tracer then tracer.Visible = false end
            if chams  then chams.Parent   = nil    end
            return
        end

        local desyncCFrame
        local t = M.config.type
        if t == "Static Local" or t == "Static Target" then
            desyncCFrame = hrp.CFrame + Vector3.new(
                M.config.staticX, M.config.staticY, M.config.staticZ
            )
        elseif t == "Local Random" or t == "Target Random" then
            desyncCFrame = hrp.CFrame + randomVector3(M.config.randomization)
        else
            desyncCFrame = hrp.CFrame
        end

        M.config.originalPosition = hrp.CFrame

        if M.config.visualize and Drawing then
            if M.config.visualizeTracer then
                local from, fromOn = worldToScreen(hrp.Position)
                local to,   toOn   = worldToScreen(desyncCFrame.Position)
                tracer.Visible = (fromOn or toOn)
                tracer.From    = from
                tracer.To      = to
                tracer.Color   = M.config.visualizeColor
            else
                tracer.Visible = false
            end

            if M.config.visualizeChar and chams then
                chams.Parent = Workspace
                updateChams(desyncCFrame, M.config.visualizeColor)
            else
                if chams then chams.Parent = nil end
            end
        else
            if tracer then tracer.Visible = false end
            if chams  then chams.Parent   = nil    end
        end

        updateSelfMaterial()
        updateSelfToolMaterial()

        hrp.CFrame = desyncCFrame
        RunService.RenderStepped:Wait()
        hrp.CFrame = M.config.originalPosition
    end)

    -- ---- Metamethod hook ----
    pcall(function()
        if getrawmetatable and setreadonly and checkcaller then
            local mt = getrawmetatable(game)
            if mt then
                local oldIndex = mt.__index
                setreadonly(mt, false)
                local newIndex = function(self, key)
                    if not checkcaller()
                        and M.config.enabled
                        and key == "CFrame"
                        and player.Character
                        and self == player.Character:FindFirstChild("HumanoidRootPart")
                    then
                        return M.config.originalPosition
                    end
                    return oldIndex(self, key)
                end
                mt.__index = newcclosure and newcclosure(newIndex) or newIndex
                setreadonly(mt, true)
            end
        end
    end)

    -- ---- Public setters ----
    function M.setEnabled(v)
        M.config.enabled = v and true or false
        if not M.config.enabled then
            if tracer then tracer.Visible = false end
            if chams  then chams.Parent   = nil    end
        end
    end
    function M.setType(v)      M.config.type = v end

    function M.setStatic(axis, v)
        if     axis == "X" then M.config.staticX = v
        elseif axis == "Y" then M.config.staticY = v
        elseif axis == "Z" then M.config.staticZ = v end
    end

    function M.setRandom(v)    M.config.randomization = v end
    function M.setVisualize(v) M.config.visualize = v and true or false end

    function M.setColor(c)
        M.config.visualizeColor = c
        if chams then
            for _, part in ipairs(chams:GetChildren()) do
                if part:IsA("MeshPart") then part.Color = c end
            end
        end
    end

    function M.setTracer(v)    M.config.visualizeTracer = v and true or false end
    function M.setChar(v)      M.config.visualizeChar   = v and true or false end
    function M.setKeybind(k)   M.config.keybind = k end

    function M.setSelfMaterialEnabled(v)
        M.config.selfMaterial.enabled = v and true or false
        if not M.config.selfMaterial.enabled then
            restoreSelfMaterial()
        end
    end
    function M.setSelfMaterialColor(c)
        M.config.selfMaterial.color = c
    end

    function M.setSelfToolMaterialEnabled(v)
        M.config.selfToolMaterial.enabled = v and true or false
        if not M.config.selfToolMaterial.enabled then
            restoreSelfToolMaterial()
        end
    end
    function M.setSelfToolMaterialColor(c)
        M.config.selfToolMaterial.color = c
    end

    -- Reset everything
    function M.resetAll()
        restoreSelfMaterial()
        restoreSelfToolMaterial()
        M.config.enabled = false
        M.config.visualize = false
        M.config.selfMaterial.enabled = false
        M.config.selfToolMaterial.enabled = false
        if tracer then tracer.Visible = false end
        if chams  then chams.Parent   = nil    end
    end

    return M
end)()


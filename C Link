    label.TextColor3             = Color3.fromRGB(200, 200, 200)
    label.Font                   = Enum.Font.Gotham
    label.TextSize               = 13
    label.TextXAlignment         = Enum.TextXAlignment.Left
    label.Parent                 = btn

    local indicator = Instance.new("Frame")
    indicator.Size             = UDim2.new(0, 36, 0, 18)
    indicator.Position         = UDim2.new(1, -46, 0.5, -9)
    indicator.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    indicator.BorderSizePixel  = 0
    indicator.Parent           = btn
    addCorner(indicator, 99)

    local knob = Instance.new("Frame")
    knob.Size             = UDim2.new(0, 14, 0, 14)
    knob.Position         = UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    knob.BorderSizePixel  = 0
    knob.Parent           = indicator
    addCorner(knob, 99)

    local state = default

    local function render()
        if state then
            indicator.BackgroundColor3 = Color3.fromRGB(207, 227, 0)
            TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, 20, 0.5, -7)}):Play()
        else
            indicator.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            TweenService:Create(knob, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -7)}):Play()
        end
    end
    render()

    btn.MouseButton1Click:Connect(function()
        state = not state
        render()
        callback(state)
    end)

    return {
        Set = function(v)
            state = v
            render()
        end,
        Get = function() return state end,
    }
end

local function createSlider(text, min, max, default, decimals, callback)
    local holder = Instance.new("Frame")
    holder.Size             = UDim2.new(1, 0, 0, 42)
    holder.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    holder.BorderSizePixel  = 0
    holder.Parent           = content
    addCorner(holder)

    local label = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, -20, 0, 18)
    label.Position               = UDim2.new(0, 10, 0, 4)
    label.BackgroundTransparency = 1
    label.Text                   = text
    label.TextColor3             = Color3.fromRGB(200, 200, 200)
    label.Font                   = Enum.Font.Gotham
    label.TextSize               = 13
    label.TextXAlignment         = Enum.TextXAlignment.Left
    label.Parent                 = holder

    local valueLabel = Instance.new("TextLabel")
    valueLabel.Size                   = UDim2.new(1, -20, 0, 18)
    valueLabel.Position               = UDim2.new(0, 10, 0, 4)
    valueLabel.BackgroundTransparency = 1
    valueLabel.Text                   = tostring(default)
    valueLabel.TextColor3             = Color3.fromRGB(207, 227, 0)
    valueLabel.Font                   = Enum.Font.Gotham
    valueLabel.TextSize               = 13
    valueLabel.TextXAlignment         = Enum.TextXAlignment.Right
    valueLabel.Parent                 = holder

    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(1, -20, 0, 6)
    bar.Position         = UDim2.new(0, 10, 1, -14)
    bar.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    bar.BorderSizePixel  = 0
    bar.Parent           = holder
    addCorner(bar, 99)

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(207, 227, 0)
    fill.BorderSizePixel  = 0
    fill.Parent           = bar
    addCorner(fill, 99)

    local value    = default
    local sliding  = false

    local function render()
        local alpha = (value - min) / (max - min)
        fill.Size       = UDim2.new(math.clamp(alpha, 0, 1), 0, 1, 0)
        valueLabel.Text = string.format("%." .. decimals .. "f", value)
    end

    local function setFromInput(input)
        local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        value = min + (max - min) * alpha
        if decimals == 0 then
            value = math.floor(value + 0.5)
        else
            local m = 10 ^ decimals
            value = math.floor(value * m + 0.5) / m
        end
        render()
        callback(value)
    end

    holder.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true
            setFromInput(input)
        end
    end)
    holder.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
            setFromInput(input)
        end
    end)

    render()
    return { Set = function(v) value = v; render(); callback(v) end }
end


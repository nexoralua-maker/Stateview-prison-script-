-- ============================================================
-- MAIN C-SYNC LOOP
-- ============================================================
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        cSyncTracer.Visible = false
        cSyncDot.Visible = false
        if cSyncChams then cSyncChams.Parent = nil end
        return
    end

    if not config.enabled then
        cSyncTracer.Visible = false
        cSyncDot.Visible = false
        if cSyncChams then cSyncChams.Parent = nil end
        return
    end

    local desyncCFrame
    local t = config.type

    if t == "Static Local" or t == "Static Target" then
        -- Standalone: no target system -> Static Target falls back to local
        desyncCFrame = hrp.CFrame + Vector3.new(config.staticX, config.staticY, config.staticZ)
    elseif t == "Local Random" or t == "Target Random" then
        desyncCFrame = hrp.CFrame + randomVector3(config.randomization)
    else
        desyncCFrame = hrp.CFrame
    end

    config.originalPosition = hrp.CFrame

    -- Visualization
    if config.visualize then
        if config.visualizeTracer then
            local from, fromOn = worldToScreen(hrp.Position)
            local to, toOn     = worldToScreen(desyncCFrame.Position)
            cSyncTracer.Visible = (fromOn or toOn)
            cSyncTracer.From    = from
            cSyncTracer.To      = to
            cSyncTracer.Color   = config.visualizeColor
        else
            cSyncTracer.Visible = false
        end

        if config.visualizeDot then
            local pos, on = worldToScreen(desyncCFrame.Position)
            cSyncDot.Visible = on
            cSyncDot.Position = pos
            cSyncDot.Radius   = config.dotSize
            cSyncDot.Color    = config.visualizeColor
        else
            cSyncDot.Visible = false
        end

        if config.visualizeChar and cSyncChams then
            cSyncChams.Parent = workspace
            updateChams(desyncCFrame, config.visualizeColor)
        else
            if cSyncChams then cSyncChams.Parent = nil end
        end
    else
        cSyncTracer.Visible = false
        cSyncDot.Visible = false
        if cSyncChams then cSyncChams.Parent = nil end
    end

    -- Apply desync
    hrp.CFrame = desyncCFrame
    RunService.RenderStepped:Wait()
    hrp.CFrame = config.originalPosition
end)

-- ============================================================
-- METAMETHOD HOOK (hide real CFrame from server)
-- ============================================================
if getrawmetatable and setreadonly and checkcaller then
    local mt = getrawmetatable(game)
    if mt then
        local oldIndex = mt.__index
        setreadonly(mt, false)

        local newIndex = function(self, key)
            if not checkcaller()
                and config.enabled
                and key == "CFrame"
                and LocalPlayer.Character
                and self == LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            then
                return config.originalPosition
            end
            return oldIndex(self, key)
        end

        if newcclosure then
            mt.__index = newcclosure(newIndex)
        else
            mt.__index = newIndex
        end

        setreadonly(mt, true)
    end
end


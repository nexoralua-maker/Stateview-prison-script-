    addCorner(holder)

    local btn = Instance.new("TextButton")
    btn.Size                = UDim2.new(1, 0, 0, 28)
    btn.BackgroundTransparency = 1
    btn.Text                = ""
    btn.Parent              = holder

    local label = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, -30, 0, 28)
    label.Position               = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text                   = text .. ": " .. default
    label.TextColor3             = TXT
    label.Font                   = Enum.Font.Gotham
    label.TextSize               = 13
    label.TextXAlignment         = Enum.TextXAlignment.Left
    label.Parent                 = holder

    local arrow = Instance.new("TextLabel")
    arrow.Size                   = UDim2.new(0, 20, 0, 28)
    arrow.Position               = UDim2.new(1, -25, 0, 0)
    arrow.BackgroundTransparency = 1
    arrow.Text                   = "v"
    arrow.TextColor3             = Color3.fromRGB(150, 150, 150)
    arrow.Font                   = Enum.Font.GothamBold
    arrow.TextSize               = 11
    arrow.Parent                 = holder

    local optionsFrame = Instance.new("Frame")
    optionsFrame.Size                = UDim2.new(1, -16, 0, #options * 24)
    optionsFrame.Position            = UDim2.new(0, 8, 0, 30)
    optionsFrame.BackgroundTransparency = 1
    optionsFrame.Parent              = holder

    local optLayout = Instance.new("UIListLayout")
    optLayout.SortOrder = Enum.SortOrder.LayoutOrder
    optLayout.Padding   = UDim.new(0, 2)
    optLayout.Parent    = optionsFrame

    local selected = default
    local open     = false

    local function toggleOpen()
        open          = not open
        holder.Size   = open and UDim2.new(1, 0, 0, 34 + #options * 24) or UDim2.new(1, 0, 0, 28)
        arrow.Text    = open and "^" or "v"
    end

    btn.MouseButton1Click:Connect(toggleOpen)

    for _, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size             = UDim2.new(1, 0, 0, 22)
        optBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        optBtn.BorderSizePixel  = 0
        optBtn.Text             = opt
        optBtn.TextColor3       = TXT
        optBtn.Font             = Enum.Font.Gotham
        optBtn.TextSize         = 12
        optBtn.AutoButtonColor  = false
        optBtn.Parent           = optionsFrame
        addCorner(optBtn, 4)

        optBtn.MouseEnter:Connect(function()
            optBtn.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        end)
        optBtn.MouseLeave:Connect(function()
            optBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        end)

        optBtn.MouseButton1Click:Connect(function()
            selected      = opt
            label.Text    = text .. ": " .. opt
            toggleOpen()
            callback(opt)
        end)
    end

    return { Get = function() return selected end }
end

local function createKeybind(text, default, callback)
    local btn = Instance.new("TextButton")
    btn.Size             = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = BG
    btn.BorderSizePixel  = 0
    btn.Text             = ""
    btn.AutoButtonColor  = false
    btn.Parent           = content
    addCorner(btn)

    local label = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, -80, 1, 0)
    label.Position               = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text                   = text
    label.TextColor3             = TXT
    label.Font                   = Enum.Font.Gotham
    label.TextSize               = 13
    label.TextXAlignment         = Enum.TextXAlignment.Left
    label.Parent                 = btn

    local keyLabel = Instance.new("TextLabel")
    keyLabel.Size                   = UDim2.new(0, 70, 1, 0)
    keyLabel.Position               = UDim2.new(1, -80, 0, 0)
    keyLabel.BackgroundTransparency = 1
    keyLabel.Text                   = default.Name
    keyLabel.TextColor3             = ACCENT
    keyLabel.Font                   = Enum.Font.GothamBold
    keyLabel.TextSize               = 13
    keyLabel.TextXAlignment         = Enum.TextXAlignment.Right
    keyLabel.Parent                 = btn

    local binding    = false
    local currentKey = default

    btn.MouseButton1Click:Connect(function()
        if binding then return end
        binding       = true
        keyLabel.Text = "..."

        local conn
        conn = UserInputService.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey    = input.KeyCode
                keyLabel.Text = currentKey.Name
                binding       = false
                conn:Disconnect()
                callback(currentKey)
            end
        end)
    end)

    return { Get = function() return currentKey end }
end

local function createColorPicker(text, default, callback)
    local holder = Instance.new("Frame")
    holder.Size             = UDim2.new(1, 0, 0, 28)
    holder.BackgroundColor3 = BG
    holder.BorderSizePixel  = 0
    holder.Parent           = content
    addCorner(holder)

    local label = Instance.new("TextLabel")
    label.Size                   = UDim2.new(1, -50, 1, 0)
    label.Position               = UDim2.new(0, 10, 0, 0)
    label.BackgroundTransparency = 1
    label.Text                   = text
    label.TextColor3             = TXT
    label.Font                   = Enum.Font.Gotham
    label.TextSize               = 13
    label.TextXAlignment         = Enum.TextXAlignment.Left
    label.Parent                 = holder

    local swatch = Instance.new("TextButton")
    swatch.Size             = UDim2.new(0, 30, 0, 20)
    swatch.Position         = UDim2.new(1, -40, 0.5, -10)
    swatch.BackgroundColor3 = default
    swatch.BorderSizePixel  = 0
    swatch.Text             = ""
    swatch.AutoButtonColor  = false
    swatch.Parent           = holder
    addCorner(swatch, 4)

    local presets = {
        Color3.fromRGB(207, 227, 0),
        Color3.fromRGB(255, 60,  60),
        Color3.fromRGB(60,  140, 255),
        Color3.fromRGB(60,  255, 140),
        Color3.fromRGB(255, 60,  255),
        Color3.fromRGB(255, 140, 60),
        Color3.fromRGB(255, 255, 255),
    }

    swatch.MouseButton1Click:Connect(function()
        local idx = 1
        for i, c in ipairs(presets) do
            if c == swatch.BackgroundColor3 then idx = i + 1 end
        end
        if idx > #presets then idx = 1 end
        swatch.BackgroundColor3 = presets[idx]
        callback(presets[idx])
    end)

    return swatch
end


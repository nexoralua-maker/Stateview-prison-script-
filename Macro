-- Keep the close button glued to the main button (works during tween AND drag)
local function updateCloseButtonPosition()
    local abs = mainBtn.AbsolutePosition
    CloseButton.Position = UDim2.new(0, abs.X - 27, 0, abs.Y)
end

mainBtn:GetPropertyChangedSignal("Position"):Connect(updateCloseButtonPosition)
mainBtn:GetPropertyChangedSignal("AbsolutePosition"):Connect(updateCloseButtonPosition)

-- 2. SLIDE IN ANIMATION
local targetPosition = UDim2.new(0, 772, 0, -12) -- Your original position

local slideInTween = TweenService:Create(
    mainBtn,
    TweenInfo.new(
        0.8, -- Duration
        Enum.EasingStyle.Quad, -- Easing style
        Enum.EasingDirection.Out -- Easing direction
    ),
    { Position = targetPosition }
)

-- Start the animation
slideInTween:Play()

-- 2b. DRAGGING LOGIC (main button is draggable)
local dragging = false
local dragInput, dragStart, startPos
local dragMoved = false

mainBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragMoved = false
        dragStart = input.Position
        startPos = mainBtn.Position

        -- Cancel the slide-in tween if the user grabs it mid-animation
        if slideInTween.PlaybackState == Enum.PlaybackState.Playing then
            slideInTween:Cancel()
        end

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

mainBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
            dragMoved = true
        end
        mainBtn.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

-- 3. KHEN'S CORE LOGIC
local function faceForward()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local hrp = character.HumanoidRootPart
    
    local lookVector = camera.CFrame.LookVector
    local flatLookVector = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
    hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + flatLookVector)
end

local function loopFaceForward()
    local connection
    connection = RunService.RenderStepped:Connect(function()
        local char = player.Character
        if isFacingForward and char and char:FindFirstChild("katana") then
            faceForward()
        else
            -- If katana is unequipped, turn everything OFF
            isFacingForward = false
            isControlHeld = false
            connection:Disconnect()
            mainBtn.Text = "Crispy.lol"
            -- Release Control when katana is unequipped
            VIM:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
        end
    end)
end

-- 4. SMART TOGGLE HANDLER
mainBtn.MouseButton1Click:Connect(function()
    -- Ignore the click if the user was just dragging the button around
    if dragMoved then
        dragMoved = false
        return
    end

    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local bp = player:FindFirstChild("Backpack")
    
    -- Check if we are already locked -> UNLOCK
    if isFacingForward then
        isFacingForward = false
        isControlHeld = false
        mainBtn.Text = "Crispy.lol"
        -- RELEASE Control when turning OFF
        VIM:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game)
        return
    end

    -- Check if katana is in backpack or hand
    local toolInHand = char and char:FindFirstChild("katana")
    local toolInBackpack = bp and bp:FindFirstChild("katana")
    
    if toolInHand or toolInBackpack then
        -- Only equip if it's in the backpack
        if toolInBackpack and hum then
            hum:EquipTool(toolInBackpack)
        end
        
        -- Start the Lock Logic
        isFacingForward = true
        isControlHeld = true
        mainBtn.Text = "ON"
        
        -- PRESS AND HOLD Left Control (no release)
        VIM:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, game)
        
        loopFaceForward()
    else
        mainBtn.Text = "NO KATANA"
        task.wait(1)
        mainBtn.Text = "Crispy.lol"
    end
end)

-- ============================================================
-- Desync / C-Sync Module
-- ============================================================
local CSync = (function()
    local M = {
        config = {
            enabled = false,
            type = "Static Local",
            staticX = 5, staticY = 0, staticZ = 5,
            randomization = 5,
            visualize = false,
            visualizeTracer = true,
            visualizeChar = false,
            visualizeColor = Color3.fromRGB(0, 220, 200),
            targetName = nil,
            originalPosition = CFrame.new(1, 1, 1),
            lastDesync = CFrame.new(1, 1, 1),
        }
    }

    local Drawing
    pcall(function()
        Drawing = loadstring(game:HttpGet("https://raw.githubusercontent.com/linemaster2/storage/main/Drawing.lua"))()
    end)

    local tracer
    if Drawing then
        tracer = Drawing.new("Line")
        tracer.Visible = false
        tracer.Thickness = 2
        tracer.Transparency = 0.5
    end

    local chams

    local function getHRP()
        local char = Player.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function getTargetHRP()
        local n = M.config.targetName
        if not n or n == "" then return nil end
        local p = game.Players:FindFirstChild(n)
        if p and p ~= Player and p.Character then
            return p.Character:FindFirstChild("HumanoidRootPart")
        end
        return nil
    end

    local function randomOffset(amount)
        return Vector3.new(
            math.random(-amount * 100, amount * 100) / 100,
            math.random(-amount * 100, amount * 100) / 100,
            math.random(-amount * 100, amount * 100) / 100
        )
    end

    local function computeDesync(hrp)
        local t = M.config.type
        local sX, sY, sZ = M.config.staticX, M.config.staticY, M.config.staticZ
        if t == "Static Local" then
            return hrp.CFrame * CFrame.new(sX, sY, sZ)
        elseif t == "Static Target" then
            local tgt = getTargetHRP()
            if tgt then return tgt.CFrame * CFrame.new(sX, sY, sZ) end
            return hrp.CFrame * CFrame.new(sX, sY, sZ)
        elseif t == "Local Random" then
            return hrp.CFrame * CFrame.new(randomOffset(M.config.randomization))
        elseif t == "Target Random" then
            local tgt = getTargetHRP()
            if tgt then return tgt.CFrame * CFrame.new(randomOffset(M.config.randomization)) end
            return hrp.CFrame * CFrame.new(randomOffset(M.config.randomization))
        end
        return hrp.CFrame
    end

    local function buildChams()
        if chams then chams:Destroy(); chams = nil end
        local char = Player.Character
        if not char then return end
        char.Archivable = true
        local clone = char:Clone()
        char.Archivable = false
        clone.Name = "CSync_Chams"
        for _, part in ipairs(clone:GetChildren()) do
            if part:IsA("Accessory") then part:Destroy()
            elseif part:IsA("BasePart") then
                part.Anchored = true
                part.CanCollide = false
                part.CanQuery = false
                part.CanTouch = false
                if part:IsA("MeshPart") then
                    part.Color = M.config.visualizeColor
                    part.Material = Enum.Material.Neon
                    part.Transparency = 0.7
                end
                if part.Name == "Head" then
                    local face = part:FindFirstChild("face")
                    if face then face:Destroy() end
                end
            end
        end
        chams = clone
    end

    local function updateChams(desyncCFrame)
        if not chams or not Player.Character then return end
        for _, part in ipairs(chams:GetChildren()) do
            local actual = Player.Character:FindFirstChild(part.Name)
            if actual and actual:IsA("BasePart") and part:IsA("BasePart") then
                part.CFrame = actual.CFrame
                if part:IsA("MeshPart") then part.Color = M.config.visualizeColor end
            end
        end
        chams:PivotTo(desyncCFrame)
    end

    if Player.Character then buildChams() end
    Player.CharacterAdded:Connect(function() task.wait(1); buildChams() end)

    RunService.Heartbeat:Connect(function()
        local hrp = getHRP()
        if not hrp or not M.config.enabled then
            if tracer then tracer.Visible = false end
            if chams and chams.Parent then chams.Parent = nil end
            return
        end
        local desyncCFrame = computeDesync(hrp)
        M.config.originalPosition = hrp.CFrame
        M.config.lastDesync = desyncCFrame
        if M.config.visualize then
            if M.config.visualizeTracer and Drawing and tracer then
                local from, fromOn = Camera:WorldToViewportPoint(hrp.Position)
                local to, toOn = Camera:WorldToViewportPoint(desyncCFrame.Position)
                tracer.Visible = (fromOn or toOn)
                tracer.From = Vector2.new(from.X, from.Y)
                tracer.To = Vector2.new(to.X, to.Y)
                tracer.Color = M.config.visualizeColor
            elseif tracer then
                tracer.Visible = false
            end
            if M.config.visualizeChar and chams then
                chams.Parent = workspace
                updateChams(desyncCFrame)
            elseif chams and chams.Parent then
                chams.Parent = nil
            end
        else
            if tracer then tracer.Visible = false end
            if chams and chams.Parent then chams.Parent = nil end
        end
        hrp.CFrame = desyncCFrame
        RunService.RenderStepped:Wait()
        hrp.CFrame = M.config.originalPosition
    end)

    pcall(function()
        if not (getrawmetatable and setreadonly and newcclosure and checkcaller) then return end
        local mt = getrawmetatable(game)
        if not mt then return end
        local oldIndex = mt.__index
        setreadonly(mt, false)
        mt.__index = newcclosure(function(self, key)
            if not checkcaller() and M.config.enabled and key == "CFrame" then
                local hrp = getHRP()
                if hrp and self == hrp then return M.config.lastDesync end
            end
            return oldIndex(self, key)
        end)
        setreadonly(mt, true)
    end)

    function M.setEnabled(v)
        M.config.enabled = v and true or false
        if not M.config.enabled then
            if tracer then tracer.Visible = false end
            if chams and chams.Parent then chams.Parent = nil end
        end
    end
    function M.setType(v) M.config.type = v end
    function M.setRandom(v) M.config.randomization = v end
    function M.setVisualize(v) M.config.visualize = v and true or false end
    function M.setTracer(v) M.config.visualizeTracer = v and true or false end
    function M.setChar(v) M.config.visualizeChar = v and true or false end
    function M.setTarget(name) M.config.targetName = name end
    function M.setStatic(axis, v)
        if axis == "X" then M.config.staticX = v
        elseif axis == "Y" then M.config.staticY = v
        elseif axis == "Z" then M.config.staticZ = v end
    end
    function M.setColor(c)
        M.config.visualizeColor = c
        if chams then
            for _, p in ipairs(chams:GetChildren()) do
                if p:IsA("MeshPart") then p.Color = c end
            end
        end
    end
    function M.resetAll()
        M.config.enabled = false
        M.config.visualize = false
        if tracer then tracer.Visible = false end
        if chams and chams.Parent then chams.Parent = nil end
    end
    return M
end)()

CSync.setColor(Color3.fromRGB(0, 220, 200))

-- ============================================================
-- Velocity Desync Module
-- ============================================================
local velocityDesync = (function()
    local state = { _init = true, enabled = false, savedCFrame = nil, savedVel = nil, savedAng = nil, conns = {} }
    local function getHRP()
        local Char = Player.Character
        if not Char then return nil, nil end
        return Char:FindFirstChild("HumanoidRootPart"), Char:FindFirstChildOfClass("Humanoid")
    end
    local function restore()
        local HRP = getHRP()
        if not HRP then return end
        if state.savedCFrame then HRP.CFrame = state.savedCFrame end
        if state.savedVel then HRP.AssemblyLinearVelocity = state.savedVel end
        if state.savedAng then HRP.AssemblyAngularVelocity = state.savedAng end
    end
    local function start()
        if state.enabled then return end
        state.enabled = true
        local HRP = getHRP()
        if HRP then
            state.savedCFrame = HRP.CFrame
            state.savedVel = HRP.AssemblyLinearVelocity
            state.savedAng = HRP.AssemblyAngularVelocity
        end
        state.conns[#state.conns + 1] = RunService.Heartbeat:Connect(function()
            if not state.enabled then return end
            local HRP, Hum = getHRP()
            if not HRP or not Hum or Hum.Health <= 0 then return end
            local realCFrame = HRP.CFrame
            local realVel = HRP.AssemblyLinearVelocity
            local realAng = HRP.AssemblyAngularVelocity
            state.savedCFrame = realCFrame
            HRP.CFrame = realCFrame * CFrame.new(9e9, 0, 9e9)
            RunService.RenderStepped:Wait()
            HRP.CFrame = realCFrame
            HRP.AssemblyLinearVelocity = realVel
            HRP.AssemblyAngularVelocity = realAng
        end)
        if not state._indexHook then
            local old
            old = hookmetamethod(game, "__index", newcclosure(function(self, key)
                if not checkcaller() and state.enabled and key == "CFrame" then
                    local HRP, Hum = getHRP()
                    if HRP and Hum and Hum.Health > 0 and self == HRP and state.savedCFrame then
                        return state.savedCFrame
                    end
                end
                return old(self, key)
            end))
            state._indexHook = old
        end
        if not state._newindexHook then
            local old
            old = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
                if not checkcaller() and state.enabled then
                    local HRP = getHRP()
                    if HRP and self == HRP and (key == "AssemblyLinearVelocity" or key == "Velocity") then
                        state.savedVel = value
                    end
                end
                return old(self, key, value)
            end))
            state._newindexHook = old
        end
    end
    local function stop()
        if not state.enabled then return end
        state.enabled = false
        restore()
        for _, c in ipairs(state.conns) do if c and c.Disconnect then c:Disconnect() end end
        state.conns = {}
    end
    return function(enable)
        if enable == nil then
            if state.enabled then stop() else start() end
        elseif enable then start() else stop() end
        return state.enabled
    end
end)()

-- ============================================================
-- Invisible Desync Module
-- ============================================================
local invisibleDesync = (function()
    local state = { enabled = false, lastCFrame = nil, conn = nil, hookInstalled = false }
    local function getHRP()
        local Char = Player.Character
        if not Char then return nil, nil end
        return Char:FindFirstChild("HumanoidRootPart"), Char:FindFirstChildOfClass("Humanoid")
    end
    local function start()
        if state.enabled then return end
        state.enabled = true
        if not state.conn then
            state.conn = RunService.Heartbeat:Connect(function()
                if not state.enabled then return end
                local HRP = getHRP()
                if not HRP then return end
                state.lastCFrame = HRP.CFrame
                HRP.CFrame = state.lastCFrame * CFrame.new(9e9, 0, 9e9)
                RunService.RenderStepped:Wait()
                if state.lastCFrame then HRP.CFrame = state.lastCFrame end
            end)
        end
        if not state.hookInstalled then
            state.hookInstalled = true
            local old
            old = hookmetamethod(game, "__index", newcclosure(function(self, key)
                if not checkcaller() and key == "CFrame" and state.enabled then
                    local HRP, Hum = getHRP()
                    if HRP and Hum and Hum.Health > 0 and self == HRP and state.lastCFrame then
                        return state.lastCFrame
                    end
                end
                return old(self, key)
            end))
        end
    end
    local function stop()
        if not state.enabled then return end
        state.enabled = false
        if state.conn then state.conn:Disconnect(); state.conn = nil end
    end
    return function(enable)
        if enable == nil then
            if state.enabled then stop() else start() end
        elseif enable then start() else stop() end
        return state.enabled
    end
end)()

-- ============================================================
-- Macro Module (Crispy.lol draggable toggle)
-- ============================================================
local Macro = (function()
    local player           = game.Players.LocalPlayer
    local camera           = workspace.CurrentCamera
    local RunService       = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local VIM              = game:GetService("VirtualInputManager")

    local M = { enabled = false, gui = nil, mainBtn = nil, stroke = nil, conns = {} }

    local isFacingForward = false
    local isControlHeld   = false
    local faceConn

    local function faceForward()
        local character = player.Character
        if not character then return end
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local lookVector = camera.CFrame.LookVector
        local flatLookVector = Vector3.new(lookVector.X, 0, lookVector.Z).Unit
        hrp.CFrame = CFrame.new(hrp.Position, hrp.Position + flatLookVector)
    end

    local function stopEverything()
        isFacingForward = false
        isControlHeld   = false
        if faceConn then faceConn:Disconnect(); faceConn = nil end
        if M.mainBtn then
            M.mainBtn.Text = "Crispy.lol"
            if M.stroke then M.stroke.Color = Color3.fromRGB(0, 200, 255) end
        end
        pcall(function() VIM:SendKeyEvent(false, Enum.KeyCode.LeftControl, false, game) end)
    end

    local function loopFaceForward()
        if faceConn then faceConn:Disconnect() end
        faceConn = RunService.RenderStepped:Connect(function()
            local char = player.Character
            if isFacingForward and char and char:FindFirstChild("katana") then
                faceForward()
            else
                stopEverything()
            end
        end)
    end

    local function toggle()
        local char = player.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local bp   = player:FindFirstChild("Backpack")

        if isFacingForward then
            stopEverything()
            return
        end

        local toolInHand     = char and char:FindFirstChild("katana")
        local toolInBackpack = bp and bp:FindFirstChild("katana")

        if toolInHand or toolInBackpack then
            if toolInBackpack and hum then
                hum:EquipTool(toolInBackpack)
            end
            isFacingForward = true
            isControlHeld   = true
            if M.mainBtn then M.mainBtn.Text = "ON" end
            if M.stroke then M.stroke.Color = Color3.fromRGB(0, 255, 100) end
            pcall(function() VIM:SendKeyEvent(true, Enum.KeyCode.LeftControl, false, game) end)
            loopFaceForward()
        else
            if M.mainBtn then M.mainBtn.Text = "NO KATANA" end
            if M.stroke then M.stroke.Color = Color3.fromRGB(255, 80, 80) end
            task.wait(1)
            if not isFacingForward then
                if M.mainBtn then M.mainBtn.Text = "Crispy.lol" end
                if M.stroke then M.stroke.Color = Color3.fromRGB(0, 200, 255) end
            end
        end
    end

    local function buildGui()
        if M.gui then
            M.gui.Enabled = true
            return
        end
        local pg = player:FindFirstChild("PlayerGui") or player:WaitForChild("PlayerGui")
        local gui = Instance.new("ScreenGui")
        gui.Name           = "CrispyToggle"
        gui.ResetOnSpawn   = false
        gui.IgnoreGuiInset = true
        gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        gui.DisplayOrder   = 999
        gui.Parent         = pg

        local btn = Instance.new("TextButton")
        btn.Name              = "MainBtn"
        btn.Size              = UDim2.new(0, 150, 0, 45)
        btn.Position          = UDim2.new(0.5, -75, 0.5, -22)
        btn.BackgroundColor3  = Color3.fromRGB(25, 25, 30)
        btn.BorderSizePixel   = 0
        btn.Text              = "Crispy.lol"
        btn.TextColor3        = Color3.fromRGB(255, 255, 255)
        btn.TextScaled        = true
        btn.Font              = Enum.Font.GothamBold
        btn.AutoButtonColor   = false
        btn.Active            = true
        btn.Parent            = gui

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 10)
        c.Parent       = btn

        local s = Instance.new("UIStroke")
        s.Color        = Color3.fromRGB(0, 200, 255)
        s.Thickness    = 2
        s.Parent       = btn

        M.mainBtn = btn
        M.stroke  = s

        local dragging, wasDrag, dragInput, pressStart, startPos
        local DRAG_THRESHOLD = 5

        table.insert(M.conns, btn.InputBegan:Connect(function(input)
            if dragging then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging   = true
                wasDrag    = false
                dragInput  = input
                pressStart = input.Position
                startPos   = btn.Position
            end
        end))

        table.insert(M.conns, UserInputService.InputChanged:Connect(function(input)
            if not dragging or input ~= dragInput then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local delta = input.Position - pressStart
            if not wasDrag and delta.Magnitude > DRAG_THRESHOLD then wasDrag = true end
            if wasDrag then
                btn.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + delta.X,
                    startPos.Y.Scale, startPos.Y.Offset + delta.Y
                )
            end
        end))

        table.insert(M.conns, UserInputService.InputEnded:Connect(function(input)
            if not dragging or input ~= dragInput then return end
            dragging = false
            if not wasDrag then toggle() end
            dragInput  = nil
            pressStart = nil
        end))

        M.gui = gui
    end

    function M.setEnabled(v)
        v = v and true or false
        if M.enabled == v then return end
        M.enabled = v
        if v then
            buildGui()
        else
            stopEverything()
            if M.gui then M.gui.Enabled = false end
        end
    end

    return M
end)()

-- ============================================================
-- Movement Modules
-- ============================================================
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera

-- fly
local Fly = (function()
    local M = { enabled = false, initialized = false, speed = 50, onStateChange = nil }
    local CONFIG = { Speed = 50, BoostMultiplier = 2.5, ToggleKey = Enum.KeyCode.F, JumpHoldTime = 0.15, MaxPitchFactor = 1.0 }
    local IS_MOBILE = UserInputService.TouchEnabled
    local flying, boost, upHeld, downHeld, jumpUpExpire = false, false, false, false, 0
    local bodyVelocity, humanoid, rootPart
    local savedWalkSpeed, savedJumpPower, savedJumpHeight

    local function setJumpButtonVisible(visible)
        if not IS_MOBILE then return end
        local pg = Player:FindFirstChild("PlayerGui"); if not pg then return end
        local touchGui = pg:FindFirstChild("TouchGui"); if not touchGui then return end
        local cf = touchGui:FindFirstChild("TouchControlFrame"); if not cf then return end
        local jb = cf:FindFirstChild("JumpButton"); if jb then jb.Visible = visible end
    end
    local function fireStateChange() if M.onStateChange then pcall(M.onStateChange, flying) end end
    local function startFly()
        if flying then return end
        local char = Player.Character; if not char then return end
        rootPart = char:FindFirstChild("HumanoidRootPart")
        humanoid = char:FindFirstChildOfClass("Humanoid")
        if not rootPart or not humanoid then return end
        savedWalkSpeed = humanoid.WalkSpeed; savedJumpPower = humanoid.JumpPower; savedJumpHeight = humanoid.JumpHeight
        humanoid.WalkSpeed = 0; humanoid.JumpPower = 0; humanoid.JumpHeight = 0
        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5); bodyVelocity.Velocity = Vector3.zero; bodyVelocity.Parent = rootPart
        flying = true; boost = false; upHeld = false; downHeld = false
        setJumpButtonVisible(false); fireStateChange()
    end
    local function stopFly()
        if not flying then return end
        flying = false; boost = false; upHeld = false; downHeld = false
        if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end
        if humanoid then humanoid.WalkSpeed = savedWalkSpeed or 16; humanoid.JumpPower = savedJumpPower or 50; humanoid.JumpHeight = savedJumpHeight or 7.2 end
        setJumpButtonVisible(true); fireStateChange()
    end
    function M.toggle() if flying then stopFly() else startFly() end end
    function M.isOn() return flying end
    function M.setEnabled(state) if state then M.init(); startFly() else stopFly() end end
    function M.setSpeed(v) M.speed = math.clamp(tonumber(v) or 50, 1, 500) end
    function M.init()
        if M.initialized then return end; M.initialized = true
        RunService.RenderStepped:Connect(function()
            if not flying then return end
            if not rootPart or not rootPart.Parent or not bodyVelocity or not humanoid then stopFly(); return end
            local move = Vector3.zero
            local md = humanoid.MoveDirection
            if md.Magnitude > 0.01 then
                local localDir = Camera.CFrame:VectorToObjectSpace(md)
                local forwardAmt = -localDir.Z
                local rightAmt = localDir.X
                local look = Camera.CFrame.LookVector
                if CONFIG.MaxPitchFactor < 1 then
                    local flat = Vector3.new(look.X, 0, look.Z)
                    if flat.Magnitude > 0 then
                        flat = flat.Unit
                        local pitch = math.asin(math.clamp(look.Y, -1, 1))
                        local maxP = math.asin(CONFIG.MaxPitchFactor)
                        pitch = math.clamp(pitch, -maxP, maxP)
                        local horiz = math.cos(pitch)
                        look = Vector3.new(flat.X*horiz, math.sin(pitch), flat.Z*horiz).Unit
                    end
                end
                move += look * forwardAmt
                move += Camera.CFrame.RightVector * rightAmt
            end
            local now = tick()
            if upHeld or (now < jumpUpExpire) then move += Vector3.yAxis end
            if downHeld then move -= Vector3.yAxis end
            local speed = M.speed * (boost and CONFIG.BoostMultiplier or 1)
            if move.Magnitude > 0 then bodyVelocity.Velocity = move.Unit * speed else bodyVelocity.Velocity = Vector3.zero end
        end)
        UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            local key = input.KeyCode
            if key == CONFIG.ToggleKey then M.toggle(); return end
            if not flying then return end
            if key == Enum.KeyCode.Space or key == Enum.KeyCode.E then upHeld = true
            elseif key == Enum.KeyCode.LeftControl or key == Enum.KeyCode.Q then downHeld = true
            elseif key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.RightShift then boost = true end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            local key = input.KeyCode
            if key == Enum.KeyCode.Space or key == Enum.KeyCode.E then upHeld = false
            elseif key == Enum.KeyCode.LeftControl or key == Enum.KeyCode.Q then downHeld = false
            elseif key == Enum.KeyCode.LeftShift or key == Enum.KeyCode.RightShift then boost = false end
        end)
        UserInputService.JumpRequest:Connect(function() if flying and IS_MOBILE then jumpUpExpire = tick() + CONFIG.JumpHoldTime end end)
        Player.CharacterAdded:Connect(function() if flying then stopFly() end; rootPart = nil; humanoid = nil end)
    end
    return M
end)()

-- walkspeed
local WalkSpeed = (function()
    local M = { enabled = false, initialized = false, speed = 16 }
    local conn, bv, char, hum, root
    local function cleanup()
        if conn then conn:Disconnect(); conn = nil end
        if bv and bv.Parent then bv:Destroy() end
        bv = nil
    end
    local function setup()
        cleanup()
        char = Player.Character; if not char then return end
        hum = char:FindFirstChildOfClass("Humanoid"); root = char:FindFirstChild("HumanoidRootPart")
        if not hum or not root then return end
        if root:FindFirstChild("SpeedBypass") then root.SpeedBypass:Destroy() end
        bv = Instance.new("BodyVelocity"); bv.Name = "SpeedBypass"; bv.MaxForce = Vector3.new(math.huge, 0, math.huge); bv.Velocity = Vector3.zero; bv.Parent = root
        conn = RunService.RenderStepped:Connect(function()
            if not M.enabled then return end
            if not bv or not bv.Parent or not hum or not hum.Parent then return end
            if hum.MoveDirection.Magnitude > 0 then
                bv.Velocity = Vector3.new(hum.MoveDirection.X * M.speed, 0, hum.MoveDirection.Z * M.speed)
            else
                bv.Velocity = Vector3.zero
            end
        end)
    end
    function M.setEnabled(v) M.enabled = v and true or false; if M.enabled then M.init(); setup() else cleanup() end end
    function M.setSpeed(v) M.speed = math.clamp(tonumber(v) or 16, 1, 500) end
    function M.init() if M.initialized then return end; M.initialized = true; Player.CharacterAdded:Connect(function() task.wait(0.5); if M.enabled then setup() end end) end
    return M
end)()

-- cframe speed
local CFrameSpeed = (function()
    local M = { enabled = false, speed = 100 }
    local connection, characterConn, deathConn
    local function moveCharacter(dt)
        if not M.enabled then return end
        local char = Player.Character; if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not humanoid then return end
        local dir = humanoid.MoveDirection
        if dir.Magnitude < 0.01 then return end
        hrp.CFrame = hrp.CFrame + dir.Unit * M.speed * dt
    end
    local function startCFrame() if connection then return end; connection = RunService.RenderStepped:Connect(moveCharacter) end
    local function stopCFrame() if connection then connection:Disconnect(); connection = nil end end
    local function onCharacterAdded(char)
        stopCFrame()
        if deathConn then deathConn:Disconnect(); deathConn = nil end
        local hum = char:WaitForChild("Humanoid", 5)
        if not hum then return end
        if M.enabled then startCFrame() end
        deathConn = hum.Died:Connect(function() stopCFrame() end)
    end
    if Player.Character then onCharacterAdded(Player.Character) end
    characterConn = Player.CharacterAdded:Connect(onCharacterAdded)
    function M.setEnabled(v) M.enabled = v and true or false; if M.enabled then startCFrame() else stopCFrame() end end
    function M.setSpeed(v) M.speed = math.clamp(tonumber(v) or 100, 1, 500) end
    return M
end)()

-- jumppower
local JumpPower = (function()
    local M = { enabled = false, initialized = false, power = 50 }
    local hookedHum = nil
    local oldNewIndex = nil
    local function applyToHumanoid(hum) if not hum then return end; pcall(function() hum.UseJumpPower = true; hum.JumpPower = M.power end); hookedHum = hum end
    local function installHook()
        if oldNewIndex then return end
        oldNewIndex = hookmetamethod(game, "__newindex", newcclosure(function(self, key, value)
            if not checkcaller() and M.enabled and self == hookedHum and key == "JumpPower" then
                if value ~= M.power then return end
            end
            return oldNewIndex(self, key, value)
        end))
    end
    local function setup()
        local char = Player.Character; if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end
        applyToHumanoid(hum); installHook()
    end
    function M.setEnabled(v) M.enabled = v and true or false; if M.enabled then M.init(); setup() else hookedHum = nil end end
    function M.setPower(v) M.power = math.clamp(tonumber(v) or 50, 1, 500); if M.enabled and hookedHum then pcall(function() hookedHum.UseJumpPower = true; hookedHum.JumpPower = M.power end) end end
    function M.init() if M.initialized then return end; M.initialized = true; Player.CharacterAdded:Connect(function() task.wait(0.5); if M.enabled then setup() end end) end
    return M
end)()

-- ============================================================
-- Movement Misc Background Loops
-- ============================================================
local LP = game.Players.LocalPlayer
local UIS = game:GetService("UserInputService")

local AutoReloadState = { Enabled = false }
RunService.RenderStepped:Connect(function()
    if not AutoReloadState.Enabled then return end
    local char = LP.Character; if not char then return end
    local tool = char:FindFirstChildOfClass("Tool"); if not tool then return end
    local ammo = tool:FindFirstChild("AMMO")
    if ammo and ammo.Value <= 0 then
        local rl = tool:FindFirstChild("rl")
        if rl then pcall(function() rl:FireServer() end) end
    end
end)

local AntiStompState = { Enabled = false }
local antiStompResetting = false
local function antiStomp_OnCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 5)
    if not humanoid then return end
    antiStompResetting = false
    humanoid.HealthChanged:Connect(function(health)
        if not AntiStompState.Enabled or antiStompResetting then return end
        if health >= 1 and health <= 20 then
            antiStompResetting = true
            task.wait(0.1)
            if humanoid.Parent and humanoid.Health > 0 then
                pcall(function() humanoid.Health = 0 end)
            end
            antiStompResetting = false
        end
    end)
end
LP.CharacterAdded:Connect(antiStomp_OnCharacter)
if LP.Character then antiStomp_OnCharacter(LP.Character) end

local StompState = { Enabled = false, Speed = 10 }
local stompLastFire, stompFirstFired = 0, false
RunService.RenderStepped:Connect(function()
    if not StompState.Enabled then stompFirstFired = false; return end
    local remote = game:GetService("ReplicatedStorage"):FindFirstChild("MAINEVENT") or game:GetService("ReplicatedStorage"):FindFirstChild("MainEvent")
    if not remote then return end
    local delay = math.clamp(1 / StompState.Speed, 0.01, 1)
    if tick() - stompLastFire >= delay then
        pcall(function() remote:FireServer("STOMP") end)
        stompLastFire = tick()
    end
end)

local RapidFire = (function()
    local M = { enabled = false, initialized = false }
    local FIRE_RATE, mouseDown = 0.015, false
    local function getTool()
        local char = LP.Character
        if not char then return nil end
        return char:FindFirstChildOfClass("Tool")
    end
    local function activateTool()
        local tool = getTool()
        if tool then pcall(function() tool:Activate() end) end
    end
    local function init()
        if M.initialized then return end
        M.initialized = true
        UIS.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseDown = true end
        end)
        UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 then mouseDown = false end
        end)
        task.spawn(function()
            while true do
                if M.enabled and mouseDown then
                    activateTool()
                    task.wait(FIRE_RATE)
                else
                    task.wait(0.1)
                end
            end
        end)
    end
    function M.setEnabled(state) M.enabled = state and true or false; if M.enabled then init() end end
    function M.setFireRate(v) FIRE_RATE = math.clamp(tonumber(v) or 0.015, 0.005, 1) end
    return M
end)()


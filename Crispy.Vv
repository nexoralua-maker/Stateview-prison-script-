local CurrentTargetPlayer = nil
local IsSpectating = false

TargetAimSection:Textbox({
    Name = "Target Player", Flag = "ta_target_name",
    Placeholder = "Username or Display Name...", Finished = false,
    Callback = function(Value)
        local query = string.lower(Value)
        CurrentTargetPlayer = nil
        if query == "" then
            BulletLogic.Targeting.Target = nil
            if BulletLogic.Visualizer then BulletLogic.Visualizer:Destroy() BulletLogic.Visualizer = nil end
            return
        end
        for _, p in ipairs(game.Players:GetPlayers()) do
            if p ~= Player then
                local name, display = string.lower(p.Name), string.lower(p.DisplayName)
                if name == query or display == query or string.find(name, query, 1, true) or string.find(display, query, 1, true) then
                    CurrentTargetPlayer = p; break
                end
            end
        end
        if CurrentTargetPlayer then
            BulletLogic.Targeting.Target = CurrentTargetPlayer
            BulletLogic.Functions.UpdateTargetVisualizer()
        end
    end
})

TargetAimSection:Toggle({
    Name = "Spectate", Flag = "ta_spectate", Default = false,
    Callback = function(Value)
        IsSpectating = Value
        if not Value then
            local hum = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
            if hum then game.Workspace.CurrentCamera.CameraSubject = hum end
        end
    end
})

game:GetService("RunService").RenderStepped:Connect(function()
    if IsSpectating and CurrentTargetPlayer and CurrentTargetPlayer.Character then
        local hum = CurrentTargetPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then game.Workspace.CurrentCamera.CameraSubject = hum end
    end
end)

TargetAimSection:Button({
    Name = "Teleport to Target",
    Callback = function()
        if CurrentTargetPlayer and CurrentTargetPlayer.Character and Player.Character then
            local myHRP = Player.Character:FindFirstChild("HumanoidRootPart")
            local tgtHRP = CurrentTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if myHRP and tgtHRP then myHRP.CFrame = tgtHRP.CFrame + Vector3.new(0, 3, 3) end
        end
    end
})

TargetAimSection:Toggle({
    Name = "Bullet TP", Flag = "ta_bullettp", Default = false,
    Callback = function(Value) BulletTPEnabled = Value end
})


})

-- ⭐ Macro toggle (bottom of JumpPower slider, inside Movements)
local MacroToggle = MovementSection:Toggle({
    Name = "Macro", Flag = "mv_macro", Default = false,
    Callback = function(Value) Macro.setEnabled(Value) end
})

MacroToggle:Keybind({
    Name = "Macro Key", Flag = "mv_macro_key",
    Default = Enum.KeyCode.M, Mode = "Toggle",
    Callback = function(Toggled)
        if MacroToggle.SetValue then MacroToggle:SetValue(Toggled) end
        Macro.setEnabled(Toggled)
    end
})

-- ============================================================
-- Misc Section (Side 1) — no Macro (moved to Movements)
-- ============================================================
local MiscSection = MovementPage:Section({
    Name = "Misc",
    Side = 1
})

MiscSection:Toggle({
    Name = "Auto Reload", Flag = "misc_ar", Default = false,
    Callback = function(v) AutoReloadState.Enabled = v end
})

MiscSection:Toggle({
    Name = "Anti Stomp", Flag = "misc_as", Default = false,
    Callback = function(v) AntiStompState.Enabled = v end
})

MiscSection:Button({
    Name = "No Jump Cooldown",
    Callback = function()
        if _G.__NO_JUMP_CD_ACTIVE then return end
        if type(hookfunction) ~= "function" then return end
        local ok = pcall(function()
            local originalWait
            originalWait = hookfunction(wait, newcclosure(function(seconds)
                return originalWait(0)
            end))
        end)
        if ok then _G.__NO_JUMP_CD_ACTIVE = true end
    end
})

MiscSection:Toggle({
    Name = "Chatlogs", Flag = "misc_chatlogs", Default = false,
    Callback = function(v)
        pcall(function()
            local TextChatService = game:GetService("TextChatService")
            TextChatService.ChatWindowConfiguration.Enabled = v
        end)
    end
})

MiscSection:Button({
    Name = "No Slow",
    Callback = function()
        if _G.__NO_SLOW_ACTIVE then return end
        local ok = pcall(function()
            local mt = getrawmetatable(game)
            if not mt then error("no metatable") end
            local backup
            backup = hookfunction(mt.__newindex, newcclosure(function(self, key, value)
                if key == "WalkSpeed" and type(value) == "number" and value < 16 then
                    value = 16
                end
                return backup(self, key, value)
            end))
        end)
        if ok then _G.__NO_SLOW_ACTIVE = true end
    end
})

MiscSection:Toggle({
    Name = "Auto Stomp", Flag = "misc_stomp", Default = false,
    Callback = function(v) StompState.Enabled = v end
})

MiscSection:Slider({
    Name = "Stomp Speed", Flag = "misc_stomp_speed",
    Min = 1, Max = 500, Default = 10, Decimals = 1,
    Callback = function(Value) StompState.Speed = math.round(Value) end
})

MiscSection:Toggle({
    Name = "Rapid Fire", Flag = "misc_rapidfire", Default = false,
    Callback = function(v) RapidFire.setEnabled(v) end
})

MiscSection:Textbox({
    Name = "Rapid Fire Rate", Flag = "misc_rapidfire_rate",
    Default = "0.015", Placeholder = "0.015",
    Numeric = true, Finished = true,
    Callback = function(Value)
        local n = tonumber(Value)
        if n then RapidFire.setFireRate(n) end
    end
})

-- ============================================================
-- Auto Buy Background Logic
-- ============================================================
local AutoBuyState = {
    AutoFood  = false, SelectedFood  = "[Chicken]",
    AutoArmor = false, SelectedArmor = "[Medium Armor]",
    AutoGun   = false, SelectedGun   = "[Silencer]"
}

local function SafeFireClickDetector(padName)
    if not padName then return false end
    local function tryClick(obj)
        if not obj then return false end
        local det = obj:FindFirstChildOfClass("ClickDetector") or obj:FindFirstChildWhichIsA("ClickDetector")
        if det then
            pcall(function() fireclickdetector(det) end)
            return true
        end
        return false
    end
    local map = game:GetService("Workspace"):FindFirstChild("MAP")
    if map then
        for _, group in ipairs({ "Pads", "Shops", "Shop", "Items" }) do
            local g = map:FindFirstChild(group)
            if g then
                local pad = g:FindFirstChild(padName)
                if tryClick(pad) then return true end
            end
        end
    end
    for _, obj in ipairs(game:GetService("Workspace"):GetDescendants()) do
        if obj.Name == padName and tryClick(obj) then return true end
    end
    return false
end

task.spawn(function()
    while task.wait(0.5) do
        pcall(SafeFireClickDetector, AutoBuyState.AutoFood  and AutoBuyState.SelectedFood  or nil)
        pcall(SafeFireClickDetector, AutoBuyState.AutoArmor and AutoBuyState.SelectedArmor or nil)
        pcall(SafeFireClickDetector, AutoBuyState.AutoGun   and AutoBuyState.SelectedGun   or nil)
    end
end)


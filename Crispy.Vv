    Name = "CFrame", Flag = "mv_cframe", Default = false,
    Callback = function(Value) CFrameSpeed.setEnabled(Value) end
})

MovementSection:Slider({
    Name = "CFrame Speed", Flag = "mv_cframe_speed",
    Min = 1, Max = 500, Default = 100, Decimals = 1,
    Callback = function(Value) CFrameSpeed.setSpeed(math.round(Value)) end
})

MovementSection:Toggle({
    Name = "Walkspeed", Flag = "mv_ws", Default = false,
    Callback = function(Value) WalkSpeed.setEnabled(Value) end
})

MovementSection:Slider({
    Name = "Walkspeed Speed", Flag = "mv_ws_speed",
    Min = 1, Max = 500, Default = 16, Decimals = 1,
    Callback = function(Value) WalkSpeed.setSpeed(math.round(Value)) end
})

MovementSection:Toggle({
    Name = "JumpPower", Flag = "mv_jp", Default = false,
    Callback = function(Value) JumpPower.setEnabled(Value) end
})

MovementSection:Slider({

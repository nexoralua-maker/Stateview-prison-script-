-- TRIGGERBOT MODULE (Da Strike â€” mobile-safe)
-- ============================================================
local TriggerBot = (function()
    local M = { enabled = false, initialized = false }
 
    local SETTINGS = {
        UseFOV        = true,
        FOVRadius     = 200,
        FireDelay     = 0.15,
        Prediction    = 0.134,
        SilentAim     = true,
        VisibleCheck  = false,
        IgnoreKnocked = true,
    }
 
    local last_shot = 0
    local main_remote = ReplicatedStorage:FindFirstChild("MAINEVENT")
 
    local function has_char(p)
        return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
    end
 
    local function is_knocked(p)
        if not has_char(p) then return false end
        local be = p.Character:FindFirstChild("BodyEffects")
        if not be then return false end
        local ko = be:FindFirstChild("K.O")
        return ko and ko.Value or false
    end
 
    local function is_behind_wall(p)
        if not has_char(p) or not has_char(player) then return false end
        local parts = camera:GetPartsObscuringTarget(
            { player.Character.HumanoidRootPart.Position, p.Character.HumanoidRootPart.Position },
            { player.Character, p.Character }
        )
        return #parts > 0
    end
 
    local function get_equipped_gun()
        if not player.Character then return nil end
        return player.Character:FindFirstChildWhichIsA("Tool")
    end
 
    local function get_closest_player(radius)
        local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
        local closest, dist = nil, radius
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and has_char(p) then
                local pos, on = camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                if on then
                    local d = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if d < dist then
                        dist = d
                        closest = p
                    end
                end
            end
        end
        return closest, dist
    end
 
    local function init()
        if M.initialized then return end
        M.initialized = true
 
        RunService.RenderStepped:Connect(function()
            if not M.enabled then return end
            if tick() - last_shot < SETTINGS.FireDelay then return end
 
            local gun = get_equipped_gun()
            if not gun then return end
 
            local radius = SETTINGS.UseFOV and SETTINGS.FOVRadius or 9999
            local target = get_closest_player(radius)
            if not target then return end
 
            if SETTINGS.VisibleCheck and is_behind_wall(target) then return end
            if SETTINGS.IgnoreKnocked and is_knocked(target) then return end
 
            local hrp = target.Character.HumanoidRootPart
            local screen_pos, on_screen = camera:WorldToViewportPoint(hrp.Position)
            if not on_screen then return end
 
            local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
            if (Vector2.new(screen_pos.X, screen_pos.Y) - center).Magnitude > radius then return end
 
            last_shot = tick()
 
            if SETTINGS.SilentAim and main_remote then
                local predicted = hrp.Position + hrp.Velocity * SETTINGS.Prediction
                pcall(function()
                    main_remote:FireServer("MOUSE", predicted)
                end)
            end
 
            pcall(function()
                gun:Activate()
            end)
        end)
 
        print("[TriggerBot] Initialized")
    end
 
    function M.setEnabled(state)
        M.enabled = state and true or false
        if M.enabled then
            init()
            last_shot = 0
        end
        print("[TriggerBot] " .. (M.enabled and "ON" or "OFF"))
    end
 
    return M
end)()
 

-- ============================================================
-- HIT DETECTION ("[DisplayName] Damaged u")
-- ============================================================
local HitDetection = (function()
    local M = { enabled = false, initialized = false }
 
    local GOLD = Color3.fromRGB(255, 210, 60)
 
    local CONFIG = {
        NotificationDuration  = 3,
        NotificationBackColor = GOLD,
        StrokeColor           = GOLD,
        StrokeThickness       = 1.5,
        NotificationTextColor = Color3.fromRGB(20, 20, 20),
        Position              = UDim2.new(0, 20, 0, 20),
 
        MergeWindow           = 0.8,
        MaxStackDisplay       = 99,
        ShowHitCounter        = true,
        DebounceWindow        = 0.05,
 
        RecentShotWindow      = 1.0,
        BulletOwnerRadius     = 12,
        FacingThreshold       = 0.45,
        MaxAttackerDistance   = 250,
        MinConfidenceScore    = 55,
    }
 
    local CoreGui = game:GetService("CoreGui")
    local screen_gui, active_notifs, merge_map
    local recent_shots = {}
    local last_hit_time = 0
 
    local HIT_PARENTS = { "HB", "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart", "Torso" }
 
    -- ---- Notification UI ----
    local function reposition_all()
        local base_y = CONFIG.Position.Y.Offset
        for i, notif in ipairs(active_notifs) do
            local target_pos = UDim2.new(
                CONFIG.Position.X.Scale, CONFIG.Position.X.Offset,
                CONFIG.Position.Y.Scale, base_y + (i - 1) * 36
            )
            TweenService:Create(notif, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Position = target_pos
            }):Play()
        end
    end
 
    local function build_notif_container(text)
        local container = Instance.new("Frame")
        container.Name = "Notif_" .. tick()
        container.Position = UDim2.new(
            CONFIG.Position.X.Scale, CONFIG.Position.X.Offset - 40,
            CONFIG.Position.Y.Scale, CONFIG.Position.Y.Offset
        )
        container.Size = UDim2.fromOffset(10, 30)
        container.BackgroundColor3 = CONFIG.NotificationBackColor
        container.BackgroundTransparency = 1
        container.BorderSizePixel = 0
        container.Parent = screen_gui
 
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = container
 
        local stroke = Instance.new("UIStroke")
        stroke.Color = CONFIG.StrokeColor
        stroke.Thickness = CONFIG.StrokeThickness
        stroke.Transparency = 1
        stroke.Parent = container
 
        local label = Instance.new("TextLabel")
        label.Name = "Label"
        label.BackgroundTransparency = 1
        label.BorderSizePixel = 0
        label.Position = UDim2.fromOffset(10, 0)
        label.Size = UDim2.new(1, -20, 1, 0)
        label.Font = Enum.Font.GothamBold
        label.Text = text
        label.TextColor3 = CONFIG.NotificationTextColor
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.TextTransparency = 1
        label.Parent = container
 
        task.wait()
        local text_width = math.max(label.TextBounds.X + 24, 100)
        container.Size = UDim2.fromOffset(text_width, 30)
 
        TweenService:Create(container, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(text_width, 30),
            BackgroundTransparency = 0,
            Position = UDim2.new(
                CONFIG.Position.X.Scale, CONFIG.Position.X.Offset,
                CONFIG.Position.Y.Scale, CONFIG.Position.Y.Offset
            ),
        }):Play()
        TweenService:Create(stroke, TweenInfo.new(0.2), { Transparency = 0 }):Play()
        TweenService:Create(label, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
 
        return container, label, stroke
    end
 
    local function destroy_notif(container)
        if not container or not container.Parent then return end
 
        TweenService:Create(container, TweenInfo.new(0.3), {
            BackgroundTransparency = 1,
            Position = UDim2.new(
                CONFIG.Position.X.Scale,
                CONFIG.Position.X.Offset - 30,
                CONFIG.Position.Y.Scale,
                container.Position.Y.Offset
            ),
        }):Play()
        for _, child in ipairs(container:GetChildren()) do
            if child:IsA("UIStroke") then
                TweenService:Create(child, TweenInfo.new(0.3), { Transparency = 1 }):Play()
            elseif child:IsA("TextLabel") then
                TweenService:Create(child, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
            end
        end
 
        task.wait(0.35)
        container:Destroy()
 
        local idx = table.find(active_notifs, container)
        if idx then table.remove(active_notifs, idx) end
        reposition_all()
    end
 
    local function show_hit(attacker_display_name)
        if not M.enabled then return end
        local now = tick()
        local key = attacker_display_name
        local existing = merge_map[key]
 
        if existing and (now - existing.last_time) <= CONFIG.MergeWindow then
            existing.count += 1
            existing.last_time = now
 
            local count = math.min(existing.count, CONFIG.MaxStackDisplay)
            local new_text = key .. " Damaged u" .. (CONFIG.ShowHitCounter and (" [x" .. count .. "]") or "")
            existing.label.Text = new_text
 
            task.wait()
            local new_w = math.max(existing.label.TextBounds.X + 24, 100)
            TweenService:Create(existing.container, TweenInfo.new(0.15, Enum.EasingStyle.Quad), {
                Size = UDim2.fromOffset(new_w, 30)
            }):Play()
 
            local stroke = existing.container:FindFirstChildOfClass("UIStroke")
            if stroke then
                stroke.Color = Color3.fromRGB(255, 255, 255)
                TweenService:Create(stroke, TweenInfo.new(0.25), { Color = GOLD }):Play()
            end
 
            if existing.timer then task.cancel(existing.timer) end
            existing.timer = task.delay(CONFIG.NotificationDuration, function()
                destroy_notif(existing.container)
                merge_map[key] = nil
            end)
            return
        end
 
        local display_text = key .. " Damaged u" .. (CONFIG.ShowHitCounter and " [x1]" or "")
        local container, label, stroke = build_notif_container(display_text)
 
        table.insert(active_notifs, container)
        reposition_all()
 
        local entry = {
            container = container,
            label = label,
            count = 1,
            last_time = now,
            timer = nil,
        }
 
        entry.timer = task.delay(CONFIG.NotificationDuration, function()
            destroy_notif(container)
            merge_map[key] = nil
        end)
 
        merge_map[key] = entry
    end
 
    -- ---- Bullet tracking ----
    local function is_bullet(obj)
        if not obj:IsA("BasePart") then return false end
        local n = obj.Name
        return n == "Part" or n == "BULLET_RAYS" or n == "bulletray"
    end
 
    local function find_beam(part)
        for _, c in ipairs(part:GetChildren()) do
            if c:IsA("Beam") then return c end
        end
        for _, c in ipairs(part:GetChildren()) do
            if c:IsA("Attachment") then
                for _, sub in ipairs(c:GetChildren()) do
                    if sub:IsA("Beam") then return sub end
                end
            end
        end
    end
 
    local function has_line_of_sight(from_pos, to_pos, ignore_char_1, ignore_char_2)
        local ray_direction = to_pos - from_pos
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {
            ignore_char_1,
            ignore_char_2,
            screen_gui,
        }
        params.IgnoreWater = true
 
        local result = workspace:Raycast(from_pos, ray_direction, params)
        return result == nil
    end
 
    local function find_attacker()
        local my_char = player.Character
        if not my_char then return nil end
        local my_hrp = my_char:FindFirstChild("HumanoidRootPart")
        if not my_hrp then return nil end
 
        local now = tick()
        local my_pos = my_hrp.Position
        local candidates = {}
 
        for _, p in ipairs(Players:GetPlayers()) do
            if p == player or not p.Character then continue end
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if not hrp then continue end
 
            local dist = (hrp.Position - my_pos).Magnitude
            if dist > CONFIG.MaxAttackerDistance then continue end
 
            local to_me = (my_pos - hrp.Position)
            if to_me.Magnitude < 0.01 then continue end
            to_me = to_me.Unit
            local facing_dot = to_me:Dot(hrp.CFrame.LookVector)
 
            local shot = recent_shots[p]
            local shot_age = shot and (now - shot.time) or 999
            local recently_shot = shot_age <= CONFIG.RecentShotWindow
 
            local trajectory_score = 0
            if shot and shot.direction then
                local to_us_from_origin = (my_pos - shot.origin)
                if to_us_from_origin.Magnitude > 0.1 then
                    to_us_from_origin = to_us_from_origin.Unit
                    local dir_match = shot.direction:Dot(to_us_from_origin)
                    if dir_match > 0.95 then
                        trajectory_score = 100
                    elseif dir_match > 0.85 then
                        trajectory_score = 70
                    elseif dir_match > 0.7 then
                        trajectory_score = 30
                    end
                end
            end
 
            local has_los = has_line_of_sight(hrp.Position, my_pos, my_char, p.Character)
 
            local score = 0
            if facing_dot >= CONFIG.FacingThreshold then
                score += facing_dot * 60
            end
            if recently_shot and shot then
                local recency_bonus = math.max(0, 80 * (1 - shot_age / CONFIG.RecentShotWindow))
                score += recency_bonus
                score += shot.confidence * 30
            end
            score += trajectory_score
            if has_los then score += 20 else score -= 30 end
            score -= math.min(dist * 0.08, 25)
 
            if facing_dot >= CONFIG.FacingThreshold or recently_shot or trajectory_score > 0 then
                table.insert(candidates, {
                    player = p,
                    score = score,
                })
            end
        end
 
        table.sort(candidates, function(a, b) return a.score > b.score end)
 
        local top = candidates[1]
        if top and top.score >= CONFIG.MinConfidenceScore then
            return top.player
        end
 
        return nil
    end
 
    local function on_hit_detected()
        if not M.enabled then return end
        local now = tick()
        if now - last_hit_time < CONFIG.DebounceWindow then return end
        last_hit_time = now
 
        local attacker = find_attacker()
        if attacker then
            show_hit(attacker.DisplayName)
        else
            show_hit("Someone")
        end
    end
 
    local function is_real_hit_blood(obj, character)
        if obj.Name ~= "BloodParticle"
            and obj.Name ~= "BloodSplatter"
            and obj.Name ~= "BloodParticles" then
            return false
        end
 
        local parent = obj.Parent
        if not parent then return false end
 
        local valid = false
        for _, name in ipairs(HIT_PARENTS) do
            if parent.Name == name then valid = true break end
        end
        if not valid then return false end
 
        local p = parent
        while p and p ~= character do
            if p:IsA("Tool") then return false end
            p = p.Parent
        end
 
        return true
    end
 
    local function watch_character(character)
        local humanoid = character:WaitForChild("Humanoid", 5)
        local last_health = humanoid and humanoid.Health or 100
 
        character.DescendantAdded:Connect(function(obj)
            if is_real_hit_blood(obj, character) then
                on_hit_detected()
            end
        end)
 
        if humanoid then
            humanoid.HealthChanged:Connect(function(new_health)
                if not M.enabled then
                    last_health = new_health
                    return
                end
                local drop = last_health - new_health
                if drop >= 1 and tick() - last_hit_time > 0.05 then
                    on_hit_detected()
                end
                last_health = new_health
            end)
        end
    end
 
    -- ---- Init ----
    function M.init()
        if M.initialized then return end
        M.initialized = true
 
        screen_gui = Instance.new("ScreenGui")
        screen_gui.Name = "CrispyHitNotifs"
        screen_gui.ResetOnSpawn = false
        screen_gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        screen_gui.Parent = CoreGui
 
        active_notifs = {}
        merge_map = {}
 
        workspace.ChildAdded:Connect(function(obj)
            if not M.enabled then return end
            if not is_bullet(obj) then return end
 
            task.spawn(function()
                local origin = obj.Position
 
                local beam, end_pos
                for i = 1, 25 do
                    beam = find_beam(obj)
                    if beam and beam.Attachment1 then
                        local wp = beam.Attachment1.WorldPosition
                        if wp and wp.Magnitude > 0 then
                            end_pos = wp
                            break
                        end
                    end
                    task.wait(0.01)
                end
 
                local direction
                if end_pos then
                    local diff = end_pos - origin
                    if diff.Magnitude > 0.1 then
                        direction = diff.Unit
                    end
                end
 
                local candidates = {}
                for _, p in ipairs(Players:GetPlayers()) do
                    if p == player or not p.Character then continue end
                    local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then continue end
                    local d = (hrp.Position - origin).Magnitude
                    if d <= CONFIG.BulletOwnerRadius then
                        table.insert(candidates, { player = p, distance = d })
                    end
                end
 
                if #candidates == 1 then
                    local p = candidates[1].player
                    recent_shots[p] = {
                        time = tick(),
                        origin = origin,
                        direction = direction,
                        confidence = 1.0,
                    }
                elseif #candidates > 1 then
                    table.sort(candidates, function(a, b) return a.distance < b.distance end)
                    local p = candidates[1].player
                    recent_shots[p] = {
                        time = tick(),
                        origin = origin,
                        direction = direction,
                        confidence = 0.4,
                    }
                end
            end)
        end)
 
        if player.Character then watch_character(player.Character) end
        player.CharacterAdded:Connect(watch_character)
 
        print("[Hit Detection] Initialized")
    end
 
    function M.setEnabled(state)
        M.enabled = state and true or false
        if M.enabled then
            M.init()
        else
            if active_notifs then
                for _, c in ipairs(active_notifs) do
                    if c and c.Parent then c:Destroy() end
                end
                active_notifs = {}
                merge_map = {}
                recent_shots = {}
            end
        end
        print("[Hit Detection] " .. (M.enabled and "ON" or "OFF"))
    end
 
    return M
end)()
 

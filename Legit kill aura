LockButton.MouseButton1Click:Connect(function()
    LockEnabled = not LockEnabled
    if LockEnabled then
        -- Find the absolute nearest player to lock onto instantly
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local closest, shortest = nil, math.huge
            for _, plr in Players:GetPlayers() do
                if plr ~= LocalPlayer and plr.Character then
                    local root = plr.Character:FindFirstChild("HumanoidRootPart")
                    local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                    if root and hum and hum.Health > 0 then
                        local dist = (myRoot.Position - root.Position).Magnitude
                        if dist < shortest then
                            shortest = dist
                            closest = plr
                        end
                    end
                end
            end
            LockedTarget = closest
        end
        
        LockButton.Text = "Target Lock: ON"
        LockButton.BackgroundColor3 = Color3.fromRGB(0, 150, 255) -- Bright Blue
    else
        LockedTarget = nil
        LockButton.Text = "Target Lock: OFF"
        LockButton.BackgroundColor3 = Color3.fromRGB(50, 50, 150)
    end
end)


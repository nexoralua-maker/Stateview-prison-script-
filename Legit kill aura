--// MAIN LOOP --------------------------------------------------
task.spawn(function()
    while task.wait(0.1) do
        local MyChar = LocalPlayer.Character
        local IsSwordEquipped = false
        
        if MyChar then
            for _, item in ipairs(MyChar:GetChildren()) do
                local name = string.lower(item.Name)
                if string.find(name, "netherite") and string.find(name, "sword") then
                    IsSwordEquipped = true; break
                end
            end
        end

        if not IsSwordEquipped then
            if not ForceStopped then
                ForceStopped = true
                ForceStopButton.Text = "Force Stop: ON (Auto)"
                ForceStopButton.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
            end
        else
            if ForceStopButton.Text == "Force Stop: ON (Auto)" then
                ForceStopped = false
                ForceStopButton.Text = "Force Stop: OFF"
                ForceStopButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            end
        end

        if ForceStopped then
            AutoAttackEnabled = false
            ToggleButton.Text = "Auto Attack: STOPPED"
            ToggleButton.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
            StatusLabel.Text = IsSwordEquipped and "Status: Manually Stopped" or "Status: No Sword"
            StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        else
            if not AutoAttackEnabled then
                ToggleButton.Text = "Auto Attack: OFF"
                ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 80, 88)
                StatusLabel.Text = "Status: Cooling Down"
                StatusLabel.TextColor3 = Color3.fromRGB(110, 160, 165)
            else
                ToggleButton.Text = "Auto Attack: ON"
                ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 220, 200)
                
                local Target = GetBestTarget()
                if Target then
                    StatusLabel.Text = "Status: Attacking " .. Target.Name
                    StatusLabel.TextColor3 = Color3.fromRGB(0, 220, 200)
                    Attack(Target)
                    
                    local randomOffset = (math.random() * 2 - 1) * RANDOM_VARIANCE
                    task.wait(BASE_INTERVAL + randomOffset)
                else
                    StatusLabel.Text = "Status: Look at target (FOV)"
                    StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
                end
            end
        end
    end
end)

--// DRAG SUPPORT -----------------------------------------------
local dragging = false
local dragInput = nil
local dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragInput = input
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging then
        if input.UserInputType == Enum.UserInputType.MouseMovement or (input.UserInputType == Enum.UserInputType.Touch and input == dragInput) then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input == dragInput or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
        dragInput = nil
    end
end)

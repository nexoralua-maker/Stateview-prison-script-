--// BYPASS HELPERS ----------------------------------------------
local function HasLineOfSight(TargetPart)
    local Origin = Camera.CFrame.Position
    local Direction = (TargetPart.Position - Origin)
    local RaycastParams = RaycastParams.new()
    RaycastParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    RaycastParams.FilterType = Enum.RaycastFilterType.Exclude
    local Result = workspace:Raycast(Origin, Direction, RaycastParams)
    if Result then
        if Result.Instance:IsDescendantOf(TargetPart.Parent) then return true end
        return false
    end
    return true
end

local function IsInFOV(TargetPart)
    local Direction = (TargetPart.Position - Camera.CFrame.Position).Unit
    local LookVector = Camera.CFrame.LookVector
    local DotProduct = Direction:Dot(LookVector)
    local FOVThreshold = math.cos(math.rad(FOV_LIMIT_DEGREES))
    return DotProduct >= FOVThreshold
end

local function GetBestTarget()
    -- If Lock is ON and we have a valid locked target, force it
    if LockEnabled and LockedTarget and LockedTarget.Character then
        local lHead = LockedTarget.Character:FindFirstChild("Head")
        local lHum = LockedTarget.Character:FindFirstChildOfClass("Humanoid")
        if lHead and lHum and lHum.Health > 0 and HasLineOfSight(lHead) then
            return LockedTarget
        end
    end

    local BestTarget = nil
    local ShortestDistance = math.huge
    
    for _, Player in Players:GetPlayers() do
        if Player == LocalPlayer then continue end
        local Character = Player.Character
        if not Character then continue end
        
        local Humanoid = Character:FindFirstChildOfClass("Humanoid")
        if not Humanoid or Humanoid.Health <= 0 then continue end
        
        local TargetPart = Character:FindFirstChild("Head") or Character:FindFirstChild("HumanoidRootPart")
        if not TargetPart then continue end
        
        if not HasLineOfSight(TargetPart) then continue end
        if not IsInFOV(TargetPart) then continue end 
        
        local Distance = (TargetPart.Position - Camera.CFrame.Position).Magnitude
        if Distance < ShortestDistance then
            ShortestDistance = Distance
            BestTarget = Player
        end
    end
    return BestTarget
end

--// ATTACK ENGINE ----------------------------------------------
local function Attack(TargetPlayer)
    local MyChar = LocalPlayer.Character
    local TargetChar = TargetPlayer.Character
    if not MyChar or not TargetChar then return end

    local MyRoot = MyChar:FindFirstChild("HumanoidRootPart")
    local MyHum = MyChar:FindFirstChildOfClass("Humanoid")
    local TargetRoot = TargetChar:FindFirstChild("HumanoidRootPart")
    local TargetHum = TargetChar:FindFirstChildOfClass("Humanoid")

    if not MyRoot or not TargetRoot or not MyHum or not TargetHum or TargetHum.Health <= 0 then return end

    -- Snap character to look at target to pass server checks
    MyRoot.CFrame = CFrame.lookAt(MyRoot.Position, TargetRoot.Position)

    local State = {
        sprint = (MyHum.WalkSpeed > 16),
        swap = false,
        gliding = false,
        water = false,
        predicted = true,
        vel = MyRoot.AssemblyLinearVelocity,
        fall = 0, 
        look = MyRoot.CFrame.LookVector,
        ground = (MyHum.FloorMaterial ~= Enum.Material.Air),
        pos = MyRoot.Position,
    }

    pcall(function()
        ActionRemote:FireServer({
            a = "attack",
            target = TargetPlayer.UserId,
            k = ATTACK_KEY,
            st = State,
        })
    end)
end

--// CAMERA & CHARACTER LOCK LOOP -------------------------------
RunService.RenderStepped:Connect(function()
    if LockEnabled and LockedTarget and LockedTarget.Character then
        local targetHead = LockedTarget.Character:FindFirstChild("Head")
        local targetHum = LockedTarget.Character:FindFirstChildOfClass("Humanoid")
        
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

        if targetHead and targetHum and targetHum.Health > 0 and myRoot and myHum then
            -- 1. Lock the Camera
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, targetHead.Position)
            
            -- 2. Lock the Character Body
            -- We disable AutoRotate so the game engine doesn't fight our body rotation
            myHum.AutoRotate = false
            myRoot.CFrame = CFrame.lookAt(myRoot.Position, targetHead.Position)
        else
            -- Target died or we died, auto-unlock
            LockedTarget = nil
            LockButton.Text = "Target Lock: OFF"
            LockButton.BackgroundColor3 = Color3.fromRGB(50, 50, 150)
            LockEnabled = false
            if myHum then myHum.AutoRotate = true end
        end
    else
        -- Ensure AutoRotate is back on if lock is disabled
        local myChar = LocalPlayer.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if myHum and not myHum.AutoRotate then
            myHum.AutoRotate = true
        end
    end
end)


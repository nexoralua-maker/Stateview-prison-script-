--==================================================================
--  IMPROVED BULLET CORE
--==================================================================
local function calcGrip(handCF, targetCF)
	return (handCF * CFrame.new(0, -1, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)):ToObjectSpace(targetCF):Inverse()
end

local function getBestTargetPart(character)
	if not character then return nil end
	local head = character:FindFirstChild("Head")
	if head then return head end
	local upperTorso = character:FindFirstChild("UpperTorso")
	if upperTorso then return upperTorso end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp then return hrp end
	return nil
end

local function getEquippedGun()
	if not LocalPlayer.Character then return nil end
	local tool = LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
	if not tool then return nil end
	if not tool:FindFirstChild("Handle") then return nil end
	return tool
end

local function fireBullet(tool)
	if not bulletOn or not bulletTarget then return end

	local char  = LocalPlayer.Character
	local tChar = bulletTarget.Character
	if not char or not tChar then return end

	local hand = char:FindFirstChild("RightHand")
	if not hand then return end

	local targetPart = getBestTargetPart(tChar)
	if not targetPart then return end

	local targetVel = targetPart.AssemblyLinearVelocity
	local hrp = tChar:FindFirstChild("HumanoidRootPart")
	if hrp then
		targetVel = hrp.AssemblyLinearVelocity
	end

	local predictedPos = targetPart.Position
	if autoPredictOn then
		local ping = 0.1
		local stats = game:GetService("Stats")
		if stats and stats.Network and stats.Network.ServerStatsItem then
			local pingValue = stats.Network.ServerStatsItem["Data Ping"]:GetValue()
			if pingValue then
				ping = pingValue / 1000
			end
		end
		local predictionTime = ping + 0.05
		predictedPos = targetPart.Position + (targetVel * predictionTime)
	end

	local predictedCF = CFrame.new(predictedPos)
	local oldGrip = tool.Grip

	tool.Parent   = LocalPlayer.Backpack
	hand.Anchored = false
	tool.Grip     = calcGrip(hand.CFrame, predictedCF)
	hand.Anchored = true
	tool.Parent   = char

	RunService.RenderStepped:Wait()

	tool.Parent   = LocalPlayer.Backpack
	hand.Anchored = false
	tool.Grip     = oldGrip
	tool.Parent   = char
end

--==================================================================
--  AUTO-FIRE LOOP
--==================================================================
local function tryAutoFire()
	if not autoFireOn then return end
	if not bulletOn then return end
	if not bulletTarget then return end
	if not bulletTarget.Character then return end

	local tChar = bulletTarget.Character
	local hum = tChar:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return end

	if tick() - lastAutoFire < AUTO_FIRE_DELAY then return end

	local gun = getEquippedGun()
	if not gun then return end

	lastAutoFire = tick()

	pcall(function()
		gun:Activate()
	end)

	task.spawn(function()
		task.wait(0.01)
		fireBullet(gun)
	end)
end

--==================================================================
--  TOOL HOOKING
--==================================================================
local toolConns = {}

local function hookTool(tool)
	if toolConns[tool] then return end
	toolConns[tool] = tool.Activated:Connect(function()
		fireBullet(tool)
	end)
end

local function unhookTool(tool)
	local c = toolConns[tool]
	if c then
		c:Disconnect()
		toolConns[tool] = nil
	end
end

local function watchCharacter(char)
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then hookTool(c) end
	end
	char.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then hookTool(c) end
	end)
	char.ChildRemoved:Connect(function(c)
		if c:IsA("Tool") then unhookTool(c) end
	end)
end

if LocalPlayer.Character then watchCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(watchCharacter)


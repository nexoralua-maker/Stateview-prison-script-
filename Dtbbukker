local function refreshView()
	local cam = workspace.CurrentCamera
	if not cam then return end

	if viewOn and target and target.Character then
		local hum = target.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
			return
		end
	end

	local myChar = LocalPlayer.Character
	local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if myHum then
		cam.CameraSubject = myHum
	end
end

--==================================================================
--  AUTO FIRE LOOP
--==================================================================
RunService.Heartbeat:Connect(function()
	if not autoFireOn then return end
	if not viewOn then return end
	if not target or not target.Character then return end

	local now = tick()
	if now - lastAutoFire < AUTO_FIRE_DELAY then return end

	local gun = getEquippedTool()
	if not gun then return end

	local aimedPlayer = getAimedPlayer()
	if aimedPlayer ~= target then return end
	if not isTargetVisible() then return end

	lastAutoFire = now

	if bulletOn then
		task.spawn(function()
			pcall(fireBullet, gun, target)
		end)
	else
		pcall(function()
			gun:Activate()
		end)
	end
end)

--==================================================================
--  SELECT PLAYER
--==================================================================
local function selectPlayer(plr)
	if targetConn then
		targetConn:Disconnect()
		targetConn = nil
	end

	destroyHighlight()
	destroyBillboard()
	target = plr

	bulletOn = false
	if bulletCheck then bulletCheck.TextTransparency = 1 end

	if plr then
		nameLabel.Text       = string.format("%s  (@%s)", plr.DisplayName, plr.Name)
		nameLabel.TextColor3 = Color3.fromRGB(110, 220, 160)

		if plr.Character then
			ensureHighlight(plr.Character)
			ensureBillboard(plr.Character)
		end

		targetConn = plr.CharacterAdded:Connect(function()
			task.wait(0.25)
			if viewOn and target == plr then
				refreshView()
			end
			if target == plr then
				destroyHighlight()
				destroyBillboard()
				updateVisuals()
			end
		end)
	else
		nameLabel.Text       = "No player selected"
		nameLabel.TextColor3 = Color3.fromRGB(170, 170, 190)
	end

	refreshView()
	updateVisuals()
end

--==================================================================
--  SEARCH
--==================================================================
local function doSearch()
	local q = string.lower(searchBox.Text)

	if q == "" then
		selectPlayer(nil)
		return
	end

	local found = nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			if string.find(string.lower(plr.Name), q, 1, true)
			or string.find(string.lower(plr.DisplayName), q, 1, true) then
				found = plr
				break
			end
		end
	end

	if found then
		selectPlayer(found)
	else
		nameLabel.Text       = 'No match for "' .. searchBox.Text .. '"'
		nameLabel.TextColor3 = Color3.fromRGB(235, 110, 110)
	end
end

searchBox.FocusLost:Connect(doSearch)


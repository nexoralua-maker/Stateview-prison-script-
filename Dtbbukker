--==================================================================
--  BULLET CORE  (HEADSHOT AIM)
--==================================================================
-- Grip solver: computes the tool grip needed so the bullet exits
-- directly toward the target's HEAD position.
local function calcGrip(handCF, targetPos)
	-- Standard gun grip orientation: barrel points forward from hand
	local baseGrip = CFrame.new(0, -1, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)

	-- Point the hand's look vector at the target position
	local aimCF = CFrame.lookAt(handCF.Position, targetPos)

	-- Combine: orientation from aim, offset from base grip
	return (aimCF * baseGrip:ToObjectSpace(CFrame.new())):Inverse()
end

local function fireBullet(tool)
	if not bulletOn or not bulletTarget then return end

	local char  = LocalPlayer.Character
	local tChar = bulletTarget.Character
	if not char or not tChar then return end

	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("LeftHand")
	if not hand then return end

	-- AIM AT HEAD (overpower accuracy)
	local head = tChar:FindFirstChild("Head")
	local hrp  = tChar:FindFirstChild("HumanoidRootPart")
	local aimPart = head or hrp
	if not aimPart then return end

	local oldGrip = tool.Grip

	tool.Parent   = LocalPlayer.Backpack
	hand.Anchored = false

	-- Aim directly at head position, lock hand, fire
	local targetPos = aimPart.Position
	tool.Grip       = calcGrip(hand.CFrame, targetPos)
	hand.Anchored   = true
	hand.CFrame     = CFrame.lookAt(hand.Position, targetPos)
	tool.Parent     = char

	RunService.RenderStepped:Wait()
	RunService.RenderStepped:Wait() -- extra frame for maximum sync

	tool.Parent   = LocalPlayer.Backpack
	hand.Anchored = false
	tool.Grip     = oldGrip
	tool.Parent   = char
end

--==================================================================
--  TOOL HOOKING
--==================================================================
local toolConns = {}

local function hookTool(tool)
	if toolConns[tool] then return end
	toolConns[tool] = tool.Activated:Connect(function()
		fireBullet(tool)
	end)
end

local function unhookTool(tool)
	local c = toolConns[tool]
	if c then
		c:Disconnect()
		toolConns[tool] = nil
	end
end

local function watchCharacter(char)
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then hookTool(c) end
	end
	char.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then hookTool(c) end
	end)
	char.ChildRemoved:Connect(function(c)
		if c:IsA("Tool") then unhookTool(c) end
	end)
end

if LocalPlayer.Character then watchCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(watchCharacter)


-- FIXED: Bullet toggle re-validates the target on every click
bulletBtn.MouseButton1Click:Connect(function()
	if not target or not target.Parent then
		nameLabel.Text       = "Select a player first"
		nameLabel.TextColor3 = Color3.fromRGB(235, 180, 90)
		return
	end

	bulletOn = not bulletOn

	if bulletOn then
		-- Always bind fresh reference
		bulletTarget = target

		-- Warn if the target hasn't spawned yet
		if not bulletTarget.Character then
			nameLabel.Text       = "Waiting for target to spawn..."
			nameLabel.TextColor3 = Color3.fromRGB(235, 180, 90)
		end

		lastAutoFire = 0
	else
		bulletTarget = nil
	end

	bulletCheck.TextTransparency = bulletOn and 0 or 1
end)


local function destroyTracer()
	if tracerPart then
		tracerPart:Destroy()
		tracerPart = nil
	end
end

local function makeTracer()
	destroyTracer()
	tracerPart = Instance.new("Part")
	tracerPart.Name          = "ViewTracer"
	tracerPart.Anchored      = true
	tracerPart.CanCollide    = false
	tracerPart.CanQuery      = false
	tracerPart.CanTouch      = false
	tracerPart.CastShadow    = false
	tracerPart.Material      = Enum.Material.Neon
	tracerPart.Color         = Color3.fromRGB(255, 255, 255)  -- WHITE
	tracerPart.Transparency  = 0.15
	tracerPart.Size          = Vector3.new(0.08, 0.08, 1)
	tracerPart.TopSurface    = Enum.SurfaceType.Smooth
	tracerPart.BottomSurface = Enum.SurfaceType.Smooth
	tracerPart.Parent        = workspace
end

--==================================================================
--  FULL-PLAYER HIGHLIGHT
--==================================================================
local function destroyHighlight()
	if highlight then
		highlight:Destroy()
		highlight = nil
	end
end

local function ensureHighlight(char)
	if not char then
		destroyHighlight()
		return
	end
	if highlight and highlight.Parent == char then return end
	destroyHighlight()

	highlight = Instance.new("Highlight")
	highlight.Name                = "HealthHighlight"
	highlight.Adornee             = char
	highlight.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.OutlineTransparency = 0
	highlight.OutlineColor        = Color3.fromRGB(60, 220, 90)
	highlight.FillTransparency    = 0.75
	highlight.FillColor           = Color3.fromRGB(60, 220, 90)
	highlight.Parent              = char
end

local function colorFor(health, maxHealth)
	if health <= 0 then
		return Color3.fromRGB(90, 90, 100)
	elseif health <= 20 then
		return Color3.fromRGB(235, 60, 60)
	elseif health <= maxHealth * 0.5 then
		return Color3.fromRGB(240, 210, 60)
	else
		return Color3.fromRGB(60, 220, 90)
	end
end

--==================================================================
--  VISUAL UPDATE
--==================================================================
local function updateVisuals()
	if not target then
		destroyTracer()
		destroyHighlight()
		return
	end

	local tChar  = target.Character
	local myChar = LocalPlayer.Character

	----------------------------------------------------- TRACER
	if tChar and myChar then
		local myHRP    = myChar:FindFirstChild("HumanoidRootPart")
		local theirHRP = tChar:FindFirstChild("HumanoidRootPart")

		if myHRP and theirHRP then
			if not tracerPart then makeTracer() end

			local from = myHRP.Position
			local to   = theirHRP.Position
			local dir  = to - from
			local dist = dir.Magnitude

			if dist > 0.01 then
				tracerPart.Size         = Vector3.new(0.08, 0.08, dist)
				tracerPart.CFrame       = CFrame.lookAt(from + dir * 0.5, to)
				tracerPart.Transparency = 0.15
			end
		else
			if tracerPart then tracerPart.Transparency = 1 end
		end
	else
		if tracerPart then tracerPart.Transparency = 1 end
	end

	----------------------------------------------------- HIGHLIGHT
	if tChar then
		ensureHighlight(tChar)
		local hum = tChar:FindFirstChildOfClass("Humanoid")
		if highlight and hum then
			local c = colorFor(hum.Health, hum.MaxHealth)
			highlight.OutlineColor = c
			highlight.FillColor    = c
		end
	else
		destroyHighlight()
	end
end

--==================================================================
--  VIEW LOGIC
--==================================================================
local function refreshView()
	local cam = workspace.CurrentCamera
	if not cam then return end

	if viewOn and target and target.Character then
		local hum = target.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
			return
		end
	end

	local myChar = LocalPlayer.Character
	local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if myHum then
		cam.CameraSubject = myHum
	end
end

--==================================================================
--  SELECT PLAYER
--==================================================================
local function selectPlayer(plr)
	if targetConn then
		targetConn:Disconnect()
		targetConn = nil
	end

	destroyHighlight()
	target = plr

	if plr then
		nameLabel.Text       = string.format("%s  (@%s)", plr.DisplayName, plr.Name)
		nameLabel.TextColor3 = Color3.fromRGB(110, 220, 160)

		if plr.Character then ensureHighlight(plr.Character) end

		targetConn = plr.CharacterAdded:Connect(function()
			task.wait(0.25)
			if viewOn and target == plr then refreshView() end
			if target == plr then
				destroyHighlight()
				updateVisuals()
			end
		end)
	else
		nameLabel.Text       = "No player selected"
		nameLabel.TextColor3 = Color3.fromRGB(170, 170, 190)
	end

	refreshView()
	updateVisuals()
end

--==================================================================
--  SEARCH
--==================================================================
local function doSearch()
	local q = string.lower(searchBox.Text)
	if q == "" then
		selectPlayer(nil)
		return
	end
	local found = nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			if string.find(string.lower(plr.Name), q, 1, true)
			or string.find(string.lower(plr.DisplayName), q, 1, true) then
				found = plr
				break
			end
		end
	end
	if found then
		selectPlayer(found)
	else
		nameLabel.Text       = 'No match for "' .. searchBox.Text .. '"'
		nameLabel.TextColor3 = Color3.fromRGB(235, 110, 110)
	end
end

searchBox.FocusLost:Connect(doSearch)


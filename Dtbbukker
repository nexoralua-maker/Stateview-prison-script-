local dropdownOpen = false

local function setDropdown(open)
	dropdownOpen = open
	local targetSize = open and UDim2.new(1, 0, 0, 42) or UDim2.new(1, 0, 0, 0)
	local targetTransparency = open and 0.1 or 1

	if open then dropdown.Visible = true end

	local sizeTween = TweenService:Create(dropdown, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Size = targetSize
	})
	local transTween = TweenService:Create(dropdown, TweenInfo.new(0.25), {
		BackgroundTransparency = targetTransparency
	})

	sizeTween:Play()
	transTween:Play()

	if not open then
		sizeTween.Completed:Connect(function()
			if not dropdownOpen then dropdown.Visible = false end
		end)
	end

	TweenService:Create(gearBtn, TweenInfo.new(0.25, Enum.EasingStyle.Quart), {
		Rotation = open and 90 or 0
	}):Play()
end


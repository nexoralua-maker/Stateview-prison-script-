--  RENDER LOOP
--==================================================================
renderConn = RunService.RenderStepped:Connect(function()
	pcall(updateVisuals)
end)

--==================================================================
--  CLEANUP
--==================================================================
Players.PlayerRemoving:Connect(function(plr)
	if target == plr then
		selectPlayer(nil)
	end
	if bulletTarget == plr then
		bulletTarget = nil
		bulletOn     = false
		if bulletCheck then bulletCheck.TextTransparency = 1 end
	end
end)

gui.Destroying:Connect(function()
	destroyTracer()
	destroyHighlight()
	destroyBillboard()
	if renderConn then renderConn:Disconnect() end
end)

	if tracerPart then
		tracerPart:Destroy()
		tracerPart = nil
	end
end

local function makeTracer()
	destroyTracer()
	tracerPart = Instance.new("Part")
	tracerPart.Name          = "ViewTracer"
	tracerPart.Anchored      = true
	tracerPart.CanCollide    = false
	tracerPart.CanQuery      = false

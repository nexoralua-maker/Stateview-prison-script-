local function autoDetectRemote()
	local names = { "MainEvent", "MAINEVENT", "Main", "Remote", "Remotes" }
	for _, n in ipairs(names) do
		local r = ReplicatedStorage:FindFirstChild(n)
		if r and r:IsA("RemoteEvent") then return r, n end
		local folder = ReplicatedStorage:FindFirstChild("Remotes")
		if folder then
			local r2 = folder:FindFirstChild(n)
			if r2 and r2:IsA("RemoteEvent") then return r2, n end
		end
	end
end


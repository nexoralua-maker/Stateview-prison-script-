local function createSlideToggle(parent, textStr, yPos, defaultOn)
	local btn = Instance.new("TextButton")
	btn.Name = textStr:gsub("%s+", "") .. "Btn"
	btn.Size = UDim2.new(1, -24, 0, 32)
	btn.Position = UDim2.new(0, 12, 0, yPos)
	btn.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
	btn.BackgroundTransparency = 0.25
	btn.BorderSizePixel = 0
	btn.Text = ""
	btn.AutoButtonColor = false
	btn.ZIndex = 2
	btn.Parent = parent

	local btnCorner = Instance.new("UICorner", btn)
	btnCorner.CornerRadius = UDim.new(0, 6)

	local btnStroke = Instance.new("UIStroke", btn)
	btnStroke.Color = Color3.fromRGB(200, 200, 205)
	btnStroke.Thickness = 1.5

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, -58, 1, 0)
	label.Position = UDim2.new(0, 12, 0, 0)
	label.BackgroundTransparency = 1
	label.Text = textStr
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.GothamBold
	label.TextSize = 13
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.ZIndex = 3
	label.Parent = btn

	-- Pill-shaped track
	local track = Instance.new("Frame")
	track.Name = "Track"
	track.Size = UDim2.new(0, 40, 0, 20)
	track.Position = UDim2.new(1, -48, 0.5, -10)
	track.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
	track.BorderSizePixel = 0
	track.ZIndex = 3
	track.Parent = btn

	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

	local trackStroke = Instance.new("UIStroke", track)
	trackStroke.Color = Color3.fromRGB(120, 120, 130)
	trackStroke.Thickness = 1

	-- Animated knob (circle)
	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.Size = UDim2.new(0, 14, 0, 14)
	knob.Position = UDim2.new(0, 3, 0.5, -7) -- OFF position (left)
	knob.BackgroundColor3 = Color3.fromRGB(220, 220, 230)
	knob.BorderSizePixel = 0
	knob.ZIndex = 4
	knob.Parent = track

	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

	local knobStroke = Instance.new("UIStroke", knob)
	knobStroke.Color = Color3.fromRGB(255, 255, 255)
	knobStroke.Thickness = 1
	knobStroke.Transparency = 0.5

	-- Set initial state
	local isOn = defaultOn and true or false
	if isOn then
		knob.Position = UDim2.new(1, -17, 0.5, -7) -- ON position (right)
		track.BackgroundColor3 = Color3.fromRGB(60, 140, 90)
		trackStroke.Color = Color3.fromRGB(90, 200, 130)
	end

	-- Animate toggle
	local function setState(state, instant)
		isOn = state
		local targetPos = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
		local targetTrackColor = state and Color3.fromRGB(60, 140, 90) or Color3.fromRGB(50, 50, 58)
		local targetStrokeColor = state and Color3.fromRGB(90, 200, 130) or Color3.fromRGB(120, 120, 130)

		if instant then
			knob.Position = targetPos
			track.BackgroundColor3 = targetTrackColor
			trackStroke.Color = targetStrokeColor
		else
			local info = TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
			TweenService:Create(knob, info, { Position = targetPos }):Play()
			TweenService:Create(track, info, { BackgroundColor3 = targetTrackColor }):Play()
			TweenService:Create(trackStroke, info, { Color = targetStrokeColor }):Play()
		end
	end

	return btn, {
		isOn = function() return isOn end,
		setState = setState,
	}
end


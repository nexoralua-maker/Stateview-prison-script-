--==================================================================
--  VISUAL UPDATE
--==================================================================
local function updateVisuals()
	if not target then
		destroyTracer()
		destroyHighlight()
		destroyBillboard()
		return
	end

	local tChar  = target.Character
	local myChar = LocalPlayer.Character

	local sharedColor = Color3.fromRGB(60, 220, 90)
	if tChar then
		local hum = tChar:FindFirstChildOfClass("Humanoid")
		if hum then
			sharedColor = colorFor(hum.Health, hum.MaxHealth)
		end
	end

	----------------------------------------------------- TRACER
	if tChar and myChar then
		local myHRP     = myChar:FindFirstChild("HumanoidRootPart")
		local theirHRP  = tChar:FindFirstChild("HumanoidRootPart")
		local theirHead = tChar:FindFirstChild("Head")

		if myHRP and theirHRP then
			if not tracerPart then makeTracer() end

			local from = myHRP.Position
			local to = theirHRP.Position
			if theirHead then
				to = theirHRP.Position:Lerp(theirHead.Position, 0.5)
			end

			local dir  = to - from
			local dist = dir.Magnitude

			if dist > 0.01 then
				local overlap = 0.5
				tracerPart.Size         = Vector3.new(0.08, 0.08, dist + overlap)
				tracerPart.CFrame       = CFrame.lookAt(from + dir * 0.5, to)
				tracerPart.Transparency = 0.35
				tracerPart.Color        = sharedColor
			end
		else
			if tracerPart then tracerPart.Transparency = 1 end
		end
	else
		if tracerPart then tracerPart.Transparency = 1 end
	end

	----------------------------------------------------- HIGHLIGHT
	if tChar then
		ensureHighlight(tChar)
		if highlight then
			highlight.OutlineColor = sharedColor
			highlight.FillColor    = sharedColor
		end
	else
		destroyHighlight()
	end

	----------------------------------------------------- BILLBOARD
	if billboardLabel then
		billboardLabel.TextColor3 = sharedColor
	end
	updateBillboard()
end

--==================================================================
--  VIEW LOGIC
--==================================================================
local function refreshView()
	local cam = workspace.CurrentCamera
	if not cam then return end
	if viewOn and target and target.Character then
		local hum = target.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
			return
		end
	end
	local myChar = LocalPlayer.Character
	local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if myHum then cam.CameraSubject = myHum end
end

--==================================================================
--  SELECT PLAYER (FIXED - handles rejoin/respawn)
--==================================================================
local function selectPlayer(plr)
	if targetConn then
		targetConn:Disconnect()
		targetConn = nil
	end
	if targetCharConn then
		targetCharConn:Disconnect()
		targetCharConn = nil
	end

	destroyHighlight()
	destroyBillboard()
	target = plr

	-- Reset bullet state cleanly
	bulletOn = false
	bulletTarget = nil
	if bulletCheck then bulletCheck.TextTransparency = 1 end

	if plr then
		nameLabel.Text       = string.format("%s  (@%s)", plr.DisplayName, plr.Name)
		nameLabel.TextColor3 = Color3.fromRGB(110, 220, 160)

		if plr.Character then
			ensureHighlight(plr.Character)
			ensureBillboard(plr.Character)
		end

		-- Fired whenever the TARGET respawns / rejoins
		targetCharConn = plr.CharacterAdded:Connect(function(newChar)
			task.wait(0.25)
			if target ~= plr then return end

			-- Refresh visuals for new character
			destroyHighlight()
			destroyBillboard()
			updateVisuals()

			-- Rebind bullet target to the fresh player object
			if bulletOn then
				bulletTarget = plr
				lastAutoFire = 0
			end

			if viewOn then refreshView() end
		end)

		-- Detect character removal (death / leave)
		targetConn = plr.CharacterRemoving:Connect(function()
			if bulletTarget == plr then
				lastAutoFire = 0
			end
		end)
	else
		nameLabel.Text       = "No player selected"
		nameLabel.TextColor3 = Color3.fromRGB(170, 170, 190)
	end
	refreshView()
	updateVisuals()
end

--==================================================================
--  SEARCH
--==================================================================
local function doSearch()
	local q = string.lower(searchBox.Text)
	if q == "" then selectPlayer(nil) return end

	local found = nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			if string.find(string.lower(plr.Name), q, 1, true)
			or string.find(string.lower(plr.DisplayName), q, 1, true) then
				found = plr
				break
			end
		end
	end
	if found then
		selectPlayer(found)
	else
		nameLabel.Text       = 'No match for "' .. searchBox.Text .. '"'
		nameLabel.TextColor3 = Color3.fromRGB(235, 110, 110)
	end
end

searchBox.FocusLost:Connect(doSearch)


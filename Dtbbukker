-- Tab creation function
local tabButtons = {}
local activeTab = "Main"

local function createTab(name, order)
	local btn = Instance.new("TextButton")
	btn.Name             = name .. "Tab"
	btn.Size             = UDim2.new(1, 0, 0, 32)
	btn.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	btn.BorderSizePixel  = 0
	btn.Text             = name
	btn.TextColor3       = Color3.fromRGB(170, 170, 190)
	btn.Font             = Enum.Font.GothamMedium
	btn.TextSize         = 12
	btn.LayoutOrder      = order
	btn.Parent           = tabContainer
	
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
	
	-- Store the page content for this tab
	local page = Instance.new("Frame")
	page.Name             = name .. "Page"
	page.Size             = UDim2.new(1, 0, 1, 0)
	page.BackgroundTransparency = 1
	page.Visible          = false -- Hidden by default
	page.Parent           = contentArea
	
	tabButtons[name] = { button = btn, page = page }
	
	btn.MouseButton1Click:Connect(function()
		-- Reset all tabs
		for tName, data in pairs(tabButtons) do
			data.button.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
			data.button.TextColor3 = Color3.fromRGB(170, 170, 190)
			data.page.Visible = false
		end
		
		-- Activate clicked tab
		btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		page.Visible = true
		activeTab = name
	end)
	
	return page
end


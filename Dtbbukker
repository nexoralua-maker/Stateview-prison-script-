--==================================================================
--  BUTTON HELPER  (hover + click effects)
--==================================================================
local function styleButton(btn, baseColor, hoverColor, textColor)
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

	local stroke = Instance.new("UIStroke", btn)
	stroke.Color        = baseColor
	stroke.Thickness    = 1
	stroke.Transparency = 0.4

	btn.BackgroundColor3 = baseColor
	btn.TextColor3       = textColor or Color3.fromRGB(235, 240, 255)

	btn.MouseEnter:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.18), {
			BackgroundColor3 = hoverColor
		}):Play()
		TweenService:Create(stroke, TweenInfo.new(0.18), {
			Transparency = 0
		}):Play()
	end)

	btn.MouseLeave:Connect(function()
		TweenService:Create(btn, TweenInfo.new(0.18), {
			BackgroundColor3 = btn:GetAttribute("BaseColor") or baseColor
		}):Play()
		TweenService:Create(stroke, TweenInfo.new(0.18), {
			Transparency = 0.4
		}):Play()
	end)

	btn:SetAttribute("BaseColor", baseColor)
	return stroke
end


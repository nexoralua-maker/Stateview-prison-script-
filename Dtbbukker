--==================================================================

viewBtn.MouseButton1Click:Connect(function()
	viewOn = not viewOn
	viewCheck.TextTransparency = viewOn and 0 or 1
	refreshView()
end)

bulletBtn.MouseButton1Click:Connect(function()
	if not target then
		nameLabel.Text       = "Select a player first"
		nameLabel.TextColor3 = Color3.fromRGB(235, 180, 90)
		return
	end

	bulletOn = not bulletOn
	bulletTarget = target
	bulletCheck.TextTransparency = bulletOn and 0 or 1
end)

autoPredictBtn.MouseButton1Click:Connect(function()
	autoPredictOn = not autoPredictOn
	autoPredictCheck.TextTransparency = autoPredictOn and 0 or 1
end)

autoFireBtn.MouseButton1Click:Connect(function()
	if not target then
		nameLabel.Text       = "Select a player first"
		nameLabel.TextColor3 = Color3.fromRGB(235, 180, 90)
		return
	end

	autoFireOn = not autoFireOn
	autoFireCheck.TextTransparency = autoFireOn and 0 or 1
end)


--==================================================================
--  AIMLOCK HELPERS
--==================================================================
local function hasCharacter(p)
	return p and p.Character and p.Character:FindFirstChild("Humanoid") ~= nil
end

local function isKnocked(p)
	if not hasCharacter(p) then return false end
	local be = p.Character:FindFirstChild("BodyEffects")
	if not be then return false end
	local ko = be:FindFirstChild("K.O")
	return ko and ko.Value or false
end

local function isGrabbed(p)
	if not hasCharacter(p) then return false end
	return p.Character:FindFirstChild("GRABBING_CONSTRAINT") ~= nil
end

local function isBlockedByWall(p)
	if not AIM.WallCheck then return false end
	if not hasCharacter(LocalPlayer) or not hasCharacter(p) then return true end
	local myHrp  = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
	local tgtHrp = p.Character:FindFirstChild("HumanoidRootPart")
	if not myHrp or not tgtHrp then return true end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { LocalPlayer.Character, p.Character }
	params.IgnoreWater = true
	local hit = Workspace:Raycast(myHrp.Position, tgtHrp.Position - myHrp.Position, params)
	return hit ~= nil
end

local function isInAir(p)
	if not hasCharacter(p) then return false end
	local hrp = p.Character:FindFirstChild("HumanoidRootPart")
	return hrp and math.abs(hrp.AssemblyLinearVelocity.Y) > 1 or false
end

--==================================================================
--  AIMLOCK TARGET (uses bulletTarget — no keybinds)
--==================================================================
local function aimTargetValid()
	local p = bulletTarget
	if not p or p == LocalPlayer then return false end
	if not hasCharacter(p) then return false end
	if AIM.IgnoreKnocked and isKnocked(p) then return false end
	if AIM.IgnoreGrabbed and isGrabbed(p) then return false end
	if isBlockedByWall(p) then return false end
	return true
end

local function getPredictedPosition()
	local t = bulletTarget
	if not t or not hasCharacter(t) then return Vector3.new(0, 0, 0) end

	local head = t.Character:FindFirstChild("Head")
		or t.Character:FindFirstChild("HumanoidRootPart")
	if not head then return Vector3.new(0, 0, 0) end

	local hrp = t.Character:FindFirstChild("HumanoidRootPart")
	local velocity = hrp and hrp.AssemblyLinearVelocity or Vector3.new(0, 0, 0)

	if isInAir(t) then
		velocity = Vector3.new(velocity.X, math.abs(velocity.Y * 0.2), velocity.Z)
	end

	return head.Position + velocity * AIM.Prediction
end

--==================================================================
--  SILENT AIM HOOK (executor only)
--==================================================================
local hookOk = pcall(function()
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local method = getnamecallmethod()
		local args = { ... }

		if not checkcaller()
			and method == "FireServer"
			and typeof(args[1]) == "string"
			and typeof(args[2]) == "Vector3"
			and AimState.enabled
			and bulletTarget
			and aimTargetValid() then

			args[2] = AimState.predicted_position
		end

		return oldNamecall(self, table.unpack(args))
	end))
end)

if not hookOk then
	warn("[Aimlock] Silent-aim hook unavailable (not in an executor).")
end

--==================================================================
--  BACKUP: fire remote on tool activate
--==================================================================
local function hookGun(character)
	if not character then return end
	character.ChildAdded:Connect(function(tool)
		if not tool:IsA("Tool") then return end
		tool.Activated:Connect(function()
			if AimState.enabled and bulletTarget and aimTargetValid()
				and remote and mouseArgument then
				pcall(function()
					remote:FireServer(mouseArgument, AimState.predicted_position)
				end)
			end
		end)
	end)
end

if LocalPlayer.Character then hookGun(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(hookGun)

--==================================================================
--  BULLET CORE
--==================================================================
local function calcGrip(handCF, rootCF)
	return (handCF * CFrame.new(0, -1, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)):ToObjectSpace(rootCF):Inverse()
end

local function fireBullet(tool)
	if not bulletOn or not bulletTarget then return end

	local char  = LocalPlayer.Character
	local tChar = bulletTarget.Character
	if not char or not tChar then return end

	local hand = char:FindFirstChild("RightHand")
	local hrp  = tChar:FindFirstChild("HumanoidRootPart")
	if not hand or not hrp then return end

	local oldGrip = tool.Grip

	tool.Parent   = LocalPlayer.Backpack
	hand.Anchored = false
	tool.Grip     = calcGrip(hand.CFrame, hrp.CFrame)
	hand.Anchored = true
	tool.Parent   = char

	RunService.RenderStepped:Wait()

	tool.Parent   = LocalPlayer.Backpack
	hand.Anchored = false
	tool.Grip     = oldGrip
	tool.Parent   = char
end

--==================================================================
--  TOOL HOOKING
--==================================================================
local toolConns = {}

local function hookTool(tool)
	if toolConns[tool] then return end
	toolConns[tool] = tool.Activated:Connect(function()
		fireBullet(tool)
	end)
end

local function unhookTool(tool)
	local c = toolConns[tool]
	if c then
		c:Disconnect()
		toolConns[tool] = nil
	end
end

local function watchCharacter(char)
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then hookTool(c) end
	end
	char.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then hookTool(c) end
	end)
	char.ChildRemoved:Connect(function(c)
		if c:IsA("Tool") then unhookTool(c) end
	end)
end

if LocalPlayer.Character then watchCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(watchCharacter)


Players.PlayerRemoving:Connect(function(plr)
	if target == plr then selectPlayer(nil) end
	if bulletTarget == plr then
		bulletTarget = nil
		bulletOn     = false
		if bulletCheck then bulletCheck.TextTransparency = 1 end
	end
end)


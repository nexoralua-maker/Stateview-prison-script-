--==================================================================
local function getBestTargetPart(character)
	if not character then return nil end
	local head = character:FindFirstChild("Head")
	if head then return head end
	local upperTorso = character:FindFirstChild("UpperTorso")
	if upperTorso then return upperTorso end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if hrp then return hrp end
	return nil
end

local function getEquippedTool()
	if not LocalPlayer.Character then return nil end
	local tool = LocalPlayer.Character:FindFirstChildWhichIsA("Tool")
	if tool and tool:FindFirstChild("Handle") then
		return tool
	end
	return nil
end

local function getPing()
	local ping = 0.1
	local ok = pcall(function()
		local v = Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
		if v then ping = v / 1000 end
	end)
	return ping
end

local function colorFor(health, maxHealth)
	if health <= 0 then
		return Color3.fromRGB(235, 60, 60)
	elseif health <= 20 then
		return Color3.fromRGB(235, 60, 60)
	elseif health <= maxHealth * 0.5 then
		return Color3.fromRGB(240, 210, 60)
	else
		return Color3.fromRGB(60, 220, 90)
	end
end

--==================================================================
--  BULLET CORE
--==================================================================
local function calcGrip(handCF, targetCF)
	return (handCF * CFrame.new(0, -1, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)):ToObjectSpace(targetCF):Inverse()
end

local function fireBullet(tool, explicitTarget)
	if not tool or not tool.Parent then return end
	if not bulletOn and not explicitTarget then return end

	local useTarget = explicitTarget or bulletTarget
	if not useTarget then return end

	local char  = LocalPlayer.Character
	local tChar = useTarget.Character
	if not char or not tChar then return end

	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	if not hand then return end

	local targetPart = getBestTargetPart(tChar)
	if not targetPart then return end

	local hrp = tChar:FindFirstChild("HumanoidRootPart")
	local targetVel = hrp and hrp.AssemblyLinearVelocity or targetPart.AssemblyLinearVelocity

	local predictedPos = targetPart.Position
	if autoPredictOn then
		local predictionTime = getPing() + 0.05
		predictedPos = targetPart.Position + (targetVel * predictionTime)
	end

	local predictedCF = CFrame.new(predictedPos)
	local oldGrip = tool.Grip

	local ok = pcall(function()
		tool.Parent   = LocalPlayer.Backpack
		hand.Anchored = false
		tool.Grip     = calcGrip(hand.CFrame, predictedCF)
		hand.Anchored = true
		tool.Parent   = char

		RunService.RenderStepped:Wait()

		tool.Parent   = LocalPlayer.Backpack
		hand.Anchored = false
		tool.Grip     = oldGrip
		tool.Parent   = char
	end)

	if not ok then
		pcall(function()
			hand.Anchored = false
			tool.Grip = oldGrip
			if tool.Parent ~= char then tool.Parent = char end
		end)
	end
end

--==================================================================
--  AUTO FIRE HELPERS
--==================================================================
local lastAutoFire = 0
local AUTO_FIRE_DELAY = 0.08

local function isTargetVisible()
	if not target or not target.Character then return false end
	local char = LocalPlayer.Character
	if not char then return false end

	local myHRP = char:FindFirstChild("HumanoidRootPart")
	local tHRP = target.Character:FindFirstChild("HumanoidRootPart")
	if not myHRP or not tHRP then return false end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char, target.Character }
	params.IgnoreWater = true

	local dir = tHRP.Position - myHRP.Position
	local hit = workspace:Raycast(myHRP.Position, dir, params)
	return hit == nil
end

local function getAimedPlayer()
	local camera = workspace.CurrentCamera
	if not camera then return nil end

	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local filter = {}
	if LocalPlayer.Character then table.insert(filter, LocalPlayer.Character) end
	params.FilterDescendantsInstances = filter
	params.IgnoreWater = true

	local hit = workspace:Raycast(origin, direction * 1000, params)
	if hit and hit.Instance then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LocalPlayer and p.Character and hit.Instance:IsDescendantOf(p.Character) then
				return p
			end
		end
	end
	return nil
end

--==================================================================
--  TOOL HOOKING
--==================================================================
local toolConns = {}

local function hookTool(tool)
	if not tool or toolConns[tool] then return end
	toolConns[tool] = tool.Activated:Connect(function()
		pcall(fireBullet, tool)
	end)
end

local function unhookTool(tool)
	local c = toolConns[tool]
	if c then
		c:Disconnect()
		toolConns[tool] = nil
	end
end

local function watchCharacter(char)
	if not char then return end
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then hookTool(c) end
	end
	char.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then hookTool(c) end
	end)
	char.ChildRemoved:Connect(function(c)
		if c:IsA("Tool") then unhookTool(c) end
	end)
end

if LocalPlayer.Character then watchCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(watchCharacter)


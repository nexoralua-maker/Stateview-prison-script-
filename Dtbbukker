--==================================================================
--  BULLET CORE
--==================================================================
local function calcGrip(handCF, rootCF)
	return (handCF * CFrame.new(0, -1, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)):ToObjectSpace(rootCF):Inverse()
end

local function fireBullet(tool)
	if not bulletOn or not bulletTarget then return end

	local char  = LocalPlayer.Character
	local tChar = bulletTarget.Character
	if not char or not tChar then return end

	local hand = char:FindFirstChild("RightHand")
	local hrp  = tChar:FindFirstChild("HumanoidRootPart")
	if not hand or not hrp then return end

	local oldGrip = tool.Grip

	tool.Parent   = LocalPlayer.Backpack
	hand.Anchored = false
	tool.Grip     = calcGrip(hand.CFrame, hrp.CFrame)
	hand.Anchored = true
	tool.Parent   = char

	RunService.RenderStepped:Wait()

	tool.Parent   = LocalPlayer.Backpack
	hand.Anchored = false
	tool.Grip     = oldGrip
	tool.Parent   = char
end

--==================================================================
--  TOOL HOOKING
--==================================================================
local toolConns = {}

local function hookTool(tool)
	if toolConns[tool] then return end
	toolConns[tool] = tool.Activated:Connect(function()
		fireBullet(tool)
	end)
end

local function unhookTool(tool)
	local c = toolConns[tool]
	if c then
		c:Disconnect()
		toolConns[tool] = nil
	end
end

local function watchCharacter(char)
	for _, c in ipairs(char:GetChildren()) do
		if c:IsA("Tool") then hookTool(c) end
	end
	char.ChildAdded:Connect(function(c)
		if c:IsA("Tool") then hookTool(c) end
	end)
	char.ChildRemoved:Connect(function(c)
		if c:IsA("Tool") then unhookTool(c) end
	end)
end

if LocalPlayer.Character then watchCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(watchCharacter)


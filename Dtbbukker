local function destroyBillboard()
	if billboard then
		billboard:Destroy()
		billboard = nil
		billboardLabel = nil
	end
end

local function ensureBillboard(char)
	if not char then
		destroyBillboard()
		return
	end

	local head = char:FindFirstChild("Head")
	if not head then
		destroyBillboard()
		return
	end

	if billboard and billboard.Parent == head then
		return
	end

	destroyBillboard()

	billboard = Instance.new("BillboardGui")
	billboard.Name           = "TargetInfoBillboard"
	billboard.Adornee        = head
	billboard.Size           = UDim2.new(0, 320, 0, 28)
	billboard.StudsOffset    = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop    = true
	billboard.LightInfluence = 0
	billboard.MaxDistance    = 500
	billboard.Parent         = head

	billboardLabel = Instance.new("TextLabel")
	billboardLabel.Name                   = "InfoLabel"
	billboardLabel.Size                   = UDim2.new(1, 0, 1, 0)
	billboardLabel.BackgroundTransparency = 1
	billboardLabel.Text                   = "Name: -- | Health: --"
	billboardLabel.TextColor3             = Color3.fromRGB(60, 220, 90)
	billboardLabel.TextStrokeTransparency = 0
	billboardLabel.TextStrokeColor3       = Color3.fromRGB(0, 0, 0)
	billboardLabel.Font                   = Enum.Font.GothamBold
	billboardLabel.TextSize               = 14
	billboardLabel.TextScaled             = false
	billboardLabel.Parent                 = billboard
end

local function updateBillboard()
	if not target then
		destroyBillboard()
		return
	end

	local tChar = target.Character
	if not tChar then
		destroyBillboard()
		return
	end

	ensureBillboard(tChar)
	if not billboardLabel then return end

	local hum = tChar:FindFirstChildOfClass("Humanoid")
	local health = hum and math.floor(hum.Health + 0.5) or 0
	local maxHealth = hum and hum.MaxHealth or 100

	billboardLabel.Text = string.format(
		"Name: %s | Health: %d",
		target.DisplayName,
		health
	)

	local c = colorFor(health, maxHealth)
	billboardLabel.TextColor3 = c
end

--==================================================================
--  VISUAL UPDATE
--==================================================================
local function updateVisuals()
	if not target then
		destroyTracer()
		destroyHighlight()
		destroyBillboard()
		return
	end

	local tChar  = target.Character
	local myChar = LocalPlayer.Character

	----------------------------------------------------- TRACER
	if tChar and myChar then
		local myHRP    = myChar:FindFirstChild("HumanoidRootPart")
		local theirHRP = tChar:FindFirstChild("HumanoidRootPart")

		if myHRP and theirHRP then
			if not tracerPart then makeTracer() end

			local from = myHRP.Position
			local to   = theirHRP.Position
			local dir  = to - from
			local dist = dir.Magnitude

			if dist > 0.01 then
				tracerPart.Size         = Vector3.new(0.08, 0.08, dist)
				tracerPart.CFrame       = CFrame.lookAt(from + dir * 0.5, to)
				tracerPart.Transparency = 0.35
			end
		else
			if tracerPart then tracerPart.Transparency = 1 end
		end
	else
		if tracerPart then tracerPart.Transparency = 1 end
	end

	----------------------------------------------------- HIGHLIGHT
	if tChar then
		ensureHighlight(tChar)

		local hum = tChar:FindFirstChildOfClass("Humanoid")
		if highlight and hum then
			local c = colorFor(hum.Health, hum.MaxHealth)
			highlight.OutlineColor = c
			highlight.FillColor    = c
		end
	else
		destroyHighlight()
	end

	----------------------------------------------------- BILLBOARD
	updateBillboard()
end

--==================================================================
--  VIEW LOGIC
--==================================================================
local function refreshView()
	local cam = workspace.CurrentCamera
	if not cam then return end

	if viewOn and target and target.Character then
		local hum = target.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			cam.CameraSubject = hum
			return
		end
	end

	local myChar = LocalPlayer.Character
	local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if myHum then
		cam.CameraSubject = myHum
	end
end

--==================================================================
--  SELECT PLAYER
--==================================================================
local function selectPlayer(plr)
	if targetConn then
		targetConn:Disconnect()
		targetConn = nil
	end

	destroyHighlight()
	destroyBillboard()
	target = plr

	if plr then
		nameLabel.Text       = string.format("%s  (@%s)", plr.DisplayName, plr.Name)
		nameLabel.TextColor3 = Color3.fromRGB(110, 220, 160)

		if plr.Character then
			ensureHighlight(plr.Character)
			ensureBillboard(plr.Character)
		end

		targetConn = plr.CharacterAdded:Connect(function()
			task.wait(0.25)
			if viewOn and target == plr then
				refreshView()
			end
			if target == plr then
				destroyHighlight()
				destroyBillboard()
				updateVisuals()
			end
		end)
	else
		nameLabel.Text       = "No player selected"
		nameLabel.TextColor3 = Color3.fromRGB(170, 170, 190)
	end

	refreshView()
	updateVisuals()
end

--==================================================================
--  SEARCH
--==================================================================
local function doSearch()
	local q = string.lower(searchBox.Text)

	if q == "" then
		selectPlayer(nil)
		return
	end

	local found = nil
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			if string.find(string.lower(plr.Name), q, 1, true)
			or string.find(string.lower(plr.DisplayName), q, 1, true) then
				found = plr
				break
			end
		end
	end

	if found then
		selectPlayer(found)
	else
		nameLabel.Text       = 'No match for "' .. searchBox.Text .. '"'
		nameLabel.TextColor3 = Color3.fromRGB(235, 110, 110)
	end
end

searchBox.FocusLost:Connect(doSearch)


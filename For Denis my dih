            task.wait(0.25)

            PlayAndWait(10714350889)
            PlayAndWait(7861263376)
            PlayAndWait(7009918446)
            PlayAndWait(7861306542)

            stopAlign = true
            task.wait(0.2)

            RipInHalf()
        end)

        if not ok then
            warn("[Chucky] error: " .. tostring(err))
        end

        timeStopActive = false
    end)
    return Tool
end


local function UpdateToggleVisual(state)
    if state then
        TweenService:Create(ToggleSwitch, TweenInfo.new(0.15), {BackgroundColor3 = Theme.YellowGold}):Play()
        TweenService:Create(SwitchDot, TweenInfo.new(0.15), {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
        StatusLabel.Text = "Status: Enabled"
        StatusLabel.TextColor3 = Theme.YellowBright
        ToggleLabel.TextColor3 = Theme.YellowBright
    else
        TweenService:Create(ToggleSwitch, TweenInfo.new(0.15), {BackgroundColor3 = Color3.fromRGB(60, 50, 25)}):Play()
        TweenService:Create(SwitchDot, TweenInfo.new(0.15), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
        StatusLabel.Text = "Status: Disabled"
        StatusLabel.TextColor3 = Theme.TextDim
        ToggleLabel.TextColor3 = Theme.TextWhite
    end
end

ToggleSwitch.MouseButton1Click:Connect(function()
    Config.enabled = not Config.enabled
    UpdateToggleVisual(Config.enabled)
end)


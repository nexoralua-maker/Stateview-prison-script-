-- ============================================================
-- AURA UPDATE LOOP
-- ============================================================
local function UpdateAura()
    if not Config.enabled then
        for _, cache in pairs(Config.aura_cache) do
            if cache.emitters then
                for _, emitter in ipairs(cache.emitters) do
                    emitter.Enabled = false
                end
            end
        end
        return
    end
    
    local char = LocalPlayer.Character
    if not char then
        for _, cache in pairs(Config.aura_cache) do
            if cache.attachment then cache.attachment:Destroy() end
            if cache.attachments then
                for _, att in ipairs(cache.attachments) do att:Destroy() end
            end
        end
        Config.aura_cache = {}
        return
    end
    
    local current_types = Config.type
    if type(current_types) ~= "table" then current_types = {current_types} end
    
    local types_to_remove = {}
    for cached_type, _ in pairs(Config.aura_cache) do
        local found = false
        for _, current_type in ipairs(current_types) do
            if cached_type == current_type then found = true break end
        end
        if not found then table.insert(types_to_remove, cached_type) end
    end
    
    for _, type_to_remove in ipairs(types_to_remove) do
        local cache = Config.aura_cache[type_to_remove]
        if cache then
            if cache.attachment then cache.attachment:Destroy() end
            if cache.attachments then
                for _, att in ipairs(cache.attachments) do att:Destroy() end
            end
            Config.aura_cache[type_to_remove] = nil
        end
    end
    
    for _, current_type in ipairs(current_types) do
        local use_upper_torso = (current_type == "Angel Wings")
        local target_part = use_upper_torso and char:FindFirstChild("UpperTorso") or char:FindFirstChild("LowerTorso")
        
        if not target_part then
            if Config.aura_cache[current_type] then
                local cache = Config.aura_cache[current_type]
                if cache.attachment then cache.attachment:Destroy() end
                if cache.attachments then
                    for _, att in ipairs(cache.attachments) do att:Destroy() end
                end
                Config.aura_cache[current_type] = nil
            end
        else
            if not Config.aura_cache[current_type] then
                local attachment = Instance.new("Attachment")
                if use_upper_torso then attachment.Position = Vector3.new(0, 0.5, 0) end
                attachment.Parent = target_part
                
                local emitters, extra_attachments = CreateAuraEffect(current_type, attachment, target_part)
                
                Config.aura_cache[current_type] = {
                    attachment = attachment,
                    emitters = emitters,
                    attachments = extra_attachments or {}
                }
            else
                local cache = Config.aura_cache[current_type]
                if cache.attachment.Parent ~= target_part then
                    cache.attachment.Parent = target_part
                    if cache.attachments then
                        for _, att in ipairs(cache.attachments) do att.Parent = target_part end
                    end
                end
                if cache.emitters then
                    for _, emitter in ipairs(cache.emitters) do emitter.Enabled = true end
                end
            end
        end
    end
end

RunService.Heartbeat:Connect(UpdateAura)


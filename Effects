-- Helper to create yellow gradient on GUI
local function ApplyYellowGradient(instance, rotation)
    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Theme.YellowBright),
        ColorSequenceKeypoint.new(0.5, Theme.Yellow),
        ColorSequenceKeypoint.new(1, Theme.YellowDeep),
    })
    gradient.Rotation = rotation or 90
    gradient.Parent = instance
    return gradient
end


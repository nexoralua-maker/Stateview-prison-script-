-- ==================== CONFIG ====================
local CONFIG = {
    Range        = 60,
    FireDelay    = 0.1,
    Prediction   = 0.134,
    SilentAim    = true,
    VisibleOnly  = false,
    IgnoreKnocked = false,
    HeadPriority = true,
    PingComp     = true,
}
-- ================================================

local enabled       = false
local last_shot     = 0
local target_index  = 1
local velocity_cache = {}

-- =================== HELPERS ===================
local function has_char(p)
    return p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
end

local function is_knocked(p)
    if not has_char(p) then return false end
    local be = p.Character:FindFirstChild("BodyEffects")
    if not be then return false end
    local ko = be:FindFirstChild("K.O")
    return ko and ko.Value or false
end

local function is_dead(p)
    if not has_char(p) then return true end
    local hum = p.Character:FindFirstChild("Humanoid")
    return not hum or hum.Health <= 0
end

local function is_behind_wall(p)
    if not has_char(p) or not has_char(local_player) then return false end
    local parts = camera:GetPartsObscuringTarget(
        {local_player.Character.HumanoidRootPart.Position, p.Character.HumanoidRootPart.Position},
        {local_player.Character, p.Character}
    )
    return #parts > 0
end

local function get_equipped_gun()
    if not local_player.Character then return nil end
    return local_player.Character:FindFirstChildWhichIsA("Tool")
end

local function get_ping()
    local ok, ping = pcall(function()
        return game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    return (ok and ping) or 50
end

-- =================== RESOLVER ===================
local function resolve_velocity(player)
    if not has_char(player) then return nil end
    local hrp = player.Character.HumanoidRootPart
    local now = tick()
    local cache = velocity_cache[player]

    if not cache or now - cache.tick > 0.5 then
        velocity_cache[player] = { pos = hrp.Position, vel = hrp.Velocity, tick = now }
        return hrp.Velocity
    end

    local dt = now - cache.tick
    if dt > 0.001 then
        local frame_vel = (hrp.Position - cache.pos) / dt
        cache.vel  = (hrp.Velocity * 0.6) + (frame_vel * 0.4)
        cache.pos  = hrp.Position
        cache.tick = now
    end
    return cache.vel
end

-- =================== PREDICTION ===================
local function predict_position(player)
    if not has_char(player) then return nil end

    local char = player.Character
    local hrp  = char.HumanoidRootPart

    local part
    if CONFIG.HeadPriority then
        part = char:FindFirstChild("Head")
            or char:FindFirstChild("UpperTorso")
            or hrp
    else
        part = char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Head")
            or hrp
    end

    local vel = resolve_velocity(player) or hrp.Velocity
    local my_pos = has_char(local_player) and local_player.Character.HumanoidRootPart.Position or Vector3.zero
    local dist = (part.Position - my_pos).Magnitude

    local pred = CONFIG.Prediction * (1 + (dist / 300))

    if CONFIG.PingComp then
        local ping_s = math.clamp(get_ping() / 1000, 0, 0.3)
        pred = pred + ping_s
    end

    if vel.Y < -5 then
        vel = Vector3.new(vel.X, vel.Y * 0.5, vel.Z)
    end

    return part.Position + vel * pred
end

-- =================== FIRE ===================
local function fire_at(player)
    local gun = get_equipped_gun()
    if not gun then return false end
    local aim_pos = predict_position(player)
    if not aim_pos then return false end

    if CONFIG.SilentAim and remote then
        for i = 1, 3 do
            pcall(function() remote:FireServer(mouse_argument, aim_pos) end)
        end
    end

    pcall(function() gun:Activate() end)

    if CONFIG.SilentAim and remote then
        pcall(function() remote:FireServer(mouse_argument, aim_pos) end)
    end

    return true
end

-- =================== TARGETS ===================
local function get_valid_targets()
    local list = {}
    if not has_char(local_player) then return list end
    local my_pos = local_player.Character.HumanoidRootPart.Position

    for _, p in ipairs(players:GetPlayers()) do
        if p ~= local_player and has_char(p) and not is_dead(p) then
            local hrp = p.Character.HumanoidRootPart
            local dist = (hrp.Position - my_pos).Magnitude
            if dist <= CONFIG.Range then
                local skip = false
                if CONFIG.VisibleOnly   and is_behind_wall(p) then skip = true end
                if CONFIG.IgnoreKnocked and is_knocked(p)     then skip = true end
                if not skip then
                    table.insert(list, {player = p, hrp = hrp, dist = dist})
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.dist < b.dist end)
    return list
end

-- =================== TICK ===================
local function kill_aura_tick()
    if not enabled then return end
    if tick() - last_shot < CONFIG.FireDelay then return end
    if not get_equipped_gun() then return end

    local targets = get_valid_targets()
    if #targets == 0 then return end

    target_index = target_index + 1
    if target_index > #targets then target_index = 1 end

    local target = targets[target_index]
    last_shot = tick()
    fire_at(target.player)
end

